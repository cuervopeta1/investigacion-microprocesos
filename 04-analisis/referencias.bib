@thesis{delvallejimenez2014estudioa,
  title = {Estudio de relación de apropiación tecnológica en el marco del movimiento educativo abierto},
  author = {Del Valle Jiménez, Donovan Daniel},
  date = {2014-01-01},
  journaltitle = {Repositorio del Tecnológico de Monterrey (Tecnológico de Monterrey)},
  url = {https://openalex.org/W7224062923},
  abstract = {Actualmente, uno de los retos es la formación integral del estudiante. Un elemento que permiten lograr esta meta es la constante actualización del docente con respecto a sus conocimientos pedagógicos, y las diferentes tendencias como es el uso de las TIC en los procesos formativos, los que requieren propuestas de formación docente pertinente y actual. Este trabajo tiene como objetivo investigar sobre resultados de la formación docente para el uso de recursos educativos abiertos y su relación con la apropiación tecnológica, a través de la innovación educativa basada en evidencia y responder a la pregunta ¿Cómo se relaciona la formación docente en el uso de recursos educativos abiertos con los procesos de apropiación tecnológica y generación de prácticas educativas abiertas innovadoras? El marco teórico abarca la innovación educativa basada en evidencias y el movimiento educativo abierto, y la apropiación tecnológica en ambientes de aprendizaje. La metodología empleada fue el estudio de casos, con la realización de tres procedimientos: diagnóstico inicial, entrevistas y revisión de documentos significativos. Las fuentes de información fueron los docentes participantes, los observadores del desarrollo de la propuesta de formación y los productos resultantes. Como resultado de la investigación, se obtuvo que las propuestas de formación docente deben realizar una ruta coherente de apropiación tecnológica, desde la familiarización hasta la evolución con las tecnologías, articulando de manera teórica y práctica el uso de tecnologías para el desarrollo de prácticas educativas abiertas.},
  langid = {spanish},
  keywords = {iberoamericana}
}

