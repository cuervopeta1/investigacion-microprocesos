  url = {https://dialnet.unirioja.es/servlet/tesis?codigo=408865},
  urldate = {2026-11-13},
  abstract = {La tesis doctoral titulada “Estrategias docentes frente al confinamiento por COVID-19: análisis de prácticas de aula con tecnologías digitales en el primer ciclo básico de escuelas públicas de la Región de Magallanes, Chile”, elaborada por Leonardo Velásquez Castro, analiza las prácticas pedagógicas mediadas por tecnologías digitales desarrolladas por docentes del primer ciclo de Educación Básica durante la enseñanza remota de emergencia provocada por la pandemia del COVID-19. El estudio se sitúa en establecimientos públicos de Punta Arenas, Región de Magallanes y de la Antártica Chilena, y aborda una problemática central de la investigación educativa contemporánea: determinar si la incorporación de tecnologías digitales respondió a una integración pedagógica orientada al aprendizaje o constituyó, principalmente, una estrategia adaptativa destinada a sostener la continuidad escolar. El objetivo general fue analizar prácticas pedagógicas que incorporaron tecnología en el primer ciclo básico, en situaciones de clases remotas de emergencia, con el fin de evidenciar un modelo de apropiación tecnológica para el aprendizaje. Complementariamente, la investigación estudió la vinculación entre perfiles docentes, creencias, formación y prácticas pedagógicas; identificó factores facilitadores y obstaculizadores en la implementación de dichas prácticas; y examinó la relación entre las percepciones docentes y la proyección de escenarios de aprendizaje flexible post-pandemia. Los objetivos específicos profundizaron en la coherencia de las prácticas con modelos de apropiación tecnológica; el reconocimiento de criterios estructurales y metodológicos asociados a planificación, estrategias, recursos, actividades, evaluación y retroalimentación; el análisis de perfiles docentes según edad, experiencia, formación, creencias y uso de tecnologías digitales; y su sistematización en cinco dimensiones: formación previa y/o durante la pandemia, planeación de la enseñanza, ejecución de la enseñanza, factores facilitadores u obstaculizadores y proyección post-pandemia. La investigación adoptó un diseño mixto secuencial de alcance descriptivo-interpretativo. La fase cuantitativa aplicó un cuestionario estructurado a 125 docentes de primer ciclo básico de escuelas públicas para caracterizar condiciones de desempeño, formación digital, percepciones y estrategias pedagógicas durante el confinamiento. En la fase cualitativa se desarrolló un estudio de casos múltiples con una muestra intencionada de 13 docentes de ocho establecimientos, mediante entrevistas semiestructuradas y análisis documental de planificaciones, guías, recursos digitales, presentaciones y evaluaciones. El análisis cualitativo se apoyó en la unidad de análisis IDEA y en un sistema categorial validado por jueces expertos. La codificación se realizó con ATLAS.ti, integrando análisis intracasos e intercasos, análisis temático progresivo y triangulación entre cuestionarios, entrevistas y documentos. Como marco transversal se articularon los modelos TPACK, SAMR y TIM, para examinar el conocimiento docente movilizado, el nivel de transformación de las tareas y la calidad de la integración tecnológica. Los resultados muestran que la formación docente en tecnologías digitales fue desigual, predominantemente reactiva y, en muchos casos, insuficiente para responder a las exigencias de la enseñanza remota. La autoformación emergió como estrategia central de desarrollo profesional, apoyada en tutoriales, exploración autónoma de plataformas y colaboración entre pares. Las capacitaciones institucionales fueron percibidas como parciales, tardías o centradas en el manejo instrumental de herramientas, con menor énfasis pedagógico. Este hallazgo evidencia una alta agencia profesional docente, pero también un apoyo institucional limitado y sobrecarga laboral. En la dimensión de planeación de la enseñanza, la planificación dejó de operar como proceso lineal y anticipatorio para convertirse en una práctica flexible, contingente y adaptativa. La priorización curricular fue utilizada para seleccionar contenidos esenciales, aunque en varios casos derivó en una reducción significativa del currículum. Los docentes reorganizaron tiempos, recursos y actividades considerando las condiciones de conectividad del alumnado y el apoyo familiar. La planificación se orientó principalmente a sostener la continuidad pedagógica y el vínculo con los estudiantes, más que a generar transformaciones profundas en las tareas de aprendizaje. Respecto de la ejecución, predominó una modalidad mixta que combinó clases sincrónicas, actividades asincrónicas, envío de guías, uso de plataformas digitales, mensajería y videoconferencias. Las sesiones en línea se concentraron en explicar contenidos, resolver dudas y mantener la interacción pedagógica, mientras que las actividades asincrónicas se orientaron al trabajo autónomo. Aunque se observaron experiencias puntuales de innovación mediante recursos interactivos, actividades colaborativas o estrategias más activas, el patrón predominante fue adaptativo e instrumental. Desde SAMR, las prácticas se ubicaron mayoritariamente en niveles de sustitución y aumento, con escasos casos cercanos a la modificación y sin evidencia suficiente de redefinición sistemática. Desde TPACK, se advierte predominio de conocimientos tecnológicos y tecnopedagógicos iniciales, con menor consolidación de una integración profunda entre contenido, pedagogía y tecnología. Desde TIM, la integración aparece heterogénea y condicionada por el contexto. Los factores facilitadores más relevantes fueron la colaboración entre docentes, el uso de recursos personales, la disponibilidad de plataformas accesibles, el compromiso de algunas familias y ciertos apoyos institucionales. Los principales obstaculizadores fueron la brecha digital del estudiantado, la falta de dispositivos o conectividad estable, la desigualdad en el acompañamiento familiar, la ausencia de lineamientos claros, la sobrecarga laboral y emocional del profesorado y la dificultad para evaluar aprendizajes en entornos remotos. La tecnología no operó como solución neutral, sino como mediación dependiente de condiciones materiales, institucionales, familiares y territoriales. En cuanto a la proyección post-pandemia, los docentes valoraron positivamente aprendizajes derivados de la experiencia, especialmente el desarrollo de competencias digitales, la diversificación de recursos y la posibilidad de complementar la presencialidad con herramientas virtuales. Sin embargo, esta valoración fue cautelosa: la continuidad de escenarios híbridos o flexibles se consideró viable solo si se garantizan formación docente sostenida, infraestructura tecnológica, apoyo institucional, criterios pedagógicos claros y condiciones de equidad para los estudiantes. La presencialidad fue revalorizada como espacio insustituible para el vínculo pedagógico, la socialización y el acompañamiento escolar. La principal aportación original de la tesis es la noción de apropiación tecnológica de emergencia, entendida como una forma acelerada, situada, desigual y contingente de incorporación de tecnologías digitales orientada a sostener la continuidad pedagógica en un contexto de crisis. Esta categoría permite explicar que la integración observada no fue resultado de un proceso institucional planificado ni de una transformación pedagógica homogénea, sino de la convergencia entre agencia docente, presión temporal, carencias formativas, desigualdades estructurales y necesidad de mantener el vínculo educativo. Así, la tesis contribuye teóricamente al estudio de la práctica docente mediada por tecnologías en contextos de crisis; metodológicamente, ofrece un marco de análisis basado en cinco dimensiones y en la articulación TPACK-SAMR-TIM; y, en el plano práctico, aporta orientaciones para políticas de formación docente, apoyo institucional y modelos híbridos sostenibles. Las conclusiones sostienen que la enseñanza remota de emergencia no transformó automáticamente las prácticas pedagógicas, pero sí visibilizó las condiciones necesarias para una integración significativa de tecnologías digitales. La apropiación tecnológica fue parcial, heterogénea y predominantemente instrumental, aunque permitió aprendizajes profesionales relevantes y abrió oportunidades para repensar la enseñanza post-pandemia. Como futuras líneas de investigación se proponen el análisis longitudinal de la integración tecnológica tras el retorno a la presencialidad, el estudio del impacto en los aprendizajes del alumnado y la comparación con otros territorios escolares. Asimismo, se subraya la necesidad de fortalecer la competencia digital pedagógica en la formación inicial y continua, consolidar comunidades profesionales de aprendizaje y diseñar políticas tecnológicas sensibles a las desigualdades territoriales, especialmente en regiones aisladas como Magallanes.},
  langid = {spanish}
}

@article{velisalvarez2025sistema,
  title = {Sistema de mando inalámbrico para vehículo terrestre no tripulado},
  author = {Velis Alvarez, Juan Pablo and Ortega Díaz, Ernesto G. and Aguilar García, Deyvy},
  date = {2025},
  journaltitle = {Revista Científica de Ingeniería Electrónica, Automática y Comunicaciones},
  volume = {46},
  number = {1},
  pages = {3--11},
  publisher = {Departamento de Ediciones (Editorial Cujae)},
  issn = {0258-5944, 1815-5928},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10398406},
  urldate = {2026-11-13},
  abstract = {This paper proposes the design and implementation of a Wireless Command System (WCS) that uses free hardware and software to control the actuators of an Unmanned Ground Vehicle (UGV). The system consists of a Futaba T10CAG (2.4 GHz) radio controller, an R6014HS receiver, an Arduino Uno, and a signal conditioning board, allowing precise control of linear and rotational movements of the UGV. The characterization of the UGV and its integration with the WCS guarantee remote steering of the vehicle. In experimental tests its operation is demonstrated up to distances of 800 m, which overcomes the range limitations of WiFi and Bluetooth technologies. Furthermore, the design avoids dependence on cellular infrastructures such as LTE/5G, making it an ideal option for operations in hard-to-reach environments. Even when the controller boxes impose restrictions on the direction inversion of motor, which limits maneuverability in situations requiring rapid changes of direction, the WCS obtained is an adaptable solution. The combination of affordable hardware and software offers technological sovereignty, with potential for future upgrades and customization to optimize the VTNT's performance in a variety of applications. El presente trabajo propone el diseño e implementación de un Sistema de Mando Inalámbrico (SMI), que emplea hardware y software libres para dirigir los actuadores de un Vehículo Terrestre No Tripulado (VTNT). El sistema se compone de un radiocontrol Futaba T10CAG (2.4 GHz), un receptor R6014HS, un Arduino Uno y una placa de acondicionamiento de señales, que permiten el control preciso de movimientos lineales y giros del VTNT. La caracterización del VTNT y su integración con el SMI garantizan la gobernabilidad remota del vehículo. En pruebas experimentales, se demuestra su funcionamiento hasta distancias de 800 m, lo que supera las limitaciones de alcance de tecnologías WiFi y Bluetooth. Además, el diseño evita la dependencia de infraestructuras celulares como LTE/5G, convirtiéndolo en una opción ideal para operaciones en entornos de difícil acceso. Aun cuando las cajas controladoras imponen restricciones en la inversión del sentido de los motores, lo cual limita la maniobrabilidad en situaciones que requieren cambios rápidos de dirección, el SMI obtenido es una solución viable. La combinación de hardware y software accesibles, ofrece soberanía tecnológica, posibilidades de mejoras y personalización futura para optimizar el desempeño del VTNT en diversas aplicaciones.},
  langid = {spanish}
}

@inproceedings{velizhuanca2025imaginarios,
  title = {Imaginarios del futuro: hacia una educación humanamente inteligente},
  shorttitle = {Imaginarios del futuro},
  booktitle = {Superintelligence Series,  Vol. 2, 2025 (Thinking in Machine Code: Dialogues between technology, knowledge, and cultur), ISBN 978-9915-9851-2-1, págs. 110-131},
  author = {Veliz Huanca, Fatima Stefanie and Felix Pachas, Efrain Ascención},
  date = {2025},
  pages = {110--131},
  publisher = {AG Editor (Uruguay)},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10538410},
  urldate = {2026-11-13},
  abstract = {This chapter examines the future imaginaries that shape the adoption of emerging technologies and AI in education. We juxtapose techno-optimistic narratives—mass personalization, process automation, expanded access to knowledge—with critical perspectives that warn about dehumanization, surveillance, standardized thinking, and the erosion of academic labor. From pedagogical and ethical standpoints, we deconstruct technological solutionism and analyze asymmetries linked to the digital divide, technological sovereignty, and data governance. Building on this, we advance the notion of a humanly intelligent education, centered on non-automatable competencies (critical thinking, creativity, collaboration, empathy, ethical judgment), on curricular redesign with situated learning and authentic assessment, and on the reflective use of AI as an augmentation—not a replacement—of teachers. The chapter closes with guidelines for responsible integration: pedagogical relevance, algorithmic transparency, inclusion, and sustained faculty development. We argue that education’s future relies less on amassing digital tools and more on pedagogical projects that cultivate human capacities in critical dialogue with technology. Este capítulo analiza los imaginarios del futuro que orientan la incorporación de tecnologías emergentes y IA en los entornos educativos. Contrastamos narrativas tecno-optimistas —personalización a gran escala, automatización de procesos y acceso ampliado al conocimiento— con miradas críticas que alertan sobre riesgos de deshumanización, vigilancia, estandarización del pensamiento y precarización del trabajo docente. Desde una perspectiva pedagógica y ética, se deconstruye el solucionismo tecnológico y se examinan las asimetrías asociadas a brecha digital, soberanía tecnológica y gobernanza de datos. Sobre esta base, proponemos el marco de una educación humanamente inteligente, centrada en competencias no automatizables (pensamiento crítico, creatividad, colaboración, empatía y juicio ético), en el rediseño curricular con experiencias situadas y evaluación auténtica, y en el uso reflexivo de la IA como aumento del rol docente, no como su sustitución. El capítulo culmina con lineamientos para una integración responsable: pertinencia pedagógica, transparencia algorítmica, inclusión y desarrollo profesional docente continuo. Sostenemos que el porvenir educativo depende menos de acumular herramientas digitales y más de proyectos pedagógicos que potencien nuestra humanidad en diálogo crítico con lo tecnológico.},
  eventtitle = {Superintelligence Series},
  isbn = {978-9915-9851-0-7},
  langid = {spanish}
}

@thesis{vencesestudillo2022peace,
  title = {The {{Peace Epistemologies}} of {{CONAMI}}},
  author = {Vences Estudillo, Alaide and Vences Estudillo, Alaide},
  date = {2022-03-31},
  journaltitle = {Mspace (University of Manitoba)},
  url = {https://openalex.org/W7110599842},
  abstract = {This collaborative research dismantles prevalent ideas around Indigenous peoples’ epistemologies on peace, arguing that the epistemologies that Indigenous peoples have built about peace do not correspond to the past but rather are evolutionary. Indigenous women play a central role revitalizing the worldviews of their peoples. As an example, I recover the knowledge that the members of the National Coordination of Indigenous Women (CONAMI) built through their collective struggle in favor of Indigenous self-determination, aligning their fundamental rights as women with the rights of their peoples. CONAMI has been an example of a solid political space, in Mexico, and perhaps in the world, supporting women to reclaim and re-signify their Indigenous roots, resisting against past and contemporaneous forms of colonization. The main participants of this research weave community networks, negotiate with multiple actors and intervene in different spaces to push forward the structural eradication of racism, sexism, and ageism.},
  langid = {english},
  keywords = {inglesa}
}

