  doi = {10.5281/zenodo.18344282},
  url = {https://openalex.org/W7125517497},
  abstract = {Abstract: Every shared system operates on a material budget, whether or not participants maintain accounts. In April 2014, the Heartbleed vulnerability in OpenSSL compromised half of the web's secure sites. The maintenance project survived on approximately two thousand dollars in annual donations. Collective action theory explains this shortfall. Large groups chronically underfund public goods unless contributing members secure direct returns on investment. Biological markets resolve this dilemma through dynamic reciprocity. Mycorrhizal fungi trade soil minerals for plant carbohydrates along shifting terms of trade, routing resources toward roots offering optimal compensation. Within fungal bodies, genetically diverse nuclei coordinate distribution through cooperative dynamics. Human worker cooperatives demonstrate comparable structural durability. Longitudinal analysis in Uruguay confirmed that worker-managed firms exhibit a twenty-nine percent lower dissolution hazard than conventional corporations. Layer 5 of the Myceloom Protocol, the Coalition layer, tallies granular contributor labor and sustains public dependencies through pooled treasuries. Keywords: Myceloom Protocol, MCP-1, Federated Economics, Public Goods Funding, Open Source Sustainability, Collective Action, Albert Hirschman, Exit and Voice, Free to Leave, The Shared Purse, Open Books, Many Ways to Pay, Credit Follows Contribution, CRediT Taxonomy, Biological Markets, Worker Cooperatives, Commons-Based Peer Production, Heartbleed Vulnerability, Digital Infrastructure Finance},
  langid = {english},
  keywords = {inglesa}
}

@report{josuea.leon2026digital,
  title = {Digital {{Sovereignty}} and {{Intangible Heritage}}: {{Biocultural Registries}}, {{Collective Trademarks}}, and {{Non-Extractive Archives}} in {{Indigenous Mesoamerica}}},
  author = {{Josué A. León}},
  date = {2026-08-12},
  doi = {10.17613/vmcg9-vwp08},
  url = {https://openalex.org/W7202294555},
  abstract = {Digital repositories increasingly hold Indigenous intangible heritage formerly transmitted orally or through embodied practice, creating a structural tension between Open Access scholarly norms and Indigenous governance claims. This research report investigates how Indigenous communities in Mesoamerica can exercise meaningful authority over the collection, description, access, circulation, and downstream use of their intangible heritage in digital environments, and evaluates where existing intellectual-property and data-governance mechanisms succeed or fail. The study rigorously distinguishes statutory intellectual property from Indigenous Data Sovereignty (IDS) and cultural authority, analyzing the operational alignment between FAIR data stewardship principles and CARE principles for Indigenous data governance. It evaluates Traditional Knowledge (TK) and Biocultural (BC) metadata labels as practical mechanisms for expressing community protocols, and synthesizes four documented Mesoamerican cases across Panama, Guatemala, and Mexico (including Guna mola collective marks, the Maya weavers' constitutional advocacy, Mexico's 2022 Indigenous heritage law, and the Maya ICBG consent precedents). Additionally, the paper examines technical vectors of digital extraction, automated scraping, and generative AI risks, distinguishing empirical harms from technical possibilities. Synthesizing these findings, the report presents an original 9-stage Indigenous Digital Heritage Governance Framework (Authority, Consent, Provenance, Classification, Access, Attribution, Benefit, Accountability, Review) alongside actionable recommendations for repositories, archives, policy makers, and technology developers.},
  langid = {english},
  keywords = {inglesa}
}

