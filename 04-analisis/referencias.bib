  volume = {19},
  issn = {0188-252X},
  doi = {10.32870/cys.v2022.8144},
  url = {http://www.scielo.org.mx/scielo.php?script=sci_arttext&pid=S0188-252X2022000100305&lang=pt},
  abstract = {Abstract Based on research on the deployment of a community Internet network in 2019 and 2020 in a rural community of Cordoba, Argentina, the collaboration strategies between organizations to produce technological and political knowledge are analyzed. The compatibility between the approaches of technological sovereignty and food sovereignty; the education-action methodology in the territory, face-to-face, collective and experiential; cooperation during the maintenance and extension of the network; articulation with other community networks and incidence on politics stand out.},
