@article{juanferrante2026pensar,
  title = {Pensar con inteligencia artificial: dimensiones de la reflexión de estudiantes de secundaria en la creación colaborativa de problemas matemáticos},
  author = {{Juan Ferrante} and {Carolina Vivera} and {Gastón Tissoni} and {Lucía Palauro} and {Guillermo Cutrera}},
  date = {2026-09-16},
  journaltitle = {Revista Binacional Brasil-Argentina Diálogo entre as ciências},
  shortjournal = {Revista Binacional Brasil-Argentina Diálogo entre as ciências},
  volume = {16},
  number = {1},
  pages = {e19955-e19955},
  doi = {10.22481/rbba.v16i1.19955},
  url = {https://openalex.org/W7213641226},
  abstract = {Este estudio analiza la reflexión escrita de estudiantes de secundaria durante una experiencia de creación colaborativa de problemas matemáticos mediada por inteligencia artificial generativa. Se adoptó un diseño cualitativo de estudio de caso múltiple con 19 estudiantes de una escuela secundaria de la provincia de Buenos Aires, Argentina, organizados en cinco grupos, quienes elaboraron diarios de clase a lo largo de una secuencia didáctica centrada en funciones exponenciales y logarítmicas. El corpus fue analizado mediante análisis de contenido inductivo, identificándose tres dimensiones principales: interacción cognitiva con la inteligencia artificial generativa, dimensión afectivo-experiencial y mediación sociopedagógica. Los hallazgos evidencian una trayectoria de apropiación tecnológica, del escepticismo inicial al uso estratégico, acompañada por vigilancia epistémica sobre las respuestas generadas por la herramienta, incluyendo la detección de errores y la reformulación de prompts. Además, emergen emociones ambivalentes, mientras la mediación docente resulta central para sostener el compromiso emocional y promover la reflexión. Se concluye que la escritura reflexiva constituye un espacio fértil para la metacognición en educación matemática secundaria.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{juanhectoralzateespinoza2026diseno,
  title = {Diseño de Ambientes de Aprendizaje {{STEAM}} Con Robótica Educativa En La Infancia: Una Experiencia Desde El Aula},
  author = {{Juan Héctor Alzate Espinoza} and {Raúl Loredo Medina} and {Damián Fernando Luna Morales} and {Graciela Lugo Rubio}},
  date = {2026-07-06},
  journaltitle = {Rastros Rostros},
  shortjournal = {Rastros Rostros},
  volume = {28},
  number = {2},
  pages = {1--15},
  doi = {10.16925/2382-4921.2026.02.03},
  url = {https://openalex.org/W7223206801},
  abstract = {This research article presents an experience in designing and implementing a STEAM-based learning environment in early childhood education, using the LEGO® Mindstorms educational robotics kit as the primary resource. The purpose of the study was to analyze how instructional design and spatial configuration influence technological appropriation, early computational thinking, and the development of 21st-century skills in preschool children. The methodology employed was qualitative, framed within action research and informed by educational phenomenology. The study was conducted in two preschool institutions located in Guasave, Sinaloa, Mexico, during the 2025 school year. Teachers and student groups participated in experimental sessions focused on hands-on exploration, basic programming, and problem-solving challenges using LEGO® Mindstorms. The article describes the phases of instructional design, planning of STEAM activities, classroom organization as an active learning environment, and the outcomes in terms of interaction, creative exploration, and collaborative work. The findings highlight that technology-enriched environments, structured with pedagogical intention and accessible resources, foster motivation, autonomy, and problem-solving skills in early childhood. It is concluded that incorporating technologies such as LEGO® Mindstorms into preschool education is an effective way to innovate teaching models, strengthen the connection between play and learning, and project a digital culture from the earliest educational stages. As a limitation, the study is restricted to a specific educational context and an intentionally selected sample. Future research may expand the analysis to other institutional contexts and further explore the development of evaluation models for STEAM learning environments in early childhood education.},
  langid = {english},
  keywords = {inglesa}
}

@article{juanignaciomereles2024niveles,
  title = {Niveles de apropiación tecnológica autopercibidos por docentes universitarios: un análisis post pandémico en la Educación Superior en Paraguay},
  author = {{Juan Ignacio Mereles} and {Valentina Canese}},
  date = {2024-07-23},
  journaltitle = {Revista Interuniversitaria de Formación del Profesorado Continuación de la antigua Revista de Escuelas Normales},
  shortjournal = {Revista Interuniversitaria de Formación del Profesorado Continuación de la antigua Revista de Escuelas Normales},
  volume = {99},
  number = {38.2},
  doi = {10.47553/rifop.v99i38.2.101297},
  url = {https://openalex.org/W4416870982},
  abstract = {Este estudio descriptivo transversal tuvo como objetivo analizar la autopercepción de los docentes universitarios sobre los niveles de apropiación tecnológica y el uso posterior a la pandemia de COVID-19. Se aplicó un cuestionario en línea a 156 docentes de la Universidad Nacional de Asunción de Paraguay durante los dos últimos meses del 2022, donde se evaluaron tres niveles de apropiación tecnológica: Conocimiento, Utilización y Transformación e Innovación. Los datos fueron analizados mediante estadísticos de resumen, pruebas chi cuadrada, pruebas de permutaciones multivariadas y correlaciones. Los resultados evidenciaron que los docentes reconocen los beneficios de la tecnología en la enseñanza, aunque enfrentan dificultades en la utilización de algunas herramientas específicas. Se encontró que la planificación y el diseño de actividades y recursos digitales se relacionan con mejoras en el rendimiento académico. En general, no se descubrieron diferencias significativas entre los niveles de apropiación tecnológica según el sexo, la experiencia o la disciplina de enseñanza. La mayoría de los docentes se autopercibieron en los niveles Avanzado y Experto en competencias en tecnologías informáticas, y estuvieron de acuerdo en que la pandemia fortaleció su nivel de apropiación de TIC. El estudio concluye que los docentes universitarios de Paraguay presentan niveles sólidos de apropiación tecnológica, que se reflejan en el reconocimiento, el uso y la transformación en el proceso educativo. Sin embargo, es necesario continuar con el desarrollo de programas de formación y apoyo para garantizar una integración efectiva de las TIC en la educación superior post pandemia.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{juanjairovaca-gonzalez2026construccion,
  title = {Construcción participativa de sistemas acuapónicos para fortalecer la seguridad y soberanía alimentaria en una comunidad Kogui de la Sierra Nevada de Santa Marta, Colombia},
  author = {{Juan Jairo Vaca‐González} and {Luz E. Ochoa} and {Adriana Patricia Muñoz Ramírez} and {A. L. Cabrera} and {María Laura Chedraui Rodríguez} and {Juan Pablo Arias Castilla} and {Clara Patricia Arias Linares} and {Raul Andrés Martínez Torres} and {Sergio Elías Martínez Solís}},
  date = {2026-10-12},
  journaltitle = {Revista Kawsaypacha Sociedad y Medio Ambiente},
  shortjournal = {Revista Kawsaypacha Sociedad y Medio Ambiente},
  number = {18},
  doi = {10.18800/kawsaypacha.202602.a010},
  url = {https://openalex.org/W7223145942},
  abstract = {Food security remains a challenge in Colombian indigenous communities, particularly due to limited access to animal protein and reliance on external supplies. This study aimed to foster the social appropriation of knowledge through the participatory implementation of an aquaponic system at the Kaggaba Matshukumake Rural Ethno-educational Center, located in the Kogui Maruámake reserve in the Sierra Nevada de Santa Marta. Employing a participatory action research approach, students, teachers, community leaders, and researchers collaborated on the system's design, construction, and commissioning. The system integrated fish-rearing tanks, grow beds, and a photovoltaic system to ensure energy autonomy. Red tilapia (Oreochromis spp.) and bocachico (Prochilodus magdalenae) were raised alongside crops such as chives, beans, maize, cassava, arracacha, tomatoes, and cilantro. Workshops and educational tools were also developed to strengthen local capacities and facilitate dialogue between scientific and traditional knowledge systems. The results demonstrated the system's technical, productive, and community viability. Tilapia reached an average weight of 357.6 g and a length of 24.6 cm, while bocachico specimens averaged 14.9 g and 10.5 cm. Powered by solar energy, the system enabled the simultaneous production of animal protein and vegetables to supplement school meals. Educational activities enhanced learning and the adoption of technologies for sustainable food production. In conclusion, participatory aquaponics represents a viable strategy for strengthening food security and sovereignty in indigenous communities by promoting technological autonomy, renewable energy use, and the integration of scientific and ancestral knowledge, with the potential for replication in similar territories.},
  langid = {spanish},
  keywords = {inglesa}
}

@thesis{juanmanuelramongarcia2022appropriation,
  title = {Appropriation of Technologies in a Context of Conflict: The Use of Ba Taxi and the Incorporation of Technology to the Taxi Service of the City of Buenos Aires},
  author = {{Juan Manuel Ramón García}},
  date = {2022-01-01},
  journaltitle = {DigitalGeorgetown (Georgetown University Library)},
  url = {https://openalex.org/W7134441524},
  abstract = {En 2016, a la llegada de Uber y otras plataformas de transporte digital a la Ciudad de Buenos Aires, había en la ciudad cerca de 38 mil licencias habilitantes para el ejercicio del servicio de taxi.Se trata de un servicio público regulado por el Gobierno de la Ciudad de Buenos Aires desde 1942.Como sucedió en otras partes del mundo, la llegada de las plataformas estuvo marcada por la conflictividad.A partir de ese momento, los taxistas, a través de sus organizaciones tanto de propietarios como de choferes, comenzaron una estrategia de resistencia y presión que tuvo lugar en la calle, en la justicia y en las puertas de las oficinas del gobierno.En estos espacios de reclamo, una de las principales demandas fue la creación de una aplicación digital para incorporar a su trabajo.En respuesta, El Gobierno de la Ciudad de Buenos Aires creó la aplicación BA Taxi, que permite a los pasajeros solicitar taxis desde su teléfono móvil.Esta investigación busca analizar los alcances de la medida tomada por el Gobierno para dar respuesta a los reclamos de los taxistas, a cinco años de su lanzamiento.Para analizar los alcances, se implementará la perspectiva de apropiación tecnológica, dado que permitirá entender en qué medida los taxistas incorporaron la aplicación no sólo a su labor diaria, sino al universo de pertenencia en el que desarrollan sus actividads, que tiene valorizaciones y prácticas arraigadas.},
  langid = {spanish},
  keywords = {iberoamericana}
}

