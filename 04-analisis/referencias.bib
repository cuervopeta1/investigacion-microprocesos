@article{cinthyastefaniasiguenza-diaz2025innovacion,
  title = {Innovación digital como motor de bienestar económico en adultos emprendedores: Un estudio aplicado en la ciudad de Milagro, Ecuador},
  author = {{Cinthya Stefania Siguenza-Diaz} and {Erick Leandro Ruano-Lara} and {Rodrigo Josué Guevara-Reyes}},
  date = {2025-06-18},
  journaltitle = {MQRInvestigar},
  shortjournal = {MQRInvestigar},
  volume = {9},
  number = {2},
  pages = {e694-e694},
  doi = {10.56048/mqr20225.9.2.2025.e694},
  url = {https://openalex.org/W4411464025},
  abstract = {El presente artículo analiza la relación que existe entre las innovaciones digitales modernas y el bienestar personal y económico de los adultos emprendedores en la ciudad de Milagro, Guayas, Ecuador. En un contexto donde el acceso, uso y apropiación de la tecnología representa una ventaja competitiva, se identifican brechas digitales que limitan el aprovechamiento de estas innovaciones. A partir de una metodología mixta con enfoque exploratorio, se realizaron talleres y se aplicaron encuestas tipo Likert a 52 adultos. Los resultados, tanto cuantitativos como cualitativos, evidencian un alto nivel de satisfacción y apropiación tecnológica: el 100\% manifestó que volvería a participar en capacitaciones similares, y se identificaron correlaciones significativas entre las variables a evaluar. Se evidenció un impacto positivo en el bienestar económico, competitividad, colaboración emprendedora, eficiencia y productividad. Estos hallazgos confirman que la capacitación en innovación digital fortalece la sostenibilidad de los emprendimientos y contribuye al desarrollo personal y económico de los emprendedores locales.},
  langid = {spanish},
  keywords = {iberoamericana}
}

