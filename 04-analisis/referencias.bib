@thesis{calderondoria2013nivel,
  title = {Nivel de apropiación de la tecnología en los docentes de educación básica secundaria},
  author = {{Calderón Doria} and {César Darío}},
  date = {2013-05-01},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  url = {https://openalex.org/W3161279464},
  abstract = {El presente estudio se realizó con el propósito de conocer en qué punto con respecto al uso y apropiación de TIC, se encuentran los docentes de educación básica secundaria de la Institución Educativa Marceliano Polo del Municipio de Cereté-Córdoba-Colombia, donde con una metodología cuantitativa desde un enfoque no experimental y bajo la consideración de un diseño transeccional correlacional-causal, se establecen las correlaciones entre los momentos de apropiación (personal y profesional) y las competencias: Pedagógicas, Técnicas y tecnológicas, Comunicativas y colaborativas y Éticas plasmadas por el Ministerio de Educación Nacional en el marco del Programa Nacional de Nuevas Tecnologías. En el contexto educativo de esta institución, las competencias se relacionan directamente con los niveles básicos de apropiación tecnológica como lo son el nivel 2, Aprendiendo el Proceso y el nivel 3, Entendiendo y aplicando el proceso, niveles en los cuales los docentes utilizan sistemas operativos y aplicativos según su contexto y necesidades y elaboran productos utilizando aplicativos y herramientas informáticas seleccionadas.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{calderonherrera2026maquina,
  title = {La máquina de vapor como tecnología minera: retazos de un patrimonio industrial},
  shorttitle = {La máquina de vapor como tecnología minera},
  author = {Calderón Herrera, David and Mata Cabrera, Francisco and Rojas Reinoso, Vicente and Soriano Garcia, Jose Antonio and Hanafi, Issam},
  date = {2026},
  journaltitle = {Revista iberoamericana de ingeniería mecánica},
  volume = {30},
  number = {1},
  pages = {71--86},
  publisher = {Servicio de Publicaciones},
  issn = {1137-2729, 2255-3509},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10695373},
  urldate = {2026-11-13},
  abstract = {The steam engine represents one of the key technologies for understanding the transformation of European mining between the seventeenth and nineteenth centuries. Its systematic application to mine drainage made it possible to overcome long-standing technical constraints, increase mining depth, and promote the pro-gressive specialization of mechanical systems adapted to diverse geological, economic, and institutional contexts. This paper examines the historiographical and technical evolution of the steam engine as a mining technology, from early experimental developments to the innovations associated with James Watt and the consolidation of Cornish engines, while also considering parallel trajectories such as that represented by Ivan Polzunov. Particular attention is paid to processes of technological transfer and appropriation in the Hispanic world, highlighting the role played by Agustín de Betancourt in the reinterpretation and adaptation of steam principles within the frame-work of Spanish Enlightenment engineering, with special reference to the Almadén mines. Based on a critical analysis of classical sources and recent scholarship, the study addresses the main types of engines employed (atmospheric, double-acting, Cornish, compound, and high-pressure), their energy efficiency, diffusion patterns, and impact on productive organization and territorial structures. Finally, the paper reflects on the valorization of steam-mining heritage through virtual reconstructions, digital modelling, and experimental prototypes, under-stood as tools for historical research, active conservation, and heritage mediation La máquina de vapor constituye una de las tecnologías fundamentales para comprender la transformación de la minería europea entre los siglos XVII y XIX. Su aplicación sistemática al desagüe permitió superar limitaciones técnicas históricas, incrementar la profundidad de explotación y favorecer la progresiva especialización de sistemas mecánicos adaptados a contextos geológicos, económicos e institucionales diversos. Este trabajo analiza la evolución historiográfica y técnica de la máquina de vapor como tecnología minera, desde los primeros desarrollos experimentales hasta las innovaciones asociadas a James Watt y la consolidación de las máquinas Cornish, incorporando asimismo trayectorias paralelas como la representada por Iván Polzunov. Se presta especial atención a los procesos de transferencia y apropiación tecnológica en el ámbito hispánico, destacando el papel desempeñado por Agustín de Betancourt en la reinterpretación y adaptación de los principios del vapor en el contexto de la ingeniería ilustrada española, con particular referencia a las minas de Almadén. A partir del examen crítico de fuentes clásicas y estudios recientes, se estudian los principales tipos de máquinas empleadas (atmosféricas, de doble efecto, Cornish, compuestas y de alta presión), su eficiencia energética, sus condiciones de difusión y su impacto en la organización productiva y territorial. Finalmente, se reflexiona sobre la puesta en valor del patrimonio minero-vapor mediante reconstrucciones virtuales, modelización digital y prototipos experimentales, entendidos como herramientas de investigación histórica, conservación activa y mediación patrimonial.},
  langid = {spanish}
}

@article{calixto2025educomunicacao,
  title = {Educomunicação: o avesso dos algoritmos e reconfigurações comunicativas no contexto escolar},
  shorttitle = {Educomunicação},
  author = {Calixto, Douglas},
  date = {2025},
  journaltitle = {Comunicação \& Educação},
  volume = {30},
  number = {2},
  pages = {66--82},
  publisher = {Universidade de São Paulo},
  issn = {0104-6829, 2316-9125},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10500366},
  urldate = {2026-11-13},
  abstract = {This article analyzes the influence of algorithms in the school context. Numerical protocols and predictive systems on the internet have reconfigured the cultural fabric. Consequently, school dynamics are traversed by symbolic codes circulating within platforms mediated by algorithmic logics such as Instagram, TikTok, and YouTube. Based on fieldwork conducted in the southern periphery of São Paulo, we systematize evidence that demonstrates the entanglement of algorithms with the cultural practices of teachers and students. At the interface of Communication and Education, we present analyses of how the school community interacts with influencers, short videos, and other productions mobilized by algorithms. Este artigo analisa a influência de algoritmos no contexto escolar. Protocolos numéricos e sistemas de predição na internet passaram a reconfigurar a trama cultural. Com efeito, as dinâmicas escolares são atravessadas pelos códigos simbólicos em trânsito em plataformas mediadas por dinâmicas algorítmicas, tais como Instagram, TikTok e Youtube. Em pesquisa de campo no extremo sul de São Paulo, sistematizamos evidências que demonstram o entrelaçamento dos algoritmos com práticas culturais de docentes e discentes. Na interface Comunicação e Educação, apresentamos análises de como a comunidade escolar interage com influencers, vídeos curtos e outras produções mobilizadas por algoritmos.},
  langid = {portuguese}
}

