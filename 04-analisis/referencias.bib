@article{dianasorayaloayzabriones2025integracion,
  title = {Integración del Storytelling Digital y las TIC para el Desarrollo de la Comprensión Lectora Crítica en Educación Básica: Un Enfoque desde la Innovación Didáctica},
  author = {{Diana Soraya Loayza Briones} and {María Mercedes Valle Jaramillo} and {Sidel María Valle Jaramillo} and {Kety Dalmita Ajila Rueda} and {Mariana De Jesús Mendía Nagua} and {Yadira Melida Chamba Cárdenas}},
  date = {2025-07-21},
  journaltitle = {Revista Veritas de Difusão Cientifica.},
  shortjournal = {Revista Veritas de Difusão Cientifica.},
  volume = {6},
  number = {2},
  doi = {10.61616/rvdc.v6i2.705},
  url = {https://openalex.org/W4412533575},
  abstract = {El estudio que se presenta busca evaluar el efecto de incorporar el storytelling digital y las Tecnologías de la Información y la Comunicación (TIC) en la comprensión lectora crítica de alumnos de educación básica, atendiendo a un enfoque de innovación didáctica. La hipótesis central plantea que un entorno digital que se articula con estrategias narrativas puede incentivar destrezas lectoras avanzadas y, por ende, favorecer una lectura más analítica, reflexiva y ajustada a los diferentes contextos en que hoy se producen los textos. El estudio utilizó un diseño de investigación-acción educativo con un enfoque mixto que privilegió los métodos cualitativos y se llevó a cabo en escuelas primarias urbanas. La población estuvo formada por 120 alumnos de 9 a 12 años y diez docentes formados en didáctica digital. Se ejecutó una intervención pedagógica centrada en la elaboración conjunta de narrativas digitales a través de Canva, Powtoon y blogs escolares. La información se obtuvo mediante rúbricas que midieron comprensión crítica, diarios de campo, entrevistas semiestructuradas y cuestionarios administrados antes y después de la actividad. Los análisis muestran avances significativos en la capacidad de inferencia, el examen de intenciones comunicativas y la evaluación crítica de los textos, sobre todo en los grupos donde la incorporación de tecnologías se acompañó de una mediación docente activa y reflexiva. Además, se registraron índices altos de motivación y apropiación tecnológica, factores que impulsaron al estudiante a verse como productor con propósito. La triangulación de evidencias cualitativas y cuantitativas corroboró una asociación positiva entre el uso del storytelling digital y el fortalecimiento de habilidades lectoras críticas. En resumen, el uso del storytelling digital en el aula, cuando se aplica desde una perspectiva pedagógica moderna, se revela como un recurso valioso para mejorar la comprensión lectora crítica en la educación básica. Esta estrategia no solo hace que las clases sean más dinámicas, sino que también contribuye a formar ciudadanos analíticos y con habilidades de alfabetización digital. Por ello, se sugiere que se incluya de manera regular en los planes de estudio y que los docentes reciban formación continua en competencias digitales para la enseñanza.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{dianastephanieleguizamonrojas2022apropiacion,
  title = {Apropiación de las plataformas tecnológicas para realizar trámites administrativos en Salud en la localidad de Chapinero},
  author = {{Diana Stephanie Leguizamón Rojas} and {Andrés Alejandro Upegui Castillo}},
  date = {2022-07-01},
  journaltitle = {REDIIS / Revista de Investigación e Innovación en Salud},
  shortjournal = {REDIIS / Revista de Investigación e Innovación en Salud},
  volume = {5},
  doi = {10.23850/rediis.v5i5.4051},
  url = {https://openalex.org/W4313034378},
  abstract = {Las Tecnologías de la Información y la Comunicación en el sector salud constituyen una herramienta que optimiza los procesos, promueve el acceso a una atención oportuna y de calidad, brinda respuestas a las necesidades planteadas desde el diseño, planeación, gestión, administración y control en el marco de los servicios de salud. Sin embargo, en medio de esta revolución digital se evidencia una gran brecha no solo por la falta de recursos materiales y/o económicos, sino también de conocimiento, uso y apropiación tecnológica que facilite la adherencia y empoderamiento de la población. Objetivo: Determinar el nivel de apropiación que tienen los usuarios de la localidad de Chapinero sobre las plataformas tecnológicas para realizar trámites administrativos en Salud. Metodología: Estudio cuantitativo, descriptivo, observacional y transversal. Muestra no probabilística, intencional o de conveniencia. Población: Habitantes de la localidad de Chapinero (Mayores de 18 años, afiliados al SGSSS, sin discapacidad cognitiva). Resultados: 52\% de las personas encuestadas refirieron no haber recibido información, orientación o capacitación por parte de la entidad de salud acerca de las plataformas tecnológicas que ofrecen para realizar trámites administrativos en salud, la mayoría refirió estar afiliado al régimen contributivo y tan solo el 15\% de las personas respondieron que siempre utilizan las plataformas electrónicas dispuestas por su EPS/IPS para realizar trámites administrativos en salud y consideran que son de fácil acceso. Conclusiones: La trasformación digital en el sector salud hace necesario el empoderamiento de las personas por medio de una alfabetización digital que promueva el uso, conocimiento y apropiación tecnológica fomentando la cultura digital y reduciendo así las brechas y su impacto en el sector. Palabras clave: TIC, plataformas tecnológicas, tramites administrativos, salud, transformación digital, educación.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{dias2026aprendizagem,
  title = {Aprendizagem baseada em vídeo no ensino de geografia: uma proposta educomunicativa para o desenvolvimento crítico de estudantes},
  shorttitle = {Aprendizagem baseada em vídeo no ensino de geografia},
  author = {Dias, Elisa Aparecida and Rivelini, Angélica Cristina},
  date = {2026},
  journaltitle = {Comunicação Midiática},
  volume = {21},
  number = {1},
  pages = {81--96},
  publisher = {Universidade Estadual Paulista Júlio de Mesquita Filho},
  issn = {2236-8000},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10910362},
  urldate = {2026-11-13},
  abstract = {This article presents the results of a continuing education program entitled “Educommunication:  videos as a didactic tool for the teaching of Geography”, offered to 12 teachers from the public  school network of Cornélio Procópio (PR). The proposal integrated principles of  Educommunication and Video-Based Learning (VBL). The study employed qualitative analysis  and descriptive statistics. The results indicate recognition of the pedagogical potential of videos  for content delivery and critical thinking (mean=1.75; mode=2). However, little practical  experience in audiovisual production was observed (mean=1.57). Half of the teachers were  unfamiliar with the term “educommunication” (mean=0.5), although many already engage in  related practices (mean=0.83). A gap was observed between students’ technological  appropriation and teachers’ resistance. The creation of communicative ecosystems and critical,  creative training limitations. pathways is advocated. It is concluded that continuing education  in VBL is a promising path for authorial and collaborative practices aligned with BNCC, despite  methodological. Este artigo apresenta os resultados de uma formação continuada intitulada “A Educomunicação:  vídeos como ferramenta didática para o ensino de Geografia”, ofertada a 12 docentes da rede  pública de Cornélio Procópio (PR). A proposta integrou fundamentos da Educomunicação e da  Aprendizagem Baseada em Vídeo (ABV). O estudo utilizou análise qualitativa e estatística  descritiva. Os resultados indicam reconhecimento do potencial pedagógico dos vídeos para  conteúdos e pensamento crítico (média=1,75; moda=2). Contudo, revelou-se baixa experiência  prática em produção audiovisual (média=1,57). Metade dos docentes desconhecia o termo  “educomunicação” (média=0,5), embora muitos já realizem práticas afins (média=0,83).  Observou-se descompasso entre a apropriação tecnológica dos alunos e resistências docentes.  Defende-se a criação de ecossistemas comunicativos e percursos formativos críticos e criativos.  Conclui-se que a formação continuada em ABV é caminho promissor para práticas autorais e  colaborativas, alinhadas à BNCC, apesar de limitações metodológicas. Este artículo presenta los resultados de una formación continua titulada “La Educomunicación:  videos como herramienta didáctica para la enseñanza de Geografía”, ofrecida a 12 docentes de  la red pública de Cornélio Procópio (PR). La propuesta integró fundamentos de la  Educomunicación y del Aprendizaje Basado en Video (ABV). El estudio utilizó análisis cualitativo  y estadística descriptiva. Los resultados indican el reconocimiento del potencial pedagógico de  los videos para contenidos y pensamiento crítico (media=1,75; moda=2). Sin embargo, se reveló  poca experiencia práctica en producción audiovisual (media=1,57). La mitad de los docentes  desconocía el término “educomunicación” (media=0,5), aunque muchos ya realizan prácticas  afines (media=0,83). Se observó un desajuste entre la apropiación tecnológica de los estudiantes  y las resistencias docentes. Se defiende la creación de ecosistemas comunicativos y recorridos  formativos críticos y creativos. Se concluye que la formación continua en ABV es un camino  prometedor para prácticas autorales y colaborativas, alineadas a la BNCC, a pesar de  limitaciones metodológicas.},
  langid = {portuguese}
}

@article{diaz2020tiempos,
  title = {Tiempos de pandemia y enseñanza universitaria: recrear las propuestas metodológicas entre el hogar y las plataformas de medios conectivos},
  author = {Diaz, Ana Griselda},
  date = {2020-10},
  journaltitle = {Revista Innovaciones Educativas},
  shortjournal = {Revista Innovaciones Educativas},
  volume = {22},
  pages = {50--63},
  issn = {2215-4132},
  doi = {10.22458/ie.v22iespecial.3216},
  url = {http://www.scielo.sa.cr/scielo.php?script=sci_arttext&pid=S2215-41322020000300050&lang=pt},
  abstract = {Abstract: Innovations in communications entail changes in the modes of interaction and social development. In order to face those changes, Universities are required to incorporate new contents as well as teaching techniques that enable future professionals to perform in changing and uncertain scenarios. In Argentina, the pandemic destabilized higher education’s most prevailing type of pedagogical mediation: live, simultaneous explanations in enclosed physical spaces. The emerging virtualization of face-to-face university courses has revealed that the traditional modes of knowledge communication were only compatible with a single system of analog and tangible reality. Connective media enables the pedagogical continuity of vocational training nowadays and it requires the learning of technological skills from both the teachers, so they can teach the contents, and from the students for knowledge appropriation. The objectives of this essay are: a) To rethink the current pedagogical and technological mediation processes of university teaching practices where classrooms and classes unfold between the ecosystem of connective media and the homes of teachers and students. b) To conceptually bring to light the relevance of the methodological construction category as a possibility to understand and recreate the modes of didactic intervention at a higher education level. Considering approaches to inclusive education, media-based learning, and contemporary didactics perspectives, it is argued that, in the methodological constructions didactic innovations are revealed to be enablers of mediation processes and technological appropriation in unequal contemporary scenarios overpassed by technological ecosystems.},
  langid = {spanish},
  keywords = {COVID-19,Enseñanza multimedia,Enseñanza superior,ensino multimídia,Ensino superior,Higher Education,Medios sociales,mídia social. Pandemia,Multimedia Teaching,Pandemia,Pandemic,Social Media}
}

@thesis{diazpalma2015analisis,
  title = {Análisis de las incidencias productivas y financieras obtenidas a partir de la implementación de sistemas de comunicaciones ip en principales negocios de Retail de la ciudad de Guayaquil},
  author = {{Díaz Palma} and {Miguel Gustavo}},
  date = {2015-01-01},
  journaltitle = {Americanae (AECID Library)},
  url = {https://openalex.org/W2920128165},
  abstract = {La importancia de la investigación, se debe al crecimiento y a la apropiación tecnológica de las comunicaciones IP en las empresas del Ecuador la misma que se viene dando en los últimos años por lo que es de alta importancia para los administradores de los departamentos de TI conocer los aportes y desventajas que se obtendrán, el presente estudio permitirá conocer cuáles son las infraestructuras tecnológicas, costos de las mismas y los resultados obtenidos en lo productivo y financiero por parte de los retailers analizados, para lo cual se ha recopilado información por medios de herramientas de análisis como las entrevistas realizadas a los administradores, software especializados para la recopilación de datos como eficiencia, niveles de servicio, información con la que se medirá la productividad del sistema, número de llamadas realizadas entre agencias con la cual se conocerá los costos de utilización de esta tecnología, se consultó a expertos en los sistemas de comunicaciones con el fin de conocer el costo de la infraestructura implementadas y análisis de la misma, se concluye que la integración de este tipo de tecnologías genera una incidencia positiva en lo productivo, medido a partir de parámetros de eficiencia y niveles de servicio en la atención al cliente interno y externo, también obtenemos un balance optimista en lo financiero, debido al ahorro de costos que se generan a partir del uso de estas tecnologías.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{didier2022programa,
  title = {O Programa Conectar Igualdad analisado a partir do construtivismo crítico de Andrew Feenberg},
  author = {Didier, Lucila and Ficoseco, Verónica and Couto, Edvaldo Souza},
  date = {2022},
  journaltitle = {Revista Ibero-Americana de Estudos em Educação},
  volume = {17},
  number = {2},
  pages = {1263--1278},
  publisher = {Universidade Estadual Paulista Júlio de Mesquita Filho},
  issn = {1982-5587},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8583262},
  urldate = {2026-11-13},
  abstract = {The objective of the article is to analyze the structure and the logic of operation of the Conectar Igualdad Program (PCI) developed in Argentina between 2011 and 2018 from the perspective of Andrew Feenberg's critical constructivism, in order to analyze salient aspects of said program with the focus on the processes of democratization and technological transformation. The method used was qualitative, descriptive and analytical. It is concluded that although the PCI was a program of such importance in relation to other policies in the area, certain difficulties can be identified in its implementation in relation to technological democratization since it reproduces logics of importing technology, distributing equipment and purchase of private licences. Even so, the intention of the program and related policies to walk towards technological sovereignty is highlighted. El objetivo del artículo fue analizar la estructura y la lógica de funcionamiento del Programa Conectar Igualdad (PCI), desarrollado en Argentina entre los años 2011 y 2018, desde la perspectiva del constructivismo crítico de Andrew Feenberg, a los fines de analizar aspectos salientes de este dicho programa a partir del foco en los procesos de democratización y transformación tecnológica. El método usado fue el cualitativo, descriptivo y analítico. Se concluye, que sí bien el PCI fue un programa de tamaña importancia en relación a otras políticas del área, pueden identificarse en su implementación ciertas dificultades en relación a la democratización tecnológica ya que reproduce lógicas de importación de tecnología, de distribución de equipamientos y de compra de licencias privadas. Aún así, se remarca la intención del programa y de políticas anexas de caminar hacia la soberanía tecnológica. O objetivo do artigo foi analisar a estrutura e a lógica de funcionamento do Programa Conectar Igualdad (PCI), desenvolvido na Argentina entre 2011 e 2018, a partir da perspectiva do construtivismo crítico de Andrew Feenberg, para discutir aspectos desta política pública com foco nos processos de democratização e transformação tecnológica. O método usado foi o qualitativo, descritivo e analítico. O estudo concluiu que o PCI foi um programa de grande importância em relação com outras políticas da área, podem se identificar na sua implementação algumas dificuldades em relação a democratização tecnológica já que o programa reproduz lógicas de importação de tecnologias, de distribuição de equipamentos e de compra de licenças privativas. Ainda assim, remarca-se a intencionalidade do programa e das políticas anexas de caminhar para a soberania tecnológica.},
  langid = {portuguese},
  file = {/home/cuervo/Zotero/storage/6GWSASLY/Didier et al. - 2022 - O Programa Conectar Igualdad analisado a partir do construtivismo crítico de Andrew Feenberg.pdf}
}

@thesis{diegoalbertotorradosoto2011research,
  title = {Research seminar, study of the variable involved in rod pumping system for the design, control, and optimization of wells in campo},
  author = {{Diego Alberto Torrado Soto} and {Fernanodo Diaz} and {Jefferson Giovanni Villamizar Lopez} and {Jorge Humberto Buitrago Rozo} and {Luis Andres Aguilar Gomez}},
  date = {2011-01-01},
  journaltitle = {Universidad Industrial de Santander},
  url = {https://openalex.org/W7133421683},
  abstract = {La Universidad Industrial de Santander Œ UIS y La Empresa Colombiana de Petróleos Œ ECOPETROL S.A., firmaron el Convenio Interadministrativo de Cooperación Empresarial con fines Científicos y Tecnológicos, por medio del cual la compañía estatal petrolera hizo entrega a la UIS del Campo Colorado. Esta alianza se constituye en la primera experiencia nacional en materia de interacción académica - industria en el sector hidrocarburos. Con este convenio se busca fortalecer la formación integral de los estudiantes al incorporar un componente práctico en sus programas académicos y desarrollar proyectos de investigación y apropiación tecnológica. Para optimizar el comportamiento de sistemas por bombeo mecánico de Campo Colorado es importante identificar y entender los problemas que reducen la rentabilidad. Se pretende crear una base metodológica y conceptual para la comprensión de los fundamentos del bombeo mecánico y el uso inteligente de las actuales tecnologías. Grandes ahorros e incrementos en los ingresos son posibles si optimizamos el comportamiento del sistema por bombeo mecánico usando tecnología moderna. Este seminario ayudara a entender los principios básicos del bombeo mecánico y a familiarizar la tecnología moderna de diagnóstico, para establecer una base procedimental como sustento científico para la posterior realización de proyectos específicos como el desarrollo de software e implementación de sistemas automatizados en los pozos de Campo Colorado.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{diegofernandomelofiallos2017tecnologias,
  title = {TECNOLOGÍAS EN LA EDUCACIÓN SUPERIOR: POLÍTICAS PÚBLICAS Y APROPIACIÓN SOCIAL EN SU IMPLEMENTACIÓN},
  author = {{Diego Fernando Melo Fiallos} and {Judith Silva-Chávez} and {Luis René Indacochea Mendoza} and {Jorge Humberto Núñez Campaña}},
  date = {2017-05-16},
  journaltitle = {Revista Digital de Investigación en Docencia Universitaria},
  shortjournal = {Revista Digital de Investigación en Docencia Universitaria},
  pages = {193--206},
  doi = {10.19083/ridu.11.498},
  url = {https://openalex.org/W2617607919},
  abstract = {En el presente artículo se hace un análisis sobre la implementación de tecnologías de información y comunicación en la educación superior con el objetivo de aportar conocimiento sobre las tendencias en su apropiación social. Para ello se ha hecho una revisión de documentos de política pública y literatura científica, que contienen las directrices planteadas por organismos internacionales en las cuales se presentan diferentes alternativas para orientar el proceso de integración de las tecnologías en la formación. Seguidamente se comentan algunos estudios acerca de problemáticas surgidas en el proceso de apropiación tecnológica sin un cambio en el proceso de enseñanza - aprendizaje, para lo cual se discute la teoría de aprendizaje conectivista como posible marco de referencia. Las conclusiones apuntan a centrar la atención en los procesos de aprendizaje más que a la inversión en equipamientos, subrayando la importancia de las tecnologías en la educación, en el contexto de la cuarta revolución industrial en la era digital.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{diegomunguiamolina2024funciones,
  title = {Funciones de la tecnología de información en el sistema mundo de la modernidad occidental: Hacia la apropiación tecnológica en América Latina},
  author = {{Diego Munguía Molina}},
  date = {2024-12-20},
  journaltitle = {International Journal of Engineering Social Justice and Peace},
  shortjournal = {International Journal of Engineering Social Justice and Peace},
  volume = {11},
  number = {1},
  pages = {23--37},
  doi = {10.24908/ijesjp.v11i1.17649},
  url = {https://openalex.org/W4406810375},
  abstract = {Se presenta un análisis de las principales funciones que cumple la tecnología de información como parte del sistema-mundo moderno del capitalismo global, considerando el período de tiempo entre la segunda mitad del siglo XX hasta la actualidad. Siguiendo el planteamiento teórico de Aníbal Quijano, estas funciones se categorizan de acuerdo con las dimensiones de las relaciones sociales de trabajo, sexo y autoridad, y se relacionan correspondientemente con las instituciones del mercado capitalista, el patriarcado, y los estados nacionales y las organizaciones transnacionales. La identificación de estas funciones permite explicitar los fines con los que históricamente se ha diseñado la tecnología de información. Este conocimiento constituye un insumo para la toma de decisiones en procesos de apropiación tecnológica que posibilitan la resignificación del diseño de tecnología de información para atender las necesidades de las poblaciones latinoamericanas y de esta forma fomentar la mejora de sus condiciones de vida.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{diegoquattrini2025experiencia,
  title = {Experiencia Sensorial en la sociedad 4.0: ¿Es pertinente un enfoque etnográfico tradicional?},
  author = {{Diego Quattrini} and {Agustina Gabriela Sánchez}},
  date = {2025-08-01},
  journaltitle = {Conicet},
  shortjournal = {Conicet},
  url = {https://openalex.org/W7169692735},
  abstract = {El avance de la digitalización interpela las prácticas metodológicas de la etnografía, especialmente el lugar que ocupa la observación participante en investigaciones cualitativas. Este trabajo reflexiona sobre los desafíos que presentan los entornos digitales para el quehacer etnográfico, considerando la necesidad de implicación sensible y situada por parte del investigador. La irrupción de plataformas, pantallas y dispositivos móviles transforma las rutinas, la noción de campo y los modos de registrar lo cotidiano. En este contexto, se analiza cómo se entrelazan lo digital y lo material, dando lugar a experiencias híbridas, cuerpos reconfigurados y nuevas formas de atención y exposición. A través del estudio de las prácticas digitales de artesanos emprendedores, se examina la validez de herramientas propias de la etnografía clásica frente a las dinámicas de la sociedad 4.0. El trabajo de campo revela tensiones en la apropiación tecnológica por parte de trabajadores manuales, que abren la posibilidad de repensar las sensibilidades emergentes y las estrategias de observación en escenarios digitales.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@book{diegorestrepo-leal2021camino,
  title = {El camino a las redes neuronales artificiales},
  author = {{Diego Restrepo-Leal} and {Julie Viloria-Porto} and {Carlos Arturo Robles Algarín}},
  date = {2021-09-01},
  doi = {10.21676/9789587464290},
  url = {https://openalex.org/W3201440865},
  abstract = {En los últimos años se ha visto un acelerado crecimiento en el uso de las redes neuronales artificiales y la inteligencia computacional en el mundo. Esto obedece a diferentes factores como las mejoras a nivel de fabricación de los procesadores y la adopción de la filosofía del hardware y software libre, con lo cual se consolidaron comunidades cooperativas en torno a proyectos cada vez más ambiciosos e innovadores. Como resultado, han surgido diversas iniciativas que facilitan la implementación de redes neuronales artificiales, aunque a su vez se han convertido en una caja negra para los usuarios puesto que están conformadas por numerosos módulos que se traducen en muchas líneas de código por asimilar. Entendiendo la importancia de forjar bases sólidas de conocimiento, los autores realizan a lo largo de esta obra un recorrido de diversos conceptos y herramientas matemáticas para sumergir poco a poco al lector en la creación de sus propias utilidades para implementar redes neuronales, con un lenguaje amigable en el que se abordan numerosos ejemplos prácticos, los cuales están disponibles en una máquina virtual y en un repositorio público.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{diegoterevintocharquero2024desenvolupament,
  title = {Desenvolupament d'una aplicació mòbil per a l'ajuda a la regularització i restitució de terres a Colòmbia},
  author = {{Diego Terevinto Charquero}},
  date = {2024-09-05},
  journaltitle = {Hispana},
  url = {https://openalex.org/W7154556522},
  abstract = {[ES] Este proyecto describe el desarrollo de una aplicación móvil diseñada para simplificar los procesos de restitución y regularización de tierras en Colombia, un problema que afecta aproximadamente al 60\% de las tierras del país. La aplicación, desarrollada en el marco del proyecto MetaTierras y financiada por la UPV, permite a los campesinos capturar y enviar datos georreferenciados directamente desde sus campos a un servidor central. Esta información será posteriormente procesada por técnicos especializados. La aplicación, que es instalable en cualquier dispositivo con sistema operativo Android, utiliza tecnologías de código abierto y ha sido implementada utilizando Angular y SQLite, lo que permite el almacenamiento de datos en el dispositivo aún sin conexión a internet. Estos datos almacenados pueden ser enviados al servidor una vez que el dispositivo se conecte a internet. Mediante la aplicación, los propietarios pueden declarar dónde están sus propiedades, aportando de una forma sencilla una posición aproximada de sus linderos, así como los datos de la propiedad, y sus propietarios El desarrollo de esta aplicación ha sido en colaboración con la Fundación Forjando Futuros (FFF) y la Asamblea de Cooperación por la Paz (ACPP), dos ONG que operan en Colombia.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{dinekezeegerspaget2020european,
  title = {European {{Public Health News}}},
  author = {{Dineke Zeegers Paget} and {Iveta Nagyová} and {Dineke Zeegers Paget} and {Hans Henri P. Kluge} and {Floris Barnhoorn}},
  date = {2020-09-14},
  journaltitle = {European Journal of Public Health},
  shortjournal = {European Journal of Public Health},
  volume = {30},
  number = {5},
  pages = {1031--1033},
  doi = {10.1093/eurpub/ckaa177},
  url = {https://openalex.org/W4213315050},
  abstract = {In this issue of the European public health news pages, we talk about collaboration and appreciation. Nagyova higlights the need to move out of silos and urges us all to be deliberately collaborative and work together with other fields and disciplines touching upon health as one team. Kluge presents the Mental Health Coalition, which is a key component of the 2020-2025 European Programme of Work and is also a key component of the post-COVID-19 recovery and reform. Zeegers highlights the need for appreciation taking the Dutch decision NOT to increase salaries of health care professionals (particularly nurses) as an example of how not to show your appreciation for their hard and excellent work during COVID-19. Barnhoorn explains the benefits of the virtual World Congress on Public Health as we have a wider audience, but also world-renowned speakers. When individual parts are connected together, they are worth more than if the parts were in silos. A phrase attributed to Aristotle ‘The whole is greater than the sum of the parts’ aptly defines the modern concept of synergy. In public health, there are numerous examples of why we need to move out of silos and work together with other fields and disciplines as a team. In 2015, the world leaders agreed on ambitious 2030 Agenda for Sustainable Development and its Sustainable Development Goals (SDGs). The 2030 Agenda consists of 17 SDGs and 169 universal, interconnected and indivisible targets1 that together create a vision of what a prosperous future world could look like. Health and well-being (SDG 3) are both enablers and major outcomes of sustainable development. However, achieving targets in SDG 3 can only be possible if actions in other 16 SDGs are also advancing and if these actions are accelerated across the whole of government and society.2 To deliver on the 2030 Agenda, states, international organizations and enterprises need to prepare effectively, leverage synergies, minimize trade-offs and view the Agenda as an indivisible whole.3 Another example that may be highlighted is the need for behavioural insights in public health research and policy. The outcomes of empirical findings show that 80\% of heart disease, 75\% of type 2 diabetes and 40\% of cancers are preventable tackling behavioural, psychosocial and environmental determinants of health.4,5 Health behaviour constitutes the foundation of good physical and mental health and as such the relevance and importance of behavioural sciences in public health could hardly be over-emphasized. In the last decades well-validated, cost-effective behavioural medicine interventions have been developed, with techniques for modifying behaviour, and enhancing motivation and learning for health.5,6 Yet, the public health community remained somewhat reluctant and only a few such interventions have been translated into policy recommendations or implemented successfully in practice. On the other hand, it must be acknowledged that the opportunities of applying behavioural insights to policymaking are increasingly used within leading institutions and organizations. For instance, on 30 July 2020, the World Health Organisation (WHO) announced the launch of the Technical Advisory Group on Behavioural Insights and Sciences for Health.7 Likewise, the Organisation for Economic Co-operation and Development (OECD) and the European Commission (EC) are both having divisions or agendas dealing with behavioural insights in order to improve people’s health and well-being.8,9 In line with the above-mentioned, the important lesson that we have learned from tackling the COVID-19 pandemic is that we are interconnected and interdependent on each other in ways we did not fully comprehend before. Addressing global issues in public health requires international cooperation that brings together the best minds and data from different fields and countries. COVID-19 has raised the expectations we have of science. International, multidisciplinary and transdisciplinary scientific research partnerships should become the standard and not the exception. We also need open-source knowledge, data and information.10 In addition, we need effective knowledge translation and science communication. ‘Collaboration, coordination and communication across the public health community are essential; supporting a digital dialogue with citizens and communities’.11 Undoubtedly, if we want to be successful in achieving our ambitious public health goals, we should move from silos to synergies, and deliberately and proactively collaborate with other fields and disciplines. By applying principles of knowledge fusions, based on the synergistic use of knowledge from multiple sources, we will be able to obtain new useful knowledge elements supporting the process of development and implementation of public health policies, processes and interventions. The 16th World Congress on Public Health 2020 ‘Public health for the future of humanity: analysis, advocacy and action’ can serve as a bridge between the different worlds of research, evaluation and policymaking. It is a platform that provides opportunities for both sharing and generating new knowledge to maximize the impact of research by disseminating existing information, rapidly and at all levels. It presents opportunities to broaden partnerships and strengthen collaborations, operating in continuous and synchronized action to promote people’s health and well-being. At the writing of this column, we are in the fifth month of the COVID-19 pandemic. So by now, we should have learned some lessons. An obvious one, highlighted recently again by the Organisation for Economic Cooperation and Development (OECD) (https://oecdobserver.org/news/archivestory.php/aid/1241/Health\_and\_the\_economy:\_A\_vital\_relationship\_.html, last accessed 25 July 2020), is that a healthy population is a necessity for a healthy economy. This means that a good public health and health care system, as well as well-trained and motivated health care workers (including public health workers) are essential. In this time of COVID-19, countries have realized and come to rely on a good functioning health care workforce, ready to take care of the ill and ready to take personal risks to do so. During the first months, health care workers were highly praised as being essential in fighting the pandemic. Furthermore, nurses who had left the profession (e.g. by becoming teachers) came back to help in this pandemic and nurses in training continued their internship to assist wherever they could. The whole profession—doctors and nurses alike—stepped up to take care of those struck with COVID-19. After months of applauding them, encouraging them and thanking them, the whole health before wealth seems to have come to a stop. Financial reasons to restart the economy have taken over from making sure the health care workers and facilities are prepared and stocked for a possible second wave. Now, usually I would not highlight the faults in our system, but I am upset at what is going on. In the Netherlands, health care workers will receive a one-off reward for their hard work (1000 Euro/person), but the government decided that—due to the economic crisis—there is no money left to increase the salary of health care workers (https://www.rtlnieuws.nl/nieuws/politiek/artikel/5178313/salarissen-de-zorg-worden-niet-extra-verhoogd, last accessed 19 August 2020). There is, however, money enough to substantially support (we are talking hundreds of millions) the Royal Dutch Airlines and national railways. It is essential to realize that health and economy are interlinked and that the one cannot thrive without the other. In COVID-19 times, the health care and public health workers have proven their value and I would like to stress that they have earned the right to be appreciated and rewarded for that. This year, World Mental Health day will take on a particularly important significance. Ten months into a pandemic that has completely altered patterns of work, education and living, we are beginning to see the devastating psychosocial effects associated with the virus itself, as well as a direct or indirect consequences of the measures that have had to be put in place to control transmission. COVID-19 has hit the poor and most vulnerable most severely, exacerbating pre-existing inequalities. Mental health is no exception. I had identified mental health as one of the four flagship priorities for the European Programme of Work 2020–2025, ‘United Action for Better’ Health, after conducting a listening tour of the 53 European Member States as part of my election campaign in 2019. At that time, it was already very clear to me that capital after capital, Ministries of Health were worried about the burden of disease caused by mental health, the stigma and increasing inequalities and the challenges in transforming services to meet increasing needs and demand across all ages. The arrival of COVID-19, a viral illness, has paradoxically strengthened the case for mental health to be a strong pillar of our effort in the European Programme of Work over the coming years. COVID-19 has unfortunately brought about disruption of routine mental health services, leaving those who were already vulnerable in a more precarious position. Furthermore, measures involving physical distancing have had negative impacts on socialization of children and youths as well as increasing the severe loneliness experienced by older persons. Healthcare workers who have given their utmost over the past months are also experiencing burn-out and mental health consequences associated with the huge challenges they are facing in dealing with the pandemic, striving to keep routine services in place whilst finding a way to cope with the implications of the pandemic on their personal lives and families. The financial and economic repercussions associated with the pandemic, including rising unemployment being seen in several countries, will also continue to increase the burden of mental illness for the coming months and years. In short, concerted efforts by everyone are going to be needed now, more than ever before. It is for this reason that WHO EURO shall be launching a ‘Mental Health Coalition’ as a core component of the European programme of ‘post-COVID-19 recovery and reform’. The Mental Health Coalition will convene high-profile, committed personalities and influential stakeholders, including the affected communities, under the auspices of Her Majesty Queen Mathilde of Belgium, to transform societal attitudes about mental health. The coalition will work to eliminate stigma and discrimination by increasing mental health literacy, also among the health workforce. It will mobilize commitments for investment in mental health and advocate for the service reforms that can bring mental health care in all Member States to deliver care and services in line with standards to meet legitimate patient and professional expectations, in line with European values. The challenges posed by mental health conditions touch all ages and social groups. They include a surge of diseases of despair, the persistent prevalence of depressive and anxiety disorders among young people, the growth of self-harm and suicide and the unmet needs of people with dementia or autism spectrum disorder. I am confident that by coming together through ‘United Action for Better Health’ we can truly make a difference such that the much sought-after objective to recover better and stronger becomes a reality. I heartily invite the European Public Health Association through its section on Public Mental Health to contribute to our efforts to advocate for mental health as part of the broader health and well-being agenda as well as to contribute with innovative evidence-informed proposals for transforming health services to ensure that mental health is firmly part of all efforts geared to expand universal health coverage across the European Region. As the world confronts the coronavirus, the sharing of knowledge—especially the latest public health science—becomes ever more important, and the virtual 16th World Congress on Public Health (WCPH2020) is the event to do it. The theme of WCPH2020 ‘Public Health for the Future of Humanity: Analysis, Advocacy and Action’, reflects our firm commitment that we, in the global public health community, have an obligation to respond to the current coronacrisis and other emerging global challenges. And in October it will be more relevant than ever. The virtual WCPH2020 will be an exciting and engaging event with live streams of plenary sessions, 30 World Leadership Dialogues, 150 workshops and presentations and posters from over 3000 abstracts. More than 100 countries will be represented in the programme. WCPH2020 offers a full and varied programme from 7:00 am to 9:00 pm Central European Time. This will allow all time zones across the globe to participate. On demand contents will be available even for 15 days after the event. Network lounges, chat boxes, exhibition areas and more will let you connect and engage with a wider audience. Read more. A dedicated COVID-19 track will be featured, covering the latest on the efficacy of policy measures, impact on health systems and the lessons to be learned. In our eight plenary sessions, we will further explore the challenges posed by the corona pandemic and other threats. Read more. In a series of eight plenary sessions we will further explore these current challenges. We look at what happened to our principles of the enlightenment: evidence and reason. Fake news is widespread and travels much faster than the truth. We explore how we can work together with other sectors to tackle global threats. We look at what public health leadership entails. The abilities and qualities of our health systems and workforce will also be discussed. In other plenary sessions, we will look at interdisciplinary approaches and the way forward for global public health. WCPH2020 offers an incredibly attractive line-up of plenary speakers: Dr Tedros Adhanom Ghebreyesus, Director General World Health Organization Stella Kyriakides, European Commissioner for Health and Food Safety Roberto Speranza, Minister of Health, Italy Iveta Nagyova, President EUPHA Sheila Tlou, Co-chair of Global HIV Prevention Coalition Sabina F. Rashid, Dean BRAC School of Public Health, Dhaka, Bangladesh George Benjamin, Executive Director American Public Health Association, USA Katherine Trebeck, Advocacy and Influencing Lead, Wellbeing Economy Alliance Philip Baba Adonga, President Association of Schools of Public Health in Africa, Ghana Natasha Azzopardi Muscat, WHO Regional Office for Europe Kasia Czabanowska, Past-President ASPHER Mauricio Lima Barreto, Professor Federal University of Bahia, Brazil Sara Cerdas, Member European Parliament, Portugal Desmond D’Sa, Environmental Campaigner, South Africa Summer May Finlay, Campaigner for the Rights of Indigenous People, Australia Walter Flores, Campaigner Civil Society, Guatemala Sir Andy Haines, Professor of Environmental Change and Public Health, UK Richard Horton, The Lancet Bronwyn King, Tobacco Free Portfolios and Radiation Oncologist, Australia Stephen K. Klasko, President Thomas Jefferson University, USA Laura Magana, President Association of Schools of Public Health in the Americas, Mexico Patricio V. Marquez, The World Bank Diogo Martins, Policy and Advocacy Lead at Wellcome Trust, UK John Middleton, Association of Schools of Public Health in the European Region, UK Christopher Murray, University of Washington, USA Gita Sen, Professor Public Health and Campaigner for Women’s Rights, India Sarah Wollaston, Former Member of Parliament, Medical Doctor, UK The 16th World Congress on Public Health is jointly organized by the World Federation of Public Health Associations (WFPHA), the Italian Society of Hygiene, Preventive Medicine and Public Health (SItI) and the European Public Health Association (EUPHA). The 13th European Public Health (EPH) Conference of 2020 will be an integral part of the 16th World Congress on Public Health.},
  langid = {english},
  keywords = {inglesa}
}

