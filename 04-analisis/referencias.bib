@thesis{renataantoniamirandamiranda2026huertas,
  title = {Huertas comunitarias urbanas : cultivando bienes comunes potencialmente transformadores a la periferia sur del Área Metropolitana de Santiago (AMS)},
  author = {{Renata Antonia Miranda Miranda}},
  date = {2026-01-01},
  journaltitle = {Universidad de Chile},
  url = {https://openalex.org/W7213993733},
  abstract = {La presente investigación se inscribe bajo el Proyecto FONDECYT Regular N°1250274, denominado: “El poder transformador de las iniciativas comunitarias de espacios verdes y naturales en zonas urbanas y periurbanas de Chile central”, al cual se agradece su vinculación para la realización de este trabajo. La investigación analiza el papel de las huertas comunitarias urbanas (HCU) como espacios de transformación socioecológica frente a la policrisis que enfrentan las ciudades latinoamericanas, particularmente en territorios urbanos periférico de grandes metrópolis como el Área Metropolitana de Santiago (AMS), Chile. El estudio se sitúa en la zona sur de Santiago, un territorio caracterizado por altos niveles de vulnerabilidad socioambiental, déficit de áreas verdes, fragmentación ecológica y exclusión territorial, pero que a la vez concentra una histórica riqueza organizativa. A través de una investigación de tipo exploratoria y predominantemente cualitativa, se aplicaron cuestionarios de caracterización inicial a estas iniciativas, que dio paso para la co-construcción de líneas de tiempo organizacionales, mapeos de actores según bienes comunes socioecológicos, y diversas instancias de trabajo territorial mediante observación participante y no participante. Ello permitió caracterizar, analizar la historia y los actores que se articulan entre estas iniciativas, identificando a los HCU como una de las redes comunitarias más vigentes en el territorio urbano. Estos no solo proveen alimentos o áreas verdes, sino que constituyen verdaderos territorios de regeneración socioecológica urbana, donde convergen prácticas agroecológicas, saberes tradicionales, ancestrales y campesinos desde un vínculo afectivo que promueve una ética de cuidado hacia la naturaleza, en resistencia a la ciudad neoliberal.},
  langid = {spanish},
  keywords = {iberoamericana}
}

