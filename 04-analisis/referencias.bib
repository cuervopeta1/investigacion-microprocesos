}

@article{irlesaindirasanchezmedina2018diseno,
  title = {Diseño de software para calcular la huella de carbono e hídrica durante la producción de café},
  author = {{Irlesa Indira Sánchez Medina} and {Ferley Medina Rojas} and {Jaime Malqui Cabrera Medina}},
  date = {2018-01-01},
  journaltitle = {Ingenieria Solidaria},
  shortjournal = {Ingenieria Solidaria},
  volume = {14},
  number = {24},
  pages = {1--12},
  doi = {10.16925/in.v14i24.2159},
  url = {https://openalex.org/W2780241960},
  abstract = {Introducción: el artículo es producto de la investigación “Diseño de software para calcular la huella de carbono e hídrica durante la producción de café”, desarrollada en la Universidad Cooperativa de Colombia, sede Neiva, en el periodo 2016-2017.Objetivo: diseñar un software para el cálculo de la huella de carbono e hídrica en la producción de café.Metodología: el desarrollo del proceso de investigación es de carácter cualitativo y cuantitativo, con reconocimiento de conceptos, contextos y experiencias de los agricultores de café en los municipios de Acevedo, San Agustín, San José de Isnos y Pitalito.Resultados: el diseño de una aplicación web para calcular huellas de carbono y huella hídrica durante el cultivo de café, la cual integre tecnologías bajo licencia de software libre que evidencien eficiencia y eficacia en el desempeño.Conclusión: la metodología xp garantiza un desarrollo ágil durante el diseño de software, lo que permitirá calcular la huella de carbono e hídrica adaptable a cambios y requisitos en corto tiempo y con un bajo costo.Originalidad: hasta el momento, no se evidencia en el estado del arte un diseño del cálculo de huella de carbono e hídrica para la producción de café en el sur del Huila.Limitaciones: este proyecto utilizó una metodología que se puede aplicar a diferentes cultivos; sin embargo, los cálculos de las huellas son específicas a estas zonas dadas las variables del medio ambiente.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{isabelasouzadasilva2025inteligencia,
  title = {Inteligência artificial como ferramenta de mobilização social : uma análise da apropriação tecnológica e do engajamento público na campanha "desaparecidos" da Piracanjuba},
  author = {{Isabela Souza da Silva}},
  date = {2025-01-01},
  journaltitle = {Lume (Universidade Federal do Rio Grande do Sul)},
  url = {https://openalex.org/W7155756145},
  abstract = {Com o avanço das tecnologias digitais, a publicidade é atravessada por mudanças que moldam a maneira como as marcas se comunicam com o público. Concomitantemente, as empresas, atravessadas pelas novas demandas dos consumidores, utilizam o campo da comunicação para expor seus valores, criar vínculos e lembranças na sociedade por meio das mídias. É nesse contexto tecnológico que a união com causas sociais ganha relevância. Tais interseções motivaram a presente pesquisa, que se propôs a observar como a publicidade pode usar a inteligência artificial (IA) para contribuir com a mobilização social, tendo as marcas como porta-vozes dessas causas. A partir dessa premissa, escolheu-se a campanha "Desaparecidos", da Piracanjuba, para aprofundar a observação do fenômeno mencionado, a partir do seguinte problema da pesquisa: de que forma a marca Piracanjuba se apropria da IA para produzir uma campanha publicitária sensível, criativa e ética, que estimula o público a participar de uma mobilização social? O objetivo geral passou por analisar de que forma a marca se apropriou da IA na campanha "Desaparecidos", a fim de construir uma narrativa publicitária sensível, criativa e ética, com potencial de mobilização social, a partir da interação do público nas redes sociais digitais. A fundamentação teórica foi construída com base em conceitos da cultura da convergência (Jenkins, 2009), convergência midiática (Neto, 2008; 2009; 2010), cidadania comunicativa (Wottrich, 2013), transformações dos movimentos identitários (Rodrigues, 2019), publicidade social (Saldanha, 2018; Saldanha; Nery, 2016), tecnologias digitais aplicadas no marketing (Kotler, Kartajaya; Setiawan, 2021), posicionamento das marcas (Telles; Queiroz, 2013; Souza; Nemer, 1993), responsabilidade social para empresas (Grajew, 2000) e evolução da IA (Santaella, 2022). Além disso, uma abordagem empírica através de uma metodologia exploratória e descritiva, de caráter qualitativo foi realizada, a partir de duas etapas: análise documental e entrevista; e análise do engajamento e da sensibilização do público no Instagram. Os resultados alcançados na primeira etapa evidenciaram como a IA possibilitou a sensibilização da marca para a criação da campanha, enquanto que os resultados alcançados com a segunda indicaram um mapeamento de nove categorias para refletir a mobilização social e o engajamento da marca com o público.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{isabelcristinaangel-uribe2023aplicativo,
