@article{hernandezdoria2014inclusion,
  title = {Inclusión de las Tecnologías para Facilitar los Procesos de Enseñanza-Aprendizaje en Ciencias Naturales},
  author = {Hernández Doria, Carlos Andrés and Gómez Zermeño, Marcela Georgina and Arredondo, Maricela Balderas},
  date = {2014-12},
  journaltitle = {Actualidades Investigativas en Educación},
  shortjournal = {Actualidades Investigativas en Educación},
  volume = {14},
  number = {3},
  pages = {230--250},
  issn = {1409-4703},
  url = {http://www.scielo.sa.cr/scielo.php?script=sci_arttext&pid=S1409-47032014000300010&lang=pt},
  abstract = {This article presents a study about the inclusion of information and communication technologies in the curricular activities of Natural Sciences in the ninth grade of a rural area school. A qualitative approach was used with the investigation-action methodology. The participants for this research were the professor of Natural Sciences and 30 students. Through a semi-structured interview and the participant observation of the teacher, the collected information allowed to know the factors that influence in the inclusion and acceptance of technologies in the subject of Natural Sciences. The findings show that the use of technology in the education allows to increase the access to information for students and teachers. It is concluded that the appropriate infrastructure, development of material and training are necessary for a successful implementation.},
  langid = {spanish},
  keywords = {actividades curriculares,apropiación tecnológica,Colombia,curricular activities,Information and communication technologies,Tecnologías de la información y la comunicación (tic)}
}

@article{hernandezgonzalez2019sistema,
  title = {Sistema para la auditoría y control de los activos fijos tangibles},
  author = {Hernández González, Bernardo and Ramírez Ramírez, Tania and Mar Cornelio, Omar},
  date = {2019-03},
  journaltitle = {Revista Universidad y Sociedad},
  shortjournal = {Revista Universidad y Sociedad},
  volume = {11},
  number = {1},
  pages = {128--134},
  issn = {2218-3620},
  url = {http://scielo.sld.cu/scielo.php?script=sci_arttext&pid=S2218-36202019000100128&lang=pt},
  abstract = {ABSTRACT As part of the rules of the Cuban internal control system, it is established that 10\% of fixed tangible assets be audited monthly, representing a core task within any entity. In the School of Sciences and Computational Technologies of the University of the Computer Science, it is done through the manual testing of the resources with a previously printed inventory, which generates a cumbersome and inefficient process. The research that follows is the analysis, design, implementation and evaluation of a computer application aimed at streamlining the process of Auditing and Control of Fixed Tangible. The development of the system is marked by the use of current technologies and tools attached to the policy of technological sovereignty that drives the country. The solution obtained improves the use of human and material resources, allowing results to be obtained quickly and reliably from the completion of the audit and control process.},
  langid = {spanish},
  keywords = {Activo fijo tangible,aplicación informática,audit and control,auditoría y control,computer application,Tangible fixed assets}
}

@article{hernandezmontero2023contribucion,
  title = {Contribución al desarrollo nacional de tecnología de monitoreo y diagnóstico industrial},
  author = {Hernández Montero, Fidel Ernesto and Ruiz Barrios, Mario Luis and Rodríguez Suárez, Juan Raúl and Iglesias Martínez, Miguel Enrique and Pino Gómez, Joel and Uribe, Vicente Atxa and Palomino Marín, Evelio and Gómez Mancilla, Julio César and Prieto Hernández, Yasmany and Rodríguez Lorenzo, Andy and Hernández Román, Jorge and Hernández Soberao, Maité and Domínguez Rodríguez, Ismel},
  date = {2023-12},
  journaltitle = {Anales de la ACC},
  shortjournal = {Anales de la ACC},
  volume = {13},
  number = {3},
  issn = {2304-0106},
  url = {http://scielo.sld.cu/scielo.php?script=sci_arttext&pid=S2304-01062023000300006&lang=pt},
  abstract = {ABSTRACT  Introduction:  There are areas, in the current national context, where both the importation substitution and the technological independence can’t be achieved. This work is focused on the presentation of different contributions to the national development of technology for industrial monitoring and diagnosis.  Methods:  The accomplished tasks were based on the cumulative scientific and technical knowledge and were focused to the solution of problems that have been remained unsolved and the adaptations of such solutions to the national industrial context.  Results:  Different system developments were achieved on the basis of general system conceptions and the solution of particular problems. The development of specific electronic modules and the implementation of different techniques for vibration analysis were covered. Conclusions, the results revealed that the highest level development of industrial monitoring and diagnosis technology is possible in Cuba.},
  langid = {spanish},
  keywords = {análisis de vibraciones,diagnóstico industrial,electronic technology,industrial diagnosis,machine condition monitoring,monitoreo de condición,pattern recognition,reconocimiento de patrones,tecnología electrónica,vibration analysis}
}

@inproceedings{hernandezmoreno2026inteligencia,
  title = {La Inteligencia Artificial ¿Una distopía para losDerechos Humanos?},
  booktitle = {Derechos Humanos e Inteligencia Artificial: Actas del VIII Congreso sobre Derechos Humanos. 16 y 17 de octubre de 2025, Valencia., 2026, ISBN 978-84-95947-51-2, págs. 288-314},
  author = {Hernández Moreno, Nacho},
  date = {2026},
  pages = {288--314},
  publisher = {Fundación Mainel},
  issn = {1080-1049},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10801049},
  urldate = {2026-11-13},
  abstract = {The expansion of artificial intelligence (AI) is reshaping the dynamics linking knowledge, power,and freedom, which direct implications for democratic deliberation and human rightsprotection. This paper examines how information automation and algorithmic mediationtransform public deliberation and human rights. Building on López de Mántaras’s assertion—“without verifiable truth there can be no deliberation, and without deliberation democracyloses its meaning”—AI is analyzed as a social and political infrastructure that structures accessto knowledge, discourse visibility, and the distribution of informational power. The studyexplores three central illusions of technology—autonomy, transparency, and neutrality—andshows how algorithmic opacity and extreme personalization foster manipulation andinequality. The shift from the early cyber-utopian ideal to Zuboff’s surveillance capitalism hascreated an economy based on data extraction and behavioral prediction, threatening freedomof expression, privacy, and equality. Drawing on authors such as Habermas, Dahl, Floridi, andSunstein, the paper argues that AI does not abolish democratic deliberation but can render ithollow when algorithms replace reason with efficiency and prediction. It concludes byproposing an ethical and political response: an ethics of responsible design grounded in justiceand explainability, and a democratic governance of informational power based ontransparency, digital literacy, and redistribution of technological sovereignty. Only under theseconditions can AI serve freedom instead of becoming a dystopia for human rights. La expansión de la inteligencia artificial («IA») está transformando de forma decisiva losvínculos entre conocimiento, poder y libertad, con implicaciones directas para la deliberacióndemocrática y los derechos humanos. Este trabajo analiza cómo la automatización de lainformación y la mediación algorítmica reconfiguran la deliberación pública y los derechoshumanos. Tomando como punto de partida la afirmación de López de Mántaras —«sin verdadverificable no hay deliberación posible y, sin deliberación, la democracia pierde sentido»—, seexamina la IA como infraestructura social y política que condiciona el acceso al conocimiento,la visibilidad del discurso y la distribución del poder informacional. El estudio explora tresilusiones centrales de la tecnología —autonomía, transparencia y neutralidad— y muestracómo la opacidad algorítmica y la personalización extrema generan un ecosistemacomunicativo propenso a la manipulación y a la desigualdad. El tránsito del ideal ciberutópicoal capitalismo de vigilancia descrito por Zuboff ha consolidado un modelo económico basadoen la extracción de datos y la predicción conductual, que amenaza la libertad de expresión, laprivacidad y la igualdad. A través del diálogo con autores como Habermas, Dahl, Floridi ySunstein, se argumenta que la IA no sustituye la deliberación democrática, pero sí puedevaciarla de contenido si los algoritmos reemplazan la racionalidad por la eficiencia y lapredicción. El trabajo concluye proponiendo una doble respuesta ética y política: una ética deldiseño responsable, fundada en los principios de justicia y explicabilidad, y una política decontrol democrático del poder informacional mediante transparencia, alfabetización digital yredistribución de la soberanía tecnológica. Solo así la IA podrá convertirse en un instrumentoal servicio de la libertad y no en una distopía para los derechos humanos.},
  eventtitle = {Derechos Humanos e Inteligencia Artificial: Actas del VIII Congreso sobre Derechos Humanos. 16 y 17 de octubre de 2025, Valencia.},
  isbn = {978-84-95947-51-2},
  langid = {spanish}
}

@thesis{hernandezorobio2025determinantes,
  type = {http://purl.org/dc/dcmitype/Text},
  title = {Determinantes de la implementación de telerrehabilitación en una Institución del Suroccidente de Colombia},
  author = {Hernández Orobio, Olga Marina},
  date = {2025},
  pages = {1},
  institution = {Universidade da Coruña},
  url = {https://dialnet.unirioja.es/servlet/tesis?codigo=362666},
  urldate = {2026-11-13},
  abstract = {Introduction: Telerehabilitation (TR), as a service delivery modality, favors access to rehabilitation; analyzing its implementation allows identifying facilitators and barriers to optimize its development.  Objective: To analyze determinants of TR implementation delimited in five domains: innovation, internal environment, external environment, people, and implementation process within an institution in the southwest of Colombia.  Method: Convergent mixed study (2020-2024), using the CFIR ―Consolidated Framework for Implementation Research―, for data analysis: interviews, document review, patient database, and evaluation of professionals' perceptions.  Results: Qualitative data resulted from the review of 32 documents and interviews with 18 professionals, 3 patients, and 3 caregivers; quantitative data from 83 profes-sionals (80.7\% women and 38 years old on average) and a database of 1611 patients attended by TR (61.3\% women and 37.3 years old on average). The 5 domains and their relationships were described, finding results of acceptability, adaptability, and sustainability in TR implementation.  Conclusions: Using the CFIR allowed us to interpret this experience of TR implementation in the language of implementation research, recognizing its usefulness in practice transformation and technological appropriation as a contribution to improve access to rehabilitation services. Introdución: A telerrehabilitación (TR), como modalidade de prestación de servizos favorece o acceso á rehabilitación; analizar a súa implementación permite evidenciar facilitadores e barreiras, para optimizar o seu desenvolvemento.  Obxectivo: Analizar determinantes da implementación da TR delimitados en cinco dominios: innovación, contorna interna, contorna externa, persoas e proceso de implementación nunha institución do suroccidente colombiano.  Método: Estudo mixto converxente (2020-2024), usando o marco CFIR ─ Consolidated Framework for Implementation Research─, para análise da información: entrevistas, revisión documental, base de datos de pacientes e avaliación das percep-cións dos profesionais.  Resultados: Datos cualitativos obtidos da revisión de 32 documentos e entrevistas a 18 profesionais, 3 pacientes e 3 coidadores; e cuantitativos de 83 profesionais (80,7\% mulleres e 38 anos media), e rexistro de 1611 pacientes atendidos por TR (61,3\% mulleres e 37,3 anos media). Describíronse os 5 dominios e as súas relacións, achando resultados de aceptabilidade, adaptabilidade e sustentabilidade na implementación.  Conclusións: O uso de CFIR posibilitou interpretar esta experiencia de implementación da TR na linguaxe propia da investigación da implementación recoñecendo utilidade nos procesos de transformación da práctica e apropiación tecnolóxica como contribución ao acceso a servizos de rehabilitación. Introducción: La telerrehabilitación (TR), como modalidad de prestación de servicios favorece el acceso a la rehabilitación; analizar su implementación permite evidenciar facilitadores y barreras, para optimizar su desarrollo.  Objetivo: Analizar determinantes de la implementación de TR delimitados en cinco dominios: innovación, entorno interno, entorno externo, personas y proceso de implementación en una institución del suroccidente colombiano.  Método: Estudio mixto convergente (2020-2024), usando el marco CFIR ―Consolidated Framework for Implementation Research―, para análisis de la información: entrevistas, revisión documental, base de datos de pacientes y evaluación de percepciones de profesionales.  Resultados: Datos cualitativos obtenidos de revisión de 32 documentos y entre-vistas a 18 profesionales, 3 pacientes y 3 cuidadores; y cuantitativos de 83 profesionales (80,7\% mujeres y 38 años promedio), y registro de 1611 pacientes atendidos por TR (61,3\% mujeres y 37,3 años promedio). Se describieron los 5 dominios y sus relaciones, hallando resultados de aceptabilidad, adaptabilidad y sostenibilidad en la implementación.  Conclusiones: El uso de CFIR posibilitó interpretar esta experiencia de implementación de TR en el lenguaje propio de la investigación de la implementación reconociendo utilidad en los procesos de transformación de la práctica y apropiación tecnológica como contribución al acceso a servicios de rehabilitación.},
  langid = {spanish}
}

@article{hernandezrazo2019apropiacion,
  title = {Apropiación social de tecnologías digitales en un contexto de trabajo informal y precario},
  author = {Hernández Razo, Óscar Enrique and López Sandoval, María Guadalupe},
  date = {2019},
  journaltitle = {Entreciencias: Diálogos en la sociedad del conocimiento},
  volume = {7},
  pages = {67--82},
  publisher = {Universidad Nacional Autónoma de México (UNAM)},
  issn = {2007-8064},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8380243},
  urldate = {2026-11-13},
  abstract = {Purpose -~to analyze, from a sociocultural perspective, the social appropriation process of digital technologies in a family broidery workshop located in Cuautepec, a low-income urban area in the north of Mexico City.Methodology - a qualitative, ethnographic design was conducted. The following were used to collect and build data: observation, semi-structured interviews, and demonstrations on the use of technology. The manner through which the owners of the workshop took decisions on what they needed to learn in order to transfer from an electric to a digital embroidery machine were analyzed. Results~ - the acquisition and the use of digital devices motivated changes in assignment distribution in the embroidery workshop. The process of social appropriation of digital technologies in a precarious labor context was articulated originating from material conditions and family decisions to acquire the digital equipment, the interaction with mediators, whom ideas and knowledge on the use of the devices were shared with, and the participation of designated actors to use the new tools. However, inequality conditions prevailed in access to social practices with digital technologies. Limitations - amongst the limitations, there is a lack of depth in the exploration of roles which, from a sociocultural perspective, are important in the social appropriation of digital technologies, such as the case of mediators; this can be further explored in future studies. Findings - it is shown that in the process of social appropriation of technology, in a precarious labor and economic environment, family and trust bonds play a relevant role in sharing knowledge and solving problems that are presented in the activity.  Objetivo -~analizar, desde una perspectiva sociocultural, el proceso de apropiación social de tecnologías digitales en un taller familiar de bordado ubicado en Cuautepec, un área urbana de bajos ingresos en la periferia norte de la Ciudad de México.Método -~se realizó un diseño metodológico de tipo cualitativo, de enfoque etnográfico. Para recabar y construir los datos se utilizaron observaciones, entrevistas semi-estructuradas y demostraciones de uso de tecnología. Se analizó la forma en que los propietarios del taller tomaron decisiones sobre lo que necesitan aprender para transitar del uso de una máquina de bordar eléctrica al uso de una bordadora digital. Resultados - la adquisición y el uso de los dispositivos digitales motivaron cambios en la distribución de tareas en el taller de bordado. El proceso de apropiación social de tecnologías digitales en un contexto laboral precario se articuló a partir de las condiciones materiales y decisiones familiares para adquirir el equipo digital, la interacción con mediadores con quienes se compartieron ideas y conocimientos sobre el uso de los dispositivos, y la participación de actores designados para usar las nuevas herramientas. Sin embargo, prevalecieron condiciones de desigualdad en el acceso a prácticas sociales con tecnologías digitales. Limitaciones -~entre las limitaciones del trabajo está la falta de profundidad en la exploración del papel de figuras que, desde la perspectiva sociocultural, son importantes en la apropiación social de tecnologías digitales, como el caso de los mediadores. Esto puede ser desarrollado de manera específica en futuras investigaciones.Principales hallazgos -~se muestra que, en el proceso de apropiación social de la tecnología, en un entorno de precariedad laboral y económica, los lazos familiares y de confianza juegan un papel relevante para compartir conocimiento y resolver problemas que se presentan en la actividad.},
  issue = {19 (Abril - Julio)},
  langid = {spanish}
}

