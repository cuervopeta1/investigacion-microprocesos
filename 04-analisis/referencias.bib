@article{iedazimmermann2013incubadora,
  title = {INCUBADORA DE ECONOMIA SOLIDÁRIA E DESENVOLVIMENTO REGIONAL SUSTENTÁVEL: O MEIO ELETRÔNICO POTENCIALIZANDO A FORMAÇÃO DE REDES SOLIDÁRIAS},
  author = {{Ieda Zimmermann} and {Noëlle M. P. Lechat}},
  date = {2013-08-07},
  journaltitle = {Salão do Conhecimento},
  shortjournal = {Salão do Conhecimento},
  url = {https://openalex.org/W7215141587},
  abstract = {INTRODUÇÃO: A incubadora de Economia Solidária da Unijuí, que atua na incubação de Empreendimentos de Economia Solidária, tem lançado mão diariamente das potencialidades oferecidas pelo meio eletrônico para articular inúmeras atividades relacionadas a promoção, fomento e divulgação dessa forma de organização da Economia em nossa região.Entre as muitas redes articuladas através desse meio de comunicação em expansão, estão as conexões estabelecidas entre comunidades desenvolvedoras de software livre que se organizam, em determinados aspectos, de maneira bastante similar aos empreendimentos.Mas de que forma o meio eletrônico potencializa redes de Economia Solidária?Para além das evidências primeiras, de fácil identificação, existem aspectos que exigem reflexões mais profundas como questões ligadas ao coletivo e a liberdade, embutidas em um contexto mais amplo.Também cabe refletirmos sobre o acesso á comunicação via meio eletrônico como um direito social básico de todo cidadão.METODOLOGIA: A possibilidade de comunicação rápida entre os integrantes da equipe local, apoiadores e simpatizantes tem sido fundamental para que as metas do projeto Incubadora se concretizem e ações equivalentes se articulem.A ação cotidiana da Incubadora tem sido potencializada pela comunicação via Internet, em pelo menos três níveis distintos e igualmente importantes.Em primeiro nível, acontece a comunicação dinâmica entre membros da equipe efetiva e colaboradores próximos, numa média de 60 mensagens/mês.Em segundo nível, há uma lista de contatos relacionados aos empreendimentos, entidades de apoio, órgãos governamentais e público em geral que faz circular informações, atividades e toda dinâmica própria dessa forma de organização da economia.Em terceiro nível, funciona uma lista dos meios de comunicação de abrangência regional, estadual e nacional que proporciona visibilidade às atividades que envolvem as ações da Incubadora e tem repercutido positivamente na esfera regional.RESULTADOS: O Curso de Formação em Economia Solidária para Gestores Públicos, o Curso de Formação com Trabalhadores de Empreendimentos Solidários, bem como as dez Oficinas, sete Ciclos de Estudos, participação em Fóruns e Seminários teriam encontrado grandes dificuldades de efetivação caso não pudéssemos contar com a comunicação via Internet.O meio eletrônico tem potencializado o surgimento de novos espaços de fluxos (Castells, 1999) e tem sido um importante recurso de articulação de formas alternativas de geração de trabalho e renda.DISCUSSÃO/CONCLUSÕES: Os resultados do mapeamento dos empreendimentos da região noroeste do RS estão registrados no SIES -Sistema de Informação em Economia Solidária e disponíveis no endereço eletrônico www.mte.gov.br.Não raras vezes ouvimos referências aos aspectos perversos do uso indevido da Internet como pedofilia, prostituição, racismo e muitas formas de discriminação, portanto, é pertinente divulgarmos os aspectos democráticos, cooperativos e solidários que este meio também proporciona.No Brasil, a economia solidária já possui vários sites onde é possível fazer downloads de estudos científicos sobre o tema, gratuitamente.Destacamos o www.unitrabalho.org,},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{ignaciojosegarciadelama2012problemas,
  title = {Problemas de optimizacion dinamicos e imprecisos: estudios de metodos de solucion y aplicaciones},
  author = {{Ignacio José García del Ama}},
  date = {2012-01-01},
  journaltitle = {Dialnet (Universidad de la Rioja)},
  shortjournal = {Dialnet (Universidad de la Rioja)},
  url = {https://openalex.org/W2570673801},
  abstract = {En la vida diaria nos enfrentamos continuamente a situaciones que pueden formularse como problemas de optimización dinámicos, donde además puede haber presencia de incertidumbre, dificultando aún más su resolución. Las técnicas de Soft Computing reúnen una serie de cualidades que las convierten en cadidatas idóneas para afrontar este tipo de problemas. En este contexto, esta tesis se centra en el estudio, diseño e implementación de métodos basados en Soft Computing para resolver Problemas de Optimización Dinámicos (DOPs). La investigación llevada a cabo en esta tesis ha producido nuevos algoritmos para DOPs, tales como las Estrategias Cooperativas (CS), el algoritmo Agentes, y varias mejoras para el algoritmo Particle Swarm Optimization (PSO) usando reglas heurísticas y un nuevo operador. Por otra parte, a raíz de los experimentos realizados y las necesidades surgidas de su análisis, se ha diseñado una técnica de comparación de resultados para múltiples algoritmos, en múltiples escenarios de problemas dinámicos, llamada SRCS. Esta técnica ha sido diseñada específicamente para analizar resultados de experimentos con un elevado volumen de datos. Por último, se ha producido una herramienta software para la configuración y análisis de algoritmos para DOPs, y un framework para el desarrollo de este tipo de problemas. Los resultados de esta tesis han permitido mejorar el estado del arte de los algoritmos, obteniendo interesantes conclusiones, como el importante papel que juega la cooperación de cara a mejorar algoritmos. Además, la técnica SRCS ha permitido descubrir qué tipos de escenarios son los más favorables para un conjunto de algoritmos, identificando así tendencias generales y comportamientos. Y finalmente, la experiencia obtenida en la implementación de estos experimentos ha derivado en una colección de software para DOPs de gran utilidad, que se ha puesto a disposición de la comunidad investigadora como software libre.},
  langid = {spanish},
  keywords = {iberoamericana}
}

