@article{yinamarcelaumbapalacio2017apoyo,
  title = {Apoyo Temático a las Actividades de Estructuración, Monitoreo y Seguimiento, para la Implementación de Insumos de Informacion Espacial al Sistema de Información Geográfica para las Áreas de Reglamentación Especial – Sig Are.},
  author = {{Yina Marcela Umba Palacio} and {Heily Yulitza Ramos Quiñones}},
  date = {2017-05-31},
  url = {https://openalex.org/W2987020626},
  abstract = {Teniendo en cuenta el estado actual del Sistema de Informacion Geografico para las areas de Reglamentacion Especial – SIGARE, se realizo un rastreo via web, telefonica y por correo de las entidades productoras de servicios y sus entidades adscritas, de los sectores de Agricultura, Infraestructura, Territorios indigenas, Interior y Cultura. Y como resultado se obtuvo una matriz-inventario de objetos espaciales que fueran de utilidad para el nicho del proyecto, documentando asi de cada posible objeto espacial, la entidad que la produce, una descripcion general del objeto, estructura organizacional a la que pertenece, nombre del objeto espacial, su tipo de geometria, como se encuentra la informacion (si es publica o privada), su funcionalidad y pertinencia en el proyecto, tipo de formato de descarga y la fuente de la informacion o link de acceso. Se hicieron las correspondientes conclusiones y analisis y diagnostico del hallasgo. Se realizaron mapas de los 32 departamentos de Colombia con cada una de las areas de interes (zonas de reserva, resguardos indigenas, parques nacionales naturales, paramos, humedales y comunidades negras) para un total de 192 mapas. Con el objetivo de fortalecer y apoyar eficaz y oportunamente a los Pueblos Indigenas por medio de una infraestructura de datos espaciales, para que asuman el control de sus territorios en defensa de sus derechos humanos y colectivos, reflejando las necesidades que poseen y consolidando su propio futuro, se propone la IDEIN (Infraestructura de Datos Espaciales Indigena) como respuesta a las necesidades actuales. Se inicia con una revision documental recopilando todos los datos necesarios para el diseno de una IDE, conociendo los actores y sus necesidades, a lo cual se realizo un diagnostico de los Datos y de la situacion en la que se encuentra la informacion geografica y se definen cuales van a ser los datos fundamentales y de pertinencia para los territorios indigenas y que son producidos por entidades distritales y nacionales involucradas en el compromiso. Se proponen 10 datos basicos y fundamentales. Una vez identificados los actores y categorizados en productores o usuarios, se focaliza la tarea con las entidades productoras con la finalidad de identificar los objetos geograficos que producen, segun las necesidades del usuario generando una nueva matriz-inventario, luego se depurara la informacion encontrada en que es de utilidad y pertinencia y la que no lo es. Posteriormente y con el fin de garantizar la interoperabilidad de los datos, se proponen los estandares geograficos que se deben tener en la IDEIN de acuerdo al tipo de informacion con la que se cuenta de los territorios indigenas. Se propone un Geoportal IDEIN, catalogo de objetos y metadatos y servicios web geograficos. Asi mismo se dan los lineamientos de politicas, una propuesta de desarrollo tecnologico en la cual se propone el software libre como la mejor opcion y un geoportal como herramienta esencial para la gestion y administracion de los territorios indigenas. Se esclarece cual sera su financiamiento y finalmente se sacan conclusiones de los hallazgos y se dan recomendaciones.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{yiselvelazquezconcepcion2025plataformas,
  title = {Plataformas digitales en la enseñanza del inglés: impacto en la motivación y el rendimiento estudiantil},
  author = {{Yisel Velázquez Concepción} and {Luis Angel Solis Maldonado}},
  date = {2025-06-19},
  journaltitle = {Journal TechInnovation},
  shortjournal = {Journal TechInnovation},
  volume = {4},
  number = {1},
  pages = {20--27},
  doi = {10.47230/journal.techinnovation.v4.n1.2025.20-27},
  url = {https://openalex.org/W4417220837},
  abstract = {El uso de plataformas digitales en la enseñanza de lenguas extranjeras se ha convertido en una estrategia fundamental para responder a los desafíos pedagógicos del siglo XXI. En el contexto actual, caracterizado por la transformación digital de la educación, resulta imprescindible analizar cómo estas herramientas tecnológicas inciden en la motivación de los estudiantes y en su rendimiento académico, especialmente en la enseñanza del idioma inglés. El objetivo principal de esta investigación fue determinar el impacto del uso de plataformas digitales en la motivación y el desempeño de los estudiantes en el aprendizaje del inglés como lengua extranjera. Se empleó una metodología de enfoque mixto, con diseño descriptivo y correlacional. Los resultados evidenciaron que el uso de plataformas como Duolingo, BBC Learning English, Kahoot y Edmodo incrementó significativamente la motivación estudiantil y contribuyó a mejorar el rendimiento académico en distintas competencias lingüísticas. Además, se observó que la apropiación tecnológica y el acompañamiento docente son factores claves para potenciar su eficacia. Se concluye que las plataformas digitales, integradas adecuadamente en el proceso de enseñanza aprendizaje, representan un recurso estratégico para mejorar la calidad educativa en la enseñanza del inglés, siempre que se apliquen de manera planificada y pedagógicamente fundamentada.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{yolandamartinezsuarez2018fotografia,
  title = {La fotografía de perfil digital. Lecturas desde el código de apropiación; O perfil digital: Leituras do código de apropriação; Digital profile. Readings from the appropiation code},
  author = {{Yolanda Martínez Suárez} and {Saleta de Salvador Agra}},
  date = {2018-07-01},
  journaltitle = {DOAJ (DOAJ: Directory of Open Access Journals)},
  shortjournal = {DOAJ (DOAJ: Directory of Open Access Journals)},
  url = {https://openalex.org/W2884546125},
  abstract = {Resumen: La cara digital de la globalización se presenta como su rasgo facilitador y, a la vez, de resistencia. Sin menospreciar la incidencia de las brechas, se podría afirmar hoy que las TIC llegan hasta las comunidades más remotas, como las indígenas. Aquí presentaremos los resultados de un caso de estudio. Para ello nos centraremos en una dinámica de elección de imágenes para un hipotético perfil de Red Social, con una muestra de 65 participantes indígenas shuar. Los resultados apuntan hacia un refuerzo de la identidad cultural mediante la auto-designación digital y a una apropiación tecnológica con fines políticos. Palabras clave: apropiaciones; identidades; redes; fotografía; perfil. Resumo: O rosto digital da globalização é apresentado como facilitador e, ao mesmo tempo, resistência. Sem subestimar a incidência de lacunas, pode-se afirmar hoje que as TIC atingem até as comunidades mais remotas, como as comunidades indígenas. Aqui apresentamos os resultados de um estudo de caso. Para isso, vamos nos concentrar em uma dinâmica de seleção de imagens para um perfil hipotético de Rede Social, com uma amostra de 65 participantes indígenas Shuar. Os resultados apontam para o reforço da identidade cultural através da auto-designação digital e da apropriação tecnológica para fins políticos. Palavras-chave: apropriaçãos; identidades; redes; fotografia; perfil. Abstract: The digital face of globalization is presented as the facilitator trait and, at the same time resistance. Without underestimating the impact of digital divides, one could say today that ICT reach the farthest communities, like the indigenous ones. Here we will present the results of a case of study. To do so, we will focus on the choice of images for a hypothetical social networking profile, with a sample of 65 Shuar participants. The results point to a strengthening of cultural identity through digital self-designation and appropriation of technologies with clearly political purposes. Key words: appropriation; identities; network; photography, profile.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{yonnyaldersonpenaramirez2026porque,
  title = {Porqué saber usar tecnología no basta.},
  author = {{Yonny Alderson Peña Ramírez}},
  date = {2026-01-01},
  journaltitle = {Figshare},
  shortjournal = {Figshare},
  doi = {10.6084/m9.figshare.31829869},
  url = {https://openalex.org/W7140031538},
  abstract = {Este podcast explora la integración tecnológica en contextos interculturales, analizando la transición del uso técnico básico hacia una verdadera apropiación tecnológica. El contenido se estructura en torno a cuatro funciones esenciales de las TIC: interactiva, formativa, comunicativa y socio-digital.La función interactiva destaca el rol activo del usuario para modificar contenidos, mientras que la formativa se centra en la negociación de significados bajo una perspectiva constructivista. Por su parte, la función comunicativa rompe barreras espacio-temporales permitiendo diálogos sincrónicos y asíncronos en entornos plurimodales que integran diversos lenguajes. Finalmente, la función socio-digital analiza el impacto del software social en la creación de comunidades de aprendizaje y la acción colectiva.Un punto crítico del debate es la comparación entre diversos colectivos. Se examinan las competencias transmedia de los adolescentes, quienes destacan por su liderazgo autodidacta. En contraste, se identifica una brecha de género donde las mujeres requieren formación específica para la creación de contenidos propios. El episodio concluye que la inclusión plena en las sociedades del conocimiento depende de una alfabetización digital que trascienda la técnica y fomente el reconocimiento de la diversidad cultural.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{yorelybryjethceballoscardona2025modelo,
  title = {Modelo de Integración de Factores de Aceptación Tecnológica y Procesos de Apropiación Tecnológica en la Educación de Zonas Rurales},
  author = {{Yorely Bryjeth Ceballos Cardona}},
  date = {2025-01-01},
  journaltitle = {Institutional Repository of the University of Granada (University of Granada)},
  url = {https://openalex.org/W7134726147},
  abstract = {La educación en zonas rurales enfrenta barreras estructurales y pedagógicas que limitan la integración de tecnologías digitales. Esta tesis doctoral propone y valida el Modelo de Integración de Factores de Aceptación y Procesos de Apropiación Tecnológica en la Educación Rural (TAAIM), que articula los constructos del Modelo de Aceptación Tecnológica (TAM) y las fases del Marco Europeo para la Competencia Digital Docente (DigCompEdu). El objetivo es fomentar una adopción sostenible y contextualizada de las TIC por parte del profesorado rural. Se aplicó una metodología mixta que incluyó revisión sistemática de literatura, entrevistas a docentes en Colombia y Ecuador, validación experta y una intervención experimental en escuelas rurales, en alianza con la Pontificia Universidad Católica del Ecuador. Los resultados evidencian mejoras significativas en la apropiación tecnológica, competencias digitales y disposición al uso de TIC en contextos vulnerables. Como producto adicional, se diseñó la herramienta GAMITIC, enfocada en la alfabetización digital de docentes, cuya efectividad fue evaluada mediante indicadores del TAM. La investigación demuestra que integrar los enfoques de aceptación y apropiación permite desarrollar modelos más eficaces y adaptados a la realidad rural. El modelo TAAIM representa una contribución teórica y práctica para políticas públicas, programas de formación docente y estrategias de inclusión digital en entornos con baja infraestructura tecnológica.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{yuribastoswanderley2017apropriacoes,
  title = {Apropriações tecnológicas no ensino e aprendizagem: as experiências dos educadores da Rede Anísio Teixeira},
  author = {{Yuri Bastos Wanderley}},
  date = {2017-06-13},
  journaltitle = {Americanae (AECID Library)},
  url = {https://openalex.org/W2624710573},
  abstract = {Por atender, em sua maioria, jovens das classes populares, as Redes Públicas de Ensino podem desempenhar um papel estratégico na diminuição das barreiras impostas por condições históricas e culturais, provenientes das desigualdades sociais e econômicas, que limitam um maior potencial das apropriações tecnológicas por parte dos jovens das classes populares. O desafio não é apenas incluir a escola pública e a sua comunidade no mundo da tecnologia por meio da distribuição de equipamentos, mas contribuir para a construção de bases pedagógicas, técnicas e políticas que possibilitem e estimulem apropriações tecnológicas críticas, contextualizadas e colaborativas, dentro e fora das escolas. A pesquisa teve como objeto de estudo o Programa de Difusão de Mídias e Tecnologias Educacionais da Rede Pública Estadual de Ensino da Bahia, a Rede Anísio Teixeira, no qual o pesquisador atua como educador e gestor. Por meio de um Estudo de Caso inspirado na Etnopesquisa Crítica e Implicada e a Pesquisa da Experiência propostas por Macedo (2009, 2010 e 2015), buscou compreender as experiências vivenciadas pelos educadores nos processos de gestão, formação, produção e compartilhamento de Mídias e Tecnologias Educacionais Livres desenvolvidos no Programa. Ao considerar as experiências dos educadores como principais elementos de seu exercício de compreensão, a pesquisa trouxe para o centro da discussão as relações humanas, suas compreensões e implicações. Experiências vivenciadas no contexto de um programa de governo, orientado por uma proposta de apropriação tecnológica nos processos de ensino e aprendizagem, que se inspira na criticidade, na contextualização e na colaboração. Apesar de ser um programa de difusão tecnológica, as experiências dos educadores da Rede Anísio Teixeira, mostraram que as tecnologias não precisam ser compreendidas como o fim em si, mas como linguagens que promovem relações, permeadas por desafios e potencialidades, oportunidades e ameaças, que podem ser apropriadas pela comunidade escolar como dispositivos políticos de afirmação social, histórica e cultural.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

