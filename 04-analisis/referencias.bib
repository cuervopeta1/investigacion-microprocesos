@article{dulceangelicagomeznavarro2021apropiacion,
  title = {Apropiación social de tecnologías digitales por jóvenes universitarios mayas de Quintana Roo},
  author = {{Dulce Angélica Gómez Navarro}},
  date = {2021-10-25},
  journaltitle = {RIDE Revista Iberoamericana para la Investigación y el Desarrollo Educativo},
  shortjournal = {RIDE Revista Iberoamericana para la Investigación y el Desarrollo Educativo},
  volume = {12},
  number = {23},
  doi = {10.23913/ride.v12i23.1055},
  url = {https://openalex.org/W3210026354},
  abstract = {La brecha digital es un problema que se articula con otras desigualdades y afecta a poblaciones en condiciones de pobreza. Así, la mayoría de las regiones indígenas en México presentan dificultades para conectarse, a pesar de que el uso del teléfono celular ha proliferado en la última década en zonas rurales, donde los jóvenes son los usuarios más activos. Este estudio etnográfico retoma el concepto apropiación social de las tecnologías de la información y la comunicación (TIC) desde una perspectiva sociocultural para comprender su aprovechamiento y para analizar los factores sociales que inciden en la apropiación tecnológica de jóvenes mayas de la Universidad Intercultural Maya de Quintana Roo (UIMQROO), los cuales, a pesar de que cuentan con experiencias escolares discontinuas en la adquisición de habilidades digitales, usan cotidianamente las TIC y las redes sociales como parte de la necesidad de pertenecer a la era digital.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{dulcegomez2017educational,
  title = {Educational Practice Reorientation Using {{OER}}: {{Preliminary}} Results of Three {{Mexican}} Faculty at Postgraduate Level},
  author = {{Dulce Gómez} and {Ismael Esquivel Gámez} and {Jesús Lau} and {Waltraud Martínez Olvera}},
  date = {2017-10-01},
  journaltitle = {Apertura},
  shortjournal = {Apertura},
  volume = {9},
  number = {2},
  pages = {96--115},
  doi = {10.32870/ap.v9n2.1098},
  url = {https://openalex.org/W2765147176},
  abstract = {El trabajo presenta los resultados preliminares de un estudio de caso múltiple de corte cualitativo cuyo objetivo fue analizar la manera en que se dan las prácticas educativas de profesores virtuales del área de educación a nivel maestría cuando incorporan recursos educativos abiertos (REA), así como la forma en que esta apropiación de REA contribuye a la transformación de la práctica pedagógica. En la investigación participaron tres docentes de maestría de una universidad mexicana. El análisis de datos se hizo, primero, revisando cada caso, codificando y categorizando inicialmente con base en los referentes teóricos establecidos y afinando según emergían los datos. Luego, se llevó a cabo la suma categórica de los casos como conjunto para obtener resultados globales. Los resultados indican que la práctica educativa de los participantes se desarrolló en forma predominante con una apropiación tecnológica a nivel de reorientación, usando en su mayoría artículos científicos de acceso abierto para realizar actividades con un enfoque de enseñanza de profundización del conocimiento. Los docentes, al emplear REA, reconocen cambios en la práctica educativa, como enriquecimiento en el diseño de los cursos, flexibilidad pedagógica, variedad de recursos, personalización de la enseñanza, desarrollo de enfoques centrados en el estudiante y apoyo en la obtención de competencias. Este trabajo aporta al conocimiento sobre la ejecución de prácticas educativas con inclusión de REA en un contexto mexicano, además de su potencial impacto en estas.},
  langid = {english},
  keywords = {iberoamericana}
}

@book{dulcemariacabrerahernandez2026becas,
  title = {BECAS EN EDUCACIÓN SUPERIOR FINANCIADAS POR EL ESTADO MEXICANO: una genealogía descriptiva 2006-2025},
  author = {{Dulce María Cabrera Hernández} and {Alejandro Méndez Méndez} and {Claudia Rivera Hernández} and {Alma Rosa Pérez Trujillo} and {Ángel Gabriel López Arens} and {Leticia Pons Bonals} and {Magda Concepción Morales Barrera} and {Teresa Ordaz Guzmán} and {Elvira Alvear Cortés} and {Citlalli Sofía Pérez Saldaña} and {Raúl Nava Cruz} and {José Luis Suárez Domínguez} and {Lida Zoraida Jimenez Calixto} and {Verónica Ortiz Rojas} and {Antonio Saldivar Moreno} and {David Alonso Noceda León}},
  date = {2026-03-01},
  journaltitle = {Zenodo (CERN European Organization for Nuclear Research)},
  doi = {10.5281/zenodo.20057970},
  url = {https://openalex.org/W7160433206},
  abstract = {Esta obra colectiva forma parte de los productos comprometidos en la primera etapa del proyecto PEE-2025-G-558 “Becas para la educación superior asignadas entre 2006 y 2025 por el Estado en la región Centro y Sur-sureste y su incidencia en la empleabilidad, las trayectorias académicas y la calidad de vida de las personas beneficiarias” financiada por la Secretaría de Ciencia, Humanidades, Tecnología e Innovación (SECIHTI) en la convocatoria de Proyectos de Investigación Científica y Humanística en Ejes Estratégicos 2025. En la primera parte se integran cuatro análisis sobre los programas de política educativa relacionados con la asignación de recursos directos a los estudiantes y en la segunda parte se reportan datos sobre las becas en tres estados de la república: Chiapas, Puebla y Veracruz. En el primer capítulo “Preámbulo: Proyectos Estratégicos y becas” en el que Dulce María Cabrera Hernández, responsable técnica ante SECIHTI, hace una descripción general del contexto y del proyecto de investigación del que se deriva esta obra colectiva. El segundo capítulo, “Becas para educación superior como expansión de capacidades: desarrollo e investigación desde Amartya Sen para el contexto mexicano”, se revisa el concepto desarrollo como libertad, propuesto por Amartya Sen, y su aplicación en el ámbito de la educación superior en México, desde la perspectiva del desarrollo sostenible. A través de un análisis teórico y documental, se argumenta que las universidades públicas mexicanas, mediante programas de inclusión, sostenibilidad y responsabilidad social, contribuyen a la expansión de capacidades humanas fundamentales. Se discuten los avances y desafíos en la implementación de políticas educativas que promueven equidad, participación y justicia social. Se concluye que, si bien existen esfuerzos institucionales significativos, es necesario fortalecer la calidad educativa, la participación estudiantil y la vinculación comunitaria para consolidar un modelo de desarrollo humano integral. En el tercer capítulo, "Becas de posgrado. Implicaciones en la transición del Programa Nacional de Posgrados de Calidad al Sistema Nacional de Posgrados", se analiza la transformación institucional del Consejo Nacional de Ciencia y Tecnología (CONACYT) en la Secretaría de Ciencia, Humanidades, Tecnología e Innovación (SECIHTI). se analiza el cambio estructural en la política pública mexicana en materia de ciencia, tecnología y formación de capital humano avanzado. Desde la perspectiva de una autoridad universitaria y especialista en programas de posgrado, se revisan las diferencias sustanciales entre ambos modelos institucionales, con énfasis en los mecanismos de apoyo económico y otorgamiento de becas a estudiantes inscritos en programas reconocidos. Se examinan los cambios normativos, administrativos y de enfoque político, así como sus implicaciones para las instituciones de educación superior, los programas de posgrado y los propios estudiantes.En el cuarto capítulo, “Acreditación, gratuidad y becas en la política educativa de la educación superior”, se analiza el proceso de acreditación como factor clave que incide en la evaluación de programas, y como un requisito indispensable para dar cumplimiento a la gratuidad de la educación superior, y principalmente, en el proceso de asignación de becas al estudiantado. Tales procesos tienen, como contexto general, las modificaciones recientes al marco normativo de la educación, realizadas entre 2019 y 2023. El análisis se concentra en el actual Sistema Nacional de Posgrados y el Sistema de Evaluación y Acreditación de la Educación Superior. El quinto capítulo, “Becas de posgrado para docentes de tipo superior: profesionalización y precarización de la docencia en instituciones públicas mexicanas”, da cuenta del devenir de un programa de becas dirigido al profesorado de instituciones de educación pública superior para realizar estudios de posgrado, con la intención de impactar en la consolidación de las trayectorias académicas y mejorar las condiciones en las que realizan su trabajo los académicos. Los datos analizados muestran que las becas otorgadas por el Programa de Mejoramiento del Profesorado (PROMEP), que transitó hacia el Programa para el Desarrollo Profesional Docente (PRODEP), tuvieron un impacto limitado que se ve opacado por la precarización del trabajo académico. A continuación el capítulo titulado “Becas y nuevos horizontes laborales: ¿semillero de emprendedores o impulso a industrias estratégicas?”, presenta la evolución genealógica de la política federal de becas de educación superior durante el periodo 2006-2025. El objetivo principal es determinar si el financiamiento educativo ha operado como un “semillero de emprendedores” o como un mecanismo de “impulso a industrias estratégicas” y soberanía tecnológica. A través de un análisis documental crítico de los marcos normativos, se identifica una mutación en la racionalidad del apoyo y la conclusión apunta hacia una fragmentación de la política vigente. En el séptimo capítulo, “Apoyo a madres mexicanas jefas de familia” se describe ese programa implementado por el Consejo Nacional de Ciencia y Tecnología (actualmente SECIHTI) durante el periodo 2010-2025. A partir de la revisión de convocatorias e informes institucionales, se revisa la evolución del programa y se realiza una breve caracterización de su población objetivo. Si bien destaca la relevancia del apoyo económico como un recurso que puede contribuir a la permanencia académica de las madres estudiantes, que son jefas de familia, es importante señalar la ausencia de indicadores que integren la jefatura femenina, la maternidad y la situación educativa a nivel superior.El objetivo en “Becas de educación superior para las diversidades sexogenéricas: una exploración para el contexto mexicano del 2006 al 2025” es explorar las becas de educación superior dirigidas a las diversidades sexogenéricas en México, durante el periodo de 2006 a 2025. Se realizó una revisión documental y exploratoria, tanto gubernamental como institucional. Entre los principales hallazgos destaca que, a pesar de los discursos sobre la no discriminación, existe una ausencia generalizada de becas especializadas. Asimismo, las políticas y los programas de apoyo de las universidades no reconocen explícitamente a esta población como un grupo vulnerable o atención prioritaria. Además, en los últimos cinco años, han surgido algunos programas dirigidos a las diversidades, pero no se enfocan a estudiantes que transitan por la universidad. En las conclusiones se subraya la importancia de desarrollar políticas y más claras, considerando las necesidades de las diversidades acciones sexogenéricas en el ámbito universitario. La segunda parte del libro contiene materiales relacionados con instituciones de educación superior ubicadas en tres estados de la región centro y sur-sureste. Esta parte inicia con el noveno capítulo: “Contexto de las becas de educación superior en el estado de Veracruz” se analiza las dinámicas de asignación de becas de educación superior en Veracruz. A partir de la búsqueda documental, se comprende que la Universidad Veracruzana (UV) y las instituciones privadas son las beneficiarias de la política estatal y federal en cuanto a tal distribución se refiere. En el caso de la UV, se debe a su presencia en las principales regiones del estado, así como a la matrícula y características del profesorado en el posgrado. En las instituciones privadas, como estrategia del estado de Veracruz para apoyar la formación en ambos niveles. El décimo capítulo titulado “Modalidades de becas a estudiantes de la Universidad Tecnológica de Huejotzingo, Puebla, período 2007-2025”, el trabajo realizado da cuenta de un breve recorrido histórico que contextualiza el surgimiento en México de la educación superior tecnológica, la forma en se consolidó la oferta educativa en esta modalidad a nivel profesional, hasta llegar a la creación del subsistema que actualmente agrupa al modelo de las Universidades Politécnicas y Tecnológicas, al cual pertenece la Universidad Tecnológica de Huejotzingo. Es acerca de esta institución, objeto de estudio para este capítulo, de la cual se presenta la trayectoria de las becas, la distribución de los apoyos por año, las modalidades y tipos de becas, la distribución por programa educativo y asignación de acuerdo con los estudiantes por sexo.El undécimo capítulo, “Becas de posgrado y estudiantes indígenas en México: acceso educativo, asignación e incidencia social”, se examina la participación de estudiantes indígenas en programas de posgrado en México, con especial atención al Programa de Becas de Posgrado para Indígenas (PROBEPI). Los datos muestran que, entre 2021 y 2024, apenas el 1.27\% de las becas se otorgó a personas que se autoidentificaron como indígenas, concentrándose en un número reducido de universidades y modalidades de apoyo. Aunque se han registrado avances normativos y la creación de universidades interculturales, persisten desafíos importantes relacionados con la validación de la identidad indígena y la plena inclusión de estos estudiantes en los estudios de posgrado. El duodécimo capítulo, “Movilidad social y empleabilidad de estudiantes indígenas de posgrados CONAHCYT–SECIHTI: trayectorias y experiencias desde El Colegio de la Frontera Sur, Chiapas”, en este trabajo, los autores parten de la necesidad de examinar la incidencia de los programas de becas de posgrado del antes Consejo Nacional de Humanidades, Ciencias y Tecnologías, ahora SECIHTI, sobre un sector social históricamente marginado: los pueblos originarios. En este contexto se analiza el papel y la importancia de la beca CONAHCYT-SECIHTI, exclusivamente en estudiantes indígenas inscritos y egresados de programas de posgrado en un centro público de investigación: El Colegio de la Frontera Sur (ECOSUR), entre 2006 y 2025. En conjunto, los resultados contribuyentes a visibilizar la de las trayectorias educativa},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{duranherrera2026empresas,
  title = {Empresas multinacionales de propiedad estatal, concurrenciales: Referencia al caso español},
  shorttitle = {Empresas multinacionales de propiedad estatal, concurrenciales},
  author = {Durán Herrera, Juan José},
  date = {2026},
  journaltitle = {Economistas},
  number = {191},
  pages = {138--145},
  publisher = {Colegio de Economistas de Madrid},
  issn = {0212-4386},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10675988},
  urldate = {2026-11-13},
  abstract = {Regulation, taxation, and ownership and control by the State of productive investments can be effective alternatives for State intervention in the business activities of the economy. State-owned multinational enterprises (SOMNEs) and their foreign subsidiaries are particularly relevant. SOMNEs can be considered strategic organizations of States, and they can play significant roles in diplomacy and international economic policy. In the current geopolitical environment, strategic autonomy, technological sovereignty, resilience, and national security have emerged as central elements in the fields of international economics and business, as well as public policy. Between 1997 and 2001, Spain privatized major strategic state-level enterprises through direct sale or stock market transactions. Some of these privatized companies have taken part in the formation of European industrial groups in sectors of great global importance. This contrasts with the approach of the main European countries which, while also belonging to the EU and the single market, have maintained ownership or shareholder control of some of their strategic enterprises. Privatization results in the denationalization of companies. Currently, Spanish SOMNEs are grouped under the State Industrial Holdings Corporation (SEPI): some are directly owned with a majority stake, others have minority ownership participation, and others have Regulación, impuestos y propiedad (con control) de inversiones productivas pueden ser alternativas eficaces de la intervención del Estado en las actividades empresariales de la economía. Especialmente son relevantes las empresas multinacionales de propiedad estatal (EMPE) y sus filiales en el exterior. Las EMPE pueden ser relevantes como organizaciones estratégicas de los Estados y por tanto como instrumentos en la diplomacia y política económica internacional. En el entorno geopolítico actual emergen como elementos centrales de políticas públicas, en el ámbito de la economía y negocios internacionales, la autonomía estratégica, la soberanía tecnológica, la resiliencia y la seguridad nacional. Hace casi tres décadas en España se privatizaron las grandes empresas estratégicas, gestionadas y coordinadas en el ámbito del Estado, mediante venta directa o salida a bolsa. Algunas de las empresas privatizadas han participado en la formación de grupos industriales europeos en sectores de gran importancia global. Esta realidad contrasta con la mostrada por los principales países europeos que perteneciendo también a la UE y al mercado único han mantenido la propiedad y control accionarial de algunas de sus empresas estratégicas. Con la privatización se produce una desnacionalización de las empresas. Las EMPE españolas están comprendidas en la Sociedad Estatal de Participaciones Industriales (SEPI): unas participadas de forma directa y con mayoría del capital, otras con participación minoritaria y otras con participación indirecta.},
  langid = {spanish}
}

@article{duranjuarez2022agencia,
  title = {Agencia Latinoamericana y Caribeña del Espacio: perspectivas y realidades},
  shorttitle = {Agencia Latinoamericana y Caribeña del Espacio},
  author = {Durán Juárez, Citlali},
  date = {2022},
  journaltitle = {Ucronías},
  number = {6},
  pages = {33--60},
  publisher = {Colaboratorio Universitario de Ciencias, Artes, Tecnología, Innovación y Saberes del Sur (CONUSUR)},
  issn = {2684-012X},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9183358},
  urldate = {2026-11-13},
  abstract = {La creación de la Agencia Latinoamericana y Caribeña del Espacio (ALCE), por conducto de las cumbres organizadas por la Comunidad de Estados Latinoamericanos y Caribeños (CELAC), despertó un creciente interés por el tema espacial. Al mismo tiempo, abrió una importante discusión acerca de su pertinencia, viabilidad y posibles alcances. El debate más importante sobre su conformación gira en torno a la capacidad de ALCE para desarrollar e impulsar proyectos con soberanía tecnológica y potencialidades que efectivamente emanen de la región. Pero, entonces, ¿se puede afirmar que estamos frente a un sueño hecho realidad?, ¿o simplemente estamos frente a un conjunto de buenas intenciones? Esta revisión presenta, por una parte, lo que hasta el momento se sabe de la ALCE de forma oficial y, por otra, busca aportar elementos y consideraciones que no se deben pasar por alto cuando se habla de desarrollo, tecnología, soberanía y autonomía dentro del sector espacial. The founding of the Latin-American and Caribbean Space Agency (LACSA), as a result of the Community of Latin American and Caribbean States endorsement (CLACS), raised a growing interest for the space sector. In addition, the LACSA establishment opened the debate in terms of its relevance, feasibility and potential scope. The most significant in relation to its creation was about LACSA's capability to develop and promote projects with technological sovereignty and capabilities that really emanate from the region.  Therefore, can we consider the Latin-American and Caribbean Space Agency (LACSA) as a promising agency for the region? or, is LACSA part of an enthusiastic focus for the Latin-American and Caribbean region? This review presents on one hand the available and official LACSA's information so far. And in the other hand, it aims to contribute with important considerations and topics in relation to development, technology, sovereignty, and autonomy within space sector.},
  langid = {spanish}
}

@article{dusanschreiber2024analise,
  title = {ANÁLISE DE VIABILIDADE TÉCNICA DE LEAN MANUFACTURING NA FABRICAÇÃO DE MÓVEIS SERIADOS},
  author = {{Dusan Schreiber} and {Vilson José Becker} and {Cristiane Froehlich} and {Alexandre André Feil}},
  date = {2024-03-04},
  journaltitle = {Reuna},
  shortjournal = {Reuna},
  url = {https://openalex.org/W7219205894},
  abstract = {No segmento moveleiro, considerado um setor com baixo nível de apropriação tecnológica por se tratar de um segmento industrial tradicional, analisar a viabilidade de adoção da metodologia do Lean Manufacturing (LM) e suas ferramentas, pode ser considerado um desafio relevante. LM representa um sistema consolidado, que na sua essência fundamenta a eliminação dos desperdícios que não agregam valor aos processos e consequentemente aos produtos e que pode propiciar o suporte necessário para as indústrias moveleiras para facultar a personalização dos produtos. O objetivo do estudo foi o de analisar a viabilidade técnica da adoção de Lean Manufacturing em uma indústria de móveis, de grande porte, localizada na região sul do país. Para a coleta de dados utilizou-se a entrevista em profundidade com seis integrantes do universo organizacional, que ocupam cargos de gestão na área de manufatura, observação participante (um dos autores é colaborador da empresa) e levantamento documental. Os dados foram submetidos à análise de conteúdo. Evidenciou-se que o conhecimento das técnicas do LM ainda se encontra na fase inicial e não está disseminado entre os colaboradores do setor de manufatura. No entanto, as características operacionais da empresa sugerem que o LM pode contribuir à competividade organizacional e alcance de níveis mais elevados de eficiência. Para tanto será necessário investir em treinamento e capacitação das equipes de trabalho.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{echeverriaezponda2008apropiacion,
  title = {Apropiación social de las tecnologías de la información y la comunicación},
  author = {Echeverría Ezponda, Javier},
  date = {2008},
  journaltitle = {CTS: Revista iberoamericana de ciencia, tecnología y sociedad},
  volume = {4},
  number = {10},
  pages = {171--182},
  publisher = {REDES, Centro de Estudios sobre Ciencia, Desarrollo y Educación Superior},
  issn = {1850-0013, 1668-0030},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=2507591},
  urldate = {2026-11-13},
  abstract = {Este artículo expone los cambios que son necesarios en las modalidades de aprendizaje para una exitosa apropiación social de las tecnologías de la información y la comunicación (TIC). En este sentido se analiza la importancia estratégica del sector educativo para el desarrollo de una sociedad de la información integradora que evite la exclusión social, tanto de personas como de grupos sociales. El autor también presenta las líneas de acción propuestas por la Cumbre Mundial de la Sociedad de la Información, organizada por la ONU, para evitar y paliar las desigualdades sociales que ha producido la expansión mundial de dichas tecnologías. El artículo finaliza abordando la problemática lingüística en torno a la emergencia del sistema TIC y planteando los peligros y las ventajas del surgimiento de una nueva fase evolutiva en el desarrollo de los idiomas.},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/75QI89QA/Echeverría Ezponda - 2008 - Apropiación social de las tecnologías de la información y la comunicación.pdf}
}

