@thesis{lauracatalinalopezarenas2026velocimetria,
  title = {Velocimetría por imágenes de partículas versus modelación hidráulica en HEC- RAS},
  author = {{Laura Catalina Lopéz Arenas}},
  date = {2026-06-30},
  journaltitle = {Repositorio Institucional Universidad Cooperativa de Colombia},
  url = {https://openalex.org/W7214826652},
  abstract = {Este estudio tiene como objetivo estimar el caudal a partir de la técnica de Velocimetría por Imágenes de Partículas en el canal de laboratorio de la Universidad Cooperativa de Colombia sede Medellín y a partir de aquí generar una práctica académica para los estudiantes de ingeniería civil. El trabajo consistió en la grabación de videos con diferentes trazadores, luego estas fueron extraídas y procesadas para el cálculo de la velocidad superficial y la estimación de los campos de velocidad, utilizando software de código abierto PIVlab. Se obtuvieron perfiles de velocidad para diferentes tipos de trazadores; los flujos con trazadores de cascaras de naranja presentaron perfiles de velocidad con vectores salidos del plano del canal, los flujos con trazadores de poli estireno fueron adecuados y se pudieron correr sin embargo arrojaron unas velocidades que no coincidieron con la capacidad del canal y sin trazadores se mostraron flujos de agua que reflejados con la iluminación de laboratorio el programa los tomo como partículas mostrando nuevamente vectores fuera del plano del canal. El producto de los perfiles de velocidad no fue el esperado para ser comparado con el software HecRas, Sin embargo, se hizo la modelación del canal con información de elevación a través de un ráster para estimar las velocidades que el agua toma en este espacio. En conclusión, los trazadores de cascaras de naranja generan alteraciones en la lectura de las magnitudes de los vectores en el programa PIV lab, el poliestireno es de fácil lectura, pero entrega resultados que no coinciden con la capacidad del canal y la iluminación en la toma de los videos altera los resultados de la lectura perpendicular de las partículas ya que toma el agua misma como trazador. Por lo tanto, para el uso del método de PIV lab en el laboratorio se deben implementar diferentes modificaciones locativas, correspondientes a iluminación, elevación de la herramienta fílmica con el uso de un trípode estático y de ser posible un laser que actúe en el mismo sentido del flujo del agua ubicado antes del canal que permita precisión en la toma de los videos},
  langid = {spanish},
  keywords = {iberoamericana}
}

