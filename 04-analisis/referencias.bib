@article{capera2025integracion,
  title = {Integración de saberes: retos para la terrotorialización del conocimiento científico, indígena y campesino},
  author = {Capera, José Javier and Núñez, Miguel Ángel},
  date = {2025-11-21},
  journaltitle = {Zenodo (CERN European Organization for Nuclear Research)},
  shortjournal = {Zenodo (CERN European Organization for Nuclear Research)},
  doi = {10.5281/zenodo.17675227},
  url = {https://openalex.org/W7106328413},
  abstract = {CUADERNO DE DEBATE 51 Las ponencias de los doctores José Capera (Colombia) y Miguel Ángel Núñez (Venezuela), aquí compiladas, sostenidas en el seno del Observatorio Nacional de Ciencia, Tecnología e Innovación (Oncti), constituyen un aporte fundamental al debatecontemporáneo sobre la intersección crítica entre la ciencia, las tecnologías emergentes y los saberes ancestrales. Estos elementos son clave para abordar las transformaciones político-sociales y la larga lucha por la soberanía en América Latina.La ponencia del Dr. José Capera problematiza el auge de la inteligencia artificial (IA) como una herramienta de doble filo. Si bien la IA puede usarse para la preservación y revitalización de los saberes de comunidades indígenas, al mismo tiempo se pone demanifiesto el riesgo inherente que se establece en la emergencia de una dependencia tecnológica crítica. Las arquitecturas de IA contemporáneas, controladas mayormente por corporaciones transnacionales y plataformas digitales, ejercen un poder infraestructural que trasciende lo técnico para instalarse en lo político y lo epistémico. Esta nueva colonialidad digitalintensifica el riego del extractivismo de datos y saberes. El control algorítmico y de datos puede derivar en nuevas formas de apropiación y mercantilización de los saberes ancestrales, cedidos bajo relaciones asimétricas de poder. Esta dinámica amenaza la autonomía y la soberanía de los pueblos originarios, subordinándolos a estructuras tecnológicas exógenas, frecuentemente desconectadas de sus ecologías de saberes y sistemas de gobernanza propios. Por su parte, el Dr. Núñez, desde su larga experiencia y estudios en la agroecología, nos la presenta, no solo como una práctica agrícola, sino como un paradigma científico emergente y un poderoso movimiento social que ofrece una alternativa robusta frente a los desafíos de la producción con bases de justicia social, respeto al ambiente y el uso de tecnologías sostenibles. Como enfoque transdisciplinario, la agroecología integra saberes tradicionales con conocimientos científicos contemporáneos, promoviendo sistemas alimentarios basados en principios de diversidad biocultural y resiliencia ecológica, vista esta última como herramienta de resistencia y transformación. En contraste con el modelo agroindustrial convencional, la agroecología enfatiza la soberanía alimentaria y la construcción de agroecosistemas sustentables que priorizan la salud de los ecosistemas y el bienestar de las comunidades rurales. El caso del Konuco venezolano, analizado ampliamente bajo una perspectiva agroecológica, es un claro ejemplo de práctica ancestral que evidencia una notable capacidad socioecológica para cambiar su estructura productiva de maneraautónoma (resistencia activa). Sin embargo, en el ámbito de la agricultura campesina y de pequeña escala, existen desafíos estructurales: su orientación al autoconsumo y circuitos de proximidad pudiera limitar su capacidad para alimentar directamente a una población mayoritariamente urbana, cuyos hábitos de consumo están profundamente arraigados en los regímenes agroindustriales. Un reto extraordinario es la organización social campesina para poder enfrentar con márgenes aceptables de éxito el sistema agroindustrial y comercializador instalado en el país y más aún: transformar los hábitos alimentarios actuales de la población, altamente dependiente de insumos importados ajenos a nuestra potencialidad agroclimática. Es por ello que la transición agroecológica requiere enfrentar obstáculos significativos, como la falta de políticas públicas diferenciadas y las dificultades para escalar prácticas sustentables en mercados concentrados que exigen volúmenes homogéneos y estandarizados. El fundamento de las conferencias de Capera y Núñez, y la discusión posterior con los participantes, evidencia los momentos decisivos que se viven actualmente en América Latina en la disputa por el futuro de sus sistemas alimentarios, sus patrimonios culturales y su soberanía tecnológica. En este marco, la transformación estratégica de la ciencia y la tecnología enherramientas de liberación epistémica y justicia social es un imperativo. Estas disciplinas, la agroecología y la IA, articuladas con una visión humanista, tienen el potencial de nutrir sistemas alimentarios justos, plurales y sostenibles en América Latina. Así mismo, al protegerse y vigorizar la pluralidad de saberes locales y ancestrales, la región construye un horizonte emancipatorio que garantiza la soberanía alimentaria, el respeto por la diversidad cultural y la resiliencia socioecológica. En suma, este es el mensaje reflexivo que nos dejan los conferencistas Capera y Núñez: la integración de los saberes ancestrales, la ciencia y la tecnología, constituye no solo una estrategia de resistencia, sino la base para la construcción de proyectos políticosalternativos y emancipadores.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{cappozzo2025enfoque,
  title = {El enfoque europeo y convencional acerca de la soberanía digital y la libertad de expresión en línea},
  author = {Cappozzo, Valerio and Tacente, Alessandro},
  date = {2025},
  journaltitle = {Revista general de derecho constitucional},
  number = {43},
  pages = {8},
  publisher = {Iustel},
  issn = {1886-6212},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10453168},
  urldate = {2026-11-13},
  abstract = {This study explores the intersection between digital sovereignty and freedom of expression online, recognized as a fundamental right within the framework of comparative constitutional law, European Union law, and the ECHR system. It examines the normative protection mechanisms, as well as the emerging challenges and doctrinal controversies stemming from the integration of digital technologies into the public sphere. Particular attention is given to the legal liability of digital platforms, emphasizing its implications for digital governance and regulatory frameworks. From a comparative perspective, the study analyzes the legal and jurisprudential developments of the Court of Justice of the European Union (CJEU) and the European Court of Human Rights (ECtHR), focusing on the evolving balance between technological innovation and the protection of fundamental rights. Based on this analysis, the paper identifies emerging regulatory trends and normative strategies aimed at ensuring an effective harmonization between state digital autonomy and the safeguarding of freedom of expression. El presente estudio analiza la interrelación entre la soberanía digital y la libertad de expresión en línea, concebida como un derecho fundamental en el marco del derecho constitucional comparado, el derecho de la Unión Europea y el sistema convencional del CEDH. Se examinan los mecanismos de tutela normativa, así como las problemáticas emergentes y las controversias doctrinales derivadas del uso de tecnologías digitales en la esfera pública. En particular, el estudio aborda la responsabilidad jurídica de las plataformas digitales, destacando sus implicaciones en términos de regulación y gobernanza del ecosistema digital. Desde una perspectiva comparada, se analizan los desarrollos normativos y jurisprudenciales del Tribunal de Justicia de la Unión Europea (TJUE) y del Tribunal Europeo de Derechos Humanos (TEDH), con especial atención a la evolución del equilibrio entre innovación tecnológica y protección de derechos fundamentales. A partir de este análisis, se identifican tendencias regulatorias emergentes y estrategias normativas orientadas a garantizar una armonización efectiva entre la autonomía digital de los Estados y la tutela de la libertad de expresión},
  langid = {spanish}
}

