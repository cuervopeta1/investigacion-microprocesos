@article{trillasfonts2026mapa,
  title = {Mapa de poder de la IA},
  author = {Trillas Fonts, Ariadna},
  date = {2026},
  journaltitle = {Alternativas económicas},
  pages = {30--35},
  publisher = {SGEL - Sociedad General Española de Librería},
  issn = {2014-9204, 2014-9913},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10947758},
  urldate = {2026-11-13},
  abstract = {Los nuevos actores de la IA han retado a Google, Microsoft y Amazon, pero necesitan su dinero, infraestructuras y usuarios para crecer. A la vez, las 'big tech' ven en la IA una palanca para su negocio. Resultado: un ecosistema que concentra aún más poder y del que cada vez cuesta más escapar. 600 mil millones de dólares es la inversión en IA de las grandes tecnológicas. 86 puesto que ocupa Mistral en el 2026 AI Index Report de la Universidad de Stanford. Es la única IA europea. EE UU lidera la inversión en IA privada: en 2025, 286.000 M\$, frente a los 20.920 M\$ de Europa y 23 veces más que China. El gasto público chino en IA sumó 184.000 M\$ entre 2020 y 2023. La IA europea que ofrece soberanía tecnológica es la francesa Mistral.},
  issue = {149 (septiembre)},
  langid = {spanish}
}

@thesis{tulioandresruizromero2025estudio,
  title = {Estudio de prefactibilidad de una conectividad autogestionada por el cabildo menor indígena Zenú el Guaimaro en el Departamento de Sucre. Práctica social},
  author = {{Tulio Andrés Ruiz Romero}},
  date = {2025-01-01},
  journaltitle = {Institutional Repository University of Antioquia (University of Antioquia)},
  url = {https://openalex.org/W7207457193},
  abstract = {El cabildo menor indígena Zenú el Guaimaro enfrenta limitaciones en materia de conectividad digital, lo que restringe su acceso a la educación, la información y las oportunidades de desarrollo económico y social. Esta brecha tecnológica ha profundizado las desigualdades frente a sectores urbanos y constituye un obstáculo para el ejercicio de derechos fundamentales como la educación, la participación ciudadana y la inclusión digital. En respuesta, este proyecto plantea el diseño de una red comunitaria de telecomunicaciones orientada a garantizar el acceso equitativo a internet de banda ancha. El estudio integró dimensiones normativas, de mercado, técnicas, organizacionales y financieras, lo que permitió estructurar una propuesta integral ajustada a las condiciones del territorio y a las necesidades de la población. En el componente técnico, se definió una arquitectura FTTH–GPON desde la OLT hasta las ONT en cada hogar, soportada en cable ADSS G.652.D y fibra drop G.657.A, seleccionados por su confiabilidad, escalabilidad y resistencia. En el ámbito financiero, los resultados actualizados estiman una inversión inicial (CAPEX) de entre 154 y 162 millones de pesos colombianos y unos gastos operativos anuales (OPEX) del orden de 166 millones de pesos. Los escenarios de ingresos evidencian que, con la tarifa base de 60.000 COP, incluso en el escenario de mayor adopción (80\% de hogares), los ingresos no cubren la totalidad del OPEX, lo que confirma la necesidad de un modelo de cofinanciación comunitaria e institucional. En conclusión, el proyecto es técnica y socialmente viable, y puede replicarse en otras comunidades indígenas y rurales siempre que se implemente bajo un esquema híbrido de sostenibilidad financiera y acompañado de estrategias de expansión. Más allá de la infraestructura tecnológica, la iniciativa busca cerrar la brecha digital y fortalecer los procesos educativos, culturales y organizativos de la comunidad Zenú, aportando al desarrollo integral de su territorio.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{tulioaugustussantosviana2026codesign,
  title = {Codesign da da Plataforma Livre Nação Yuxibu com o Povo Indígena Huni Kuı̃: desafios e reflexões iniciais},
  author = {{Túlio Augustus Santos Viana} and {Diego Zabot} and {Valéria Argôlo Rosa} and {José Nilson Sabóia Kaxinawá (Tuwe)} and {Solon Dutra} and {Débora Abdalla Santos}},
  date = {2026-05-06},
  journaltitle = {Conferência Latino-Americana de Interação Humano-Computador (CLIHC)},
  shortjournal = {Conferência Latino-Americana de Interação Humano-Computador (CLIHC)},
  pages = {176--180},
  doi = {10.5753/clihc.2026.21162},
  url = {https://openalex.org/W7164007725},
  abstract = {Tecnologias digitais têm sido apropriadas por povos indígenas para fortalecer redes de apoio e compartilhar saberes e culturas. Este artigo discute a concepção inicial da Plataforma Livre Nação Yuxibu, voltada ao povo Huni Kuı̃ para compartilhar sua cosmovisão nas dimensões cultural, socioambiental, educacional e financeira. A pesquisa adotou o design semioparticipativo para construir a interação em colaboração com a comunidade, apresentando reflexões iniciais sobre decisões técnicas e metodológicas do processo de codesign. Argumenta-se que a articulação entre software livre e cocriação pode favorecer modelos de desenvolvimento tecnológico mais alinhados ao protagonismo indígena e à autonomia de seus saberes no ambiente digital.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{turk2025commons,
  title = {Commons in the {{Neoliberal Era}}: {{An Analysis}} of {{Transformation}}, {{Threat}}, and {{Resistance}}},
  author = {Türk, Ömer Şemsi},
  date = {2025-10-29},
  journaltitle = {Zenodo (CERN European Organization for Nuclear Research)},
  shortjournal = {Zenodo (CERN European Organization for Nuclear Research)},
  doi = {10.5281/zenodo.17589940},
  url = {https://openalex.org/W7105647339},
  abstract = {This paper analyses how neoliberalism, as both an economic and political project, restructures social relations by systematically undermining traditional and digital commons through processes of privatization, commodification, and enclosure. Theoretically, it draws on Karl Marx’s notion of primitive accumulation and David Harvey’s concept of accumulation by dispossession to frame neoliberalism as a renewed and continuous phase of enclosure that extends capitalist control over shared resources. It also engages with Elinor Ostrom’s institutional theory of collective action and Massimo De Angelis’s conception of value struggles to examine the resilience and transformative potential of commons-based practices. The paper compares the material commons (such as land, water, and forests) with immaterial or digital commons (such as open-source software, data, and platforms) to reveal how neoliberal rationality reshapes both domains. Through case studies like the Bolivian Water War and the Zapatista movement, it demonstrates how communities resist dispossession by reconstructing cooperative, non-market-oriented systems of governance and production. In digital contexts, the emergence of platform capitalism and algorithmic control signifies a new enclosure of informational resources, turning participation and data into commodities. Ultimately, the study argues that reclaiming the commons requires not only defending shared resources but reimagining production, governance, and social cooperation beyond the logic of capital accumulation.},
  langid = {english},
  keywords = {inglesa}
}

@article{ugeda2026brics,
  title = {BRICS e Astropolítica: desafios de governança em uma ordem espacial multipolar},
  author = {Ugeda, Luiz and Sanches, Karine},
  date = {2026-05-05},
  doi = {10.1590/SciELOPreprints.16042},
  url = {/scielo.php?script=sci_arttext&pid=https://preprints.scielo.org/index.php/scielo/preprint/view/16042&lang=pt},
  abstract = {This study explores the convergence between astropolitics, smart governance, and technological sovereignty within the BRICS framework, analyzing the impacts of these interactions on international relations and urban management. The research examines how BRICS countries integrate advanced technologies, such as artificial intelligence and big data, to enhance the interoperability of geoinformation systems and environmental monitoring, offering innovative solutions to emerging challenges in outer space. Through a comparative analysis of the bloc's heterogeneous public policies, the potential of the Glonass and Beidou systems as central axes of spatial articulation within the BRICS is identified. The discussion also addresses how these initiatives influence space security, sustainability, and the formulation of global space governance norms. The conclusion argues that the creation of a smart space governance body by the BRICS could solidify the bloc's position as a strategic actor in global astropolitics, fostering a multilateral and inclusive approach that offers an alternative to the traditional dominance of Western powers.},
  langid = {portuguese},
  keywords = {Astropolítica,Astropolitics,geoinformação,geoinformation,infraestrutura de dados espaciais,Objetivos de Desenvolvimento Sustentável (ODS),soberania tecnológica,spatial data infrastructure,sustainability,Sustainable Development Goals (SDGs),sustentabilidade,technological sovereignty}
}

