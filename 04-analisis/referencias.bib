@article{rodriguez-perez2015atencion,
  title = {Atención Primaria en Salud y Redes Integradas en una institución de salud de primer nivel, Tauramena (Casanare, Colombia): propuesta de Mejoramiento},
  author = {Rodríguez-Pérez, María and Hernández-Rincón, Erwin},
