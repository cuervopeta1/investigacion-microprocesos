  volume = {8},
  number = {2},
  doi = {10.22456/1679-1916.15246},
  url = {https://openalex.org/W1589430962},
  abstract = {O trabalho é parte dos resultados de uma pesquisa-ação desenvolvida em 2009 no PPGENSIMAT/UFRGS numa escola pública estadual em Porto Alegre, que tem por objetivo compreender o processo de aprendizagem do estudante em matemática. Com o decorrer do trabalho em sala de aula evidencia-se uma apropriação tecnológica natural pelos estudantes, tanto como estratégia e/ou forma de apresentação dos seus portfólios a professora, colegas, e a comunidade. Apresenta-se neste trabalho o trabalho construído e apresentado pelos estudantes do 3º ano do Ensino Médio para a comunidade de acordo com a responsabilidade e autonomia de construção dos próprios estudantes e segundo o que julgavam necessário para que todos compreendessem o significado de portfólio de matemática, como forma de demonstrar o que aprenderam de matemática.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{alinesilvadebona2013aprendendo,
  title = {APRENDENDO MATEMÁTICA NA REDE SOCIAL FACEBOOK POR AÇÕES COOPERATIVA},
  author = {{Aline Silva De Bona} and {Lucas Bravo} and {Vinicius Maciel} and {Marcus Vinícius de Azevedo Basso}},
