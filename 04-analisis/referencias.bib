@article{sebastianbenitezlarghi2013popular,
  title = {Lo popular a partir de la apropiación de las TIC},
  author = {{Sebastián Benítez Larghi}},
  date = {2013-06-01},
  journaltitle = {DOAJ (DOAJ: Directory of Open Access Journals)},
  shortjournal = {DOAJ (DOAJ: Directory of Open Access Journals)},
  url = {https://openalex.org/W57769067},
  abstract = {¿Qué prácticas y representaciones construyen sujetos provenientes de las clases populares para aprehender las tecnologías digitales, cuyo manejo se presenta cada vez más decisivo para el posicionamiento de los individuos en la sociedad? ¿Cómo se insertan las nuevas tecnologías en los universos de sentidos populares mediante los cuales cada sector social construye su visión del mundo? ¿Cómo se articulan estos universos con la reproducción del orden social? A partir de estos interrogantes, a lo largo de este artículo, recorreremos las dimensiones principales que constituyen las heterogéneas experiencias de apropiación de las TIC por parte de las clases populares argentinas. Si las TIC, como todo desarrollo tecnológico, son un constructo social e histórico que se moldea a través de las prácticas a los que lo someten los actores sociales, nos interesa conocer cómo son las nuevas tecnologías creadas y recreadas por varones y mujeres, jóvenes y adultos de clases populares, qué sentidos adquieren, si reproducen o rompen con los significados dominantes y si agregan algo novedoso a las experiencias tecnológicas vigentes entre las clases dominantes. Para cumplir con este objetivo nos abocaremos a indagar las representaciones sociales que atraviesan y movilizan las prácticas tecnológicas construidas por distintos actores populares (integrantes de movimientos de desocupados, jóvenes usuarios de espacios de acceso público de barrios periféricos, mujeres desempleadas, estudiantes secundarios en barrios obreros) en términos de acceso, adquisición de habilidades y usos concretos de las TIC en distintas esferas de su vida cotidiana. Para sostener y alimentar esta conjetura nos valdremos del trabajo de campo acumulado mediante diferentes proyectos de investigación durante casi una década (2003-2011) dedicadas a indagar las experiencias de apropiación tecnológica de distintos actores de clases populares argentinas: 1) miembros de Movimientos de Trabajadores Desocupados; 2) jóvenes adolescentes y jóvenes adultos usuarios de tres modelos de espacio de acceso público a las TIC (un cibercafé, un taller de computación autogestionado comunitariamente, y un telecentro financiado por un programa estatal y gestionado por una organización de base) en el populoso municipio de La Matanza; 3) estudiantes secundarios de distintas escuelas públicas de barrio populares y obreros del Gran Buenos Aires y el Gran La Plata beneficiarios del Programa Conectar Igualdad (PCI) que opera bajo la modalidad 1 a 1 (una netbook por alumno). Los distintos proyectos de investigación privilegiaron una estrategia metodológica cualitativa utilizando como herramientas de indagación la observación no participante, entrevistas a informantes clave, entrevistas en profundidad y grupos focales. Como hipótesis planteamos que existiría un conjunto de tensiones entre las representaciones sociales hegemónicas construidas en torno a las TIC y las prácticas efectivas mediante las cuales los sujetos de clases populares incorporan esas tecnologías en sus vidas cotidianas. Esto obedecería a que el procesamiento práctico de esas representaciones opera desde condiciones socio-culturales particulares y a través de racionalidades diferentes a las de otros sectores sociales, asociadas a la experiencia cotidiana de las clases populares.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{sebastianbenitezlarghi2013tic,
  title = {TIC, sectores populares y juventud. Modalidades de apropiación tecnológica en tres espacios de acceso público del partido de La Matanza (Prov. de Buenos Aires - Argentina)},
  author = {{Sebastián Benítez Larghi} and {Carolina Aguerre} and {Marina Calamari} and {Ariel Fontecoba} and {Marina Moguillansky} and {Jimena Ponce de León}},
  date = {2013-06-01},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  shortjournal = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  url = {https://openalex.org/W2252896373},
  abstract = {El trabajo analiza las distintas modalidades de apropiación tecnológica por parte de jóvenes de sectores populares urbanos que acceden a las TIC en diferentes espacios de acceso público. En tal sentido, se procura establecer la contribución de cada uno de estos espacios sobre las siguientes dimensiones de la vida cotidiana de los y las jóvenes que las utilizan: sociabilidad, educación, empleo y participación política. Desde una perspectiva cualitativa, se indagaron tres distintos tipos de espacio de acceso público (comercial; autogestionado; comunitario con financiamiento estatal) situados en el municipio de La Matanza. El trabajo de campo se basó en entrevistas semiestructuradas y grupos focales con jóvenes usuarios de los espacios de acceso público, así como la observación no articipante de los mismos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{sebastianbenitezlarghi2018construcciones,
  title = {Las construcciones del género en tiempos de Internet: modos de expresión y riesgos percibidos en las redes sociales durante la niñez.},
  author = {{Sebastián Benítez Larghi} and {Carolina Duek}},
  date = {2018-06-27},
  journaltitle = {Revista Mediterránea de Comunicación},
  shortjournal = {Revista Mediterránea de Comunicación},
  volume = {9},
  number = {2},
  pages = {41--41},
  doi = {10.14198/medcom2018.9.2.18},
  url = {https://openalex.org/W2810545942},
  abstract = {En el presente trabajo se presentan resultados de una investigación dedicada a comprender el modo en que las desigualdades de género y los procesos de apropiación tecnológica se co-constituyen a partir del estudio comparativo de las trayectorias de apropiación de las Tecnologías de Información y Comunicación (TIC) por parte de niñas y niños en diferentes regiones de la Argentina. Presentaremos aquí los hallazgos surgidos de los grupos focales realizados durante 2017 a niños y niñas de seis regiones distintas el país con una perspectiva cualitativa abarcando diferentes niveles socioeconómicos, culturales y geográficos. En cada región se visitaron escuelas primarias de gestión pública y de gestión privada donde se realizaron grupos focales y entrevistas en profundidad con niñas y niños de 9 a 11 años de edad, con sus padres y docentes. Retomaremos, para el desarrollo del presente artículo, los grupos focales que brindan información nodal sobre la construcción de las trayectorias de los y las informantes.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@book{sebastianbenitezlarghi2022despues,
  title = {Después del Conectar igualdad: Tecnobiografías juveniles en el Gran La Plata},
  author = {{Sebastián Benítez Larghi}},
  date = {2022-08-17},
  journaltitle = {Universidad Nacional de La Plata. Facultad de Humanidades y Ciencias de la Educación eBooks},
  doi = {10.24215/978-950-34-2127-7},
  url = {https://openalex.org/W4292210201},
  abstract = {Después del Conectar Igualdad estudia una política de inclusión digital desde la perspectiva de sus destinatarios. A lo largo de sus capítulos se rastrean los diversos sentidos que la apropiación de las tecnologías digitales adquiere a lo largo de la vida de las y los jóvenes. Mediante la reconstrucción de tecnobiografías inscriptas en diferentes contextos se transitan, desde una mirada socioantropológica, los sinuosos caminos de la apropiación tecnológica, en relación con la cual sujetos, objetos y políticas se interrelacionan de múltiples maneras. Se logra, así, captar la trama de adaptaciones, negociaciones y resistencias que tejen las juventudes con las tecnologías digitales sin perder de vista las marcadas desigualdades que surcan sus trayectorias sociales, educativas y laborales.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{sebastianbenitezlarghi2025entre,
  title = {ENTRE EL DISPOSITIVO Y EL SENTIDO: Trayectorias de apropiación de tecnologías digitales en infancias, adolescencias y juventudes de Argentina y Colombia},
  author = {{Sebastián Benítez Larghi} and {Eliana Noscué Mera}},
  date = {2025-12-30},
  journaltitle = {Administración Pública y Sociedad (APyS)},
  shortjournal = {Administración Pública y Sociedad (APyS)},
  number = {19},
  pages = {136--156},
  doi = {10.71047/2524.9568.n18.49505},
  url = {https://openalex.org/W7117676715},
  abstract = {El artículo analiza comparativamente los procesos de apropiación de tecnologías digitales por parte de niñas, niños y adolescentes en Argentina y Colombia, en el marco de políticas públicas de inclusión digital. Desde una perspectiva cualitativa y situada; se abordan las experiencias del Programa Conectar Igualdad (Argentina) y el Programa Computadores para Educar (Eje Cafetero - Colombia) y una investigación focalizada en grupos sociales con experiencias de migraciones involuntarias y pertenecientes a comunidades indígenas del suroccidente colombiano; atendiendo a los sentidos, usos y resignificaciones construidas por los propios sujetos en contextos de desigualdad estructural. Se concluye que la apropiación tecnológica no puede ser entendida como un proceso homogéneo ni lineal, sino como una práctica social atravesada por mediaciones pedagógicas, antecedentes históricos y contextos socio culturales y materiales. Asimismo, se advierte que la eficacia de estas políticas depende de su articulación con las trayectorias vitales de los sujetos y las condiciones socioeconómicas y territoriales en las que se implementan.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{sebastianduquemahecha2026empowering,
  title = {Empowering {{Incremental Housing}} - {{A Parametric Workflow}} for {{Climate-Sensitive Solar Assessment}} of {{Urban Photovoltaics}}},
  author = {{Sebastian Duque Mahecha} and {Régis Widmer} and {Sergi Aguacil Moreno}},
  date = {2026-07-27},
  journaltitle = {Infoscience (Ecole Polytechnique Fédérale de Lausanne)},
  shortjournal = {Infoscience (Ecole Polytechnique Fédérale de Lausanne)},
  url = {https://openalex.org/W7222861608},
  abstract = {Self-constructed incremental housing—driven by self-help and community practices—is one of the most widespread modes of urban growth across the Global South. In cities throughout Latin America, Africa, and Asia, families build step by step, adapting dwellings to shifting needs and scarce resources [1,2]. These processes not only deliver access to housing and ownership but also embed everyday knowledge, resilience, and adaptability into the very fabric of the city. However, a critical paradox remains despite abundant solar irradiation and an urgent need for affordable energy, renewable energy systems are strikingly absent from these neighbourhoods [4]. This gap is driven by major barriers, including financial constraints, limited technical capacity, and a fundamental disconnect between bottom-up construction practices and top-down energy planning. Meanwhile, digital tools for estimating photovoltaic (PV) potential are rapidly advancing. They increasingly enable non-specialists to produce solar-power estimations independently. However, these instruments typically rely on statistical assumptions or image-based datasets, which often fail to account for the dynamic and heterogeneous morphology of incremental settlements [3]. As a result, outputs lack precision and fail to support robust planning for energy equity. To overcome these limitations, this study introduces an open-source, parametric workflow to assess urban-integrated photovoltaics (UIPV) in incremental housing contexts. The workflow is structured into four modules: (1) growth scenario generation, to algorithmically model the morphological logics of self-built neighbourhoods [1,2]; (2) automated PV allocation, distributing modules across usable surfaces according to flexible orientation and specific contextual constraints [5]; (3) climate-data driven irradiation simulation, utilizing standardized hourly datasets such as EnergyPlus weather (EPW) files for accurate energy modelling; and (4) performance evaluation, comparing PV output at both the building (“part”) and neighbourhood (“assembly”) levels. The entire simulation is built within parametric platforms (e.g., Grasshopper) leveraging Ladybug tools to integrate morphological and climatic data in a single, reproducible workflow. Our findings reveal urban form as a decisive factor in solar performance. Neighbourhoods with homogeneous clusters achieve higher overall efficiency, while heterogeneous arrangements significantly reduce it. At the dwelling level, relative height and shading patterns are the primary determinants of productivity per panel. These findings highlight the inadequacy of traditional rooftop-based methods and underscore the necessity of morphology-sensitive digital models. Moving beyond technical outputs, the workflow is fundamentally conceived as a community-oriented tool. By embedding local construction logics into rigorous parametric modelling, it enhances the precision of digital simulations while ensuring outputs remain grounded and actionable within the realities of incremental housing. The approach offers not only a methodological innovation but also a conceptual shift in how we view self-constructed neighbourhoods, positioning them as essential contexts for advancing building and urban science. Ultimately, the project envisions an accessible online platform enabling households, cooperatives, and municipalities to explore energy scenarios, assess financial viability, and integrate resilience considerations. This work demonstrates how the integration of local practices with digital science yields actionable pathways toward equitable, resilient, and climate-responsive cities.},
  langid = {english},
  keywords = {inglesa}
}

