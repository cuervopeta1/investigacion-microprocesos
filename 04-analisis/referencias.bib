@article{josealexsoaressantos2024politicas,
  title = {Políticas públicas e possibilidades pedagógicas do cinema na escola como educação antirracista e indígena},
  author = {{José Alex Soares Santos} and {Fábio José Paz da Rosa} and {Adriana Fresquet}},
  date = {2024-11-27},
  journaltitle = {Revista Espaço Pedagógico},
  shortjournal = {Revista Espaço Pedagógico},
  volume = {31},
  pages = {e16345-e16345},
  doi = {10.5335/rep.v31.16345},
  url = {https://openalex.org/W4405471397},
  abstract = {O texto analisa a Política Nacional de Educação Digital (PNED) e a Estratégia Nacional de Escolas Conectadas (ENEC), inseridas no contexto da plataformização da educação e do capitalismo de vigilância. Aborda os riscos impostos pelas grandes corporações de tecnologia, que manipulam dados comportamentais para controle e previsão de ações, gerando preocupações sobre a autonomia educacional no Brasil. A PNED busca inserir a educação digital em todos os níveis, mas corre o risco de se subordinar aos interesses das Big Techs. A ENEC visa garantir conectividade para fins pedagógicos, mas destaca a gravidade da hiperconectividade de crianças e adolescentes, especialmente no Brasil, onde o uso de dispositivos móveis é amplamente difundido. Qual o impacto dessas políticas no currículo escolar e na formação docente? A PNED permitirá práticas pedagógicas autônomas em diálogo com as audiovisualidades antirracistas e indígenas ou reforçará a dependência de plataformas digitais, apontando para a necessidade de garantir soberania digital e proteção de dados?},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@thesis{josearlesvegavera2026mucolife,
  title = {Mucolife: Bioherbicida ecológico elaborado a partir del mucílago de café},
  author = {{José Arles Vega Vera} and {Deibis Eduardo Castro Gavalan} and {John Jairo Cortes Bejarano} and {Juan Camilo Chaverra Martínez} and {Oscar de Jesús Leal Flórez}},
  date = {2026-02-18},
  journaltitle = {Institutional Repository of the National University Open and Distance UNAD (Universidad Nacional Abierta y a Distancia)},
  url = {https://openalex.org/W7169820457},
  abstract = {La presente investigación aborda la problemática socioambiental en Santodomingo (Acevedo, Huila) generada por la gestión inadecuada del mucílago de café y el uso generalizado de agroquímicos de alta toxicidad. El objetivo principal fue desarrollar un modelo de negocio social y asociativo para producir Mucolife, un bioherbicida ecológico de absorción superficial y nula toxicidad, obtenido mediante la fermentación anaeróbica de dicho residuo líquido. Metodológicamente, el proyecto se estructuró bajo el enfoque de Design Thinking, facilitando el codiseño de la solución junto a 300 familias caficultoras del sector. El desarrollo experimental contempló una prueba piloto en campo para evaluar la efectividad del insumo en las propiedades del suelo, articulada con una estrategia pedagógica mediante la herramienta lúdica Sikinting para el aprendizaje colaborativo. La viabilidad comercial se determinó a través de un Canvas Social basado en la economía solidaria. Por su parte, el análisis financiero para el año 2026 demostró la sostenibilidad de la bio-fábrica al proyectar una producción de 500 a 700 litros mensuales, respaldando una inversión inicial de \$86.400.000 y alcanzando su punto de equilibrio al séptimo mes de operación. La validación participativa confirmó una elevada aceptabilidad, facilidad de aplicación y pertinencia rural del prototipo. Se concluye que el proyecto viabiliza la transición hacia la economía circular en el sector agropecuario, promoviendo la soberanía tecnológica, el fortalecimiento comunitario y la preservación del patrimonio natural del Huila},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{josecandon-mena2019identidad,
  title = {Identidad colectiva y cultura digital en México: Del EZLN al movimiento \#yosoy132},
  author = {{José Candón-Mena}},
  date = {2019-05-20},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  shortjournal = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  volume = {10},
  number = {18},
  pages = {52--62},
  doi = {10.2123/virtualis.v10i18.268},
  url = {https://openalex.org/W2962638347},
  abstract = {El Neozapatismo y el movimiento \#yosoy132 han destacado en México por el uso de las nuevas tecnologías digitales. Sin embargo, ambos movimientos presentan grandes diferencias en cuanto a su forma de apropiación de las TIC y sus identidades colectivas. Mientras que el EZLN se enmarca como precedente del movimiento altermundista en los llamados Recents Social Movements o Nuevos Movimientos Globales y hace un uso hacktivista de las TIC, el 132 presenta una identidad más transversal y ciudadanista alejada de la identidad izquierdista y militante y hace un uso subversivo de las redes comerciales, con un menor nivel de apropiación tecnológica.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{josecandon-mena2022visionarios,
  title = {Visionarios pragmáticos imaginarios, mitos y tecnopolítica en el movimiento 15M},
  author = {{José Candón-Mena}},
  date = {2022-09-13},
  journaltitle = {Revista Española de Investigaciones Sociológicas},
  shortjournal = {Revista Española de Investigaciones Sociológicas},
  number = {180},
  pages = {47--64},
  doi = {10.5477/cis/reis.180.47},
  url = {https://openalex.org/W4295345563},
  abstract = {Este artículo examina los imaginarios sobre Internet y su influencia en las formas de apropiación tecnológica por parte de los movimientos sociales. Se incide en el concepto de mito, la sublimación digital y la retórica ciberlibertaria que mistifica el poder emancipador de Internet. Mediante un trabajo empírico basado en 37 entrevistas, tres grupos focales y observaciones participantes, se analizan los imaginarios y las prácticas mediáticas del 15M. Nuestros resultados destacan tres tensiones híbridas entre: la fe en el poder democratizador de Internet y la praxis política; la acción complementaria en el espacio virtual y físico; y el uso simultáneo de redes corporativas y medios alternativos. Se concluye que los mitos utópicos sobre Internet son negociados con la realidad de formas complejas e inspiran la acción política y la innovación tecnológica.},
  langid = {spanish},
  keywords = {iberoamericana}
}

