@article{2023notes,
  title = {Notes on {{Contributors}}},
  date = {2023-07-01},
  journaltitle = {Journal of American Ethnic History},
  shortjournal = {Journal of American Ethnic History},
  volume = {42},
  number = {4},
  pages = {135--136},
  doi = {10.5406/19364695.42.4.15},
  url = {https://openalex.org/W4383218234},
  abstract = {Elizabeth Barahona is a fifth-year PhD candidate in History at Northwestern University. Her dissertation chronicles how Black and Latinx communities in Durham, North Carolina created grassroots coalitions to address racial injustice in the form of governmental negligence, increased policing, and racial injustice.Llana Barber is Associate Professor of American Studies at the State University of New York College at Old Westbury. She is the author of Latino City: Immigration and Urban Crisis in Lawrence, Massachusetts, 1945–2000 (University of North Carolina Press, 2017).Jesse David Chariton is a PhD student in the history program at Iowa State University. His dissertation research focuses on nineteenth-century German immigration to the American Midwest. Much of his work examines the intersections of immigration and race/ethnicity through the lens of religion and voluntary associations.J. Marlena Edwards is a scholar of late nineteenth- and early twentieth-century Black transnational migration. She completed her dual doctorate in African American and African Studies and History at Michigan State University in 2018. Her forthcoming manuscript, Oceans Away from My Soul: Cape Verdean and West Indian Community Networks in Early Twentieth-Century New England, examines the lived experiences, community organizing, and homemaking strategies of Black emigrant seamen and families in New Bedford and Providence.Miguel Giron is a doctoral candidate at Northwestern University and the editor for Not From Here, the blog of the Immigration and Ethnic History Society. His research focuses on the urban histories of racial capitalism at the San Diego–Tijuana borderlands in the twentieth century.Nicole Greer Golda is Assistant Professor of History at Ferrum College in Virginia. She received her PhD in the joint program in History and Women's Studies from the University of Michigan. Her work utilizes the border city of Detroit to explore immigration, family order, and the industrial city in the first half of the twentieth century.Jessica Kim is Associate Professor of History at California State University, Northridge, and the author of Imperial Metropolis: Los Angeles, Mexico, and the Borderlands of American Empire, 1865–1941.Kenneth E. Marshall is currently Associate Professor of History at SUNY Oswego. His published essays on slavery and gender have appeared in New Jersey Studies, the Journal of African American History, Slavery \& Abolition, the Journal of American Ethnic History, and Contours: A Journal of the African Diaspora. In 2011, his book titled Manhood Enslaved: Bondmen in Eighteenth- and Early Nineteenth-Century New Jersey was published by the University of Rochester Press (Gender and Race in American History series).Lisa Munro is an independent scholar and member of the National Coalition of Independent Scholars. She holds a PhD in modern Latin American history from the University of Arizona (2015). Her scholarship focuses on US imperialism within the cultural relationships between the United States and Latin America.Jessica Ordaz is Assistant Professor of Ethnic Studies at the University of Colorado Boulder. She received her doctorate from the University of California Davis in American History. Her first book, The Shadow of El Centro: A History of Migrant Incarceration and Solidarity, was released in March 2021.Fernando Ortiz, Jr. is managing editor of Texas Public Radio in San Antonio. He holds a BA from the University of Texas at Austin and an MA from the University of Texas at San Antonio, both in US history. He has also taught the subject at four colleges and universities in the Alamo City.Michael E. Staub is Professor of English and Director of American Studies at Baruch College, CUNY. His books include Torn at the Roots: The Crisis of Jewish Liberalism in Postwar America (Columbia University Press, 2002), Madness Is Civilization: When the Diagnosis Was Social, 1948–1980 (University of Chicago Press, 2011), and The Mismeasure of Minds: Debating Race and Intelligence Between Brown and The Bell Curve (University of North Carolina Press, 2018). He is currently writing a history of anti-environmental thought in the United States since 1965.Thong M. Trinh is an Edwin J. O'Leary Fellow and currently pursuing a doctorate at the University of Illinois Urbana-Champaign. His research interest is Higher Education Policy with a focus on Finance. Thong has published in the areas of student willingness to pay, university budgeting, and related topics of higher education policy.Luther Young, Jr., is a PhD candidate in the Department of Sociology at The Ohio State University. He holds a BS from Belmont University, MDiv from Vanderbilt University, and MA from The Ohio State University. His research examines intersections of race, gender, sexuality, and religion and has been published in Sociology of Religion.},
  langid = {english},
  keywords = {inglesa}
}

@article{2025identisic,
  title = {IdentiSIC 2024: la identidad protegida y amparada por el IDAS2, NIS2 y DORA, catalizadora de la transformación digital viable},
  shorttitle = {IdentiSIC 2024},
  date = {2025},
  journaltitle = {Revista SIC: ciberseguridad, seguridad de la información y privacidad},
  volume = {34},
  number = {163},
  pages = {176--182},
  publisher = {Ediciones CODA},
  issn = {1136-0623},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9997480},
  urldate = {2026-11-13},
  abstract = {Una vez más, IdentiSIC, el congreso de referencia sobre la gestión y protección de la identidad, ha mostrado cómo ésta es, aún más si cabe, determinante para la transformación digital factible, y evidenciando asimismo los nada triviales retos para propiciar tecnológicamente su exitosa viabilidad. A ello se suma el delicado panorama geopolítico, donde sus principales actores se aprestan a librar una batalla, sin duda colosal, por dominar esta faceta de la protección cuyas derivadas se antojan golosas para todos los actores en pos de la soberanía tecnológica en este litigio cibernético planetario. Así pues, el evento convocó a destacados referentes en este ámbito, como Julián Inza y Paloma Llaneza, quienes mostraron el estado del arte y los retos que supondrá poner en marcha, de forma segura, la cartera digital europea en 2026. Además, se ofreció una interesante propuesta, por parte de PwC, sobre la importancia de contar con métricas y automatización, a la que se sumaron exposiciones de los distintos enfoques tecnológicos de última generación por parte de grandes referentes como Cisco, Okta, Omada, Opentext y SIA, también copatrocinadores del congreso.},
  langid = {spanish}
}

@article{2025impulso,
  title = {Impulso urgente para la industria española: El camino hacia un futuro sostenible y resiliente},
  shorttitle = {Impulso urgente para la industria española},
  date = {2025},
  journaltitle = {Revista DYNA},
  volume = {100},
  number = {4},
  pages = {292--292},
  publisher = {Publicaciones DYNA SL},
  issn = {0012-7361, 0012-7361},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10345645},
  urldate = {2026-11-13},
  abstract = {En 2020, la Comisión Europea fijó un objetivo crucial: que el Producto Interior Bruto (PIB) del sector industrial alcanzara el 20\% del PIB total de la Unión. Esta meta es fundamental para la competitividad, soberanía tecnológica y autonomía estratégica de Europa. Lamentablemente, el sector industrial español aún está lejos de este propósito. En un contexto global de incertidumbre, escasez de recursos y urgencia climática, reforzar nuestra base industrial es una necesidad imperiosa. No buscamos volver al pasado, sino construir una industria del futuro: más sostenible, digitalizada y resiliente.},
  langid = {spanish}
}

@book{2026panorama,
  title = {Panorama Estratégico 2026},
  date = {2026},
  publisher = {Instituto Español de Estudios Estratégicos},
  url = {https://dialnet.unirioja.es/servlet/libro?codigo=1026026},
  urldate = {2026-11-13},
  abstract = {Vivimos una transición acelerada a un orden mundial muy diferente al que alumbró la Segunda Guerra Mundial. Se trata de uno de esos momentos de transformación vertiginosa que solo ocurren cada muchos años. Esta nueva edición del Panorama Estratégico ofrece una mirada desde España para diagnosticar la entrada en una era geopolítica nueva. Asimismo, en la medida de lo posible, se elaboran pronósticos que permiten anticipar los cambios políticos, económicos, tecnológicos y sociales en marcha. La pregunta que recorre esta obra es cómo condicionarán la toma de decisiones de Gobiernos y otros actores internacionales en ámbitos como la seguridad y la defensa, el desarrollo económico y tecnológico o la defensa de la democracia y los derechos humanos. Es una obra coral y rigurosa, en la que cada autor o autora es responsable de sus opiniones y argumentos. La suma de distintas voces y miradas cristaliza en un análisis reposado y de luces largas, algo nada sencillo de hacer, pero cada vez más urgente y necesario.  Antes de actuar siempre es necesario dar un paso atrás y entender la realidad. Confiamos en que esta obra sea una contribución sosegada y de luces largas desde España a la reflexión sobre un mundo que atraviesa profundas transformaciones. Siempre es necesario dar un paso atrás y entender la realidad en la que se opera antes de actuar, pero todavía más en tiempos de gran incertidumbre y amenazas crecientes. En este nuevo tiempo, el imperativo de defender intereses y promover valores democráticos es acuciante. Solo si disponemos de mapas de la realidad como los que dibuja esta publicación será posible hacerlo y navegar con buen rumbo y seguridad la geopolítica de la incertidumbre.},
  langid = {spanish}
}

@book{2026tensiones,
  title = {Tensiones y perspectivas interdisciplinarias de la educación en México: Miradas desde los territorios, las diversidades y las prácticas educativas},
  date = {2026-09-01},
  doi = {10.65446/c7kurwo0},
  url = {https://openalex.org/W7225807247},
  abstract = {¿Qué significa construir una educación justa en un país marcado por profundas diferencias sociales, culturales, territoriales y educativas? La educación mexicana atraviesa un escenario de transformaciones en el que las desigualdades persistentes conviven con nuevas formas de diversidad, movilidad, inclusión y apropiación tecnológica. En este contexto, comprender los problemas educativos exige ir más allá de explicaciones homogéneas y reconocer las condiciones concretas en las que estudiantes, docentes, comunidades e instituciones construyen sus trayectorias. Tensiones y perspectivas interdisciplinarias de la educación en México reúne investigaciones que exploran estas complejidades desde distintas perspectivas teóricas, metodológicas y disciplinares. Sus páginas abordan la educación rural y multigrado, la Nueva Escuela Mexicana, la interculturalidad, las literacidades, la inclusión, la discapacidad, las desigualdades de género, las diversidades, las transformaciones tecnológicas y las trayectorias educativas transnacionales. Más que ofrecer respuestas definitivas, esta obra propone preguntas necesarias: ¿cómo articular referentes educativos comunes con realidades profundamente diversas?, ¿cómo transformar las condiciones que producen exclusión?, ¿cómo reconocer los saberes y experiencias de quienes participan en los procesos educativos? Es este un libro para quienes buscan comprender la educación mexicana desde su complejidad y para quienes consideran que educar implica también cuestionar las condiciones sociales, culturales e institucionales que hacen posible, o limitan, el derecho a aprender.},
  langid = {spanish},
  keywords = {iberoamericana}
}

