@article{universidadautonomadequeretaro2021public,
  title = {Public Policy for the Appropriation of {{ICT}} in Organizations in {{Mexico}}: The Case of {{Prosoft}}},
  author = {{Universidad Autónoma de Querétaro} and {Raúl Arturo Alvarado López}},
  date = {2021-02-26},
  journaltitle = {PAAKAT Revista de Tecnología y Sociedad},
  shortjournal = {PAAKAT Revista de Tecnología y Sociedad},
  volume = {11},
  number = {20},
  pages = {1--22},
  doi = {10.32870/pk.a11n20.577},
  url = {https://openalex.org/W3138435875},
  abstract = {The objective of the article is to analyze the impulse to the appropriation of Information and Communication Technologies (ICT) at the organization level through the application of the public policy called Program for the Development of the Software Industry and Innovation (Prosoft, by its acronym in Spanish), created in Mexico since 2004. The methodology is an exploratory-descriptive analysis supported by secondary information, based on some available results of the program and the certifications of the beneficiaries, in addition to basing it on a theoretical-conceptual framework on the economy of innovation. The results indicate that Prosoft, as a public policy, has managed to promote innovation activities in the ICT sector in Mexico, which has favored the processes of technological appropriation in both the public and private sectors, which is based on learning activities and construction of technological capabilities.},
  langid = {english},
  keywords = {inglesa}
}

@article{universidaddechile2016telegrafia,
  title = {De telegrafía sin hilos a radiodifusión: Apropiación tecnológica de la radio en Chile, 1901-1931},
  author = {Universidad de Chile, Chile, Santiago and {C Mauricio Quezada} and {Martin Andrés Pérez Comisso} and Universidad de Chile, Chile, Santiago},
  date = {2016-01-01},
  journaltitle = {Revista de Historia Iberoamericana},
  shortjournal = {Revista de Historia Iberoamericana},
  volume = {9},
  number = {1},
  pages = {103--125},
  doi = {10.3232/rhi.2016.v9.n1.05},
  url = {https://openalex.org/W2509964446},
  abstract = {¿Cómo fue la historia tecnológica que da origen a la radio en Chile? A partir de la aproximación por medio de un nuevo modelo de apropiación tecnológica, este trabajo explora la transformación de la telegrafía sin hilos hacía de la radiofonía en Chile, desde 1901 hasta 1931. Inicialmente se describe un modelo racional de apropiación tecnológica, que explica conceptualmente la aproximación utilizada. Con esta perspectiva se narra el proceso sociotécnico anterior a la primera transmisión radial de 1922, en el cual ocurre la apropiación de la telegrafía sin hilos y su evolución a la radiofonía. Finalmente, a través de una metodología propuesta para examinar la apropiación tecnológica en grupos sociales del pasado, se discute la apropiación tecnológica de la radiofonía y se explicitan las ventajas de analizar la apropiación de una tecnología en un grupo social del pasado, junto con el uso del modelo racional de apropiación tecnológica en estudios históricos de la tecnología.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{universidaddelafrontera2024appropriation,
  title = {Appropriation Process of Digital Technologies by Rural Drinking Water Committees in the Region of {{La Araucanía}}, {{Chile}}},
  author = {Universidad de la Frontera, Chile and {Marco Rosas Leutenegger} and {Oscar Vivallo Urra} and Universidad de la Frontera, Chile and {Paulette Dougnac Quintana} and Universidad de la Frontera, Chile},
  date = {2024-02-27},
  journaltitle = {PAAKAT Revista de Tecnología y Sociedad},
  shortjournal = {PAAKAT Revista de Tecnología y Sociedad},
  volume = {14},
  number = {26},
  pages = {1--25},
  doi = {10.32870/pk.a14n26.840},
  url = {https://openalex.org/W4392388868},
  abstract = {While the coverage of potable water in rural areas has significantly increased in Chile, challenges persist in ensuring its quality, quantity, and continuity. This has required cooperatives and committees providing this service to engage in projects aimed at improving aspects associated with their management, such as transferring technologies that enable data-driven decision-making. The general objective of this study was to understand the obstacles and facilitators involved in the process of transferring a telemetry system by rural sanitary services, using a conceptual approach composed of three perspectives: sociotechnical systems, technological appropriation, and territorial governance. Information was collected through semi-structured interviews with leaders of rural drinking water committees in the La Araucanía region who have been involved in digital technology projects. The adopted theoretical perspectives, as well as the methodology used in this article, indicate that the appropriation of digital technologies by rural drinking water committees should be understood as a complex, territorial, systemic, multi-agent, and multilevel process.},
  langid = {english},
  keywords = {inglesa}
}

@article{universidaddelrosario2018tic,
  title = {LAS TIC EN LOS ENTORNOS EDUCATIVOS. UN ESTUDIO SOBRE LOS HÁBITOS COMUNICACIONALES DE LOS JÓVENES UNIVERSITARIOS DE BOGOTÁ (COLOMBIA) Y GUARANDA (ECUADOR)},
  author = {{Universidad del Rosario} and {Daniel Barredo Ibáñez} and {F. Rodríguez Arellano} and {Karen Pinto} and {Universidad Estatal de Bolívar} and {Universidad Técnica Particular de Loja}},
  date = {2018-12-01},
  journaltitle = {Revista de Investigación Enlace Universitario},
  shortjournal = {Revista de Investigación Enlace Universitario},
  volume = {17},
  number = {1},
  pages = {25--29},
  doi = {10.33789/enlace.17.37},
  url = {https://openalex.org/W2920890388},
  abstract = {RESUMENLas TIC, en los últimos años, se han ido desarrollando como un factor clave dentro del relacionamiento de los jóvenes universitarios, al canalizar la interacción de dichos jóvenes con la esfera pública y con sus entornos sociales y afectivos.Dentro de ese proceso, cobra especial relevancia el estímulo del uso que promueven las instituciones educativas, las cuales tienden a incorporar estas plataformas tecnológicas, sea como recursos de apoyo a los procesos de enseñanza y aprendizaje, sea como espacios de difusión y participación social.Con este estudio, presentamos un trabajo comparativo entre los hábitos comunicacionales de los jóvenes universitarios en dos entornos urbanos: Bogotá (Colombia) y Guaranda, capital de la provincia de Bolívar (Ecuador).Los resultados coinciden con los obtenidos por otros autores, al observar una implementación irregular de las TIC, en tanto que la disponibilidad de las conexiones y los dispositivos de acceso no bastan para impulsar una profundización de los hábitos comunicacionales de los jóvenes, sino que hay que revisar otros aspectos, como los grados de apropiación tecnológica de los docentes o la adecuación de los procesos al interior de las universidades, entre otros.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{universidaddemedellin2015ruralidad,
  title = {Ruralidad y dispositivos móviles: apropiación social y uso de la Tableta de Información Cafetera TIC. Estudio de caso Federación Nacional de Cafeteros para Antioquia},
  author = {{Universidad de Medellín} and {María Isabel Zapata Cárdenas} and {Beatriz Elena Marín Ochoa} and {Universidad Pontificia Bolivariana}},
  date = {2015-01-01},
  journaltitle = {Revista Lasallista de Investigación},
  shortjournal = {Revista Lasallista de Investigación},
  volume = {12},
  number = {2},
  pages = {19--27},
  doi = {10.22507/rli.v12n2a2},
  url = {https://openalex.org/W2255981492},
  abstract = {Introduction. The incursion of ICT´s, by the \textbackslash nnational government, has put in a public scenario \textbackslash nthe relationship between information, consumption \textbackslash nand technology appropriation in the rural Colombian \textbackslash nsector. Today, productivity and daily life if rural areas \textbackslash nare related with the digital activities and practices. \textbackslash nObjective. Identify the use and the appropriation of \textbackslash n“ICT tablets” in Antioquian coffee production towns.Materials and methods. The study is classified \textbackslash nas qualitative, as it aims to comprise an outlook of \textbackslash ndata, information and results that involve rural daily \textbackslash nlife, experiences and human relationships proper \textbackslash nof the Antioquian coffee farmers and the use they \textbackslash nmake of the ICT tablet devices. Meetings with focus \textbackslash ngroups and conversations in rural places were made, \textbackslash nthus evaluating and getting to know the program \textbackslash nfrom the cultural and social characteristics of the \textbackslash nfarmers. Focused interviews were also made, and a \textbackslash ncontent analysis instrument was designed to revise \textbackslash nthe tablet´s contents and applications related to \textbackslash ncoffee farming topics. Results. 1) The dimensions \textbackslash nof social appropriation of technology from the \textbackslash naccess, competencies, digital literacy and gender \textbackslash nequality in the use, were demonstrated according \textbackslash nto the UNESCO´s ICT appropriation parameters. 2) \textbackslash nThe assimilation of technology is not incompatible \textbackslash nwith the daily experience of coffee farmers. The \textbackslash nrelationship is mutual, round, the device and the rural \textbackslash nnecessities coexist in harmony. Conclusion. The ICT \textbackslash nappropriation levels achieved by coffee farmers are \textbackslash nhigh, especially in those who assume the challenge of \textbackslash novercome fear, inexperience and lack of technological \textbackslash nknowledge. They do want to add these technologies \textbackslash nto their daily lives. The fact that most of coffee farmers \textbackslash nhave cellular phones and consider the “Coffee \textbackslash nTablet” as a valuable element for their lives and for \textbackslash ntheir families, is a valuable opportunity to boost rural \textbackslash ndevelopment and production with the use of ICT.},
  langid = {spanish},
  keywords = {inglesa}
}

@article{universidaddemedellin2017priority,
  title = {Priority Technologies and Innovations in the Fishing Agribusiness by the Year 2032. {{Foresight}} Study through the {{Delphi}} Method},
  author = {{Universidad de Medellín} and {Juan Manuel Montes Hincapié} and {Elva Esther Vargas Martínez} and {Universidad Autónoma del Estado de México} and {José Luís Hoyos Concha} and {Universidad de Cauca} and {Juan Carlos Palacio Piedrahíta} and {Universidad Pontificia Bolivariana} and {Juan Francisco Acevedo Rincón} and {Fundación Tecnológica Rural Coredi –FUNTEC} and {Gloria Liliana Rojas Fernández} and {Universidad del Cauca} and {Jhon Wilder Zartha Sossa} and {Universidad Pontificia Bolivariana}},
  date = {2017-01-01},
  journaltitle = {Revista Lasallista de Investigación},
  shortjournal = {Revista Lasallista de Investigación},
  volume = {14},
  number = {2},
  pages = {105--120},
  doi = {10.22507/rli.v14n2a10},
  url = {https://openalex.org/W2794468269},
  abstract = {Introduction. This paper is presented in the framework of the project "Alternatives for the use of by-products derived from fishing agribusiness", Universidad del Cauca, through the research group: Harvesting of Byproducts and Agro-industrial Residues, ASUBAGROIN, which aims at the development and implementation of technologies and innovations for the use of by-products generated by the fishery activity, in order to improve research and innovation capacities in that specific subsector. Objective. The purpose of this paper is to prioritize innovations in fish by-products by consulting experts to identify innovation, technology and knowledge management activities for the institutions involved in the sector. Materials and methods. The methodology consisted in the application of the Delphi method through a structured and anonymous survey with national and international experts on topics related to the fish farming industry, using a questionnaire of 143 items divided in five groups, in order to choose priority topics. Results. The questionnaires were filled out by 37 experts from Colombia, Brazil, the United States, Mexico and Uruguay; a total of 54 priority themes were obtained, corresponding to 38 \% of the topics presented. Among the topics of greatest consensus and mode are the formulation of concentrated foods, partial substitution of fishmeal, extrusion of concentrated foods, Omega-3 rich oil, probiotics, bioaccumulation, microalgae of fish processing wastewater, technological appropriation, technological evaluation, measurement of intellectual capital, innovation processes, and technological strategies. Conclusions. One of the main contributions of the study is the benefit for current players in the fish innovation system and new ones, such as technology development centers and new ventures, since they will have a route map of innovations on which to focus their investments and project initiatives.},
  langid = {english},
  keywords = {inglesa}
}

@article{universidadjuarezautonomadetabasco2022apropiacion,
  title = {La apropiación tecnológica infantil. Un ecosistema tecno-educativo en la escuela comunitaria},
  author = {{Universidad Juárez Autónoma de Tabasco} and {Flor de Líz Pérez Morales} and {Diana del Carmen Madrigal Castellanos}},
  date = {2022-12-21},
  journaltitle = {Diálogos sobre educación},
  shortjournal = {Diálogos sobre educación},
  volume = {0},
  number = {26},
  doi = {10.32870/dse.v0i26.1182},
  url = {https://openalex.org/W4313492385},
  abstract = {En nuestros días se admite que el conocimiento se ha convertido en objeto de inmensos desafíos; esto posibilita políticas de inclusión digital cada vez más presentes en las agendas educativas que se traduce en proyectos de equipamiento de dispositivos digitales y diversos esfuerzos pedagógicos por integrar la tecnología como una herramienta didáctica que garantice una educación útil para la vida. Lo anterior, propicia reflexiones respecto al Programa de Inclusión y Alfabetización Digital (PIAD) y el escenario social que se planteó para su operatividad en las comunidades de Tabasco. Emerge así la interrogante como un punto de partida que explora en ese escenario y señala: ¿Qué tipo de apropiación tecnológica tienen los niños de primaria de comunidades marginadas de Tabasco a partir de su interacción con los recursos tecnológicos? Estudiar este territorio social implicó señalar un objetivo que permitiera analizar las prácticas tecnológicas que desarrollan los niños de primaria de comunidades marginadas de Tabasco a partir de su interacción con el PIAD; esto provocó una discusión conceptual sobre la cultura educativa y las prácticas tecnológicas que conducen a la comprensión de la Apropiación Tecnológica. El trayecto trazado es una perspectiva heurística fundamentada en un estudio de caso, sobre el que se focaliza un sistema de relaciones que encuentra su mejor ángulo explicativo en la trandisciplinariedad del conocimiento. Las acciones o tareas que los niños y niñas propician en su relación con la tecnología adquieren el carácter de apropiación exploratoria, institucional e informacional, niveles con los que se responde a la interrogante que moviliza el estudio que toma forma en lo que aquí se denomina ecosistema tecno-educativo.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{urdaneta2023sensormov,
  title = {SensorMov, biblioteca nativa para interacciones tangibles con dispositivos Android},
  author = {Urdaneta, Camilo and Rodríguez-Almanza, Julián and Cortés-Rico, Laura},
  date = {2023-04},
  journaltitle = {TecnoL.},
  shortjournal = {TecnoL.},
  volume = {26},
  number = {56},
  issn = {0123-7799},
  doi = {10.22430/22565337.2446},
  url = {http://www.scielo.org.co/scielo.php?script=sci_arttext&pid=S0123-77992023000100207&lang=pt},
  abstract = {Abstract The study presented in this paper aimed to contribute to the Spanish-speaking mobile developer community with a set of free programming tools, documentation, and examples to create tangible user interfaces with smartphones. These interfaces allow diversifying interactions with mobiles, prioritizing alternative uses of their sensors. The development of this set of tools occurred within the framework of a research project that sought to promote the dialogue of knowledge between engineering and traditional textile knowledge. The project used a participatory design methodology that involved diverse actors in different stages: self-recognition and mutual recognition, ideation, prototyping, and experimentation. As a result, we present a review of references on mobile devices and tangible interfaces, highlighting those mobile interactions that use physical objects and gestural actions; a technical description of SensorMov: its architecture and the specific design and, finally, its preliminary evaluation through a case study and an academic project. The library understands the tangible as the mobile itself or passive physical objects that do not require electrical power, such as magnets. In this sense, the documented version of SensorMov allowed working with raw data from the sensors, identifying objects and positions according to the static magnetic field of physical objects, and identifying and positioning physical objects on the mobile screen. The main challenge for the future is to enable appropriation spaces that facilitate and extend the library's use and functionalities, creating a community around it.},
  langid = {spanish},
  keywords = {Android Applications,Aplicaciones Android,Interfaces Tangibles de Usuario,Mobile Technologies,Open Software,Software Libre,Tangible User Interface,Tecnologías Móviles}
}

@article{urielesguerrero2022tic,
  title = {Las TIC en la Educación: entre la apropiación tecnológica y la mediación pedagógica},
  shorttitle = {Las TIC en la Educación},
  author = {Urieles Guerrero, Alejandro},
  date = {2022},
  journaltitle = {Revista de Ciencias de la Educación, Docencia, Investigación y Tecnologías de la Información: CEDOTIC},
  volume = {7},
  number = {1},
  pages = {9--13},
  publisher = {Universidad del Atlántico},
  issn = {2539-1518},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8889808},
  urldate = {2026-11-13},
  abstract = {Covid-19 had a profound impact on all areas of human life. The tenth issue of the CEDOTIC magazine is published in this transcendental period of change towards face-to-face activities. In this sense, the issue of transformations in the field of education turns out to be a recurring topic given that, due to social isolation, remote information and communication technologies gained critical relevance by allowing educational processes to continue. Accordingly, we decided to dedicate a large part of this space during 2022 to the dissemination of experiences, research and reflections on innovations, didactics, technological applications and pedagogies implemented to overcome this challenge that undoubtedly still keeps communities and institutions busy. in the adjustment and implementation of systems that combine face-to-face sessions with remote classes. El Covid-19 produjo un profundo impacto en todos los ámbitos de la vida humana. El décimo número de la revista CEDOTIC se publica en este periodo trascendental de cambio hacia las actividades presenciales. En ese sentido el tema de las transformaciones en la esfera de la educación resulta ser un tópico recurrente dado que, por cuenta del aislamiento social, las tecnologías remotas de la información y las comunicaciones cobraron una relevancia crítica al permitir que los procesos educativos siguieran adelante. En consonancia, decidimos dedicar buena parte de este espacio durante el 2022 a la divulgación de experiencias, investigaciones y reflexiones en torno a las innovaciones, didácticas, aplicaciones tecnológicas y pedagogías implementadas para superar este desafío que sin duda aún mantiene a las comunidades e instituciones ocupadas en el ajuste e implementación de sistemas que combinen las jornadas presenciales con las clases remotas. O Covid-19 teve um impacto profundo em todas as áreas da vida humana. A décima edição da revista CEDOTIC é publicada neste período transcendental de mudança para as atividades presenciais. Nesse sentido, a questão das transformações no campo da educação torna-se um tema recorrente, visto que, devido ao isolamento social, as tecnologias de informação e comunicação remotas ganharam relevância crítica ao permitirem a continuidade dos processos educacionais. Nesse sentido, decidimos dedicar grande parte deste espaço durante 2022 à divulgação de experiências, pesquisas e reflexões sobre inovações, didáticas, aplicações tecnológicas e pedagogias implementadas para superar esse desafio que, sem dúvida, ainda mantém comunidades e instituições ocupadas. implementação de sistemas que combinam sessões presenciais com aulas remotas.},
  langid = {spanish}
}

