@article{ruizaguilar2026sistemas,
  title = {Sistemas bioenergéticos rurales como mediadores del diseño e innovación socioambiental y autonomía energética},
  author = {Ruiz Aguilar, Graciela M. L. and Camarena Martínez, Sarai and Alejo López, Sergio Jacinto and Núñez Palenius, Héctor G.},
  date = {2026},
  journaltitle = {Cuadernos del Centro de Estudios en Diseño y Comunicación. Ensayos},
  number = {322},
  pages = {153--166},
  publisher = {Universidad de Palermo (UP)},
  issn = {1853-3523, 1668-0227},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10783967},
  urldate = {2026-11-13},
  abstract = {This study examines the role of design as a mediator between science, technology, and rural communities in the implementation of geomembrane tubular biodigesters in the state of Guanajuato, Mexico. Adopting a qualitative and transdisciplinary approach, it combined participatory co-design processes, technical analysis of anaerobic digestion, and systematization of field experiences. The results show that, in general, contextually designed biodigesters achieved methane concentrations ranging from 56.9\% to 67.4\%, with an average yield of 0.21 m³ CH₄/kg of volatile solids, confirming their efficiency and adaptability. At the same time, the active involvement of producers and researchers fostered technological appropriation, organic waste valorization, and collective learning processes. It is concluded that design, when integrated with environmental biotechnology and education for sustainability, functions as a translation device between scientific knowledge and local wisdom, consolidating a model of social innovation that promotes energy autonomy, territorial resilience, and the transition toward a circular bioeconomy. El presente estudio analiza el papel del diseño como mediador entre la ciencia, la tecnología y las comunidades rurales en la implementación de biodigestores tubulares de geomembrana en el estado de Guanajuato, México. Bajo un enfoque cualitativo y transdisciplinar, se combinaron procesos de co-diseño participativo, análisis técnico de la digestión anaerobia y sistematización de experiencias de campo. Los resultados muestran que, de manera general, los biodigestores diseñados de manera contextual alcanzaron concentraciones de metano entre 56.9 \% y 67.4 \%, con un rendimiento promedio de 0.21 m³ CH₄/kg de sólidos volátiles, confirmando su eficiencia y adaptabilidad. Paralelamente, la participación de productores e investigadores favoreció la apropiación tecnológica, la valorización de residuos orgánicos y la generación de aprendizajes colectivos. Se concluye que el diseño, al integrarse con la biotecnología ambiental y la educación para la sostenibilidad, actúa como un dispositivo de traducción entre el conocimiento científico y saber local, consolidando un modelo de innovación social que promueve la autonomía energética, la resiliencia territorial y la transición hacia una bioeconomía circular. O presente estudo analisa o papel do design como mediador entre a ciência, a tecnologia e as comunidades rurais na implementação de biodigestores tubulares de geomembrana no estado de Guanajuato, México. Sob uma abordagem qualitativa e transdisciplinar, combinaram-se processos de co-design participativo, análise técnica da digestão anaeróbia e sistematização de experiências de campo. Os resultados mostram que, de modo geral, os biodigestores concebidos de forma contextual alcançaram concentrações de metano entre 56,9\% e 67,4\%, com um rendimento médio de 0,21 m³ CH₄/kg de sólidos voláteis, confirmando sua eficiência e adaptabilidade. Paralelamente, a participação de produtores e pesquisadores favoreceu a apropriação tecnológica, a valorização dos resíduos orgânicos e a geração de aprendizagens coletivas. Conclui-se que o design, ao integrarse com a biotecnologia ambiental e a educação para a sustentabilidade, atua como um dispositivo de tradução entre o conhecimento científico e o saber local, consolidando um modelo de inovação social que promove a autonomia energética, a resiliência territorial e a transição para uma bioeconomia circular.},
  langid = {spanish}
}

@article{ruizvazquez2025importancia,
  title = {La importancia geopolítica de las infraestructuras digitales: cables submarinos de datos},
  shorttitle = {La importancia geopolítica de las infraestructuras digitales},
  author = {Ruiz Vázquez, Andrés Jesús},
  date = {2025},
  journaltitle = {Revista de Investigación CUGC},
  number = {27},
  pages = {937--1036},
  publisher = {Centro Universitario de la Guardia Civil (CUGC)},
  issn = {2444-6556},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10771529},
  urldate = {2026-11-13},
  abstract = {This Master's investigation analyzes the growing geopolitical importance of digital infrastructures, with special focus on submarine data cables, which carry more than 95\% of international information traffic. Through a multidisciplinary approach, it examines how these infrastructures —together with data centers, 5G networks, satellites, and cloud services — have become strategic assets that directly impact the digital sovereignty, National Security, and technological autonomy of States. Este Trabajo Fin de Máster analiza la creciente importancia geopolítica de las infraestructuras digitales, con especial atención a los cables submarinos de datos, que transportan más del 95\% del tráfico internacional de información. A través de un enfoque multidisciplinar, se estudia cómo estas infraestructuras -junto con centros de datos, redes 5G, satélites, y servicios en la nube- se han convertido en activos estratégicos que afectan directamente a la soberanía digital, la Seguridad Nacional y la autonomía tecnológica de los Estados.},
  langid = {spanish}
}

@article{ruthb.rodriguez2026responsible,
  title = {Responsible {{AI}}, {{Digital Intellectual Property}}, and the {{Creative Economy}} in the {{Global South}}: {{A Scoping Review}} of {{Policy Frameworks}} and {{Ethical Guardrails}}},
  author = {{Ruth B. Rodriguez}},
  date = {2026-01-01},
  journaltitle = {SSRN Electronic Journal},
  shortjournal = {SSRN Electronic Journal},
  doi = {10.2139/ssrn.7357743},
  url = {https://openalex.org/W7204207827},
  abstract = {The rapid diffusion of generative artificial intelligence (AI) has intensified longstanding tensions between innovation, intellectual property (IP) protection, and equitable participation in the global creative economy. These tensions are especially acute in the Global South, where creators, cultural institutions, and regulators confront governance frameworks largely authored in the Global North while seeking to protect indigenous knowledge, traditional cultural expressions, and nascent creative industries from data extraction and value capture. This scoping review, conducted in accordance with the PRISMA-ScR guidelines, maps the landscape of responsible AI principles, digital IP frameworks, and ethical guardrails as they pertain to the creative economy across Africa, Latin America and the Caribbean, and South and Southeast Asia. Drawing on peer-reviewed literature, multilateral policy instruments, and grey literature published between January 2018 and mid-2026, the review organizes findings around five themes: the adaptation gap between universalist AI ethics and Global South institutional capacity; authorship, ownership, and text-and-data-mining controversies; sectoral impacts on creative industries; the political economy of data colonialism; and emergent regional and national frameworks that attempt to localize global norms. The review identifies significant capacity asymmetries, limited empirical evidence on economic impacts, and the inadequate fit of individual-authorship copyright paradigms with collectively held traditional cultural expressions. It concludes with policy recommendations oriented toward contextually grounded ethical guardrails that strengthen digital sovereignty while enabling beneficial AI use by Global South creators.},
  langid = {english},
  keywords = {inglesa}
}

@article{ruthgreszyzyndelima2011necessidades,
  title = {Necessidades e uso de informação em empresas incubadas de base tecnológica em Curitiba e Região Metropolitana},
  author = {{Ruth Greszyzyn de Lima}},
  date = {2011-01-01},
  journaltitle = {Repositório Digital Institucional da UFPR (Universidade Federal do Paraná)},
  shortjournal = {Repositório Digital Institucional da UFPR (Universidade Federal do Paraná)},
  url = {https://openalex.org/W2737130214},
  abstract = {Resumo: Pesquisa descritiva com abordagem qualitativa sobre necessidades e uso de informação em empresas incubadas de base tecnológica em Curitiba e região metropolitana. Analisa as necessidades e os usos de informação para empreendedores de empresas incubadas de base tecnológica na cidade de Curitiba e região metropolitana. Adota como instrumento de coleta de dados - questionários aplicados em 3 empresas incubadas de base tecnológica na Incubadora de Base tecnológica (INTEC) no TECPAR. Utiliza a análise de conteúdo, realizada a partir de categorias estabelecidas a priori. Identifica como necessidades e uso de informação dos empreendedores das empresas incubadas de base tecnológica de Curitiba e Região Metropolitana: expectativas dos empreendedores com relação às Incubadoras; exigências formais e legais para empresas em estágio inicial de desenvolvimento, informações sobre clientes, aspectos referentes a fontes de financiamentos, produtos e serviços de informação, aspectos tecnológicos, competitivos, comerciais e ambientais, assim como, necessidades de apropriação tecnológica com o uso de patentes para registro de seus produtos e utilização destas para a evoluir os seus negócios e ter diferencial competitivo no mercado. Conclui que as empresas em fase de incubação utilizam diversos produtos ou serviços de informação para negócios, que necessitam de consultas a base de dados, estudos de viabilidade dentre outros produtos ou serviços de informação para negócios. Infere com base na pesquisa que há demanda de produtos e serviços de informação e, portanto, há possibilidade de colocação do Gestor da Informação em empresas incubadas.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{ruthisabelzhinincochancela2026competencia,
  title = {Competencia digital docente y metodologías activas en las áreas humanísticas y artísticas},
  author = {{Ruth Isabel Zhiñin Cochancela} and {Elena del Rocio Rivera Huanca} and {Davis Andrey Paccha Guanuche} and {Luz Ercilia Pizarro Flores}},
  date = {2026-10-09},
  journaltitle = {SAGA Revista Científica Multidisciplinar},
  shortjournal = {SAGA Revista Científica Multidisciplinar},
  doi = {10.63415/saga.v3i4.487},
  url = {https://openalex.org/W7221350932},
  abstract = {La transformación educativa demanda competencias digitales docentes orientadas a integrar tecnologías y metodologías activas en la enseñanza de las humanidades y las artes, favoreciendo experiencias de aprendizaje participativas, creativas e interdisciplinarias. Objetivo: Analizar la producción científica reciente sobre competencia digital docente y metodologías activas aplicadas a las áreas humanísticas y artísticas, identificando enfoques pedagógicos, recursos tecnológicos, resultados educativos y oportunidades de mejora. Metodología: Se desarrolló una revisión bibliográfica orientada por los criterios PRISMA 2020, mediante una matriz documental de publicaciones académicas del período 2021–2026. El corpus preliminar reunió 32 registros, con cuatro duplicados identificados y 28 referencias únicas, clasificadas según diseño metodológico, procedencia geográfica y pertinencia temática. Resultados: La literatura examinada aborda competencias tecnológicas y pedagógicas, narrativas digitales, aprendizaje basado en proyectos, gamificación, aula invertida y experiencias interdisciplinarias. Las investigaciones latinoamericanas aportan perspectivas sobre formación docente, innovación educativa y apropiación tecnológica. Se identificaron diferencias entre los enfoques investigativos y una representación limitada de intervenciones específicamente artísticas y humanísticas. Conclusiones: La articulación entre competencia digital docente y metodologías activas constituye una línea pertinente para fortalecer la innovación pedagógica. Se requiere ampliar la evidencia empírica, evaluar resultados de aprendizaje y documentar experiencias disciplinares mediante procedimientos sistemáticos verificables y reproducibles.},
  langid = {spanish},
  keywords = {iberoamericana}
}

