@article{igorradtkebederode2024processos,
  title = {Processos de ensino e aprendizagem apoiados pelo uso criativo da tecnologia digital, um caminho imprescindível para os professores contemporâneos},
  author = {{Igor Radtke Bederode} and {Claudia Escalante Medeiros} and {Miguel Alfredo Orth}},
  date = {2024-06-17},
  journaltitle = {Revista Caribeña de Ciencias Sociales},
  shortjournal = {Revista Caribeña de Ciencias Sociales},
  volume = {13},
  number = {6},
  pages = {e4011-e4011},
  doi = {10.55905/rcssv13n6-004},
  url = {https://openalex.org/W4399760339},
  abstract = {A sociedade da informação e da comunicação, na qual se vive atualmente, impõe ao docente a adoção de processos de ensino e aprendizagem apoiados pela tecnologia digital. O professor necessita percorrer caminhos de autoria e criatividade na utilização das referidas tecnologias em sala de aula. Assim sendo, o presente artigo propõe-se analisar os efeitos das tecnologias digitais nos processos de ensino e aprendizagem, tecendo, ao final, uma análise crítica acerca dos desafios e das possibilidades de utilização das tecnologias, tendo em vista as informações obtidas na revisão bibliográfica, bem como junto aos educadores do Instituto Federal Sul-rio-grandense (IFSul), Campus Pelotas. Esta investigação se pauta por uma abordagem qualitativa (Bogdan; Biklen,1999), bem como pelos pressupostos do levantamento bibliográfico (Köche, 2011), e pesquisa de campo por meio de entrevistas semiestruturadas. Os resultados evidenciam pouca apropriação tecnológica dos educadores, o que dificulta a criação de contextos de aprendizagem com a utilização dos recursos tecnológicos; em contrapartida, os recursos tecnológicos emergem como possibilidade didático-pedagógica para aproximar as escolas dos nativos digitais, renovando os processos de ensino e aprendizagem na sociedade contemporânea.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@incollection{ikerpuentevigiola2012politica,
  title = {Política y psicología integral},
  booktitle = {Dipòsit Digital de Documents de la UAB (Universitat Autònoma de Barcelona)},
  author = {{Iker Puente Vigiola}},
  date = {2012-01-01},
  pages = {265--284},
  url = {https://openalex.org/W2514892107},
  abstract = {Presentación del trabajo del filósofo integral Ken Wilber, comenzando por sus aportaciones al campo de la psicolgía y finalizando con su modelo de los 4 cuadrantes y la integración de la teoría de la "espiral dinámica" de Beck y Cowan dentro de su modelo. Incluye algunos ejemplos de cómo Wilber emplea su modelo para interpretar la evolución del pensamiento político y las diferentes formas de gobierno, así como para analizar los diferentes conflictos politicos que se están produciendo en el mundo actualmente. La espiral dinámica y el modelo de los 4 cuadrantes de Wilber puede servirnos para explicar la dimensión política que poseen las experiencias trascendentes y transpersonales. Numerosos proyectos sociales novedosos que están emergiendo en la actualidad (desde el software libre al coachsurfing o la economía cooperativa), basados todos ellos en la cooperación, la transparencia y la interdependencia, pueden ser explicados desde estas teorías, y sus características se hayan más cercanas al pensamiento holístico e integral, y apuntan a que se está produciendo una importante transformación social, un cambio y ruptura en relación al paradigma social imperante.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{ilianaviridianaroagonzalez2024youth,
  title = {Youth {{Strategies}} in the {{Face}} of {{Climate}} and {{Educational Vulnerability}}},
  author = {{Iliana Viridiana Roa González}},
  date = {2024-12-31},
  journaltitle = {Perspectiva austral.},
  shortjournal = {Perspectiva austral.},
  volume = {2},
  doi = {10.56294/pa2024.42},
  url = {https://openalex.org/W4407831311},
  abstract = {Introduction: The study analyzed the risk and vulnerability in the educational trajectory of indigenous youth as they progressed to postgraduate studies. It focused on students from Intercultural Universities and assessed the social, economic, and cultural conditions that influenced their academic development. The research explored the accumulation of disadvantages throughout their education and how transversal factors such as gender, age, and ethnicity impacted their access to and retention in higher education.Development: The analysis was based on semi-structured interviews with postgraduate students from various public universities in Mexico City. It was identified that educational vulnerability was not only a result of structural conditions but also of material and symbolic inequalities. The study examined educational segmentation and the creation of Intercultural Universities as a governmental strategy to include marginalized populations, although it also revealed that these institutions perpetuated institutional differences. Additionally, the impact of the COVID-19 pandemic was addressed, which amplified inequalities and forced indigenous students to develop strategies to cope with distance education, such as using community networks and strengthening digital literacy.Conclusion: The study concluded that the educational vulnerability of indigenous youth was exacerbated by the pandemic, highlighting structural inequality in access to education. However, it emphasized their resilience and the strategies they implemented to mitigate adverse effects. The denaturalization of disasters helped understand the intersection of social, economic, and political factors in the education of vulnerable populations.},
  langid = {english},
  keywords = {inglesa}
}

@article{indiraarumugam2023cooking,
  title = {Cooking {{Up}} a {{Distinctly Singaporean Tamil Cuisine}}},
  author = {{Indira Arumugam}},
  date = {2023-01-01},
  journaltitle = {Gastronomica The Journal of Food and Culture},
  shortjournal = {Gastronomica The Journal of Food and Culture},
  volume = {23},
  number = {2},
  pages = {65--70},
  doi = {10.1525/gfc.2023.23.2.65},
  url = {https://openalex.org/W4380248665},
  abstract = {“Cheee, what is that stench?” exclaimed my mother-in-law, wrinkling her nose at the pungent fishy smell emanating from a neighbor’s kitchen. Visiting from Tamil Nadu, my mother-in-law was staying in our apartment in Singapore. Inhaling the scent appreciatively, I sighed, “That is the smell of toasting fermented shrimp paste (belacan in Malay) for making sambal (chili relish). I am so hungry.” Both my mother-in-law and I were born in rural Tamil Nadu. While she spent her whole life in Tamil Nadu, I migrated to Singapore when I was three years old.1 In Singapore, I grew up among mainly Malay and Chinese neighbors and friends. Both my mother-in-law and I are intimately familiar with Tamil foods. However, our varying degrees of exposure to different cultures because of migration or the lack thereof makes our tastes decidedly different. Continuing engagement with Tamil Nadu—visiting my relatives, long-term ethnographic fieldwork in Vaduvur, the village where I was born, and marriage to a Tamil Nadu native—has only made my sense of a distinctively Singaporean Tamil food more acute. A cuisine steeped in but not precious about its history, context, and culture but reflecting the dynamism, ingenuity, and playfulness of Tamil immigrants remembering old flavors but also relishing the new ones so plentiful in Singapore.Tamils form the majority of the Indians in Singapore. For more than two hundred years, Tamils have been living in, traveling to, and trading with Singapore. Tamil is one of Singapore’s four official languages. However, this deep-rooted Tamil presence is not reflected in mainstream understandings of Indian food in Singapore. “Indian food” still refers mainly to either North Indian standards (tandoori chicken and naan) served in restaurants or the Indian Muslim food (roti prata [fried flatbread], nasi biryani [layered spiced rice], and mamak mee goreng [spicy fried noodles]) sold in hawker centers. Awareness of a distinctly Tamil food, especially the simple dishes eaten every day by Tamils at home, remains elusive. My grandmother Seethaiammal’s diasporic kitchen exemplifies the confrontations between inherited tastes and techniques and newly available ingredients and methods that gave rise to a distinctive, if routine, Singaporean Tamil cuisine.Seethaiammal was born in Pullavarayan Kudikadu, a village in central Tamil Nadu. Orphaned2 at a young age, she had to marry my much older grandfather Doraisamy when she was just fourteen years old. In the 1920s, Doraisamy had migrated from the nearby village of Vaduvur to Singapore. Initially working as a manual laborer, Doraisamy eventually set up his own construction company, called Samy \& Sons. Returning to Tamil Nadu, he married Seethaiammal, and they settled in Singapore to raise six children. Cooking for eight people with her husband’s erratic allowance forced Seethaiammal to be resourceful. She raised chickens and turkeys for the tables of the British colonial powers ruling Singapore. She smuggled broken cream crackers home from the biscuit factory where she worked to feed her children. She went to the market at closing time to buy the last and already rotting fish and wilting seasonal vegetables for cheap. Appropriating some public land by a canal opposite her house, Seethaiammal grew mango, guava, jackfruit, moringa, and hummingbird trees to supplement their diet. Adding lentils to hummingbird tree leaves (used only as cattle feed in Tamil Nadu), she made a soupy dal (tannisar). She mixed the meager quantity of mutton she could afford with chopped cabbage leaves to make a mildly spiced curry. Nearly fifty years after his mother’s death, my father still raves about her cooking: “She used only a few ingredients…cooked very quickly. But whatever she made was delicious. There is this relish. Just a dried fish grilled over a charcoal flame…Flakes of smoky fish. Spiked with lots of chopped onions, chilies and calamansi lime juice. I can still taste it.”This relish borrows liberally from Malay techniques. Part of Seethaiammal’s ingenuity involved experimenting with ingredients adopted from her new home, and flavors and techniques adapted from her Malay and Chinese neighbors to revise the Tamil food she had grown up with.Seethaiammal’s innovations were not just accidents or calculated responses to scarcity. Given their similar ecologies, the ingredients Seethaiammal was accustomed to in her native Tamil Nadu were abundantly available in Singapore. The long history of migration, trade, and cultural exchange between South India and Southeast Asia, intensified by British colonialism in the nineteenth century, resulted in a thriving population of Tamils in Singapore. Specialty shops, provisions, and services to cater to Tamil people’s specific needs were plentiful. Seethaiammal did not need to edit her recipes to cope with the dearth of the ingredients and equipment she was accustomed to. A port city like Singapore where people from different cultures met, mingled, and shared their food offered new ingredients, techniques, and tastes to play with in the kitchen. Seethaiammal’s culinary repertoire became more varied, deeper, more complex. From the intermingling of easily available Indian provisions and processes and cosmopolitan (Malay and Chinese) influences emerged a specifically Singaporean Tamil food.At the heart of a Singaporean Tamil cuisine is the appreciation of ingredients which, to unaccustomed Tamil palettes like my mother-in-law’s, seem pungent, even malodorous. From her Malay neighbors, Seethaiammal learned to harness and balance the umami-packed flavors of fermented shrimp paste (belacan), dried shrimp (udang kering), and dried anchovies (ikan bilis) (Johari 2021). She added dried anchovies or shrimp—soaked in water and pounded in a mortar and pestle into a soft, fluffy mass—to stir-fried vegetables like French beans,3 beansprouts, or long beans. Enamored of their savory potency, Seethaiammal incorporated these provocative fishy ingredients into typically Tamil recipes. During ethnographic fieldwork in Vaduvur, I watched my aunt grinding spices into a paste on her stone grinder for a characteristic village curry:Black pepper, coriander seeds, cumin…These are the traditional…nattu [referring literally to country or rural in Tamil but also meaning indigenous] spices…Nowadays people also use cinnamon, cloves, star anise and cardamon. These are sweeter…more fragrant…In the past, these spices were hard to get…more expensive. Only Muslims cooked with them.Seethaiammal’s chicken curry not only incorporates the fragrant cinnamon, cloves, star anise, and cardamon readily available in Singapore but also distinctly Southeast Asian fresh herbs and rhizomes. To the sautéed onions base, she added crushed lemon grass stalks and pandan leaves. She included ground galangal and candlenuts in the standard Indian ginger-garlic paste. Into the freshly ground coconut paste for thickening and enriching the curry, she added toasted shrimp paste. A classic Tamil chicken curry became imbued with a Singaporean savoriness.Ordinary women, like my grandmother, making everyday innovations in their home kitchens helped to craft a new and still developing culinary canon. Adding toasted shrimp paste to ground garlic, ginger, onions, and fresh chilies, Seethaiammal made sambal, a Malay condiment she came to cherish. Sambal belacan (shrimp paste), constituted of ground chilies and soured with calamansi lime juice, took the place of the pickles, chutneys, and powders accompanying a traditional South Indian meal.Sambal is not simply a condiment. Seethaiammal also made a more liquid version—using prawns, squid, boiled eggs or omelets, fried fish steaks, fried anchovies, canned sardines in tomato sauce, lightly fried chicken, or precooked mutton—to serve as a spicy gravy over rice. Even quintessentially Tamil dishes such as lentil and vegetable curry (sambar), mild mashed lentil dishes (dal), or mashed and spiced greens are rarely served without piquant sambals. For when meat is prohibited for religious reasons, Seethaiammal has developed vegetarian versions omitting the toasted shrimp paste or pounded anchovies common to Malay sambals and substituting deep-fried firm tofu, tempeh, or eggplants. In some temples, a Tamil sambar accompanied by a Singaporean tofu sambal has even become part of the offerings to Hindu deities during worship.The sheer variety of ingredients from multiple cooking traditions in Singapore allowed Seethaiammal to experiment with and adopt novel combinations, at least to traditional Tamil tastes. Malay ingredients like shrimp paste, dried anchovies, and dried shrimp layer flavor onto and add depth to classic curries. Coconut milk, instead of the customary yogurt, moistens and binds cucumber salad (raita). An Indonesian soy sauce caramel (kecap manis) sweetens and colors Tamil meat sautés. Chinese ingredients like soya sauce salt traditional Tamil dishes. Bean thread noodles (soo hoon) add bulk to spicy broths. Southeast Asian herbs like pandan leaves perfume a milky Tamil vermicelli pudding (payasam) traditionally spiced only with cardamoms. Along with the usual Indian aromatics, pandan leaves and lemongrass stalks also scent a Singaporean biryani. British colonization and settlement introduced butter, which along with the locally available coconut milk enriches my family’s murukku, the savory, spiral or lattice-shaped deep-fried crisps without which no Deepavali festival is complete (Arumugam 2020). Malay sweetmeats (kuih) such as makmur (ghee and peanut cookies), dahlia (butter cookies), love letters (crispy crepe scrolls), agar-agar (jelly), and the Chinese-influenced pineapple jam tarts are as much a part of Singaporean Deepavali celebrations as the traditional Tamil savories and sweetmeats.4Along with ingredients, cooking techniques, and recipes, accompaniments, tastes, and textural preferences have also shifted. In contrast to her inland village with only freshwater fish, living on a tropical island gave Seethaiammal access to an abundance of seafood. She made a prawn and drumstick curry, a curried squid, and a cumin and pepper spiced crab sauté. In a Tamil Nadu fish curry, the pristine taste of fresh fish is paramount. As I watched her kill, gut, and descale the live fish from the market, my aunt explained: “We must have absolutely fresh fish. You can add quarters of green mango. Together with tamarind and tomatoes, these add tartness. No other vegetables…they will detract from the taste of the fish.”To her Singaporean fish curry, Seethaiammal not only added green mangoes but also eggplants, as well as okra that become deliciously sodden with the tart gravy. She made a curry not just out of fresh and sun-dried fish, as is usual in Tamil Nadu, but also canned sardines in tomato sauce.Readily available, affordable, and relatively imperishable, canned fish, introduced during colonialism, has become a convenient addition to the Singaporean Tamil kitchen. Seethaiammal also sautéed canned sardines with chopped onion, chilies, and tomatoes, sprinkled with turmeric powder, and finished with lime juice to make a spicy, tart, and quintessentially Singaporean sandwich filling. Seethaiammal served traditional Tamil breakfast and tiffin items such as appam (spongy rice pancake), idiyappam (steamed rice vermicelli), and puttu (steamed rice and coconut rolls), not with spicy curries or sweetened coconut milk as they are served in Tamil Nadu but with the Malay accompaniments of grated fresh coconut and a luridly orange-colored sugar or a sardine sambal.For family birthdays and picnics, Seethaiammal served chicken curry, not with the usual rice, thosais (rice and urad dal crepes) and idlis (steamed rice and urad dal cakes), but with loafs of roti perancis (French bread in Malay), the soft and pillowy Singaporean interpretation of the baguette. A highlight of our familial celebrations is a recipe that could arise only out of Singapore’s cosmopolitan crucible: Seethaiammal’s fried rice vermicelli dish, which we call sivappu mee (red noodles).Involving a mixture of Chinese ingredients such as rice noodles, tofu, beansprouts, garlic chives, mustard greens, and soya sauce stir-fried in a Malay sambal paste5 boosted with both toasted shrimp paste and a pounded and fried dried shrimp floss, sweetened with tomato ketchup and spiked with calamansi lime juice, this dish exemplifies the abundant culinary cross-fertilizations one can find in a multicultural city.Seethaiammal saw herself as a Singaporean Tamil. Instead of a sari, she usually wore a batik sarong and long blouse typical of Malay women in the region. She was more comfortable speaking in Malay than Tamil. Even the Tamil she spoke was liberally peppered with Malay words. She knew only the Malay names for the fish she cooked, and the Hokkien names for the leafy greens she stir-fried. While my grandfather preferred traditional Tamil foods, my grandmother relished Singaporean hawker dishes such as Hainanese chicken rice and mamak mee goreng (Indian Muslim fried noodles)—so much so that we place these typically Singaporean dishes, along with her much-loved sambal belacan, before her photograph during our twice-yearly ancestor worship (Arumugam 2022). Even our ritual offerings tell the compelling story of a thoroughly diasporic woman, remembering and keeping alive the flavors of her rural Indian past but also thoroughly savoring the exciting possibilities of her new home.Much of the appeal of food lies in its comforting familiarity and the sense of intimacy it can evoke. Especially within diasporic cultures, recipes are charged with keeping generational culture and identity alive in a foreign land. Locating “authenticity” in notions of provenance, pedigree, and the passing down of knowledge-practices without modifications, we have been conditioned to value grandmothers and mothers laboring to reproduce, preserve, and bequeath seemingly unchanged family recipes. Given how they are byproducts of trade, travel, colonization, and migration, change and adaption are intrinsic to diasporic cuisines. At their heart are also intrepid migrant women like my grandmother, adopting, adapting, and experimenting in their own kitchens, not simply out of necessity but also out of interest. Willing and able to relinquish rigid conventions about food and playing with the novel ingredients and techniques available to them in their new homes, they went on to craft a still unheralded but innovative, hybrid, and distinctive cuisine. Redolent with region-specific rich cultures, complex migratory histories, relationships pierced by love and longing, this distinctively and decidedly Singaporean Tamil cuisine is crafted ultimately by inventive immigrant women determined not simply to survive but also to thrive in their new homes—to taste all that their new life has to offer.},
  langid = {english},
  keywords = {inglesa}
}

@article{inserny2008diseno,
  title = {Diseño de un sistema de supervisión centralizado para las plantas de tratamiento de agua de CVG GOSH. Ciudad Guayana},
