  doi = {10.7203/ciriec-e.103.21476},
  url = {https://openalex.org/W4200224919},
  abstract = {El tercer sector de acción social (en adelante, TSAS) es, desde el punto de vista teórico, un concepto elusivo y fluido, especialmente en el ámbito europeo. Los debates y las definiciones de consenso han sido numerosas para construir un concepto medible, compartido, compresivo y comparable. Estos esfuerzos han dado frutos notables en el desarrollo y análisis del TSAS. Ahora bien, el dinamismo de la realidad social en los últimos 10 años ha producido respuestas innovadoras y alternativas de la sociedad civil que han impactado en la cosmovisión compartida de los marcos conceptuales, las funciones y las acciones del TSAS. El TSAS se ha configurado como un espacio relacional híbrido que se desarrolla en tensión dinámica entre la movilización ciudadana, el emprendimiento social, la economía social y las redes comunitarias de apoyo. Esta tensión, que produce múltiples significados y perspectivas de análisis, solo es comprensible desde el análisis de las respuestas plurales que promueve la sociedad civil. El propósito de este artículo es analizar este proceso en el periodo de 10 años entre la Gran Recesión (2009-2012) y el Gran Confinamiento (2020) producido por el Covid-19. Debemos observar esta relacionalidad híbrida desde la intensificación de la presión asistencial que han supuesto ambas crisis para el conjunto de las organizaciones sociales. Esta tensión ha girado desde el dinamismo de los movimientos sociales en la Gran Recesión y el auge de las redes vecinales-comunitarias durante la pandemia.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{sebastiansilvaborja2025automatizacion,
  title = {Automatización del Monitoreo de un Reactor por Ozonización para el Saneamiento de Agua},
  author = {{Sebastián Silva Borja} and {Jorge Sánchez Girón} and {Fernanda Jocelin Enríquez Hernández} and {Katia Marcela Carpio Domínguez} and {Hipólito Aguilar Sierra} and {A. Martínez}},
  date = {2025-10-28},
  journaltitle = {Memorias del Concurso Lasallista de Investigación Desarrollo e innovación},
  shortjournal = {Memorias del Concurso Lasallista de Investigación Desarrollo e innovación},
  volume = {12},
  number = {1},
  pages = {143--147},
  doi = {10.26457/mclidi.v12i1.4685},
  url = {https://openalex.org/W7131067872},
  abstract = {El presente trabajo desarrolla una solución tecnológica automatizada para el monitoreo en tiempo real de parámetros críticos en un reactor de ozonización destinado al tratamiento de aguas residuales. A través de la integración de sensores de pH, temperatura y conductividad eléctrica, un microcontrolador ESP32 con conectividad Wi-Fi, y una aplicación de escritorio desarrollada en Python, se diseñó e implementó un sistema capaz de registrar, visualizar y almacenar datos de manera continua y precisa. Esta automatización mejora significativamente la eficiencia operativa, reduce los errores asociados al registro manual y facilita la toma de decisiones basadas en evidencia. La solución fue validada experimentalmente, demostrando su confiabilidad, escalabilidad y bajo costo, lo que la hace ideal para entornos académicos, comunitarios o de infraestructura limitada. Desde una perspectiva ambiental, el sistema optimiza el proceso de saneamiento mediante ozonización, reduciendo riesgos en el manejo del ozono y contribuyendo a la gestión segura del recurso hídrico. Desde el punto de vista social, democratiza el acceso a tecnologías de monitoreo, fortalece capacidades locales e impulsa la apropiación tecnológica con enfoque sostenible. Este proyecto sienta las bases para el desarrollo de una planta piloto de tratamiento automatizado y representa una alternativa viable, replicable y adaptable a distintos contextos. La propuesta contribuye directamente al cumplimiento de los Objetivos de Desarrollo Sostenible de la ONU, en particular el ODS 6 (Agua limpia y saneamiento), el ODS 9 (Industria, innovación e infraestructura) y el ODS 13 (Acción por el clima), consolidándose como un precedente de innovación con impacto ambiental y social.},
  langid = {spanish},
  keywords = {iberoamericana}
}

