@article{martino2025pratica,
  title = {A prática de ensino em teoria da comunicação: um estudo a partir de experiências docentes},
  shorttitle = {A prática de ensino em teoria da comunicação},
  author = {Martino, Luís Mauro Sá},
  date = {2025},
  journaltitle = {Comunicação \& Educação},
  volume = {30},
  number = {2},
  pages = {36--52},
  publisher = {Universidade de São Paulo},
  issn = {0104-6829, 2316-9125},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10500364},
  urldate = {2026-11-13},
  abstract = {How one become a communication theory teacher? Based on the responses of 37 faculty members to an online questionnaire, it was possible to observe three main aspects regarding the paths, choices, and contingencies in teaching the discipline: (1) most respondents (34) took the discipline by chance or institutional determination; (2) most of the training was carried out by individuals; (3) there is a~ dichotomy between teaching and research is observed, with few references to research. These elements are discussed against the bibliography on Communication teaching. Como alguém se torna docente de Teoria da Comunicação? Este texto delineia algumas das condições a partir das respostas de 37 docentes a um questionário online. Foi possível observar três aspectos principais: (1) a maior parte dos respondentes assumiu a disciplina por acaso ou determinação institucional, sem necessariamente aderência ou afinidade de pesquisa; (2) a formação ficou, majoritariamente, a cargo de cada docente; (3) há uma dicotomia entre ensino e pesquisa, com poucas referências às investigações realizadas por docentes. Esses elementos são discutidos contra o pano de fundo da bibliografia sobre ensino de Comunicação. Este texto describe aspectos de la enseñanza de la Teoría de la Comunicación en cursos universitarios, centrándose en las condiciones para iniciar esta actividad. A partir de las respuestas de 37 docentes a un cuestionario en línea listas de discusión del área, y con el apoyo de investigación bibliográfica, se observaron tres aspectos principales en cuanto a las trayectorias, elecciones y contingencias en la enseñanza de la disciplina: (1) la mayoría de los encuestados (34) se decantaron por la disciplina por casualidad o por decisión institucional, sin necesariamente compromiso o afinidad con la investigación; (2) la mayor parte de la formación fue impartida de modo individual en estudios de maestría o doctorado; (3) hay dicotomía entre docencia e investigación, con pocas referencias a la investigación dirigida por el profesorado. Estos elementos se discuten com la bibliografía sobre la enseñanza de la Comunicación.},
  langid = {portuguese}
}

