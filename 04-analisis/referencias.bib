}

@article{martinvargas2026aprenentatge,
  title = {Aprenentatge servei i ciència oberta: un model transformador per a la cocreació de ciència, tecnologia i innovació i el foment del lideratge prosocial en la joventut veneçolana davant de reptes planetaris},
  shorttitle = {Aprenentatge servei i ciència oberta},
  author = {Martín Vargas, Daniel Enrique},
  date = {2026},
  journaltitle = {RIDAS. Revista iberoamericana de aprendizaje servicio: Solidaridad, ciudadanía y educación},
  number = {21},
  pages = {15--37},
  publisher = {Facultat d'Educació},
  issn = {2339-9341},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10757775},
  urldate = {2026-11-13},
  abstract = {L'escalada de reptes planetaris demanda una transformació sistèmica i radical en la pedagogia científica i la transferència de coneixement. Aquest article de revisió crítica aborda aquesta urgència en proposar i validar un marc epistemicopedagògic innovador que fusiona estratègicament els principis de la ciència oberta amb la metodologia de l'aprenentatge servei. Aquesta sinergia constitueix el motor principal per a desenvolupar competències d'alt nivell en ciència, tecnologia i innovació i, fonamentalment, el lideratge prosocial en la joventut, amb un punt estratègic d'aplicació en contextos de complexitat institucional i socioeconòmica, com és el cas de Veneçuela. S'analitza la literatura convergent en ciència oberta, aprenentatge transformador i desenvolupament de competències per a la sostenibilitat, argumentant que la integració de l’aprenentatge servei i la ciència oberta genera un mecanisme de reforç mutu: l'aprenentatge servei ancora la recerca científica en la solució de problemes socials i comunitaris reals, mentre que la ciència oberta garanteix que el coneixement generat s'apliqui de manera responsable, ètica, transparent, accessible i globalment replicable. Aquest model integrat és essencial per forjar solucions que beneficiïn mútuament els sistemes humans i naturals. No només accelera l'apropiació tecnològica i l'alfabetització de dades, sinó que promou una ciutadania científica cívica i resilient, preparada per a la cocreació transdisciplinària. The escalating nature of planetary challenges demands a systemic and radical transformation in scientific pedagogy and knowledge transfer. This critical review article addresses this urgency by proposing and validating a novel epistemic-pedagogical framework that strategically merges the principles of open science with the service-learning methodology. This synergy constitutes the primary driver for developing high-level science, technology, and innovation competencies, and fundamentally, prosocial leadership in youth, with a strategic point of application in contexts of institutional and socioeconomic complexity, such as Venezuela. We analyze the convergent literature on open science, transformative learning, and the development of competencies for sustainability, arguing that the open science with the service-learning integration generates a mechanism of mutual reinforcement: service-learning grounds scientific research in the solution of real social and community problems, while open science ensures that the knowledge generated is applied responsibly, ethically, transparently, accessibly, and globally replicable. This integrated model is essential for forging solutions that mutually benefit human and natural systems. Not only accelerates technological appropriation and data literacy but also promotes a civic and resilient scientific citizenry, prepared for transdisciplinary co-creation. La escalada de desafíos planetarios demanda una transformación sistémica y radical en la pedagogía científica y la transferencia de conocimiento. Este artículo de revisión crítica aborda esta urgencia al proponer y validar un novedoso marco epistémico-pedagógico que fusiona estratégicamente los principios de la ciencia abierta con la metodología del aprendizaje-servicio. Esta sinergia constituye el motor principal para desarrollar competencias de alto nivel en ciencia, tecnología e innovación y, fundamentalmente, el liderazgo prosocial en la juventud, con un punto estratégico de aplicación en contextos de complejidad institucional y socioeconómica, como es el caso de Venezuela. Se analiza la literatura convergente en ciencia abierta, aprendizaje transformador y desarrollo de competencias para la sostenibilidad, argumentando que la integración de la ciencia abierta con el aprendizaje-servicio genera un mecanismo de refuerzo mutuo: el aprendizaje-servicio ancla la investigación científica en la solución de problemas sociales y comunitarios reales, mientras que la ciencia abierta garantiza que el conocimiento generado se aplique de manera responsable, ética, transparente, accesible y globalmente replicable. Este modelo integrado es esencial para forjar soluciones que beneficien mutuamente a los sistemas humanos y naturales. No solo acelera la apropiación tecnológica y la alfabetización de datos, sino que promueve una ciudadanía científica cívica y resiliente, preparada para la cocreación transdisciplinaria.},
  langid = {catalan}
}

@article{marycelyheraldinecordovasolis2024gobernanza,
  title = {Gobernanza, Migración e Identidad. Los indígenas oaxaqueños en Los Ángeles, California.},
  author = {{Marycely Heraldine Córdova Solís} and {José Federico de la Torre Rodríguez} and {Mijael Altamirano Santiago}},
  date = {2024-05-01},
  journaltitle = {Dilemas contemporáneos Educación Política y Valores},
  shortjournal = {Dilemas contemporáneos Educación Política y Valores},
  doi = {10.46377/dilemas.v11i3.4229},
  url = {https://openalex.org/W4396560251},
  abstract = {El estudio sobre la gobernanza, migración e identidad de los indígenas oaxaqueños en Los Ángeles, California, destaca la compleja intersección entre factores socio-culturales y políticos. Los indígenas provenientes de Oaxaca enfrentan desafíos significativos al migrar, manteniendo sus tradiciones mientras se adaptan a un entorno urbano distinto. La gobernanza implica la creación de redes comunitarias y formas de autogestión, preservando su identidad en una sociedad diversa. Este análisis científico resalta cómo estas comunidades preservan sus raíces culturales mediante organizaciones locales, al mismo tiempo que interactúan con políticas migratorias y desafíos identitarios. El estudio revela la resiliencia y adaptabilidad de estos indígenas, aportando al entendimiento de la complejidad de la migración y la preservación cultural en entornos urbanos diversificados como Los Ángeles.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{mascamacho2018red,
  title = {Red local inalámbrica en la comunidad indígena de Otavalo. Ecuador, 2018},
  author = {Mas Camacho, María Rosa and Íñiguez Jiménez, Gloria Piedad and Botero Giraldo, Héctor},
  date = {2018-12},
  journaltitle = {Revista Cubana de Informática Médica},
  shortjournal = {Revista Cubana de Informática Médica},
  volume = {10},
  number = {2},
  issn = {1684-1859},
  url = {http://scielo.sld.cu/scielo.php?script=sci_arttext&pid=S1684-18592018000200008&lang=pt},
  abstract = {ABSTRACT  Introduction Technological progress in relation to communications and information were boosted after incorporating Web 2.00 and networking impacting networks and virtual communities. Devices with wireless technology have impacted the effectiveness of communications, which facilitate the development of diverse tasks, advantageous for their impact on the economy, image and competitiveness. Access to smart devices has spread throughout the Ecuadorian population, where work is being done to recognize the rights of indigenous peoples and communities to respect their cultures, traditions, customs, values, knowledge and ways of life, Otavalo being one of the the cities with the greatest indigenous presence in the country.  Objective To show how to incorporate technology in daily life with social purposes, as well as to promote development and local enterprises.  Methodology After interviewing the Cantonal Coordinator of the Otavalo indigenous communities, interested in spreading and promoting local development, he is explained about the facilities offered by the Kimera Wireless Local Network tool, which uses free software and open content. After an exchange with the community of Gualsaqui, consent is obtained and the information of interest to be disseminated is complemented.  Conclusions A wireless local network is installed that constitutes a proposal for the disclosure of the history, legal system and community data, information that is easy to update because it does not require specific technical knowledge for its customization.},
  langid = {spanish},
  keywords = {comunidades indígenas,desarrollo local,indigenous communities,local area networks,local development,redes de área local}
}

