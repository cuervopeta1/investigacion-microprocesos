@article{agustinzanotti2012comunidades,
  title = {Comunidades de software libre en Argentina: Algunas exploraciones y vectores de análisis},
  author = {{Agustín Zanotti}},
  date = {2012-08-04},
  journaltitle = {Acta Académica (Acta Académica)},
  shortjournal = {Acta Académica (Acta Académica)},
  url = {https://openalex.org/W2564146850},
  abstract = {La ponencia presenta avances de investigaciones en curso que exploran y problematizan algunos aspectos referidos a comunidades y grupos de usuarios vinculados al software libre en Argentina. Pretendemos comprender estas formas de organización como parte constitutiva de un movimiento social que se constituye en el marco del capitalismo informacional actual y articula en él sus demandas. Sus propuestas giran en torno a formas alternativas de concebir las tecnologías en este dominio particular, centradas en valores libertarios, trabajo colaborativo en redes y la circulación ampliada del conocimiento que subyace a la escritura de código. Nos aproximamos así a una consideración de las tecnologías informacionales como bienes comunes o formas de tecnología social, que trascienden las finalidades estrictamente mercantiles y extienden la diversidad de motivaciones de creación y desarrollo de software hacia otros dominios. A partir de allí nos interesa explorar la configuración de algunas de las comunidades del movimiento software libre en Argentina. En base a entrevistas realizadas a miembros de estos colectivos y documentos generados en tales espacios, buscaremos reconocer cuáles son las formas de organización que se presentan, cuál es la participación de los nodos locales en redes globales más amplias, cuál es la inserción de estas comunidades en el medio local y cuáles las vinculaciones que se trazan entre sus participantes y otros actores e instituciones pertenecientes al sub-campo de la producción de software. Al mismo tiempo indagaremos acerca de las disputas específicas que se plantean en el medio local, así como las diferentes motivaciones que reúnen a las personas involucradas en este tipo de iniciativas. Buscamos así trazar algunos vectores de análisis que orienten la indagación dentro de un terreno de investigación aún relativamente inexplorado en la región.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{agustinzanotti2014comunidades,
  title = {Comunidades de software libre en Argentina: motivaciones, participación, militancia},
  author = {{Agustín Zanotti}},
  date = {2014-12-31},
  journaltitle = {Americanae (AECID Library)},
  shortjournal = {Americanae (AECID Library)},
  volume = {7},
  number = {2},
  pages = {55--74},
  url = {https://openalex.org/W1505273540},
  abstract = {El artículo retoma indagaciones sobre comunidades de software libre en Argentina para analizar sus formas de participación y militancia. Nos enfocamos en las motivaciones que convocan a los miembros de comunidades y proyectos, las cuales se asocian a las potencialidades tanto técnicas como sociales del modelo libre de producción de software. El análisis nos lleva a comprender que las formas de solidaridad al interior de estos grupos se encuentran inescindiblemente unidas a una búsqueda personal y a necesidades cotidianas de sus participantes. Las comunidades generan y distribuyen capitales o recursos de manera retributiva, en función de sus contribuciones y aportes. Sobre la base de ciertas identidades geeks/hackers ligadas a estos entusiastas informáticos, tales espacios fortalecen vínculos, relaciones de pertenencia y experiencias compartidas. Junto con ello se van construyendo definiciones éticas y políticas en relación al software y los diferentes temas que hacen a la agenda local de los colectivos. El texto abre la discusión sobre las formas de militancia que existen detrás de estos colectivos y la construcción del software libre como un objeto político. Inscribimos de este modo el debate en una reflexión más amplia sobre la acción colectiva y los movimientos sociales contemporáneos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{agustinzanotti2016cooperativas,
  title = {Cooperativas de trabajo en software y servicios informáticos ¿subversión al capitalismo cognitivo?},
  author = {{Agustín Zanotti}},
  date = {2016-12-31},
  journaltitle = {Chasqui Revista Latinoamericana de Comunicación},
  shortjournal = {Chasqui Revista Latinoamericana de Comunicación},
  number = {133},
  pages = {129--129},
  doi = {10.16921/chasqui.v0i133.2930},
  url = {https://openalex.org/W2566335969},
  abstract = {La industria del software y servicios informáticos en Argentina mantiene un crecimiento sostenido. Una tendencia reciente es la conformación de la Federación Argentina de Cooperativas de Trabajo en Tecnología, Innovación y Conocimiento (FACTTIC), la cual promueve un modelo basado en el desarrollo de tecnologías y software libre. El artículo observa trayectorias de emprendimientos de la región centro para analizar su conformación cooperativa, modalidades de organización del trabajo, condiciones laborales e iniciativas innovadoras. El desenvolvimiento de estas experiencias se ubica en un contexto de capitalismo cognitivo, en su doble faceta de mercantilización de conocimientos y explotación del trabajo inmaterial. La investigación en curso toma por base entrevistas a referentes, análisis de registros web y fuentes secundarias.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@book{agustinzanotti2017software,
  title = {El software libre y su difusión en Argentina. Aproximación desde la sociología de los movimientos sociales},
  author = {{Agustín Zanotti}},
  date = {2017-01-01},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  url = {https://openalex.org/W3009613457},
  abstract = {La presente investigación nos acerca a la producción de software desde una perspectiva sociológica, buscando comprender el modo como éste se erige en un elemento determinante del mundo contemporáneo. Nos referimos al software como el componente intangible de la informática, un conjunto de aplicaciones y sistemas, elaborados a partir de instrucciones escritas en diferentes lenguajes de programación, que posibilitan el funcionamiento y la utilización de todo tipo de dispositivos. El mismo constituye una de las grandes áreas que componen las Tecnologías de la Información y las Comunicaciones (TIC), junto al hardware, la industria electrónica y las telecomunicaciones. El software se ha inmiscuido en la casi totalidad de los espacios de vida de las personas, mediando las relaciones sociales de modos novedosos y cambiantes. Al mismo tiempo se ha convertido en una pieza central en los procesos de acumulación a nivel global, siguiendo una serie de transformaciones en el capitalismo actual. A lo largo del trabajo sostenemos que la propia producción de software conlleva una disputa abierta. Nos referimos a dos modos de creación y apropiación diferenciados, que reconocemos como modelo privativo y modelo libre. El modelo privativo enfatiza el carácter de mercancía del software y basa sus ingresos en la utilización de licencias o patentes que restringen su copia, distribución, modificación y uso. Se caracteriza por mantener sus desarrollos fuera del dominio público y se distribuye en formato binario o ejecutable, lo que equivale a decir que su código es cerrado. El modelo libre considera en cambio al software como una forma de bien común. Su desarrollo y distribución se basan en criterios no restrictivos. Este otorga a los usuarios la libertad para utilizar, copiar, distribuir, estudiar y mejorar el código fuente de sus aplicaciones, el cual se encuentra abierto y accesible en el dominio público. Nos interesa pensar el modelo libre como un movimiento social contemporáneo. Valiéndonos de una serie de consideraciones teórico-metodológicas provenientes de los estudios sobre acción colectiva, consideramos a los movimientos sociales como forma de acción política. Pretendemos así entender las prácticas y significaciones vinculadas al software libre -junto a sus tendencias y transformaciones recientes- con herramientas analíticas que nos permitan luego emparentarlas con otras manifestaciones de diverso tipo de contienda/confrontación política. Destacamos de este modo ciertos elementos constitutivos de la organización de diferentes grupos y colectivos, la inscripción de demandas, su interpelación a otros agentes en calidad de aliados u opositores, así como el surgimiento de experiencias e identidades colectivas en torno a estas problemáticas.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{ahumadacervantes2025emprendimiento,
  title = {El emprendimiento comunitario y el desarrollo innovador sostenible como pilar para la transformación social},
  author = {Ahumada Cervantes, Juan Miguel and Rivera Obregón, Mónica Liliana and Salcido Bastidas, Lenin Orlando},
  date = {2025},
  journaltitle = {RILCO DS: Revista de Desarrollo sustentable, Negocios, Emprendimiento y Educación},
  volume = {7},
  number = {72},
  pages = {109--120},
  publisher = {Servicios Académicos Intercontinentales S.L.},
  issn = {2695-6098},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10508291},
  urldate = {2026-11-13},
  abstract = {This work analyzes the strategic role of community entrepreneurship and sustainable innovative development as fundamental pillars for social transformation in regional contexts. In an environment characterized by deep territorial inequalities and increasing economic challenges, communities have begun to mobilize local resources through entrepreneurial and innovative practices, articulating solutions tailored to their socioeconomic realities. The presentation will explore how these community dynamics, based on technological appropriation, social innovation, and self-management, drive the creation of new labor markets that are more inclusive, resilient, and sustainable. Initiatives such as cooperatives, collaborative networks, and social entrepreneurship are positioned as transformative agents that not only generate dignified employment but also promote social cohesion, territorial strengthening, and environmental sustainability. The research will be approached from a qualitative documentary perspective, through a critical review of academic literature, case studies, and conceptual frameworks related to regional development, social economy, and territorial innovation. This analysis aims to identify patterns and strategies that have proven effective in generating positive and sustainable impacts in different regions.~In this context, it is assumed that community entrepreneurship, when linked to innovation processes oriented towards the common good, becomes a key driver for transforming local realities. The results of the study could demonstrate how strategies of innovation and community entrepreneurship can activate fairer and more sustainable local economic ecosystems, facilitating the active participation of communities in building their own development. El presente trabajo analiza el papel estratégico del emprendimiento comunitario y el desarrollo innovador sostenible como pilares fundamentales para la transformación social en contextos regionales. En un entorno caracterizado por profundas desigualdades territoriales y crecientes desafíos económicos, las comunidades han comenzado a movilizar recursos locales mediante prácticas emprendedoras e innovadoras, articulando soluciones adaptadas a sus realidades socioeconómicas. La ponencia explorara cómo estas dinámicas comunitarias, basadas en la apropiación tecnológica, la innovación social y la autogestión, impulsan la creación de nuevos mercados laborales más inclusivos, resilientes y sostenibles. Iniciativas como cooperativas, redes colaborativas y emprendimientos sociales se posicionan como agentes transformadores que no solo generan empleo digno, sino que también promueven cohesión social, fortalecimiento territorial y sostenibilidad ambiental. La investigación se abordará desde un enfoque cualitativo de tipo documental, mediante la revisión crítica de literatura académica, estudios de caso y marcos conceptuales relacionados con el desarrollo regional, la economía social y la innovación territorial. Este análisis busca identificar patrones y estrategias que hayan demostrado efectividad en la generación de impactos positivos y sostenibles en diferentes regiones. Bajo este contexto se asume que el emprendimiento comunitario, cuando se vincula con procesos de innovación orientados al bien común, se convierte en un motor clave para transformar realidades locales. Los resultados del estudio podrían evidenciar cómo las estrategias de innovación y emprendimiento comunitario pueden activar ecosistemas económicos locales más justos y sostenibles, facilitando la participación activa de las comunidades en la construcción de su propio desarrollo.},
  langid = {spanish}
}

@article{aitaschmitz2021eighteen,
  title = {Eighteen years in two days: the next steps for remote consultation in Brazil},
  author = {Aita Schmitz, Carlos André and Rodrigues Gonçalves, Marcelo and Nunes Umpierre, Roberto and Martins Costa, Manuela and Harzheim, Erno and Souza da Silva, Rodolfo and Goulart Molina-Bastos, Cynthia and Ambrosini Mendonça, Marcos Vinícius and Katz, Natan},
  date = {2021-11-05},
  doi = {10.1590/SciELOPreprints.3126},
  url = {/scielo.php?script=sci_arttext&pid=https://preprints.scielo.org/index.php/scielo/preprint/view/3126&lang=pt},
  abstract = {This is an opinion article that aims to support the Disease caused by the New Coronavirus of 2019 (COVID-19) post-pandemic regarding the regulation of care through digital resources. Through a literature review, an attempt was made to conceptualize remote consultation and to survey both the historical evolution of technological appropriation by health and the regulation on the subject. Texts covering the pre-pandemic and pandemic periods in Brazil, the United States, the European Union and Australia were evaluated. We tried to highlight the main fallacies, sophisms and dissensions that orbit the theme, as well as the real points where there is a need for greater commitment for decision makers: data security and privacy, reimbursement parity and interstate licensing. It is concluded that the technological appropriation by health has divided the world into at least three segments: those that maintained the autonomy of professionals and patients; those who retarded technological advancement through bureaucracy; and those who forbade advances. The pandemic has generated positive reallocations among these groups and there is a need to refine progress and avoid setbacks.},
  langid = {portuguese},
  keywords = {Consulta Remota,COVID-19,eHealth Policies,Health Policy,Política de Salud,Política de Saúde,Políticas de eSalud,Políticas de eSaúde,Remote Consultation,Telehealth,Telemedicina,Telemedicine,Telesalud,Telessaúde}
}

@article{alaimsouzaneto2015aprender,
  title = {Do aprender ao ensinar com as tecnologias digitais : mapeamento dos usos feitos pelos professores na escola},
  author = {{Alaim Souza Neto}},
  date = {2015-11-10},
  url = {https://openalex.org/W2898910532},
  abstract = {O uso das Tecnologias Digitais (TD) nos contextos educativos e orientacoes para que sua insercao aconteca na formacao de professores sao desafios constantes nas agendas educacionais atuais. Em meio a esses desafios contemporâneos, esta pesquisa denominada de mapa social (SILVA; JABER-SILVA, 2015) toma como objeto os usos das TD feitos pelos professores numa escola publica da rede municipal de educacao de Florianopolis, investigando que usos sao efetivados com mais ou menos frequencia nas praticas escolares a luz da fluencia digital. O desenho do mapa se desenvolveu sob a egide de iniciativas do Grupo de Pesquisa Observatorio de Praticas Escolares (OPE) e, sobretudo, como um dos objetivos do Projeto Tablets, computadores e laptops: analise sobre politicas e aspectos pedagogicos da insercao de novas tecnologias na escola . Para tanto, esta pesquisa foi financiada com uma bolsa de doutorado com recursos do Programa Observatorio da Educacao (OBEDUC) da Coordenacao de Aperfeicoamento de Pessoal de Nivel Superior (CAPES), e desenvolvida no PPGE da UDESC no âmbito da linha de pesquisa, Educacao, Comunicacao e Tecnologia. Assim, a pesquisa e resultado da imersao/observacao de um ano e meio na escola para realizar um mapeamento etnografico de abordagem qualitativa que se inicia de modo exploratorio, tendo como fontes primarias, a aplicacao de questionario, seguida de observacao-participante e entrevista. Como fontes secundarias, fez-se uso dos registros de acoes e projetos do OBEDUC/OPE realizados na propria escola. O alicerce teorico problematiza, principalmente, aspectos relacionados aos usos pedagogicos das TD, aos processos de ensinar e aprender com TD, a fluencia digital, a apropriacao tecnologica e a consciencia do professor. Os resultados apontam que os professores, de modo geral, sao usuarios moderados de TD em sua vida pessoal e pouco usuarios na cultura escolar, principalmente, para ensinar os conteudos curriculares em funcao de varios impedimentos, em que a falta de confianca e a inseguranca se sobrepoem. Sao logicas de uso que se estabelecem, diferentemente, na vida pessoal e na escola porque os objetivos de uso nao sao iguais. Os dados ainda mostram o uso das TD na sala de aula como recurso de exposicao, entretenimento, diversificacao, complementacao e ocupacao do tempo da aula. Alem disso, os professores afirmam que as TD dao mais trabalho pedagogico e por isso necessitam de mais formacao que ora oscila entre a tecnica, ora na didatico-pedagogica para lidar com as TD. Como tese, defendo a ideia de apropriacao tecnologica dos professores por meio da fluencia digital para que se sintam mais confiantes e seguros e, assim, usem mais as TD nas suas praticas escolares, ressaltando a importância da sua tomada de consciencia para o reconhecimento da importância dos conhecimentos tecnologicos entre os saberes pedagogicos nos processos formativos.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{alaimsouzaneto2017os,
  title = {OS USOS DAS TECNOLOGIAS DIGITAIS NA ESCOLA: DISCUSSÕES EM TORNO DA FLUÊNCIA DIGITAL E SEGURANÇA DOCENTE},
  author = {{Alaim Souza Neto} and {Geovana Mendonça Lunardi Mendes}},
  date = {2017-06-30},
  journaltitle = {Revista e-Curriculum},
  shortjournal = {Revista e-Curriculum},
  volume = {15},
  number = {2},
  pages = {504--504},
  doi = {10.23925/1809-3876.2017v15i2p504-523},
  url = {https://openalex.org/W2730536212},
  abstract = {Este artigo é uma síntese das discussões feitas no Programa de Pós-Graduação em Educação (PPGE) da Universidade do Estado de Santa Catarina (UDESC) na linha de pesquisa “Educação, comunicação e tecnologias” e produzida a partir de demandas das ações e projetos do Observatório de Práticas Escolares (OPE)da UDESC com financiamento da Coordenação de Aperfeiçoamento de Pessoal de Nível Superior (CAPES). A pesquisa teve como objeto os usos das tecnologias digitais de informação e comunicação (TDIC) feitos pelos professores numa escola pública da rede municipal de educação de Florianópolis, mapeando quais desses usos são efetivados com mais ou menos frequência nas práticas escolares à luz da fluência digital a fim de contribuir com discussões no tocante à apropriação tecnológica do professor. Como objetivo, pretendemos apresentar algumas reflexões em torno da fluência digital do professor para usar essas TDIC na escola. Trata-se de um estudo de caso de natureza qualitativa com abordagem etnográfica inspirada na Cartografia de Rolnik (2007). Como instrumentos, fizemos uso de questionários, observações e entrevistas com professores do Ensino Fundamental II. Dos resultados, a insegurança docente emerge como uma das barreiras ao uso das TDIC na escola. Por fim, defendemos que a fluência digital opera no professor como um elemento pedagógico de sua formação e que pode permitir usar as TDIC, superando o sentimento de insegurança que ronda os professores.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{alancolin-arce2026prereview,
  title = {PREreview of "De Acceso Abierto a Ciencia Abierta: Lecciones de PKP en América Latina"},
  author = {{Alan Colín‐Arce} and {Rosario Rogel-Salazar}},
  date = {2026-09-29},
  journaltitle = {Zenodo (CERN European Organization for Nuclear Research)},
  shortjournal = {Zenodo (CERN European Organization for Nuclear Research)},
  doi = {10.5281/zenodo.23046930},
  url = {https://openalex.org/W7214706216},
  abstract = {This Zenodo record is a permanently preserved version of a PREreview. You can view the complete PREreview at https://prereview.org/reviews/23046931. Resumen: El texto ofrece una reflexión analítica sobre la experiencia de Public Knowledge Project (PKP) y su contribución al desarrollo del Acceso Abierto y la Ciencia Abierta en América Latina. Para ello, conecta la trayectoria y las iniciativas de PKP con los cuatro pilares de la Ciencia Abierta. Entre las contribuciones que el manuscrito identifica se encuentran el desarrollo y sostenimiento de infraestructuras abiertas, el uso extendido de Open Jornal System (OJS) por revistas que no cobran cuotas a lectores ni autores, el apoyo a la publicación multilingüe y la participación de PKP en algunos debates y procesos relacionados con políticas de Acceso Abierto en la región. Este trabajo muestra que un modelo descentralizado de comunicación académica permite promover el control comunitario y la soberanía tecnológica al reducir las barreras de costo para acceder al conocimiento académico. Sin embargo, en América Latina, PKP también enfrenta desafíos como asegurar la sustentabilidad del proyecto, la capacitación a las comunidades y las tensiones entre lo estándares globales y las necesidades locales. Consideramos particularmente valioso que el texto no presente a América Latina únicamente como receptora de modelos globales de Ciencia Abierta, sino como una región cuya larga experiencia con modelos de publicación académica abierta, no comercial y descentralizada puede ofrecer aprendizajes relevantes para el debate internacional. Asimismo, el manuscrito muestra que el tránsito del Acceso Abierto hacia la Ciencia Abierta requiere más que herramientas tecnológicas: implica considerar infraestructura, gobernanza, sostenibilidad, capacidades locales y participación comunitaria. Las contribuciones relativas a infraestructura, descentralización, sostenibilidad y adopción de OJS se encuentran entre los argumentos más sólidamente desarrollados. En cambio, algunas afirmaciones sobre soberanía tecnológica, participación social, diálogo con otros sistemas de conocimiento, justicia cognitiva y diversidad epistémica están sustentadas de manera más indirecta y podrían beneficiarse de una mayor delimitación entre evidencia, interpretación y potencialidad. Inquietudes mayores El manuscrito presenta un propósito analítico pertinente, claro y relevante, particularmente por la manera en que conecta infraestructura, gobernanza y experiencia latinoamericana. Consideramos que funciona de manera convincente como una reflexión analítica informada por la trayectoria y experiencia de PKP. Sin embargo, sería conveniente precisar con mayor claridad el estatuto analítico desde el cual se realiza esta reflexión, especialmente si se pretende caracterizar el trabajo como un "estudio de caso" del que pueden derivarse lecciones más generales para la Ciencia Abierta. Asimismo, valoramos que el manuscrito declare expresamente que dos de las personas autoras forman parte de PKP; sin embargo, sugerimos aprovechar esta transparencia para incorporar una breve reflexión sobre el posicionamiento analítico de las personas autoras. Su conocimiento directo constituye una fortaleza del texto, pero también hace conveniente distinguir con claridad entre experiencia institucional, evidencia documental e interpretación analítica. Esto contribuiría a delimitar el alcance de las conclusiones y fortalecería la reflexividad del manuscrito. Lista de preocupaciones mayores y devolución: 1. Precisar el enfoque analítico y la relación entre evidencia e interpretación El manuscrito se beneficiaría de una explicación más explícita de la estrategia mediante la cual la trayectoria de PKP es utilizada como caso para derivar aprendizajes sobre Ciencia Abierta. No consideramos necesario incorporar una sección metodológica convencional; sin embargo, sería útil explicar brevemente con qué criterios se seleccionaron las experiencias y fuentes consideradas, cómo se vincularon determinadas actividades de PKP con los cuatro pilares de UNESCO y cómo se derivaron de ellas las lecciones propuestas. En particular, recomendamos distinguir entre contribuciones directamente documentadas —por ejemplo, adopción de OJS, descentralización de la infraestructura o diversidad lingüística— y efectos o implicaciones más amplios, como soberanía tecnológica, justicia cognitiva, diversidad epistémica o diálogo con otros sistemas de conocimiento. El multilingüismo, por ejemplo, constituye una condición relevante para ampliar la diversidad de la comunicación científica, pero no demuestra por sí mismo la existencia de diversidad epistémica. Una diferenciación más explícita entre resultados documentados, interpretaciones y potencialidades fortalecería considerablemente el argumento. 2. Ampliar y diversificar las fuentes utilizadas para analizar la experiencia de PKP Recomendamos incorporar investigaciones que analicen el uso, alcance y contribuciones de OJS y PKP en el mundo y en América Latina desarrolladas por personas que no formen parte del equipo de PKP. Las referencias de las propias personas autoras y las fuentes institucionales son pertinentes y, en muchos casos, necesarias para documentar la trayectoria del proyecto. Sin embargo, cuando esas mismas fuentes sirven simultáneamente para describir PKP y valorar su impacto, se reduce la posibilidad de contrastar las interpretaciones propuestas. Incorporar literatura independiente —incluyendo trabajos latinoamericanos sobre infraestructuras abiertas, Acceso Abierto no comercial/Diamante, gobernanza y soberanía tecnológica— permitiría introducir mayor distancia analítica y contrastar los argumentos del capítulo. Esto resulta especialmente importante porque algunas fuentes externas han llegado a conclusiones semejantes a las planteadas en el manuscrito y podrían, por tanto, fortalecer su evidencia. 3. Delimitar el alcance de las conclusiones y reconocer las limitaciones del análisis El texto discute varios desafíos enfrentados por PKP, pero sería conveniente incorporar también una breve reflexión sobre las limitaciones del propio enfoque analítico. En particular, sugerimos reconocer, por ejemplo, los límites de generalizar desde la experiencia de PKP hacia la Ciencia Abierta latinoamericana en su conjunto y las dificultades para atribuir a una infraestructura tecnológica e institucional efectos sociales o epistémicos amplios. Relacionado con ello, sería útil distinguir las contribuciones directamente atribuibles a PKP de aquellas que dependen de ecosistemas más amplios en los que intervienen organizaciones, universidades, redes, comunidades y políticas públicas regionales. Esta precisión permitiría reconocer mejor el carácter colectivo del desarrollo del Acceso Abierto en América Latina y situar las contribuciones de PKP dentro de ese ecosistema. Lista de preocupaciones menores y devolución: Temporalidad de los datos y Figura 1: Cuando se presentan datos cuantitativos, recomendamos especificar la fecha o periodo en que fueron recolectados. La Figura 1 retoma datos de una publicación previa, pero incorporar esta información en la propia figura permitiría interpretarla sin necesidad de consultar la fuente original. También podría indicarse qué representa exactamente cada punto y, si los datos lo permiten, proporcionar cifras específicas para los países latinoamericanos. Podría valorarse asimismo una forma de contextualizar el número de revistas mediante alguna métrica comparable —por ejemplo, población o número de instituciones de educación superior. Colaboraciones y políticas públicas: Se podría detallar con mayor claridad cómo las colaboraciones institucionales, redes y políticas públicas desarrolladas en América Latina han contribuido al éxito y expansión de las iniciativas de PKP. Esto ayudaría a contextualizar los logros descritos y a reconocer la participación de otros actores en esos procesos. APC y desafíos regionales: En la página 7, se afirma que "el mayor reto del Acceso Abierto no es la eliminación de barreras para los lectores, sino para los autores, quienes no pueden publicar en muchas revistas debido a las tarifas elevadas por publicación (APCs)." Aunque éste es, sin duda, un desafío relevante a escala global, resulta debatible caracterizarlo como el mayor reto del Acceso Abierto en América Latina, particularmente considerando la amplia presencia regional de modelos Diamante. Sugerimos matizar esta afirmación y reconocer otros desafíos específicos de los ecosistemas latinoamericanos de publicación abierta. Multilingüismo y lenguas indígenas: Dada la importancia que el manuscrito atribuye al multilingüismo y a la diversidad epistémica, sería interesante indicar —si existe información disponible— si las plataformas de PKP se utilizan para publicar en lenguas indígenas u otras lenguas minorizadas de América Latina. No consideramos necesario producir nuevos datos para responder a esta cuestión, pero la información existente enriquecería el argumento. Terminología: En las páginas 2 y 8 se utiliza el término "abogacía", aparentemente como traducción de advocacy. Recomendamos revisar esta expresión, que resulta poco habitual en este contexto en español; dependiendo del contexto, podrían considerarse términos como "incidencia", "promoción" o "defensa". Revisión editorial: Sugerimos una revisión final de estilo para resolver algunos problemas puntuales de sintaxis, concordancia y consistencia terminológica, así como homogeneizar nombres, siglas y uso de mayúsculas. Evaluación general Consideramos que el manuscrito constituye una contribución pertinente a la discusión sobre el tránsito del Acceso Abierto hacia la Ciencia Abierta y valoramos especialmente su esfuerzo por situar la experiencia latinoamericana como fuente de aprendizajes para el debate internacional. Una mayor explicitación de la posición analítica, una interlocución bibliográfica más divers},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{alanramirezgarcia2021institutional,
  title = {Institutional Redesign to Close the Residual Telecommunications Gap in {{Peru}}: {{The}} Third Channel of Intervention for the Emergence of Sustainable Community Networks},
  author = {{Alan Ramírez García} and {Gislayne Yocelyn Blanco Romero}},
  date = {2021-08-01},
  journaltitle = {Revista Latinoamericana de Economía y Sociedad Digital},
  shortjournal = {Revista Latinoamericana de Economía y Sociedad Digital},
  number = {2},
  doi = {10.53857/vhzy9461},
  url = {https://openalex.org/W3195180311},
  abstract = {El problema de falta de conectividad en gran parte del mundo ha sido más expuesto a raíz de la pandemia de la COVID-19; particularmente, en América Latina y el Caribe, así como en el Perú, se ha atestiguado cómo la falta de acceso a Internet limita las condiciones de desarrollo y agranda las brechas sociales y económicas entre los conectados en las áreas urbanas y los no conectados en las rurales. La multidimensionalidad de este problema se encuentra la concurrencia de causas estructurales y profundas que, en el tiempo, han sido ya ampliamente diagnosticadas. En tal sentido, este trabajo, enfocado en Perú, pero potencialmente aplicable a América Latina y el Caribe, propone como nuevo aporte la definición de la brecha residual de telecomunicaciones rurales («brecha residual»), entendida como el conjunto de localidades no priorizadas ni priorizables por el sector privado ni por las intervenciones públicas tradicionales en el corto ni el mediano plazo. Asimismo, se analiza la efectividad del diseño institucional actual con el que se atiende, desde el Estado, a la brecha de conectividad y se propone, para el conjunto de «brecha residual», incorporar una tercera vía: un modelo de gobernanza bottom-up para la emergencia de redes comunitarias sostenibles. Por sus características, esta tercera vía demanda la reconfiguración multiestamental de roles y habilita la inclusión de enfoques de territorialidad e interculturalidad en diversos espacios geográficos. Finalmente, si bien las localidades que integran la brecha residual se caracterizan por una serie de condiciones desfavorables para la provisión tradicional de servicios de telecomunicaciones u otros, para el caso rural peruano, un gran conjunto de la brecha residual cuenta con un vasto tejido social comunitario, ajeno a las telecomunicaciones (v.g. comunidades campesinas, pueblos indígenas, asociaciones de agua y riego, etc.). Esta condición previa se presenta como una gran ventaja para la aplicación exitosa del modelo de redes comunitarias propuesto en el rediseño institucional, su caracterización e identificación de oportunidades es el tercer aporte de este trabajo.},
  langid = {english},
  keywords = {iberoamericana}
}

@thesis{albasantasoriano2016comunidades,
  title = {Comunidades virtuales de aprendizaje para potenciar la apropiación social de tecnología : Un caso de estudio basado en MOOC},
  author = {{Alba Santa Soriano}},
  date = {2016-06-20},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  url = {https://openalex.org/W2548791181},
  abstract = {El presente trabajo de investigación pretende avanzar en explorar y analizar la actividad desarrollada en un curso MOOC, para comprender cómo se articulan en la práctica sus actores, procesos de aprendizaje y dinámicas de interacción social, y cómo estos pueden contribuir a reforzar los procesos de apropiación social de la tecnología en el paradigma de la Sociedad Red. Para ello, se propone un estudio exploratorio, de carácter interpretativo, sistematizado y riguroso, orientado a comprender el problema de investigación definido desde una perspectiva de investigación-acción.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{albertoramirezmartinell2025sintesis,
  title = {Síntesis Temática en Ciudadanía Digital: Experiencias Formativas del Bachillerato},
  author = {{Alberto Ramírez Martinell} and {Elvia Garduño Téliz} and {Karla Paola Martínez Rámila}},
  date = {2025-06-10},
  journaltitle = {Revista Senderos Pedagógicos},
  shortjournal = {Revista Senderos Pedagógicos},
  pages = {101--119},
  doi = {10.53995/rsp.v17i2.1915},
  url = {https://openalex.org/W4416365462},
  abstract = {En el bachillerato mexicano, la política educativa considera la formación en ciudadanía digital pero su concreción es desafiante. Por ende, el objetivo del trabajo es identificar las experiencias formativas de ciudadanía digital en el bachillerato para ampliar la perspectiva de formación existente. Desde una síntesis narrativa temática derivada de la búsqueda documental y el enfoque cualitativo se presentan resultados que muestran tendencias, ausencias, cambios y fortalecimiento de la formación así como efectos en la enseñanza y el aprendizaje relacionados con la alfabetización y competencias digitales, la transferencia de concepciones de la ciudadanía territorial al ámbito digital, transversalidad, adaptaciones curriculares basadas en la apropiación tecnológica, la integración pedagógica, didáctica y cultural, la construcción de sentidos y significados desde la diversidad de roles y de actores educativos. Los resultados contribuyen a ampliar las posibilidades de formación a la luz de los planteamientos de la política educativa nacional.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{albertthomasmosquera2026mvp,
  title = {MVP Komirezo plataforma digital modular para la gestión administrativa y financiera en Juntas de Acción Comunal},
  author = {{Albert Thomas Mosquera}},
  date = {2026-08-25},
  journaltitle = {Institutional Repository of the National University Open and Distance UNAD (Universidad Nacional Abierta y a Distancia)},
  shortjournal = {Institutional Repository of the National University Open and Distance UNAD (Universidad Nacional Abierta y a Distancia)},
  url = {https://openalex.org/W7212197886},
  abstract = {Las Juntas de Acción Comunal (JAC) desempeñan un papel fundamental en la organización y desarrollo de las comunidades; sin embargo, gran parte de sus procesos administrativos, financieros y documentales continúan realizándose de manera manual, lo que dificulta la trazabilidad de la información, la transparencia en la gestión y la conservación de los registros institucionales. En respuesta a esta problemática, se desarrolló el prototipo Komirezo, orientado a apoyar la gestión administrativa y financiera de la Junta de Acción Comunal del IV Sector del Pedregal. El proyecto se desarrolló bajo la modalidad de Proyecto Aplicado y contempló actividades de análisis del contexto organizacional, revisión normativa, identificación de requerimientos, delimitación del alcance y validación funcional del sistema. Durante su ejecución, la propuesta inicial fue redefinida hacia un Producto Mínimo Viable (MVP) (Figma, s.f.), priorizando las necesidades más críticas de la organización y ajustando el alcance a las condiciones técnicas y temporales del proyecto. Como resultado, se implementaron módulos para la gestión de afiliados, reservaciones del salón comunal, inventario, ingresos y egresos, programación de reuniones y generación de reportes para inventario básicos. Asimismo, se elaboraron evidencias funcionales, documentación técnica y un manual de usuario para apoyar la adopción de la herramienta por parte de los miembros de la organización. Las pruebas funcionales realizadas permitieron verificar el correcto funcionamiento de los módulos implementados, evidenciando la viabilidad técnica del prototipo para apoyar los procesos definidos dentro del alcance de esta primera fase. No obstante, se identificaron retos relacionados con la apropiación tecnológica de algunos usuarios y con el registro oportuno de la información, aspectos que deberán fortalecerse mediante procesos de capacitación y acompañamiento institucional. En términos generales, los resultados obtenidos permiten concluir que Komirezo constituye una herramienta funcional para apoyar la digitalización progresiva de los procesos de la Junta de Acción Comunal, estableciendo una base sólida para futuras fases de desarrollo orientadas a ampliar sus capacidades y fortalecer su implementación en contextos de uso reales.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{albocastro2020importancia,
  title = {Importancia de la calidad de la distribución GNU/Linux Nova para la informatización del sistema de salud de Cuba},
  author = {Albo Castro, Mónica María and Coca Bergolla, Yuniesky},
  date = {2020-12},
  journaltitle = {Revista Cubana de Información en Ciencias de la Salud},
  shortjournal = {Revista Cubana de Información en Ciencias de la Salud},
  volume = {31},
  number = {4},
  issn = {2307-2113},
  url = {http://scielo.sld.cu/scielo.php?script=sci_arttext&pid=S2307-21132020000400008&lang=pt},
  abstract = {ABSTRACT The progress of science and technology applied for the benefit of society contributes to a country's sustainable development. One of the fundamental elements of the work for technological sovereignty in Cuba is using an operating system developed by national specialists. The operating system GNU/Linux Nova is a free software distribution developed by the Information Sciences University. It is one of the proposals of operating systems to be applied during the process of migration to free software and open code platforms in Cuba. The purpose of the study was to determine the way in which the quality of the GNU/Linux Nova distribution impacts on the migration process, particularly in the Cuban health sector. A brief analysis was conducted of the importance of technical and scientific development, as well as migration to free software for the informatization of society. A concise overview is provided of the evolution of the process of development of the GNU/Linux Nova distribution, which currently includes a quantitative quality evaluation procedure. This has made it possible to obtain better results in the evaluation of the product before its official release to show those results objectively. An assessment is finally presented of the economic, technical and scientific, and social impact of the distribution in the Cuban health sector.},
  langid = {spanish},
  keywords = {calidad,GNU/Linux,operating system,quality,sistema operativo,Software}
}

@article{albocastro2020importanciaa,
  title = {La importancia de la calidad de la distribución GNU/Linux Nova para un desarrollo económico y social sostenible del país},
  author = {Albo Castro, Mónica María and Rodriguez Jimenez, Arianna},
  date = {2020},
  journaltitle = {Serie Científica de la Universidad de las Ciencias Informáticas},
  volume = {13},
  number = {2},
  pages = {108--118},
  publisher = {Ediciones Futuro},
  issn = {2306-2495},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8590253},
  urldate = {2026-11-13},
  abstract = {The advancement of science and technology applied in favor of society allows the sustainable development of a country. In Cuba, work has been done based on technological sovereignty, and one of the fundamental elements for this is to have an operating system developed by national specialists, at least with the ability to adapt or modify it. In the Informatics Fair 2009 the free operating system GNU/Linux Nova was officially presented, a free software distribution developed by the University of Informatics Sciences. From then on it was proposed as one of the operating systems to be applied during the migration process to free and open source software platforms in order to achieve technological sovereignty. This paper aims to analyze how the quality of GNU/Linux Nova distribution impacts the economic and social development of the country focused on sustainability. Through a critical analysis of the mechanisms and processes for evaluating the quality of the GNU/Linux Nova distribution, be evidence the need to integrate a quantitative evaluation procedure that allows achieving better results in the evaluation of the product before its official release~ and objectively show these results.The approach to the problem from the point of view of science, technology and society allows us to show the impact that this software product, the result of the scientific-technical communion, has on the computerization of society El avance de la ciencia y la tecnología aplicadas en favor de la sociedad permite el desarrollo sostenible de un país. En Cuba, se ha venido trabajando en función de la soberanía tecnológica, y uno de los elementos fundamentales para ello es contar con un sistema operativo desarrollado por especialistas nacionales, al menos con la capacidad de adaptarlo o modificarlo. En Informática 2009 fue presentado oficialmente el sistema operativo libre GNU/Linux Nova, una distribución de software libre desarrollada por la Universidad de Ciencias Informáticas. A partir de entonces fue propuesta como uno de los sistemas operativos a aplicar durante el proceso de migración hacia plataformas de software libre y código abierto en aras de alcanzar la soberanía tecnológica. El presente trabajo tiene como objetivo analizar cómo impacta la calidad de la distribución GNU/Linux Nova en el desarrollo económico y social del país enfocado en la sostenibilidad. A través de un análisis crítico de los mecanismos y procesos de evaluación de la calidad de la distribución GNU/Linux Nova, se muestra la necesidad de integrar un procedimiento de evaluación cuantitativa que permita lograr mejores resultados en la evaluación del producto antes de su liberación oficial y mostrar objetivamente estos resultados. El enfoque de la problemática desde el punto de vista de la ciencia, la tecnología y la sociedad permite mostrar el impacto que este producto de software, resultado de la comunión científico-técnica, tiene en la informatización de la sociedad},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/ZZ5SIBIV/Albo Castro y Rodriguez Jimenez - 2020 - La importancia de la calidad de la distribución GNULinux Nova para un desarrollo económico y social.pdf}
}

@article{albocastro2020importanciab,
  title = {Importancia de la calidad de la distribución GNU/Linux Nova para la informatización del sistema de salud de Cuba},
  author = {Albo Castro, Mónica María and Coca Bergolla, Yuniesky},
  date = {2020},
  journaltitle = {Revista Cubana de Información en Ciencias de la Salud},
  volume = {31},
  number = {4},
  pages = {8},
  publisher = {Infomed},
  issn = {2307-2113, 1024-9435},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=7676424},
  urldate = {2026-11-13},
  abstract = {El avance de la ciencia y la tecnología aplicadas en favor de la sociedad contribuye al desarrollo sostenible de un país. Uno de los elementos fundamentales para trabajar en función de la soberanía tecnológica en Cuba es contar con un sistema operativo desarrollado por especialistas nacionales. El sistema operativo libre GNU/Linux Nova es una distribución de software libre desarrollada por la Universidad de Ciencias Informáticas. Es una de las propuestas de sistemas operativos a aplicar durante el proceso de migración hacia plataformas de software libre y código abierto en Cuba. El presente trabajo tuvo como objetivo determinar cómo impacta la calidad de la distribución GNU/Linux Nova en el proceso de migración, específicamente en el sector de la salud en Cuba. Se realizó un breve análisis de la importancia del desarrollo científico-técnico, así como de la migración a software libre para la informatización de la sociedad. Se muestra una breve reseña de la evolución del proceso de desarrollo de la distribución GNU/Linux Nova que actualmente incluye un procedimiento de evaluación cuantitativa de la calidad. Este último ha permitido lograr mejores resultados en la evaluación del producto antes de su liberación oficial para mostrar objetivamente estos resultados. Finalmente se presentan valoraciones sobre el impacto económico, científico-técnico y social de la distribución en el sector de la salud en Cuba.},
  langid = {spanish}
}

