@incollection{johnwatson2014nonindustrial,
  title = {Nonindustrial {{Pharmaceutical Research}} in the {{BRIC Countries}}: {{Lessons}} for {{Drug Discovery Partnerships}} with {{Academic}} and {{Governmental Institutions}}},
  booktitle = {Wiley {{eBooks}}},
  author = {{John Watson}},
  date = {2014-04-04},
  pages = {159--172},
  doi = {10.1002/9781118778166.ch11},
  url = {https://openalex.org/W1594797468},
  abstract = {As more academic and governmental institutions incorporate drug discovery as a core mission, the BRIC countries (Brazil, Russia, India, and China) may provide a model for pharmaceutical development in a nonindustrial setting. Historically focused on producing generic drugs driven by public health needs, the BRIC countries have recently started investing in small molecule discovery programs. The Chinese government has created Sinopharm from multiple drug discovery, development, and production facilities previously managed by various governmental ministries. India, an early innovator in government-funded pharmaceutical production, has transitioned to Open Source Drug Discovery, a public–private partnership model that places some of the early discovery in governmental institutions and production in private companies. FioCRUZ in Brazil is a global model for profitable, public health driven, drug production and distribution. Russia has begun to develop an indigenous semiprivate pharmaceutical industry through government financial support. While each of the countries face unique challenges, they all face issues related to managing differing public–private priorities, bureaucratic inertia, and funding limitations.},
  langid = {english},
  keywords = {inglesa}
}

@article{jonathasbeckramos2024linguagem,
  title = {LINGUAGEM AUDIOVISUAL E HIPERMÍDIA: EXPERIÊNCIA ESTÉTICA DAS TEXTURAS SONORAS NA PRODUÇÃO PARTILHADA DO CONHECIMENTO},
  author = {{Jonathas Beck Ramos} and {Sérgio Bairon} and {Valdemar Siqueira Filho}},
  date = {2024-02-28},
  journaltitle = {Revista Contemporânea},
  shortjournal = {Revista Contemporânea},
  volume = {4},
  number = {2},
  pages = {e3260-e3260},
  doi = {10.56083/rcv4n2-128},
  url = {https://openalex.org/W4392231053},
  abstract = {O artigo estabelece reflexões acerca da cultura audiovisual e hipermidiática na perspectiva do conceito de produção partilhada do conhecimento, compreendida como processos de apropriação e tradução de linguagens e performances culturais em contextos populares de produção estética. Nosso objetivo foi sistematizar por meio de uma hipermídia o processo de captação de imagens durante manifestações de rituais de Coroação de Reis Congo, realizadas pelos pesquisadores Sérgio Bairon e José da Silva Ribeiro nos anos noventa, no sertão do norte de Minas Gerais. Como abordagem metodológica, utilizamos os conceitos de cultura popular e tradução cultural que seguem o percurso histórico da Semana de Arte de 1922, completando neste ano seu centenário, que proponha a relação entre o campo popular e a apropriação tecnológica, a partir da parceria entre Mário de Andrade e Oswald de Andrade. Como resultados, apontamos a abertura da produção cultural para o uso das novas tecnologias, a criação de laços de cooperação e afetividade mediadas pela ética participativa e a necessidade de investimentos em produções culturais e educativas para um novo tipo de conhecimento que seja mais generoso e inclusivo.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

