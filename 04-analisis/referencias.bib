@article{rodriguezgarces2014test,
  title = {Test informatizados y su contribución a la acción evaluativa en educación},
  author = {Rodríguez Garcés, Carlos René and Muñoz Sepúlveda, Marlene and Castillo Riquelme, Víctor},
  date = {2014},
  journaltitle = {RED: revista de educación a distancia},
  number = {43},
  pages = {8},
  publisher = {Departamento de Psicología Evolutiva y de la Educación},
  issn = {1578-7680},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=6317326},
  urldate = {2026-11-13},
  abstract = {The national educational system not only reveals weaknesses in its ability to install cognitive and procedural skills in its students, but also in the quality of its assessment systems. While evaluation is a cumbersome and complex task for the teachers, the Computerized Tests provide a powerful tool to improve the evaluative action in terms of relevance, validity and security. The Computerized Tests are versatile and user-friendly applications, which not only facilitate the task of the teacher to assess, but in allowing the use of calibrated and tested metric items, it makes the certification of the proficiency attainable, more objective and fair; incorporating new contributions of the item response theory. Therefore, carrying out actions of technological appropriation; in general, may strongly increase the improvement of the efficiency levels and the quality of the educational process El sistema educativo nacional no sólo evidencia debilidades en su capacidad para instalar competencias cognitivas y procedimentales en su alumnado, sino que también en la calidad de sus sistemas evaluativos. Si bien evaluar es una tarea engorrosa y compleja para el profesorado, los Test Informatizados proporcionan una poderosa herramienta para mejorar en pertinencia, validez y rigor en la acción evaluativa. Los Test Informatizados son aplicaciones versátiles y amigables, que no sólo facilitan la tarea del docente al evaluar, sino que al permitir usar ítems calibrados y de métrica probada hace más objetiva y justa la certificación del dominio de la competencia, incorporando los nuevos aportes de la teoría de respuesta al ítem. Por ello, realizar acciones de apropiación tecnológica puede tributar fuertemente al mejoramiento de los niveles de eficiencia y calidad del proceso educativo en general},
  langid = {spanish}
}

@inproceedings{rodriguezgarcia2021elearning,
  title = {E-learning: una oportunidad educativa para comunidades rurales e indígenas en América del Sur},
  shorttitle = {E-learning},
  booktitle = {La educación digital en el ámbito universitario: un enfoque 360, 2021, ISBN 978-84-1390-660-7, págs. 285-313},
  author = {Rodríguez García, Yeldy Milena and Manrique Villanueva, Lina María Patricia and Maris Valenzuela, Estela and Montoya Arévalo, Nelson Leonardo},
  date = {2021},
  pages = {285--313},
  publisher = {Thomson Reuters Aranzadi},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8993970},
  urldate = {2026-11-13},
  abstract = {Las comunidades rurales e indígenas de América del Sur enfrentan grandes desafíos en desarrollo educativo derivados de la revolución tecnológica, expansión del internet, el trabajo en redes de cooperación digital y el inevitable encuentro intercultural. Este capítulo describe características educativas y de apropiación de las tecnologías educomunicativas en una apuesta por el e-learning y su impacto sobre el aprendizaje de tres comunidades rurales: Tocantins, Brasil; El Chaco, Argentina y Mitú, Colombia. En el estudio se utilizan metodologías descriptivas y de observación participante. Los resultados sugieren la necesidad de reconocer y apropiar los entornos digitales a las necesidades locales, de una forma crítica, humanista y aplicando pedagogías decoloniales; que permita el desarrollo y la preservación de la identidad y la cultura. La discusión parte de una postura crítica frente al acceso y apropiación tecnológica, resalta ideas pedagógicas decoloniales al poner en diálogo los saberes propios de la pedagogía con las ideas provenientes del denominado giro decolonial, partiendo del concepto nodal de colonialidad del poder, propuesto por Quijano (1999, 2000). Se resalta la importancia de entender la historia, la interculturalidad (Valério, 2021), para desarrollar prácticas educativas emancipadoras y descentralizar las ideas epistémicas coloniales del poder y del saber; sin desconocer la importancia del ecosistema digital actual, al que inevitablemente acceden los estudiantes (Lazo, y Gabelas, 2012). Se concluye que urge un análisis de la creciente brecha digital y la necesidad de profundizar en investigación e-learning en poblaciones rurales, que enfrentan un escenario polarizado entre las limitaciones de acceso a la tecnología y el riesgo de pérdida de identidad, tras el consumo indiscriminado de contenidos de internet, debido al alto grado de analfabetismo digital. Rural and indigenous communities in South America face great challenges in educational development derived from the technological revolution, expansion of the internet, work in digital cooperation networks and the inevitable intercultural encounter. This chapter describes educational characteristics and appropriation of educational technologies in a commitment to e-learning and its impact on learning in three rural communities: Tocantins, Brazil; El Chaco, Argentina and Mitú, Colombia. The study uses descriptive methodologies and participant observation. The critical results suggest the need to recognize and appropriate digital environments to local needs, in a humanistic way and applying decolonial pedagogies; that allow the development and preservation of identity and culture. The discussion starts from a critical stance towards access and technological appropriation, highlights decolonial pedagogical ideas by putting into dialogue the knowledge of pedagogy with the ideas coming from the so-called decolonial turn, starting from the nodal concept of coloniality of power, proposed by Quijano (1999, 2000). The importance of understanding history, interculturality (Valério, 2021), to develop emancipatory educational practices and decentralize colonial epistemic ideas of power and knowledge is highlighted; without ignoring the importance of the current digital ecosystem, which students inevitably access (Lazo, y Gabelas, 2012). It is concluded that an analysis of the growing digital divide is urgently needed and the need to deepen e-learning research in rural populations, who face a polarized scenario between the limitations of access to technology and the risk of identity loss, after indiscriminate consumption of internet content, due to the high degree of digital illiteracy.},
  eventtitle = {La educación digital en el ámbito universitario: un enfoque 360},
  isbn = {978-84-1390-660-7 978-84-1390-658-4},
  langid = {spanish}
}

@article{rodriguezgonzalez2026sesgo,
  title = {El Sesgo del Algoritmo ante el Desplazamiento Lingüístico: Una Crítica Jurídico-Filosófica sobre la Extinción del Indigenismo en la Era de la IA},
  shorttitle = {El Sesgo del Algoritmo ante el Desplazamiento Lingüístico},
  author = {Rodríguez González, Octavio},
  date = {2026},
  journaltitle = {Prisma ODS: Revista Científica Multidisciplinaria para el Desarrollo Sostenible},
  volume = {5},
  number = {2},
  pages = {724--741},
  publisher = {Instituto Latinoamericano en Desarrollo Sostenible (LATINDES)},
  issn = {3072-8452},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10888415},
  urldate = {2026-11-13},
  abstract = {El presente artículo analiza la crisis de las lenguas indígenas en México bajo la lente de la Inteligencia Artificial (IA), conceptualizándola no como un evento fortuito, sino como un proceso sociocultural complejo de desplazamiento lingüístico inducido por factores históricos, económicos, educativos y políticos. A través de una crítica jurídico-filosófica que articula el pensamiento de Althusser, Foucault y Sousa Santos, se argumenta que la arquitectura técnica de la IA opera como un Aparato Ideológico de Estado y un panóptico digital que invisibiliza y desplaza el Patrimonio Cultural Inmaterial de los pueblos originarios. El estudio integra datos del INEGI (2020) para evidenciar cómo el sesgo algorítmico y la escasez de corpus digitales aceleran la extinción del indigenismo, produciendo una "línea abismal" que excluye a las lenguas de baja representatividad del ecosistema de la comunicación global. Finalmente, se propone la necesidad de una transición hacia la soberanía tecnológica indígena y una justicia lingüística que desarticule el poder normalizador del algoritmo contemporáneo.},
  langid = {spanish}
}

@article{rodriguezleyva2016componentes,
  title = {Componentes y funcionalidades de un sistema de recuperación de la información},
  author = {Rodríguez Leyva, Paúl and Viltres Sala, Hubert and Pons Flores, Leiny Amel},
  date = {2016},
  journaltitle = {Revista Cubana de Ciencias Informáticas},
  shortjournal = {Revista Cubana de Ciencias Informáticas},
  volume = {10},
  pages = {150--162},
  issn = {2227-1899},
  url = {http://scielo.sld.cu/scielo.php?script=sci_arttext&pid=S2227-18992016000600012&lang=pt},
  abstract = {ABSTRACT The information retrieval systems or browsers are commonly known for the Internet users, these systems are a source of access to information that is distributed in the world of the web as well as the services that are provided in this, its importance and necessity in the world of internet surfing is determined because they are crawlers of information wich is then stored and subsequently accessible through interfaces and search functionalities and ordered according to mathematical algorithms used to calculate the relevance of the results. Orion is a system of information retrieval designed and implemented at the University of Information Science and complying with more than one year of use by the university community of the country, it contains a number of features that make it a powerful tool for finding information housed in Cuban web, has developed services and other development projection that will allow a breakthrough in the country's economy. This search engine allows us to describe the basic components of a tool for information retrieval and some data of the technologies used for its development, this article also provides a summary of its economic and social impact and some of the guarantees of this have been worthwhile software.},
  langid = {spanish},
  keywords = {buscador,consultas,crawling,indexación,indexing,information retrieval,queries,rastreo,recuperación de información,searching}
}

