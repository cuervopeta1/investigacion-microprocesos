  author = {Barreto, Rafael Silva},
  date = {2015-01-01},
  journaltitle = {Portuguese National Funding Agency for Science, Research and Technology (RCAAP Project by FCT)},
  url = {https://openalex.org/W1891430151},
  abstract = {Teste vem sendo reconhecido cada vez mais como atividade chave para o desenvolvimento de software de qualidade. A definição de um processo de teste contribui para que este\textbackslash ndesenvolvimento seja realizado de forma organizada e eficiente. Neste trabalho, apresenta-se um estudo sobre teste, processo de teste e qualidade de software, e propõe-se um processo de teste para uma cooperativa que desenvolve software - TecnoLivre. A proposta foi elaborada em consonância com o processo de desenvolvimento de software implantado no empreendimento.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

