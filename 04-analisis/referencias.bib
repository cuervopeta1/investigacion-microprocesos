  doi = {10.29327/2848808.2.1-38},
  url = {https://openalex.org/W7222930969},
  abstract = {A expansão da inteligência artificial na Educação Básica brasileira ocorre em um contexto de consolidação de políticas voltadas à educação digital, à inclusão tecnológica e à formação para participação em ambientes mediados por tecnologias. Este ensaio teórico objetiva analisar a produção teórica brasileira recente sobre educação digital na Educação Básica, examinando como políticas públicas e propostas de regulação da inteligência artificial se articulam às questões de inclusão tecnológica, letramento digital e algorítmico, cidadania e desigualdades educacionais. O estudo possui natureza teórico-bibliográfica, apoiada por busca narrativa estruturada de produções publicadas entre 2021 e 2026 e por análise documental complementar de marcos político-normativos brasileiros. A literatura examinada indica que infraestrutura e conectividade constituem condições fundamentais de inclusão, enquanto os letramentos digital e algorítmico ampliam as possibilidades de compreensão, avaliação e participação dos sujeitos diante das tecnologias. A inteligência artificial acrescenta questões relacionadas à autoria, à mediação pedagógica, à formação docente, aos dados e às responsabilidades institucionais. O diálogo entre esses eixos permite compreender a cidadania digital como elo entre educação digital e regulação da inteligência artificial. Sustenta-se que a efetividade educacional da regulação depende da articulação entre proteção de direitos, condições materiais de acesso, formação crítica e capacidade institucional para enfrentar desigualdades de apropriação tecnológica.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

