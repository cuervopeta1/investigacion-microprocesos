@article{carolinaaguerre2017internet,
  title = {The {{Internet}} in {{Argentina}} and {{Brazil}}: {{The Origins}} of {{Networking Experiences}}},
  author = {{Carolina Aguerre}},
  date = {2017-01-01},
  journaltitle = {Information \& Culture},
  shortjournal = {Information \& Culture},
  volume = {52},
  number = {2},
  pages = {264--294},
  doi = {10.1353/lac.2017.0010},
  url = {https://openalex.org/W2612728328},
  abstract = {This article discusses the choices, processes, and patterns that emerged during the first two decades of existence of networking technologies in two South American countries, Argentina and Brazil. Both nations stand out in the region for their implementation of science and technology development programs during the twentieth century. The Internet relies on many layers of infrastructure, technologies, and capacities; this work examines the commonalities and differences around its adoption in these national contexts. The essay combines an institutional analysis, which provides an understanding of the main processes that led to the establishment of the Internet in the two countries, with key concepts from the literature on technology appropriation. The tensions generated by new forms of networking due to the worldwide dissemination of TCP/IP are assessed in the framework of the paradigm shift in telecommunications reform during the 1990s.},
  langid = {english},
  keywords = {inglesa}
}

@article{carolinaalzategouzy2019expectativas,
  title = {Expectativas e percepções sobre os impactos da metodologia de construção da capacidade criativa em duas comunidades rurais.},
  author = {{Carolina Alzate Gouzy} and {Cristiane Gomes Barreto} and {Ricardo Gomes Ribeiro} and {Marina Speroto Serra} and {Juliana Assis} and {Bárbara Salvio} and {Zaré Augusto Brum Soares} and {Odair Scatolini}},
  date = {2019-06-30},
  journaltitle = {REVISTA BRASILEIRA DE AGROECOLOGIA},
  shortjournal = {REVISTA BRASILEIRA DE AGROECOLOGIA},
  volume = {14},
  number = {2},
  pages = {108--123},
  doi = {10.33240/rba.v14i2.22965},
  url = {https://openalex.org/W3033436586},
  abstract = {As tecnologias sociais permitem a apropriação e a inclusão de agricultores e agricultoras, e o método de Construção da Capacidade Criativa (Creative Capacity Building) tem como objetivo desenvolver a capacidade de inovação e desenvolvimento tecnológico de baixo custo emcomunidades. Essa abordagem pressupõe o envolvimento ativo dos atores desde seu desenho e construção, como a melhor forma de alcançar a apropriação tecnológica. Foram realizadas duas oficinas, utilizando-se essa metodologia em comunidades rurais que permitiram o desenvolvimento de diversos protótipos ligados a processos de transição agroecológica. Essa pesquisa procurou avaliar as expectativas e percepções sobre os impactos dessa metodologia sobre os participantes das oficinas e registrar seus desdobramentos. Foram aplicados questionários antes e depois das oficinas para os participantes. Embora as expectativas iniciais girassem em torno da realização de trabalhos em equipe, ao final, os participantes perceberam o desenvolvimento de habilidades como um insumo importante para desenhar e criar soluções apropriadas.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@incollection{carolinadecristoamaral2026adocao,
  title = {ADOÇÃO TECNOLÓGICA NA ECONOMIA SOLIDÁRIA: PERSPECTIVAS PARA A INTELIGÊNCIA ARTIFICIAL NO COOPERATIVISMO},
  author = {{Carolina de Cristo Amaral}},
  date = {2026-08-05},
  pages = {119--125},
  doi = {10.22533/at.ed.851132605088},
  url = {https://openalex.org/W7212283405},
  abstract = {RESUMO: Este artigo de revisão teórica examina a relação ainda incipiente entre Inteligência Artificial (IA) e o cooperativismo/economia solidária.Argumenta-se que, embora a produção acadêmica recente (2024-2026) já trate da adoção operacional de IA por cooperativas, sobretudo financeiras e agrícolas, há uma lacuna teórica na articulação entre os modelos algorítmicos vigentes e os princípios cooperativistas estabelecidos pela Aliança Cooperativa Internacional (ACI).A partir do diálogo com Zuboff (2021), Scholz (2016a), Couldry e Mejias (2019) e Benjamin (2019), propõese uma matriz de adaptação que confronta os riscos do capitalismo de vigilância com alternativas de IA explicável, código aberto e governança comunitária de dados.Conclui-se que a IA não é intrinsecamente incompatível com a autogestão democrática, mas sua adequação ao setor depende de decisões político-metodológicas de design, e não apenas de capacidade técnica.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

