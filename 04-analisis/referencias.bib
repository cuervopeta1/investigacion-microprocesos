@article{perezalfaro2026tecnocracias,
  title = {Tecnocracias digitales y soberanía algorítmica: la disputa por el poder infraestructural en el siglo XXI.},
  shorttitle = {Tecnocracias digitales y soberanía algorítmica},
  author = {Pérez Alfaro, Andreina},
  date = {2026},
  journaltitle = {Tsafiqui: Revista científica en ciencias sociales},
  volume = {16},
  number = {2},
  pages = {139--152},
  publisher = {Universidad UTE},
  issn = {1390-5341, 2602-8069},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10882415},
  urldate = {2026-11-13},
  abstract = {La transformación digital ha alterado profundamente las formas contemporáneas de producción, circulación y ejercicio del poder. En este contexto, el control de infraestructuras digitales, plataformas tecnológicas y flujos masivos de datos ha adquirido una relevancia estratégica comparable a la que históricamente tuvieron los recursos energéticos o los territorios. El presente ensayo analiza la emergencia de las tecnocracias digitales como actores clave con creciente capacidad para influir en procesos tradicionalmente asociados a la soberanía estatal. A partir de los aportes de la geopolítica crítica, la economía política del dato y los estudios sobre soberanía digital, se examina cómo las grandes corporaciones ejercen formas de poder infraestructural que reconfiguran los límites convencionales entre lo público y lo privado. Se profundiza en el giro tecnológico del control mediante las tesis de la gubernamentalidad algorítmica, analizando la transición de los mecanismos disciplinarios hacia la modulación preventiva de conductas. Asimismo, se evalúan los modelos de soberanía digital en disputa (Estados Unidos, China y la Unión Europea) y se reflexiona sobre las implicaciones de estas dinámicas para América Latina, una región que enfrenta el desafío de superar el extractivismo informacional y construir capacidades propias de autonomía estratégica. Digital transformation has profoundly altered contemporary forms of production, circulation, and the exercise of power. In this context, the control of digital infrastructures, technological platforms, and massive data flows has acquired a strategic relevance comparable to that historically associated with energy resources or territories. This essay examines the emergence of digital technocracies as key actors with increasing capacity to influence processes traditionally linked to state sovereignty. Drawing on critical geopolitics, the political economy of data, and digital sovereignty studies, it analyzes how major technology corporations exercise forms of infrastructural power that reshape conventional boundaries between the public and private spheres. The essay explores the technological shift in social control through the lens of algorithmic governmentality, addressing the transition from classic disciplinary mechanisms to the preventive modulation of behavior. Furthermore, it evaluates the competing models of digital sovereignty (United States, China, and the European Union) and reflects on the implications of these dynamics for Latin America, a region facing the challenge of overcoming informational extractivism to build its own capacities for strategic autonomy.},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/KFGT3CTB/Pérez Alfaro - 2026 - Tecnocracias digitales y soberanía algorítmica la disputa por el poder infraestructural en el siglo.pdf}
}

@article{perezalonso2025poder,
  title = {Poder ejecutivo y poder judicial en Estados Unidos durante el primer semestre de 2025: inmigración, aranceles y universidades},
  shorttitle = {Poder ejecutivo y poder judicial en Estados Unidos durante el primer semestre de 2025},
  author = {Pérez Alonso, Jorge},
  date = {2025},
  journaltitle = {Revista de administración pública},
  number = {228},
  pages = {261--300},
  publisher = {Centro de Estudios Políticos y Constitucionales},
  issn = {0034-7639},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10540815},
  urldate = {2026-11-13},
  abstract = {The article analyses the role of Ireland’s Data Protection Commission as a data protection authority, within a context defined by the concentration of major technology companies in the country. It examines the Commission’s evolution, institutional limitations, and criticisms, as well as the tensions between its regulatory function and Ireland’s economic environment. In light of new regulations such as the Digital Services Act and the Artificial Intelligence Act, the article warns of the potential replication of the weaknesses of the General Data Protection Regulation’s One-StopShop mechanism. It proposes structural reforms aimed at ensuring a more equitable, consistent, and effective enforcement of digital law in the European Union, as it seeks to reclaim its digital sovereignty. El artículo analiza el rol de la Data Protection Commission de Irlanda como autoridad de protección de datos, en un contexto marcado por la concentración de grandes empresas tecnológicas en el país. Examina su evolución, limitaciones institucionales y críticas, así como las tensiones entre su función y el entorno económico irlandés. A la luz de nuevas normativas como el Reglamento de Servicios Digitales y el Reglamento de Inteligencia Artificial, se advierte sobre la posible reproducción de las debilidades del Sistema de ventanilla única del Reglamento General de Protección de Datos. El texto propone reformas estructurales, en aras de una aplicación más equitativa, coherente y eficaz del derecho digital en la Unión Europea en su búsqueda por recuperar su soberanía digital.},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/9N4UXVTS/Pérez Alonso - 2025 - Poder ejecutivo y poder judicial en Estados Unidos durante el primer semestre de 2025 inmigración,.pdf}
}

@article{perezbustos2010construyendo,
  title = {Construyendo espacios de exclusividad: una aproximación etnográfica al papel y la experiencia de mujeres indias y colombianas en las comunidades locales de Software Libre},
