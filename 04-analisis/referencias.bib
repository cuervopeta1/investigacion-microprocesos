@article{claudioandresmaldonadorivera2021technology,
  title = {Technology Appropriation and {{Mapuche}} Self-Communication: {{An}} Interpretation of Indigenous e-Communication in {{Chile}}},
  author = {{Claudio Andrés Maldonado Rivera} and {Juan Alfredo Del Valle Rojas}},
  date = {2021-03-10},
  journaltitle = {Ethnicities},
  shortjournal = {Ethnicities},
  volume = {21},
  number = {6},
  pages = {1026--1045},
  doi = {10.1177/1468796821998715},
  url = {https://openalex.org/W3139300513},
  abstract = {The use and appropriation of digital information and communication technologies by Mapuche communicators and activists has turned into a new process of political and identity innovation in the context of the Chilean–Mapuche intercultural and interethnic conflict. This study aims to understand the Mapuche intercultural dialogue. Based on a corpus of semi-structured interviews with Mapuche communicators, we interpret and analyze their discourses in relation to the dissemination and/or analysis of the indigenous digital informative media. The results are built upon the valorization and recognition of the mediations that the Mapuche agents develop around their own e-communication praxis. This interpretation derives from applying theoretical–conceptual categories which have enabled us to address technological, technopolitical, (inter)cultural, and communicative dimensions regarding the Mapuche e-communication work.},
  langid = {english},
  keywords = {inglesa}
}

@dataset{claudioantonioklaus2026global,
  title = {Global {{Water Law Judicial Decisions Dataset}} (2016-2026)},
  author = {{Cláudio Antônio Klaus}},
  date = {2026-01-01},
  journaltitle = {Harvard Dataverse},
  eprinttype = {OpenAlex},
  doi = {10.7910/dvn/c9pefs},
  url = {https://openalex.org/W7159951791},
  abstract = {A comparative corpus of 83,596 judicial decisions addressing water law, sanitation access, and water governance across three jurisdictions: Brazil (11,724 decisions, 2016-2025 plus 200 historical TJSP decisions 1997-2015), Canada (3,218 decisions, 2016-2025), and the Netherlands (68,654 decisions, 2016-2025). Decisions were collected from national legal databases (Rechtspraak Open Data API, CanLII REST API, and Brazilian state court portals) using purpose-built scrapers. Each decision is coded with seven jurimetric variables: hr\_language (human rights / right-to-water framing), sust\_language (sustainability framing), governance\_cat (dispute type: tariff, connection refusal, water quality, etc.), win\_loss (litigation outcome, Brazil only), mp\_involvement (Ministerio Publico, Brazil), indigenous\_water (First Nations / Indigenous water rights), and public\_interest (collective action framing). This dataset supports preliminary research on administrative law and sanitation access (the Legal Last Mile project) by an independent researcher. Scrapers and coding engine are open-source at https://github.com/jrklaus8/water-law-dataset. Also archived on Zenodo: https://doi.org/10.5281/zenodo.19836413},
  langid = {english},
  keywords = {inglesa}
}

@thesis{claudiobarboza2014modelo,
  title = {Modelo de previsão de inadimplência de operadoras brasileiras de planos de saúde},
  author = {{Claudio Barboza}},
  date = {2014-02-12},
  journaltitle = {Portuguese National Funding Agency for Science, Research and Technology (RCAAP Project by FCT)},
  url = {https://openalex.org/W2942734400},
  abstract = {A saúde financeira de uma empresa, sua continuidade e o seu processo de gestão se fortalecem na medida em que a sociedade demanda das organizações, maior transparência e práticas mais robustas de governança corporativa. Isto é particularmente relevante em relação às Operadoras de Planos de Saúde, dado o impacto social e econômico que a deficiência de controles nesse tipo de atividade pode acarretar para a própria operadora e principalmente para a sociedade. A presente pesquisa se insere no ambiente de negócios atual, haja vista que cada vez aumenta mais o número de operadoras que sofrem a suspensão da venda de seus planos de saúde por incorrerem em problemas no atendimento aos seus beneficiários. Nesse sentido, o objetivo principal do presente estuo foi investigar se existe relação entre os dados financeiros e não financeiros que podem prever a incidência de suspensão da venda de planos de saúde das Operadoras aqui caracterizadas pelas Cooperativas Médicas. Para tanto, buscou-se construir Modelo de Previsão de Inadimplência que possa ser utilizado como instrumento de gestão e controle e que também possa contribuir no direcionamento do comportamento dos seus gestores. Para suportar o presente estudo, foram realizadas pesquisas na literatura sobre os conceitos de crédito, risco de crédito, inadimplência, modelos de previsão, regulação e sobre Operadoras de Planos de Saúde. A metodologia aplicada foi de caráter quantitativo, sendo que as amostras foram obtidas e selecionadas através dos dados constantes no site da ANS e o tratamento dos dados foi feito com o auxílio de planilhas eletrônicas e do software livre R. Como resultado do estudo, obteve-se um modelo que prevê a inadimplência de Cooperativas Médicas assim caracterizadas pela ocorrência da suspensão da venda de seus planos de saúde.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{claudiofardellicorropolese2025herramientas,
  title = {Herramientas de gestión y soluciones tecnológicas: un estudio comparado de casos},
