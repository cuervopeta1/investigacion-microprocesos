@article{rosadamarismarin-sandoval2019apropiacion,
  title = {La apropiación de la computadora y teléfono celular de estudiantes con discapacidad visual de la Universidad de Guadalajara. Acercamiento a las interacciones sociales en línea},
  author = {{Rosa Dámaris Marín-Sandoval} and {José Eduardo Portes Gil León}},
