@report{rightsandresourcesinitiative2024estado,
  title = {El estado del financiamiento para los derechos de tenencia y la custodia forestal: Financiamiento de donantes para los Pueblos Indígenas, comunidades locales y Pueblos Afrodescendientes en países boscosos forestales (2011–2023)},
  author = {{Rights and Resources Initiative}},
  date = {2024-05-16},
  doi = {10.53892/oect7536},
  url = {https://openalex.org/W4396948340},
  abstract = {El 10 de abril de 2024, Iniciativa para los Derechos y Recursos (RRI) y Rainforest Foundation Norway (RFN) lanzaron el panel Path to Scale, una nueva herramienta en línea de código abierto que facilita el acceso a los datos de financiación de donantes para los derechos de los Pueblos Indígenas, los Pueblos Afrodescendientes y las comunidades locales y la custodia de los bosques. Este nuevo informe analiza los datos del panel y las principales tendencias de financiación desde 2020. En él se constata que, si bien la financiación de los donantes entre 2020 y 2023 aumentó un 36 \% con respecto a los cuatro años anteriores, con una media de 517 millones de dólares estadounidenses al año, todavía no se ha producido ningún cambio sistemático en la financiación directa de los donantes a las organizaciones de titulares de derechos. Al poner estos datos a disposición por primera vez, el panel y el informe ayudarán a los donantes, las organizaciones no gubernamentales y los titulares de derechos a identificar brechas y oportunidades de financiación críticas en los esfuerzos mundiales para garantizar los derechos de las comunidades y combatir la doble crisis climática y de biodiversidad.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{rios-henao2021redes,
  title = {Redes comunitarias de cuidadores: acompañamiento a la movilización ciudadana para el cuidado compasivo},
  author = {Ríos-Henao, Laura and Cañaveral-Castro, Juan F. and Krikorian, Alicia},
  date = {2021-06},
  journaltitle = {Rev. salud pública},
  shortjournal = {Rev. salud pública},
  volume = {23},
  number = {3},
  pages = {1},
  issn = {0124-0064},
  doi = {10.15446/rsap.v23n3.89931},
  url = {http://www.scielo.org.co/scielo.php?script=sci_arttext&pid=S0124-00642021000300010&lang=pt},
  abstract = {ABSTRACT  Objective To present the process of contact and mobilization of a community, seeking to facilitate the development of a caregiving network in Medellín, Colombia.  Method The systematization process of the caregiving network's promotion was conducted according to the phases of clinical community involvement: contact with the community, clinical-community therapeutic modalities and analysis of the process. The method emplo-yed was community-based rehabilitation.  Results Training needs and family organization towards caregiving are the caregivers' major challenges are. The participants are aware of the relevance of creating support networks and have acquired practical knowledge useful to fulfill their daily needs, which are the foundations for future network development.  Conclusions The experience of promoting the development of a community network brings insights and concerns regarding the methods used and the actual caregiving needs of the community. Despite the difficulties encountered with collective actions, group cohesion and assistance to community gatherings, caregivers were able to reflect upon and learn about caregiving networks.},
  langid = {spanish},
  keywords = {apoyo social,BIREME),caregivers,Community networks,community participation,cuidadores,NLM),participación de la comunidad,política pública (fuente: DeCS,psychosocial support systems,public policy (source: MeSH,Redes comunitarias,sistemas de apoyo psicosocial,social support}
}

@article{rivera-vargas2025monografico,
  title = {Monográfico. El capitalismo digital BigTech y sus implicancias en los sistemas educativos globales},
  author = {Rivera-Vargas, Pablo and Herrera-Urízar, Gustavo and Trejo‑Quintana, Janneth},
