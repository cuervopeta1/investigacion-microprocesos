@article{alinesilvadebona2010portfolio,
  title = {Portfólio de Matemática: uma evidência do processo de aprendizagem com apropriação tecnológica},
  author = {{Aline Silva De Bona} and {Marcus Vinícius de Azevedo Basso}},
