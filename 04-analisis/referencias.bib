@article{soriaguzman2021mujeres,
  title = {Mujeres hacker, saber-hacer y código abierto: tejiendo el sueño hackfeminista},
  shorttitle = {Mujeres hacker, saber-hacer y código abierto},
  author = {Soria Guzmán, Martha Irene},
