@article{pabloolguin2015proceso,
  title = {Proceso de adopción e integración de recursos educativos abiertos (REA) en ambientes de aprendizaje de educación media},
  author = {{Pablo Olguín}},
  date = {2015-08-25},
  journaltitle = {Revista de investigación educativa de la escuela de graduados en educación/Revista de investigación educativa de la escuela de Graduados en Educación},
  shortjournal = {Revista de investigación educativa de la escuela de graduados en educación/Revista de investigación educativa de la escuela de Graduados en Educación},
  volume = {6},
  number = {11},
  pages = {21--28},
  url = {https://openalex.org/W2264057600},
  abstract = {La investigacion analiza el proceso de seleccion, integracion, aplicacion, adopcion y apropiacion tecnologica de Recursos Educativos Abiertos (REA) en profesores y estudiantes de nivel medio superior. En la metodologia de la investigacion se utilizo el estudio de caso, a traves del metodo cualitativo ; en la recoleccion de datos se aplicaron entrevistas a profundidad a los profesores, el cuestionario a los estudiantes y la guia de observacion a profesores y estudiantes. En los resultados, la integracion, aplicacion y adopcion del REA en el contenido, condujo a realizar modificaciones en el ambiente de aprendizaje, como la personalizacion de la tecnologia y el incremento del uso de las nuevas tecnologias. La apropiacion tecnologica se alcanza en un nivel de utilizacion debido a que tanto profesores como estudiantes demostraron poseer habilidades en el uso de TIC.},
