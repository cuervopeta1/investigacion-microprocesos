@article{barreda2024somos,
  title = {¿Somos lo que dice el dato?: El impacto de la huella digital en la toma de decisiones relevantes},
  shorttitle = {¿Somos lo que dice el dato?},
  author = {Barreda, Luis},
  date = {2024},
