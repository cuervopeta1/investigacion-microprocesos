@article{peraltagutierrez2023impacto,
  title = {El impacto de la DSA (Digital Services Act o Reglamento Europeo de Servicios Digitales) en los contratos de términos del servicio respecto a la moderación de contenidos online},
  author = {Peralta Gutiérrez, Alfonso},
  date = {2023},
  journaltitle = {Revista Aranzadi Doctrinal},
  number = {8},
  pages = {7},
  publisher = {Thomson Reuters Aranzadi},
  issn = {1889-4380},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9055857},
  urldate = {2026-11-13},
  abstract = {The EU considers it essential that service providers behave responsibly and diligently in order to create a safe, predictable and trustworthy online environment, implementing a European digital sovereignty to guarantee fundamental rights. For that purpose, the Digital Services Regulation aims to improve the transparency and accountability of online companies, as well as to increase the protection of users with initiatives that to some extent remind us of other bodies of legislation such as consumer law or regulated sectors returning to a public law after passing through the "laws of social networks". La UE considera esencial que los prestadores de servicios se comporten de modo responsable y diligente para crear un entorno en línea seguro, predecible y digno de confianza, implementando una soberanía digital europea para garantizar los derechos fundamentales. Para ello, el Reglamento de Servicios Digitales pretende mejorar la transparencia y la responsabilidad de las empresas en línea, así como aumentar la protección de los usuarios con iniciativas que en cierta medida nos recuerdan a otros «corpus» legislativos como el derecho de consumo, protección de datos o los sectores regulados retornando a un derecho público tras pasar por las “leyes de las redes sociales”},
  langid = {spanish}
}

