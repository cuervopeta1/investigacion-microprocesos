@article{angelayamilenogueratorres2026tic,
  title = {TIC y formulación de políticas públicas locales: diagnóstico para el municipio de Sotaquirá (Boyacá)},
  author = {{Angela Yamile Noguera Torres}},
  date = {2026-09-30},
  journaltitle = {Institutional Repository of the National University Open and Distance UNAD (Universidad Nacional Abierta y a Distancia)},
  shortjournal = {Institutional Repository of the National University Open and Distance UNAD (Universidad Nacional Abierta y a Distancia)},
  url = {https://openalex.org/W7220535887},
  abstract = {El municipio de Sotaquirá, en el departamento de Boyacá, enfrenta el desafío de incorporarse a los procesos de transformación digital en un contexto caracterizado por limitaciones de conectividad, capacidades institucionales restringidas y ausencia de una política pública local en Tecnologías de la Información y las Comunicaciones (TIC). Estas condiciones afectan la modernización de la administración pública, la inclusión digital de la ciudadanía y las oportunidades de desarrollo territorial. En respuesta a esta problemática, la presente investigación tuvo como propósito analizar las condiciones institucionales, técnicas y sociales del municipio para formular lineamientos estratégicos que orienten la construcción de una Política Pública TIC ajustada a las necesidades del territorio. La investigación se fundamenta en referentes nacionales e internacionales relacionados con la transformación digital, el gobierno digital y el cierre de brechas tecnológicas, entre ellos el Documento CONPES 3975 de 2019, el Plan Nacional de Desarrollo 2022–2026 y los Objetivos de Desarrollo Sostenible. Asimismo, considera las dinámicas de desarrollo local y los procesos de modernización impulsados por la administración municipal, reconociendo las TIC como herramientas estratégicas para fortalecer la gestión pública, la participación ciudadana y la competitividad territorial. Metodológicamente, el estudio adopta un enfoque mixto, con alcance descriptivo y exploratorio, desarrollado mediante un diseño de estudio de caso en el municipio de Sotaquirá. Se emplean técnicas de análisis documental y revisión de información institucional, junto con encuestas dirigidas a funcionarios públicos, docentes, estudiantes y miembros de la comunidad. La información cuantitativa se complementa con el análisis cualitativo de las percepciones y respuestas abiertas de los participantes, mediante procesos de codificación, categorización e interpretación temática. La integración de ambos tipos de información mediante triangulación cualitativa–cuantitativa permite construir un diagnóstico integral sobre el acceso, uso y apropiación de las TIC en el municipio, identificando fortalezas, limitaciones, necesidades y oportunidades que orientan la formulación de lineamientos estratégicos para la Política Pública TIC local. Los resultados evidencian brechas significativas en conectividad rural, disponibilidad y actualización de infraestructura tecnológica, formación en competencias digitales y apropiación social de las TIC. Aunque se identifican avances en procesos de digitalización institucional y una percepción positiva sobre el potencial de las tecnologías para mejorar la calidad de vida y la gestión pública, persisten limitaciones estructurales que afectan la sostenibilidad de los procesos de transformación digital. De igual manera, se observa una alta disposición de los diferentes actores locales para fortalecer sus capacidades digitales y participar en iniciativas orientadas al desarrollo tecnológico del municipio. Como aporte principal, la investigación formula lineamientos estratégicos para la construcción de una Política Pública TIC de Sotaquirá, estructurados en torno al fortalecimiento de la conectividad e infraestructura digital, el desarrollo de capacidades y apropiación tecnológica, la transformación digital institucional y la gobernanza digital participativa. Asimismo, se propone una hoja de ruta de implementación orientada a promover la inclusión digital, la modernización administrativa y el desarrollo territorial sostenible. Los hallazgos permiten concluir que la consolidación de una política pública TIC requiere fortalecer las capacidades institucionales, garantizar mecanismos de financiación sostenibles y promover la articulación entre actores públicos, educativos y comunitarios para reducir las brechas digitales y avanzar hacia un modelo de desarrollo más inclusivo y competitivo.},
  langid = {spanish},
  keywords = {iberoamericana}
}

