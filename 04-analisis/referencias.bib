@article{barcelos2026analise,
  title = {Análise tecnológica e de mercado do segmento de membranas de hemodiálise no Brasil com base nos dados de compras públicas federais},
  author = {Barcelos, Gustavo Feliciano de Jesus and family=Nogueira, given=Beatriz Godoi, prefix=de, useprefix=false and Figueiredo, Kátia Cecília de Souza and Tagliati, Carlos Alberto},
  date = {2026},
  journaltitle = {Cad. Saúde Pública},
  shortjournal = {Cad. Saúde Pública},
  volume = {42},
  issn = {0102-311X},
  doi = {10.1590/0102-311xpt106625},
  url = {http://www.scielosp.org/scielo.php?script=sci_arttext&pid=S0102-311X2026000105044&lang=pt},
  abstract = {This study analyzes the market and technology of the hemodialysis membrane segment in Brazil, based on public acquisitions made by the Brazilian Company of Hospital Services (EBSERH, acronym in Portuguese). Kidney failure, which affects about 10\% of the world’s population, represents a growing challenge for health systems, and Brazil is highly dependent on imports to meet the demand for dialyzers. From August 2022 to July 2023, EBSERH acquired 144,162 dialyzers, from six international manufacturers, evincing the absence of a national production and a great technological dependence on Brazil. Additionally, the physical and transport characteristics of the membranes were evaluated, such as materials used (predominance of polysulfone), dimensions and ultrafiltration coefficient. The results point to the need for robust public policies to foster national production, reducing costs, promoting innovation and strengthening Brazil’s technological autonomy. This work provides relevant information for the strategic planning of the hemodialysis sector, identifying gaps and opportunities for the development of a national hemodialysis membrane industry.},
  langid = {portuguese},
  keywords = {Administração em Saúde,Administración en Salud,Diálise Renal,Diálisis Renal,Health Administration,Hospital Hemodialysis Units,Renal Dialysis,Unidades de Hemodiálisis en Hospital,Unidades Hospitalares de Hemodiálise}
}

