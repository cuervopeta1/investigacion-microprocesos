@article{andreadanielaortegaherreta2022importancia,
  title = {Importancia de los simuladores virtuales para la enseñanza-aprendizaje de la asignatura de química inorgánica en las escuelas de educación media.},
  author = {{Andrea Daniela Ortega Herreta} and {Richard Field Julio} and {Álvaro David Hernández Ospino}},
  date = {2022-12-19},
  journaltitle = {Revista de Ciencias de la Educación Docencia Investigación y Tecnologías de la Información CEDOTIC},
