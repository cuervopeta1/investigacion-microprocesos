@article{gonzaleslara2026algorithmic,
  title = {Algorithmic {{Coloniality}}, {{Digital Sovereignty}}, and {{Cognitive Justice}} in the 21st {{Century}}},
  author = {Gonzales Lara, Jorge Yeshayahu},
  date = {2026},
  journaltitle = {Entretextos: Revista de Estudios Interculturales desde Latinoamérica y el Caribe},
  volume = {20},
  number = {40},
  pages = {208--227},
  publisher = {Universidad de la Guajira},
  issn = {2805-6159, 0123-9333},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10794311},
  urldate = {2026-11-13},
  abstract = {El artículo analiza el papel de los sistemas algorítmicos en la reconfiguración del capitalismo contemporáneo en América Latina, destacando su impacto en la distribución del poder, la producción de conocimiento y las nuevas formas de dependencia tecnológica. A partir de una revisión documental y un enfoque interdisciplinario que integra economía política digital, teoría de la dependencia y colonialidad del poder, se propone el concepto de colonialidad algorítmica para explicar la reproducción de jerarquías económicas, epistémicas y normativas mediante sistemas automatizados. El análisis, organizado en dimensiones infraestructural, epistémica y normativa, sostiene que estas arquitecturas refuerzan formas de subordinación digital, pero también abren posibilidades para estrategias orientadas a la soberanía tecnológica y la justicia cognitiva. The article analyzes the role of algorithmic systems in the reconfiguration of contemporary capitalism in Latin America, highlighting their impact on the distribution of power, knowledge production, and emerging forms of technological dependence. Based on a documentary review and an interdisciplinary approach that integrates digital political economy, dependency theory, and the concept of coloniality of power, it proposes the notion of algorithmic coloniality to explain the reproduction of economic, epistemic, and normative hierarchies through automated systems. The analysis, organized around infrastructural, epistemic, and normative dimensions argues that these architectures reinforce forms of digital subordination, while also opening possibilities for strategies aimed at technological sovereignty and cognitive justice.},
  langid = {english},
  file = {/home/cuervo/Zotero/storage/X7IUV95V/Gonzales Lara - 2026 - Algorithmic Coloniality, Digital Sovereignty, and Cognitive Justice in the 21st Century.pdf}
}

