@article{chingatehernandez2025hacia,
  title = {Hacia un constitucionalismo digital multinivel frente a la inteligencia artificial en América Latina},
  author = {Chingaté Hernández, Nathalie},
  date = {2025},
  journaltitle = {Revista Via Iuris},
  number = {39},
  pages = {1--33},
  publisher = {Fundación Universitaria Los Libertadores},
  issn = {1909-5759, 2500-803X},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10715779},
  urldate = {2026-11-13},
  abstract = {This article examines the challenges that agentic artificial technology poses to constitutional law in Latin America. It argues that the decision-making autonomy of these systems represents a new form of constitutional power that exceeds traditional legal categories, insofar as algorithmic autonomy is not understood as legal autonomy, but rather as a delegation derived from the institutional architecture itself. The article proposes articulating digital constitutionalism with multilevel constitutionalism as a normative framework capable of guaranteeing the protection of fundamental rights and promoting digital sovereignty and democratic governance in contexts of technological dependence such as that of Latin America. El artículo analiza los desafíos que plantea la inteligencia artificial agéntica para el derecho constitucional en América Latina. Se afirma que la autonomía de decisión de estos sistemas supone una nueva forma de poder constitucional que sobrepasa las categorías jurídicas tradicionales, pues no se entiende la autonomía algorítmica como autonomía jurídica, sino como una delegación que se otorga desde la misma arquitectura institucional. El trabajo plantea la articulación del constitucionalismo digital con el constitucionalismo multinivel como diseño normativo que garantice la protección de los derechos fundamentales y fomente la soberanía digital y la gobernabilidad democrática en contextos de dependencia tecnológica como el latinoamericano. O artigo analisa os desafios que a inteligência artificial agêntica impõe ao direito constitucional na América Latina. Sustenta-se que a autonomia decisória desses sistemas representa uma nova forma de poder constitucional que ultrapassa as categorias jurídicas tradicionais, uma vez que a autonomia algorítmica não é compreendida como autonomia jurídica, mas como uma delegação concedida pela própria arquitetura institucional. O trabalho propõe a articulação do constitucionalismo digital com o constitucionalismo multinível como um desenho normativo capaz de garantir a proteção dos direitos fundamentais e promover a soberania digital e a governança democrática em contextos de dependência tecnológica, como os existentes na América Latina.},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/FXHHKABR/Chingaté Hernández - 2025 - Hacia un constitucionalismo digital multinivel frente a la inteligencia artificial en América Latina.pdf}
}

@report{chirumamilla2025indigenous,
  title = {Indigenous {{Internet Networks}}},
  author = {Chirumamilla, Padma and Rosa, Fernanda R.},
  date = {2025-07-01},
  journaltitle = {VTechWorks (Virginia Tech)},
  url = {https://openalex.org/W7112636582},
  abstract = {This case study explores how Indigenous communities in Mexico are responding to digital inequalities and state neglect by building their own internet infrastructure grounded in communal values. Despite the constitutional guarantee of broadband access, commercial ISPs have failed to serve remote Indigenous regions like Guelatao (Zapoteco) and Abasolo (Tseltal). In response, these communities have repurposed residential internet connections and unlicensed spectrum to build shared networks that align with local values such as coexistence, tequio (communal labor), and comunalidad (collective governance). These grassroots infrastructures support not just connectivity but cultural autonomy and educational access, offering local intranets with Tseltal language materials and community-curated resources. Yet these networks remain vulnerable to commercial ISP policies, government regulations, and infrastructural precarity. The case illustrates how digital sovereignty intersects with Indigenous territorial rights and highlights broader questions of equity, ownership, and values in design. By resisting extractive and commercial models of internet access, the Zapoteco and Tseltal peoples reimagine what it means to build and govern technology on their own terms.},
  langid = {english},
  keywords = {inglesa}
}

@article{christiandavidrodriguezgonzalez2026modelo,
  title = {Modelo de arquitectura de software para la gestión de servicios en la comunidad de Candelaria Valle del Cauca, para mejorar la eficiencia operativa y organizativa},
  author = {{Christian David Rodríguez González}},
  date = {2026-06-04},
  journaltitle = {Repositorio Institucional Universidad Cooperativa de Colombia},
  shortjournal = {Repositorio Institucional Universidad Cooperativa de Colombia},
  url = {https://openalex.org/W7214866180},
  abstract = {La transformación digital en pequeñas y medianas empresas, conocidas como PYMES, del sector servicios representa un desafío significativo en contextos locales con baja apropiación tecnológica. Este estudio tiene como objetivo proponer un modelo de arquitectura de software orientado a la transformación digital y optimización de la gestión en negocios de servicios en la comunidad de Candelaria, Valle del Cauca. Metodológicamente, se adopta un enfoque mixto de tipo descriptivo y aplicado, que integra revisión de literatura, análisis de brecha digital mediante fuentes institucionales y recolección de información a través de entrevistas y encuestas. A partir de estos insumos, se diseña una arquitectura de software basada en principios como modularidad, escalabilidad y desacoplamiento, complementada con un modelo de datos y la implementación de un sistema web para la gestión de citas y control financiero. Los resultados evidencian mejoras en la organización operativa, reducción de tiempos, incremento en el control de ingresos y mayor satisfacción del cliente. Se concluye que la adopción de modelos arquitectónicos adaptados al contexto de las PYMES permite optimizar procesos y generar impacto social y cultural, siendo una solución replicable en contextos similares.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{christianemoisesmartins2021apropriacao,
  title = {Apropriação tecnológica de professores de Português Língua Estrangeira em tempos pandêmicos: uma reflexão sobre formação},
  author = {{Christiane Moisés Martins} and {Flávia Girardo Botelho Borges}},
  date = {2021-10-08},
  journaltitle = {Revista EntreLinguas},
  shortjournal = {Revista EntreLinguas},
  pages = {e021033-e021033},
  doi = {10.29051/el.v7i00.15516},
  url = {https://openalex.org/W3205326111},
  abstract = {O isolamento social decretado durante o período pandêmico do Sars-Cov19 trouxe à tona questões indeléveis ao campo da Educação. O presente artigo visa tecer reflexões sobre a formação de professores de Português Língua Estrangeira e sua iminente relação com as Tecnologias Digitais de Informação, Comunicação e Expressão (TICE). Tratamos da questão da apropriação à luz do lócus de enunciação e de preceitos da cibercultura, uma vez que essas bases teóricas fornecem insumos densos referente aos processos de ensino-aprendizagem inovadores. Durante um ano, observamos a práxis e processos de desenho pedagógicos que culminaram na produção desse artigo, o qual tece reflexões e provocações sobre questões inerentes à formação, desenvolvimento e capacitação de professores quanto a apropriação, uso e aplicação das TICE em suas práticas cotidianas.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{christineleyns2023disease,
  title = {From Disease- to People-Centred Pandemic Management: Organized Communities, Community-Oriented Primary Care and Health Information Systems},
  author = {{Christine Leyns} and {Sara J. T. Willems} and {Richard Antony Powell} and {Vivian Camacho} and {Ricardo Fábrega} and {Jan De Maeseneer} and {Salman Rawaf} and {Punam Mangtani} and {Austen A.R. El-Osta}},
  date = {2023-10-23},
  journaltitle = {International Journal for Equity in Health},
  shortjournal = {International Journal for Equity in Health},
  volume = {22},
  number = {1},
  pages = {225--225},
  doi = {10.1186/s12939-023-02032-z},
  url = {https://openalex.org/W4387875887},
  abstract = {BACKGROUND: The COVID-19 pandemic exposed the health equity gap between and within countries. Western countries were the first to receive vaccines and mortality was higher among socially deprived, minority and indigenous populations. Surprisingly, many sub-Saharan countries reported low excess mortalities. These countries share experiences with community organization and participation in health. The aim of this article was to analyse if and how this central role of people can promote a successful pandemic response. METHODS: This analysis was partly based on local and national experiences shared during an international and Latin American conference on person-and people-centred care in 2021. Additionally, excess mortality data and pandemic control-relevant data, as well as literature on the pandemic response of countries with an unexpected low excess mortality were consulted. RESULTS: Togo, Mongolia, Thailand and Kenya had a seven times lower mean excess mortality for 2020 and 2021 than the United States of America. More successful pandemic responses were observed in settings with experience in managing epidemics like Ebola and HIV, well-established community networks, a national philosophy of mutual aid, financial government assistance, more human resources for primary care and paid community health workers. DISCUSSION: Since trust in authorities and health needs vary greatly, local strategies are needed to complement national and international pandemic responses. Three key levers were identified to promote locally-tailored pandemic management: well-organized communities, community-oriented primary care, and health information systems. An organized community structure stems from a shared ethical understanding of humanity as being interconnected with each other and the environment. This structure facilitates mutual aid and participation in decision making. Community-oriented primary care includes attention for collective community health and ways to improve health from its roots. A health information system supports collective health and health equity analysis by presenting health needs stratified for social deprivation, ethnicity, and community circumstances. CONCLUSIONS: The difference in excess mortality between countries during the COVID-19 pandemic and various country experiences demonstrate the potential of the levers in promoting a more just and effective health emergency response. These same levers and strategies can promote more inclusive and socially just health systems.},
  langid = {english},
  keywords = {inglesa}
}

