  doi = {10.51302/tce.2022.720},
  url = {https://openalex.org/W4205282318},
  abstract = {La «apropiación social» se entiende como un proceso en el cual los ciudadanos (hombres y mujeres) y las comunidades utilizan de manera intencional y consciente herramientas tecnológicas, comprendiendo su función desde un punto de vista conceptual y práctico, percibiéndolas como útiles para su desarrollo educativo, laboral y social. El presente artículo de revisión tiene como propósito analizar el papel de la apropiación social de las tecnologías en época de pandemia. El análisis se realizó en el ámbito de la educación y del teletrabajo durante la cuarentena provocada por la COVID-19. La investigación se fundamentó en el paradigma interpretativo. El tipo de investigación fue documental y se aplicó el método del análisis de contenido de documentos científicos publicados en relación con las categorías de estudio. La reflexión final es que, a pesar de los beneficios que aportan las tecnologías de la información y la comunicación (TIC) en el ámbito educativo y laboral y su apropiación en época de pandemia, es inevitable pensar en las consecuencias negativas que pueden provocar en los jóvenes si no existe una supervisión adecuada por parte de padres o tutores.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{agostini2026multiagent,
  title = {Towards a {{Multi-Agent Network Society}}: A Paradigm Shift Inducedby Generative Artificial Intelligence},
  shorttitle = {Towards a {{Multi-Agent Network Society}}},
  author = {Agostini, Stefano},
  date = {2026},
  journaltitle = {Trilogía: Ciencia Tecnología Sociedad},
  volume = {18},
  pages = {3},
  publisher = {Instituto Tecnológico Metropolitano. Facultad de Artes y Humanidades},
  issn = {2145-7778, 2145-4426},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10768242},
  urldate = {2026-11-13},
  abstract = {Este artículo sostiene que la convergencia tecnológica que habilita la inteligencia artificial generativa requiere una extensión del marco fundacional de la Sociedad Red de Manuel Castells. El objetivo del estudio es introducir el modelo de sociedad red multiactor, proponiendo que la inteligencia artificial generativa puede conceptualizarse como una forma de agencia artificial capaz de iniciar y moldear acciones en entornos en red, incluso bajo objetivos y restricciones definidos por seres humanos, y de ejercer una selección (gatekeeping) operativa (de facto) a escala, con lo que la tecnología pasa de ser un instrumento neutral a un vector de  valor cargado. La metodología desarrolla el modelo conceptual mediante tres pasos analíticos: deconstrucción canónica del nodo centrado en lo humano; síntesis conceptual de la evidencia de agencia no humana y de casos ilustrativos; y construcción del modelo mediante razonamiento abductivo. El artículo sostiene que el vector de valor cuestiona conceptos establecidos como la soberanía digital y redefine la auto comunicación de masas, transformándola en comunicación de masas mediada algorítmicamente, con implicaciones para la confianza informativa y el discurso político. La utilidad pronóstica del modelo se explora discutiendo sus implicaciones en dominios tecnológicos de alto riesgo. El artículo concluye que los esfuerzos actuales de gobernanza global se basan en un modelo de control obsoleto y centrado en lo humano. This paper argues that the technological convergence enabling Generative Artificial Intelligence requires an extension of Manuel Castells’ foundational Network Society framework. The study’s objective is to introduce the Multi-Agent Network Society model, proposing that Generative Artificial Intelligence can be conceptualized as a form of artificial agency capable of initiating and shaping actions within networked environments, even under human-defined objectives and   constraints, and of enacting operational (de facto) gatekeeping at scale, which transforms technology from a neutral instrument into a value-laden vector. The methodology develops the conceptual model through three analytical steps: canonical deconstruction of the human-centric node; conceptual synthesis of non-human agency evidence and illustrative cases; and model construction via abductive reasoning. The paper argues that the value vector challenges established concepts such as digital sovereignty and redefines Mass Self-Communication, transforming it into algorithmically mediated mass communication, which has implications for information trust and political discourse. The model’s prognostic utility is explored by discussing its implications in high-stakes technological domains. The paper concludes that current global governance efforts are based on an outdated, human-centric control model.},
  issue = {38 (Enero-Abril Número especial)},
  langid = {english},
  file = {/home/cuervo/Zotero/storage/YPEXZAN9/Agostini - 2026 - Towards a Multi-Agent Network Society a paradigm shift inducedby generative artificial intelligence.pdf}
}

@thesis{aguilar-valencia2023effective,
  title = {Effective strategies to reduce maternal mortality in Cauca},
  author = {Aguilar-Valencia, Lina María and Anasco-Salamanca, Diana Astrith and Fajardo-Zuñiga, Ebelyn Dayanna and Quisoboni-Zuñiga, Herman Leni},
  date = {2023-11-11},
  journaltitle = {Minerva Digital Library (Universidad EAN)},
  url = {https://openalex.org/W7113231928},
  abstract = {Aproximadamente 830.000 mujeres mueren por causas prevenibles relacionadas con el embarazo y el parto en todo el mundo. Para el 2023, Colombia contabiliza un total de 175 muertes maternas en donde las principales causas son trastorno hipertensivo, hemorragia obstétrica y el evento tromboembólico. A nivel nacional a través de la resolución 3280 del 2018, se implementa la ruta integral de atención en salud para grupos de riesgo, en la que se encuentra la poblacional materno perinatal. A pesar de las estrategias implementadas para la reducción de la morbimortalidad, no se ha logrado su objetivo. El objetivo de este estudio fue determinar que estrategias son efectivas para la reducción de la mortalidad materna en el cauca, en contexto del plan de aceleración nacional del año 2023. Se realizó una revisión de la literatura tipo estado del arte. Se consultaron 3 bases de datos especializadas en salud y se replicó la misma estrategia de búsqueda con términos especializados. Se encontraron 134 artículos de los cuales se sintetizaron cualitativamente 8 de ellos. Se evidencio con esta investigación que “el plan de aceleración para reducir la mortalidad materna” dispuesto por el ministerio de salud se basa en 6 líneas de acción, centradas en la autonomía sexual, fortalecimiento de redes, acceso a intervenciones, cualificación institucional, información para autocuidado, y gobernanza. Adicionalmente se hizo evidente que las estrategias exitosas para reducir a morbimortalidad materna incluyen directrices políticas, apropiación tecnológica, y seguimiento, pero falta enfoque en gestión del talento humano e investigación propia, aspectos cruciales según estudios en otros países.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{aguilarbarcelo2026determinantes,
  title = {Determinantes de la apropiación tecnológica y la brecha digital en México: una exploración del IDTMex para 2016 y 2020},
  shorttitle = {Determinantes de la apropiación tecnológica y la brecha digital en México},
  author = {Aguilar Barceló, José Gabriel and Mahecha Guerra, Ronal E.},
  date = {2026},
  journaltitle = {CIENCIA ergo-sum},
  volume = {33},
  number = {1},
  pages = {1},
  publisher = {Universidad Autónoma del Estado de México},
  issn = {1405-0269},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10913988},
  urldate = {2026-11-13},
  abstract = {Se analizan las diferencias en materia de brecha digital y apropiación tecnológica entre los estados mexicanos y las regiones que conforman, así como el efecto que en ello tienen los factores sociodemográficos y socioeconómicos. El modelo estadístico utiliza información del índice de desarrollo de las tecnologías de la información y las comunicaciones (TIC) en México y de la Encuesta Nacional sobre Disponibilidad y Uso de Tecnologías de la Información en los Hogares. Se concluye que tanto el estrato socioeconómico como el nivel educativo inciden en la apropiación de las TIC y en el tamaño de la brecha digital, por lo que la sola provisión de infraestructura no puede garantizar la formación y desarrollo de habilidades digitales en la población This study examines the differences in the digital divide between Mexican states and their regions, as well as the impact of sociodemo-graphic and socioeconomic factors. A statistical model was developed using data from the Information and Communication Technolog y Development Index in Mexico and the National Survey on the Availability and Use of Information Technolog y in Households. It is concluded that socioeconomic status and educational level influence adoption of ICTs, as well as the extent of the digital divide. Therefore, providing an infrastructure alone cannot guarantee the development of digital skills among the population},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/LU893BUW/Aguilar Barceló y Mahecha Guerra - 2026 - Determinantes de la apropiación tecnológica y la brecha digital en México una exploración del IDTMe.pdf}
}

@article{aguileraalvarez2020sistema,
  title = {Sistema para la Evaluación Integral Estudiantil},
  author = {Aguilera Álvarez, Duriet and Rodríguez Rodríguez, Alcides},
  date = {2020},
  journaltitle = {Revista Innovación y Software},
  volume = {1},
  number = {2},
  pages = {52--61},
  publisher = {Universidad La Salle},
  issn = {2708-0935, 2708-0927},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8573498},
  urldate = {2026-11-13},
  abstract = {La Federación Estudiantil Universitaria en Cuba lleva a cabo un importante número de procesos que requieren reducir el tiempo de procesamiento de la información que se genera, estandarizar la documentación que aportan las diferentes áreas en relación con la organización y elevar la persistencia de los datos. En el presente informe se muestran los resultados de la implementación de la herramienta Sistema para la Evaluación Integral Estudiantil. Esta es una aplicación informática que asegura la calidad del proceso de evaluación estudiantil. Se centra principalmente en el proceso de integralidad y caracterización de los estudiantes, registrando mediante evidencias la trayectoria de cada uno de ellos en un expediente digital. El sistema es desarrollado sobre el marco de trabajo Django, utilizando como lenguaje de programación Python y empleando PostgreSQL como servidor de base de datos. Para guiar todo el proceso de desarrollo del sistema fue empleada la metodología AUP-UCI ajustándose a la soberanía tecnológica por la cual aboga Cuba. Cuenta con diez subsistemas que se integran entre sí y permiten el correcto funcionamiento, integridad y persistencia de los datos que se introducen y procesan. Como parte de la investigación se valida la herramienta a partir de diferentes pruebas al sistema permitiendo examinar el correcto funcionamiento del mismo. Los resultados satisfactorios en la validación del sistema le otorgan validez a la presente investigación, siendo esto la base para favorecer los procesos estudiantiles que tienen lugar en las universidades o sedes del país. The University Student Federation in Cuba carries out an important number of processes that require reducing the processing time of the information that is generated, standardizing the documentation provided by the different areas in relation to the organization, and increasing the persistence of the data. This report shows the results of the implementation of the Comprehensive Student Assessment System tool. This is a computer application that ensures the quality of the student evaluation process. It focuses mainly on the process of comprehensiveness and characterization of students, recording the trajectory of each of them in a digital file through evidence. The system was developed on the Django framework, using Python as the programming language, using PostgreSQL as the database server. To guide the entire development process of the system, the AUP-UCI methodology was used, adjusting to the technological sovereignty for which Cuba advocates. It has ten subsystems that are integrated with each other and allow the correct operation, integrity, and persistence of the data that is entered and processed. As part of the investigation, the tool is validated from different tests to the system which allowed to test the correct operation of the system and the satisfactory results of the same gave validity to the present investigation, this being the basis for the system to be able to promote student processes that take place in all universities or headquarters in the country.},
  langid = {spanish}
}

