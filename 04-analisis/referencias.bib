@article{j.martinez2025etnografia,
  title = {Etnografía Crítica y Procesos Comunicativos en el Barrio: Cómo Entender el Paso a la Comunicación en Red},
  author = {{J. Martínez}},
  date = {2025-06-30},
  journaltitle = {Ibero Ciencias - Revista Científica y Académica},
  shortjournal = {Ibero Ciencias - Revista Científica y Académica},
  volume = {4},
  number = {2},
  pages = {354--407},
  doi = {10.63371/ic.v4.n2.a72},
  url = {https://openalex.org/W4411795053},
  abstract = {This article offers a critical and systematic review of the processes of technological and communicative appropriation in communities, based on the semiotic dynamics that emerge in popular neighborhoods in Latin America. It adopts a methodological approach grounded in critical and digital ethnography. The main objective is to analyze how marginalized communities re-signify technology and digital platforms from their own cultural horizons, generating new forms of communication, social organization, and collective meaning-making. Through the review of empirical cases, regional reports, book chapters, and recent theses, the article identifies key changes in social life, methodological, ethical, and political challenges in research, as well as theoretical gaps and future lines of inquiry. The findings show that technological appropriation is neither linear nor homogeneous; rather, it involves creativity, resistance, negotiation, and collective agency, leading to complex communication systems and new repertoires of digital citizenship. The analysis highlights the importance of collaborative models, transdisciplinary approaches, and situated methodologies for doctoral research, promoting the construction of relevant, inclusive, and transformative knowledge in the digital era. This work contributes to consolidating the field of community communication and technology studies by offering concrete recommendations and paving the way for future doctoral research committed to social justice and technological equity.},
  langid = {spanish},
  keywords = {inglesa}
}

@article{jackbowers2019tei,
  title = {{{TEI Encoding}} of a {{Classical Mixtec Dictionary Using GROBID}}- {{Dictionaries}}},
  author = {{Jack Bowers} and {Mohamed Khemakhem} and {Laurent Romary}},
  date = {2019-10-01},
  journaltitle = {HAL},
  shortjournal = {HAL},
  url = {https://openalex.org/W3015979357},
  abstract = {This paper presents the application of GROBID-Dictionaries (Khemakhem et al. 2017, Khemakhem et al. 2018a, Khemakhem et al. 2018b, Khemakhem et al. 2018c), an open source machine learning system for automatically structuring print dictionaries in digital format into TEI (Text Encoding Initiative) to a historical lexical resource of Colonial Mixtec 'Voces del Dzaha Dzahui' published by the Dominican fray Francisco Alvarado in the year 1593. The GROBID-Dictionaries application was applied to a reorganized and modernized version of the historical resource published by Jansen and Perez Jiménez (2009). The TEI dictionary produced will be integrated into a language documentation project dealing with Mixtepec-Mixtec (ISO 639-3: mix) (Bowers \& Romary, 2017, 2018a, 2018b) an under-resourced indigenous language native to the Juxtlahuaca district of Oaxaca Mexico.},
  langid = {english},
