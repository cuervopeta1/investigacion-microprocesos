@article{astudillonahuelcoy2025datos,
  title = {De los datos a las decisiones: Monitoreo de órdenes de trabajo de la dirección de servicios y logística de la Universidad de Tarapacá},
  author = {Astudillo Nahuelcoy, Ramón and Fernández Gutiérrez, Daniel and Mirabal, Pedro and Espinosa Oliva, Roberto},
  date = {2025},
  journaltitle = {Ingeniare. Rev. chil. ing.},
  shortjournal = {Ingeniare. Rev. chil. ing.},
  volume = {33},
  issn = {0718-3305},
  doi = {10.4067/s0718-33052025000100209},
  url = {http://www.scielo.cl/scielo.php?script=sci_arttext&pid=S0718-33052025000100209&lang=pt},
  abstract = {ABSTRACT The exponential growth of data has highlighted its importance as a strategic resource for business decision-making, although a significant gap persists between data generation and organizations' analytical capabilities. This article presents a methodology for developing customized dashboard-type analytical tools, focused on effective data visualization and aligned with the concept of technological sovereignty. The methodology consists offourphases: planning, design, implementation, and testing, integrating exploratory data analysis and interactive visualizations. This proposal aims to address the limitations of proprietary tools, including high costs, dependencies, and customization restrictions, by utilizing ad-hoc solutions based on open-source software. A case study is presented, applied to the Services and Logistics Department of the Universidad de Tarapacá, where a dashboard was implemented for real-time monitoring of work orders. The results show improved decision-making, reduced response times, and increased operational efficiency.},
  langid = {spanish},
  keywords = {ciencia de datos,dashboard,data science,Data-driven decision making,soberanía tecnológica,technological sovereignty,Toma de decisiones basada en datos}
}

@article{astudillonahuelcoy2025datosa,
  title = {De los datos a las decisiones: Monitoreo de órdenes de trabajo de la dirección de servicios y logística de la Universidad de Tarapacá},
  shorttitle = {De los datos a las decisiones},
  author = {Astudillo Nahuelcoy, Ramón and Fernández Gutiérrez, Daniel and Mirabal, Pedro and Espinosa Oliva, Roberto},
  date = {2025},
  journaltitle = {Ingeniare: Revista Chilena de Ingeniería},
  volume = {33},
  number = {1},
  pages = {9},
  publisher = {Universidad de Tarapacá},
  issn = {0718-3305, 0718-3291},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10814370},
  urldate = {2026-11-13},
  abstract = {The exponential growth of data has highlighted its importance as a strategic resource for business decision-making, although a significant gap persists between data generation and organizations' analytical capabilities. This article presents a methodology for developing customized dashboard-type analytical tools, focused on effective data visualization and aligned with the concept of technological sovereignty. The methodology consists offourphases: planning, design, implementation, and testing, integrating exploratory data analysis and interactive visualizations. This proposal aims to address the limitations of proprietary tools, including high costs, dependencies, and customization restrictions, by utilizing ad-hoc solutions based on open-source software. A case study is presented, applied to the Services and Logistics Department of the Universidad de Tarapacá, where a dashboard was implemented for real-time monitoring of work orders. The results show improved decision-making, reduced response times, and increased operational efficiency. El crecimiento exponencial de los datos ha resaltado su importancia como recurso estratégico para la toma de decisiones empresariales, aunque persiste una brecha significativa entre la generación de datos y la capacidad de análisis de las organizaciones. Este artículo presenta una metodología para el desarrollo de herramientas analíticas personalizadas tipo dashboard, enfocadas en la visualización efectiva de datos y alineadas con el concepto de soberanía tecnológica. La metodología abarca cuatro fases: planificación, diseño, implementación y prueba, integrando análisis exploratorio de datos y visualizaciones interactivas. Esta propuesta busca superar las limitaciones de herramientas propietarias, como costos, dependencia y restricciones de personalización, mediante soluciones ad-hoc basadas en software de código abierto. Se presenta un caso de estudio aplicado en la Dirección de Servicios y Logística de la Universidad de Tarapacá, donde se implementó un dashboard para el monitoreo en tiempo real de las órdenes de trabajo. Los resultados muestran una mejora en la toma de decisiones, reducción de tiempos de respuesta y mayor eficiencia operativa.},
  langid = {spanish}
}

@thesis{asubadinasubadin2006diseno,
  title = {Diseño e implementación de una aplicación web para la gestión y planificación de cursos de capacitación usando herramientas OPEN-SOURCE},
  author = {{Asubadín Asubadín} and {Manuel Elías}},
  date = {2006-06-01},
  journaltitle = {Repositorio Institucional de la Universidad de las Fuerzas Armadas ESPE (Universidad de las Fuerzas Armadas ESPE)},
  url = {https://openalex.org/W2281504881},
  abstract = {El presente proyecto se ha desarrollado con el propósito de facilitar al INDESIC en el trabajo al que se dedica, que es la de capacitar a jóvenes indígenas y presentarles una nueva alternativa de capacitar mediante la tecnología y medios disponibles en la actualidad. Este trabajo se ha desarrollado usando software de código abierto (open source) y software libre, como son: sistema operativo Linux, base de datos MySql, tecnología de desarrollo Java (JSP, Servlest), Apache Web Server y servidor de aplicaciones Tomcat. El ciclo de vida usado para el desarrollo de la aplicación es el Espiral, que se basa en dar vueltas en círculo varias veces hasta obtener un producto terminado. Además, para la obtención de los requerimientos del usuario se ha procedido según el estándar IEEE 830, con la que se ha realizado la Especificación de Requerimientos de Software. Como parte importante de la ingeniería del software se ha realizado diagramas de diseño del software basados en la metodología orientada a objetos. También se ha realizado el diagrama de contexto y los DFD con el fin de comprender los procesos de la aplicación. En la implementación se ha utilizado los Servlets, Beans y JSP, todos estos componentes se basan en la tecnología Java, que es una de las herramientas para realizar aplicaciones para Internet. Los JSP se usa para dar el formato a las ventanas de los usuario, los Servlets se han usado para implementar el acceso a datos y los Beans representan a las clases. Finalmente, como parte importante en la ingeniería del software, se han realizado las pruebas a la aplicación, esto permite detectar fallas que pudieran no haberse controlado en el desarrollo de la aplicación. Estas pruebas se han realizado siguiendo el estándar IEEE Std. 829.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@book{auramariatorresreyes2026educacion,
  title = {EDUCACION, INNOVACIÓN Y TRANSFORMACIÓN: PERSPECTIVAS CONTEMPORÁNEAS SOBRE INTELIGENCIA ARTIFICIAL, PRÁCTICAS PEDAGÓGICAS Y DESARROLLO ESTUDIANTIL},
  author = {{Aura María Torres Reyes} and {Reina Castellanos-Vega} and {Cristhian Hernán Bonilla Gutierrez} and {Alberto Villa Valencia}},
  date = {2026-06-04},
  journaltitle = {Zenodo (CERN European Organization for Nuclear Research)},
  doi = {10.5281/zenodo.20533443},
  url = {https://openalex.org/W7163361195},
  abstract = {La educación atraviesa un periodo de profunda transformación y reflexión, impulsado por múltiples factores que convergen, como la irrupción acelerada de la inteligencia artificial, la renovación de enfoques pedagógicos, la creciente preocupación por el bienestar estudiantil y la necesidad de fortalecer la convivencia democrática y la resiliencia ciudadana en entornos complejos, inciertos e hiper digitalizados. Estos procesos no solo reorganizan y reconfiguran las prácticas educativas, sino que también ponen a prueba la capacidad de las instituciones para adaptarse, innovar y responder ante nuevas demandas sociales, culturales y tecnológicas. En este contexto, las instituciones educativas de todos los niveles se enfrentan al desafío de repensar su cotidianidad pedagógica desde las tensiones y posibilidades que surgen al integrar nuevas tecnologías, promover el desarrollo de competencias socioemocionales y a su vez, garantizar procesos inclusivos, pertinentes y de calidad. La fragilidad y el dinamismo de los contextos actuales exigen una mirada crítica y creativa que permita comprender la complejidad de los cambios en curso y orientar decisiones educativas informadas. El presente volumen reúne contribuciones desarrolladas originalmente en distintas lenguas —español, portugués, inglés— reflejo de la diversidad geográfica y académica de los autores participantes. Con el fin de respetar la voz y estilo de cada equipo investigador, se optó por mantener los capítulos en su idioma original y unificar en español con su correspondencia en inglés, aquellos que tenían una versión previa en español. En consecuencia, la obra se organiza en dos grandes apartados según el idioma, siendo configurada por una serie de capítulos que, desde perspectivas diversas pero complementarias, analizan estas transformaciones y ofrecen propuestas innovadoras para la lectura, comprensión e intervención educativa. Los textos se organizan en cuatro grandes secciones que dialogan entre sí y permiten recorrer distintos niveles, actores y problemáticas del sistema educativo: Sección 1. Transformaciones tecnológicas y educativas. Los capítulos de este apartado abordan la relación entre inteligencia artificial y educación superior desde diferentes ángulos: el análisis de la oferta académica y su vínculo con los índices de apropiación tecnológica, la presentación de experiencias de innovación universitaria y la exploración de metodologías emergentes para el desarrollo de competencias digitales. Sección 2. Innovación pedagógica y desarrollo del lenguaje, la creatividad y la comprensión. Aquí se presentan dos propuestas pedagógicas situadas en niveles educativos distintos — educación básica primaria y educación superior— que muestran cómo la narrativa, la creatividad y la mediación cognitiva pueden convertirse en motores de aprendizaje profundo y significativo, y una tercera propuesta que analiza los alcances y las limitaciones del modelo de estimación de mínimos cuadrados en el contexto de la investigación educativa. Sección 3. Convivencia, liderazgo y articulación institucional. Este apartado examina las dinámicas de gestión, liderazgo y poder dentro de las instituciones educativas, así como las posibilidades de articulación entre escuela y universidad para fortalecer la medicación escolar y promover entornos democráticos e inclusivos. Sección 4. Bienestar, desarrollo cognitivo y contextos educativos específicos. Los capítulos finales ofrecen aproximaciones conceptuales y estudios aplicados que permiten comprender la relación entre educación, bienestar, funciones cognitivas y resiliencia, atendiendo contextos diferenciados y problemáticas emergentes. En conjunto, estos capítulos ofrecen una mirada amplia, articulada y crítica sobre los retos y oportunidades que afronta la educación contemporánea. Destacan la importancia de la innovación pedagógica, la colaboración interinstitucional, el desarrollo humano y la resiliencia como ejes fundamentales para dar respuesta ante los desafíos que plantean los escenarios educativos emergentes.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@inproceedings{avalosgutierrez2007politica,
  title = {La política de la política científica y tecnológica venezolana: Una reflexión sobre casi cuatro décadas},
  shorttitle = {La política de la política científica y tecnológica venezolana},
  booktitle = {Claves del desarrollo científico y tecnológico de América Latina, 2007, ISBN 978-84-323-1305-9, págs. 405-447},
  author = {Avalos Gutiérrez, Ignacio},
  date = {2007},
  pages = {405--447},
  publisher = {Siglo XXI de España},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=7088520},
  urldate = {2026-11-13},
  abstract = {A lo largo de casi cuatro décadas, Venezuela ha tenido una evolución importante en su política de ciencia, tecnología e innovación. Comprimiendo al máximo lo ocurrido podría decirse que se ha pasado de una política concentrada en la ciencia y administrada por la comunidad de investigadores, a una política que entra también en la zona de la tecnología y de la innovación y es administrada por el Estado, esto es, es asumida claramente como una política pública. Ese cambio ha supuesto, asimismo, la paulatina presencia de otros actores sociales (además de los investigadores) en plan de actores e interlocutores, conforme a un modo de producción del conocimiento «socialmente distribuido». Además, dicha política se ha centrado en torno a tres ideas básicas —la soberanía tecnológica, el desarrollo endógeno y la apropiación social del conocimiento—, dentro del marco que implica la transición de la actual sociedad capitalista rentística hacia la sociedad socialista del siglo XXI.},
  eventtitle = {Claves del desarrollo científico y tecnológico de América Latina},
  isbn = {978-84-323-1305-9},
  langid = {spanish}
}

