@article{morenotrujillo2016usoa,
  title = {Uso de plataformas de libre distribución (LMS) para educación básica},
  author = {Moreno Trujillo, Helena and Pintor Chávez, María Manuela and Gómez Zermeño, Marcela Georgina},
  date = {2016},
  journaltitle = {TE \& ET: Revista Iberoamericana de Tecnología en Educación y Educación en Tecnología},
  number = {17},
