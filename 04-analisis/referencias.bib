@article{prato2022redesa,
  title = {Las redes comunitarias de Internet y la producción colaborativa de conocimiento tecnológico y político},
  author = {Prato, Anna Valeria and Weckesser, Cintia and Segura, María Soledad},
  date = {2022},
  journaltitle = {Comunicación y sociedad},
  number = {19},
