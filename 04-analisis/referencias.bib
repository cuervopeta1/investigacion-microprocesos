@article{gomessamia2025arqueologia,
  title = {Arqueología digital decolonial: tecnologías y epistemologías del sur para la apropiación de narrativas patrimoniales en América Latina: Artículo},
  shorttitle = {Arqueología digital decolonial},
  author = {Gomes Samia, Danielle},
  date = {2025},
  journaltitle = {Práctica arqueológica: revista de la Asociación de Arqueólogos Profesionales de la República Argentina},
  volume = {8},
  number = {2},
  pages = {19--30},
  publisher = {Asociación de Arqueólogos Profesionales de la República Argentina},
  issn = {2618-2874},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10516563},
  urldate = {2026-11-13},
  abstract = {The article critically analyzes digital archaeology from a decolonial perspective in Latin America. It recognizes that digital technologies provide tools to research, preserve, and disseminate cultural heritage, but warns that their uncritical use can reproduce historical inequalities and reinforce colonial power structures, rendering local knowl­edge invisible by being designed from hegemonic visions. In response, it proposes digital archaeology that does not limit itself to the use of technologies but recon­figures them as instruments at the service of communities. It suggests integrating scientific, Indigenous, Afro-descendant, and popular knowledge into collaborative processes that foster horizontal dialogue and respect for local cosmologies. The ap­proach is based on three pillars: radical collaboration, technological sovereignty, and the co-creation of heritage narratives. It advocates for the development of digital tools adapted to community contexts, local infrastructures for managing heritage data, and interactive platforms that express collective memories through the voices of those who live them. This decolonial digital archaeology seeks epistemic justice, recogniz­ing heritage as a living source of identity, resistance, and future. It aspires to a more just, plural archaeological practice committed to territories and their communities, transforming the relationship between technology, knowledge, and memory in favor of diversity and cultural autonomy. El artículo analiza críticamente la arqueología digital desde una perspectiva decolonial en América Latina. Reconoce que las tecnologías digitales aportan herramientas para investigar, preservar y difundir el patrimonio cultural, pero advierte que su uso acrítico puede reproducir desigualdades históricas y reforzar estructuras de poder coloniales, invisibilizando saberes locales al estar diseñadas desde visiones hegemónicas. Frente a ello, se plantea una arqueología digital que no se limite al empleo de tecnologías, sino que las reconfigure como instrumentos al servicio de las comunidades. Se propone integrar conocimientos científicos, indígenas, afrodescendientes y populares en procesos colaborativos que fomenten el diálogo horizontal y el respeto por las cosmologías locales. El enfoque se sostiene en tres pilares: colaboración radical, soberanía tecnológica y co-creación de narrativas patrimoniales. Se sugiere crear herramientas digitales adaptadas a los contextos comunitarios, infraestructuras locales para gestionar datos patrimoniales y plataformas interactivas que expresen memorias colectivas desde las voces de quienes las viven. Esta arqueología digital decolonial busca la justicia epistémica, reconociendo el patrimonio como fuente viva de identidad, resistencia y futuro. Aspira a una práctica arqueológica más justa, plural y comprometida con los territorios, transformando la relación entre tecnología, conocimiento y memoria en favor de la diversidad y la autonomía cultural. Este artigo examina criticamente o campo da arqueologia digital a partir de uma perspectiva decolonial, com foco nos contextos latino-americanos. Embora as tecnologias digitais ofereçam ferramentas inovadoras para a pesquisa, preservação e difusão do patrimônio cultural, sua implementação sem uma reflexão crítica pode reproduzir desigualdades históricas e reforçar estruturas de poder herdadas do colonialismo. Interfaces, algoritmos e modelos de representação costumam ser concebidos a partir de perspectivas hegemônicas, o que pode invisibilizar saberes locais e formas diversas de compreender o passado.Diante desse panorama, propõe-se uma arqueologia digital que não apenas utilize tecnologias avançadas, mas que as reconfigure como instrumentos a serviço das comunidades. Essa prática busca integrar conhecimentos científicos, indígenas, afrodescendentes e populares em processos colaborativos, promovendo o diálogo horizontal e o respeito às cosmologias locais. A abordagem se baseia em três pilares fundamentais: colaboração radical, soberania tecnológica e co-criação de narrativas patrimoniais.A proposta inclui o uso de ferramentas digitais adaptadas aos contextos comunitários, o desenvolvimento de infraestruturas locais para a gestão de dados patrimoniais e a criação de plataformas interativas que expressem as memórias coletivas a partir das próprias vozes de quem as vive. Essa arqueologia digital decolonial orienta-se pela justiça epistêmica, reconhecendo que o patrimônio não é apenas objeto de estudo, mas também fonte viva de identidade, resistência e futuro. Em síntese, trata-se de construir uma prática arqueológica mais justa, plural e comprometida com os territórios e suas comunidades.},
  langid = {spanish}
}

