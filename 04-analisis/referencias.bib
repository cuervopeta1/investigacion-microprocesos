@article{anajesuslopez2012aprendizaje,
  title = {Aprendizaje abierto y cooperativo de Econometria. Reflexiones de dos decadas y perspectivas de futuro},
  author = {{Ana Jesús López} and {Rigoberto A. Curbelo Pérez}},
  date = {2012-09-25},
