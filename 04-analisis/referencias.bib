@article{mariaalexandraespinosacarreno2025explicando,
  title = {Explicando las barreras de apropiación tecnológica desde la perspectiva de las características de diseño empleadas en la interacción campesino-innovaciones agrícolas},
  author = {{Maria Alexandra Espinosa Carreño} and {Maria Fernanda Mantilla Arango} and {Doris Amparo Barreto Osma} and {Roman Eduardo Sarmiento Porras}},
  date = {2025-12-01},
  journaltitle = {DOAJ (DOAJ: Directory of Open Access Journals)},
  shortjournal = {DOAJ (DOAJ: Directory of Open Access Journals)},
  doi = {10.29375/25392115.5536},
  url = {https://openalex.org/W7124542706},
  abstract = {Ante la imperante necesidad de salvaguardar la seguridad alimentaria mundial, diversos sectores académicos, gubernamentales y empresariales han dedicado esfuerzos para optimizar la producción agrícola a pequeña escala mediante tecnologías como la agricultura de precisión. No obstante, la creciente brecha tecnológica, explicada principalmente por las capacidades digitales y la deficiencia de infraestructura propia de las zonas rurales, entorpece la implementación de dichas tecnologías en dicho sector. Este artículo propone una causa adicional relacionada con las características de diseño empleadas en el manejo campesino-solución, resultado de una revisión sistemática de la literatura de 101 artículos científicos publicados entre 2015 y 2021, así como de una vigilancia tecnológica de cuatro empresas reconocidas a nivel mundial por el desarrollo de soluciones para el riego. Se identificaron ocho características de interacción en las distintas soluciones seleccionadas para el estudio, lo que facilitó la comparación de los diseños implementados en el ámbito académico y en la industria. Dichas características contribuyeron a identificar las deficiencias en el desarrollo de innovaciones agrícolas digitales para el sector agrícola de pequeña escala y a analizar su influencia en las barreras de apropiación tecnológica.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{mariaaparecidafloresdesousajunqueirade[unesp]andrade2024niveis,
  title = {Níveis de apropriação tecnológica após o contexto pandêmico : o caso dos licenciandos do IFPE - Campus Vitória à luz das categorias do Centro de Inovação para a Educação Brasileira (CIEB)},
  author = {{Maria Aparecida Flores de Sousa Junqueira de [UNESP] Andrade}},
  date = {2024-06-13},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  url = {https://openalex.org/W7120618722},
  abstract = {O uso das tecnologias digitais teve um aumento significativo no ano de 2020 por causa da pandemia de Covid-19, quando os docentes precisaram se apropriar desses recursos na prática educacional, mesmo sem formação específica. Ao mesmo tempo, pesquisadores nacionais e internacionais têm desenvolvido matrizes de competências digitais que são esperadas dos docentes, através de análises dos níveis de apropriação tecnológica, como as que têm sido propostas pelo Centro de Inovação para a Educação Brasileira (CIEB). Assim, surge o seguinte questionamento desta pesquisa: Quais níveis de apropriação tecnológica os licenciandos dos últimos períodos do curso de Licenciatura em Química do IFPE - Campus Vitória, têm desenvolvido para utilização das TDICs na prática docente após o contexto pandêmico? Este curso de Licenciatura é o único curso de formação docente no Instituto Federal de Pernambuco, da região de Vitória de Santo Antão/PE). O objetivo geral da pesquisa foi analisar os níveis de apropriação tecnológica dos licenciandos dos últimos períodos do curso de Química do IFPE/Campus Vitória. E os objetivos específicos: (1) Identificar os níveis de apropriação tecnológica dos licenciandos dos últimos períodos do curso de Química do IFPE - Campus Vitória; (2) Comparar os níveis de apropriação tecnológica identificados na presente pesquisa com os níveis de apropriação tecnológica descritos na literatura antes e após o contexto pandêmico; e (3) Descrever as fragilidades dos licenciandos na utilização das TDICs no processo de ensino e aprendizagem. A pesquisa tem uma abordagem qualitativa de condição exploratória e descritiva, tendo como principal referencial teórico a matriz curricular do Centro de Inovação para Educação Brasileira- CIEB (2019). Como instrumento de coletas de dados foi realizado um questionário piloto, análises documentais e entrevista semiestruturada. A análise dos dados foi realizada por meio da abordagem de análise de conteúdo (Moraes, 1999). Após a realização da análise dos dados foi possível concluir que a maioria dos licenciandos participantes utilizam as TDICs pontualmente em suas atividades e identifica as tecnologias como apoio ao ensino. Desta forma, apresentam o nível de apropriação tecnológica caracterizado como “Familiarização” segundo os critérios do CIEB. Assim, ressalta-se a importância de estratégias de desenvolvimento profissional voltadas para uma integração mais ampla e eficaz das TDICs no contexto educacional.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{mariabelenrosales2019apropiaciones,
  title = {Apropiaciones tecnológicas, visibilidad y subjetividades colectivas en \#niunamenos 2015-2016},
  author = {{María Belén Rosales} and {María Florencia Cremona} and {Alejandra Valentino}},
  date = {2019-04-04},
  journaltitle = {Investigación Joven},
  shortjournal = {Investigación Joven},
  volume = {6},
  pages = {208--209},
  url = {https://openalex.org/W3035082331},
  abstract = {El artículo se propone identificar el contexto cultural en que se produce \#NiUnaMenos y los actores sociales que forman parte del fenómeno a fin de dar cuenta de su compleja polifonía. Asimismo, nos interrogamos por los usos y las prácticas de apropiación tecnológica en los modos de acción política y formas de agencia colectiva desplegadas en las convocatorias de los años 2015 y 2016. En este marco, la pregunta por las apropiaciones tecnológicas en campañas y activismos feministas y del movimiento de mujeres en línea, desde una perspectiva ciberfeminista, se articula a la interrogación por los vínculos con las perspectivas y prácticas de los modos de militancia "tradicionales" y la emergencia de nuevos marcos de referencia, de representación y de acción vinculadas a lógicas "nativas digitales" de la sociedad-red- global que las reconfiguran, desbordan y ponen en tensión en la cibercultura. A su vez, este concepto permite comprender las formas en las que fluyen transversalmente las dimensiones política, cultural y económica en la espiral de dominación / resistencia desde investigaciones que, emplazadas en el campo de los estudios de género y TICs, enlazan las relaciones de la cibercultura con la cultura patriarcal o androcéntrica e indagan los efectos sociales que devienen del uso y apropiación de este campo socio- simbólico.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{mariacamilaescuderosolera2024psicologia,
  title = {Psicología Ancestrales Propuesta De Intervención Psicosocial: Estrategias de Intervención Psicosocial para Navegar en el Conflicto entre Tradición y Modernidad en el pueblo Indígena ¨Wixarika¨ mediante el Enfoque ancestral},
  author = {{María Camila Escudero Solera} and {María Alejandra Lemus Villadiego} and {Gessy Cecilia Arroyo Bedoya} and {Sara Edith Rico Gomez}},
  date = {2024-11-25},
  journaltitle = {Repositorio Institucional Universidad Cooperativa de Colombia},
  url = {https://openalex.org/W7215003147},
  abstract = {Este proyecto de intervención psicosocial está diseñado para abordar el conflicto entre tradición y modernidad en el pueblo indígena Wixarika, utilizando un enfoque correlacional basado en su cosmovisión y prácticas ancestrales. El pueblo indígena Wixarika está ubicada en la región occidental de México, Sin embargo, enfrenta desafíos derivados de la influencia de la modernidad, la migración y el debilitamiento de las tradiciones en las generaciones jóvenes, experimenta así tensiones intergeneracionales y sociales que afectan la transmisión cultural, la cohesión familiar y su identidad colectiva. Todos estos conflictos surgen de la coexistencia de valores tradicionales con las exigencias del mundo contemporáneo por lo tanto buscamos promover la cohesión social y el fortalecimiento de la identidad cultural Wixarika mediante estrategias psicosociales que permitan equilibrar la preservación de sus tradiciones con la integración de elementos de la modernidad. El diseño metodológico de este proyecto de intervención psicosocial incluye un enfoque correlacional y participativo, basado en herramientas como entrevistas, talleres, observación etnográfica y análisis de redes comunitarias con esto esperamos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{mariaclaraaquinobittencourt2016em,
  title = {Em tempos de midiatização do ativismo: repensando características da narrativa jornalística digital através da apropriação do medium pelo Mídia Ninja},
  author = {{Maria Clara Aquino Bittencourt}},
  date = {2016-12-17},
  journaltitle = {Animus Revista Interamericana de Comunicação Midiática},
  shortjournal = {Animus Revista Interamericana de Comunicação Midiática},
  volume = {15},
  number = {30},
  doi = {10.5902/2175497716199},
  url = {https://openalex.org/W2573600439},
  abstract = {Este artigo parte da premissa de midiatização do ativismo em processos de produção e circulação de conteúdos em contexto de movimentos em rede. Trabalha-se o impacto da midiatização nas práticas jornalísticas digitais para em seguida voltar a atenção para os recursos midiáticos empregados na narrativa construída pelo Mídia Ninja em sua página no Medium, uma ferramenta de publicação de conteúdo adotada pelo coletivo no início de 2014. O olhar para esta ferramenta permite inferir apontamentos que indicam como a apropriação tecnológica, fundamentada em aspectos sociais e calcada na midiatização do ativismo, é, ao mesmo tempo, capaz de provocar a evolução e promover a continuidade de características da narrativa jornalística digital.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{mariaclaramarcondesviannakataja2026indigenous,
  title = {Indigenous {{Voices Beyond Borders}}: {{Brazilian Digital Activism}} in the {{Global North}}},
  author = {{Maria Clara Marcondes Vianna Kataja}},
  date = {2026-05-15},
  journaltitle = {Työväentutkimus Vuosikirja},
  shortjournal = {Työväentutkimus Vuosikirja},
  url = {https://openalex.org/W7201201131},
  abstract = {This thesis explores how Brazilian Indigenous women activists living in the Global North negotiate, create, and articulate cultural and political practices online through social media, particularly Instagram. The study examines how activists navigate digital spaces shaped by colonial histories and platform power while engaging in cultural revitalization and political activism. Using a qualitative research design, the study combines in-depth semi-structured interviews with two Brazilian Indigenous women activists and netnographic analysis of Instagram content produced and shared within these activists’ networks, collected between August and November 2024. The data were analyzed using Reflexive Thematic Analysis, while interpretation was interpreted through decolonial theory and digital sovereignty frameworks. The findings show that cultural revitalization and political engagement are enacted as lived, embodied, and relational practices that sustain cultural continuity, territorial responsibility, and environmental care across geographical distance. Indigenous women’s leadership and practices of care and pedagogy play a central role, while social media also functions as a space for Indigenous knowledge-sharing and political education. At the same time, activists face challenges related to visibility, emotional labour, platform constraints, and racism. The study contributes to research on Indigenous digital activism and digital sovereignty by centering Indigenous epistemologies in transnational digital spaces.},
  langid = {english},
  keywords = {inglesa}
}

@article{mariaclaudiapinto-figueroa2026inteligencia,
  title = {Inteligencia artificial y transformación de los procesos de enseñanza matemática},
  author = {{María Claudia Pinto-Figueroa}},
  date = {2026-01-01},
  journaltitle = {EPISTEME KOINONIA},
  shortjournal = {EPISTEME KOINONIA},
  volume = {9},
  number = {17},
  pages = {306--325},
  doi = {10.35381/e.k.v9i17.4917},
  url = {https://openalex.org/W7129381684},
  abstract = {El presente estudio tuvo como propósito analizar el impacto del uso de la inteligencia artificial en el aprendizaje de las matemáticas con un enfoque en la región de La Guajira, resaltando el papel de las mujeres en la implementación y apropiación de estas tecnologías dentro de un contexto matriarcal. La metodología se enfocó en un paradigma interpretativo, con enfoque cualitativo y método hermenéutico. Los informantes clave los conformaron cuatro mujeres Wayuu. Entre los resultados, se identificaron categorías, tales como: la apropiación tecnológica, las prácticas de enseñanza de las matemáticas, el liderazgo femenino aunado al contexto matriarcal y la pertinencia cultural y educativa. Por ende, se concluyó que, cuando las mujeres Wayuu han recibido formación tecnológica y pedagógica, han logrado emplear estrategias con IA para el fomento de la innovación y el aprendizaje autónomo estudiantil.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{mariaconstanzatorres-madronero2020brechas,
  title = {Las brechas digitales en Dabeiba y Frontino, Colombia: un desafío para la educación virtual para la paz},
  author = {{Maria Constanza Torres-Madronero} and {Esperanza Milena Torres-Madroñero}},
  date = {2020-11-20},
  journaltitle = {Virtu lmente},
  shortjournal = {Virtu lmente},
  volume = {8},
  number = {2},
  doi = {10.21158/2357514x.v8.n2.2020.2719},
  url = {https://openalex.org/W3100906552},
  abstract = {Este es un estudio de casos centrado en la incorporación y apropiación de las Tecnologías de la Información y la Comunicación (TIC) para la educación en la ruralidad colombiana. Desde la implementación del proyecto PAZRED y su objetivo de construir una cultura de paz desde una apuesta virtual y pedagógica, se han identificado diferentes dimensiones de las brechas digitales en los municipios de Dabeiba y Frontino, en el Occidente antioqueño. Estas dimensiones se encuentran relacionadas con el acceso y uso de las tecnologías, el acompañamiento en los procesos de aprendizaje y la incorporación de la multiculturalidad de la población indígena. Este artículo expone el estado actual de las brechas digitales en estas dos zonas, así como los desafíos que presenta la educación virtual en estos escenarios. La metodología implementada en el proceso fue de carácter cualitativo, principalmente a través de entrevistas semiestructuradas, observación sistemática y revisión documental. De esta manera, se pudo dar cuenta de las brechas digitales en las zonas de estudio en términos de acceso, calidad y complejidad que se demanda para la educación en contextos con amplia diversidad cultural y de carácter rural. El análisis concluye que es necesario ampliar el concepto de «cobertura tecnológica», puesto que la apropiación tecnológica por parte de las comunidades rurales e indígenas debe ir más allá de la incorporación de TIC. Se requiere generar contenidos propios, modelos educativos y comunicativos con soporte tecnológico posicionados ética y políticamente, que reflejen las necesidades de aprendizaje, comprendan las lógicas y lenguajes propios de las comunidades.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{mariaconsuelolemuspool2024acceso,
  title = {Acceso y uso de tecnologías digitales durante la pandemia de COVID-19: experiencia de estudiantes de primaria con discapacidad},
  author = {{María Consuelo Lemus Pool} and {César Bárcenas Curtis} and {Arely Socorro Millán-Orozco}},
