@incollection{arizhumerezalvez2026brecha,
  title = {Brecha digital y su impacto en la educación del departamento amazónico de Pando, Bolivia},
  booktitle = {Editora Científica Digital eBooks},
  author = {{Ariz Humerez Alvez}},
  date = {2026-01-01},
  pages = {54--70},
  doi = {10.37885/251120642},
  url = {https://openalex.org/W7124753123},
  abstract = {El presente artículo realiza una revisión documental sobre la brecha digital y su impacto en la educación del departamento amazónico de Pando, Bolivia, durante el período 2020–2025. A partir del análisis de fuentes académicas, institucionales y de organismos internacionales, se examinan las desigualdades en el acceso, uso y apropiación de las tecnologías de la información y comunicación (TIC) en un territorio caracterizado por su aislamiento geográfico, baja densidad poblacional y limitada infraestructura tecnológica. Los hallazgos revelan que Pando se encuentra entre los departamentos con menor conectividad del país, con menos de 110.000 conexiones registradas y altos costos asociados al acceso digital. La falta de infraestructura y las condiciones socioeconómicas desfavorables profundizan las desigualdades educativas, especialmente en comunidades rurales e indígenas, donde solo el 3\% de los estudiantes accede a internet. El estudio identifica tres dimensiones críticas: la persistencia de brechas estructurales entre áreas urbanas y rurales, el impacto diferencial en los procesos de enseñanza-aprendizaje durante la pandemia, y la necesidad de políticas integrales que combinen inclusión tecnológica, formación docente y sostenibilidad cultural. Se destacan experiencias amazónicas regionales que ofrecen modelos alternativos, como redes comunitarias y estrategias de educación semipresencial, adaptadas a contextos de baja conectividad. Finalmente, se propone una agenda de acción centrada en el desarrollo de infraestructura local, la alfabetización digital y la participación comunitaria como ejes para reducir la exclusión tecnológica y fortalecer la equidad educativa en la Amazonía boliviana.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{arjonahernandez2023proteccion,
  title = {La protección de los cables submarinos de telecomunicaciones: Soberanías digitales y seguridad de la red de cable submarina},
  shorttitle = {La protección de los cables submarinos de telecomunicaciones},
  author = {Arjona Hernández, Noelia},
  date = {2023},
  journaltitle = {Revista internacional de pensamiento político},
  number = {18},
  pages = {41--67},
  publisher = {Laboratorio de Ideas y Prácticas Políticas},
  issn = {1885-589X},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9273659},
  urldate = {2026-11-13},
  abstract = {El sabotaje de los gasoductos Nord Stream en octubre de 2022 ha magnificado la vulnerabilidad y la importancia crítica de la infraestructura submarina. También ha puesto de manifiesto la falta de comprensión sobre cómo funcionan las redes submarinas, cómo se regulan, quién las controla y cómo se protegen. El conflicto en Ucrania ha amplificado las tensiones en este contexto en términos de la creciente amenaza de actividad de guerra híbrida/zona gris. Este artículo analizará el contexto y los organismos que intervienen en la gobernanza de los cables submarinos e identificará las lagunas de esta protección, incidiendo en la actuación de actores cable como la Unión Europea y otras iniciativas en el marco de la Ruta de la Seda China. The sabotage of the Nord Stream pipelines in October 2022 has magnified the vulnerability and critical importance of subsea infrastructure. It has also highlighted the lack of understanding of how subsea networks work, how they are regulated, who controls them and how they are protected. The conflict in Ukraine has amplified tensions in this context in terms of the growing threat of hybrid warfare/grey zone activity. This article will analyse the context and bodies involved in the governance of submarine cables and identify gaps in this protection, with a focus on the actions of cable actors such as the European Union and other initiatives within the framework of China’s Silk Road.},
  langid = {spanish}
}

