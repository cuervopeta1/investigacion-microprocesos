@article{miranda2021estrategias,
  title = {Estrategias comunitarias de construcción de oportunidades de juventudes en situación de vulnerabilidad},
  author = {Miranda, Ana and Arancibia, Milena and Fainstein, Carla},
  date = {2021-12},
  journaltitle = {Revista Reflexiones},
  shortjournal = {Revista Reflexiones},
  volume = {100},
  number = {2},
  pages = {139--165},
  issn = {1659-2859},
  doi = {10.15517/rr.v100i2.43796},
  url = {http://www.scielo.sa.cr/scielo.php?script=sci_arttext&pid=S1659-28592021000200139&lang=pt},
  abstract = {Abstract Introduction Research has shown that despite advances in schooling and income programs in the region, differences persist within the same generation of young people, who present unequal living conditions according to gender, social sector and the place where they live. Thus, youths face a widely segmented opportunity structure. Objective In this sense, this study aims to characterize and investigate the working and habitat conditions of young people who live in marginalized neighborhoods of a large urban agglomeration, Greater Buenos Aires, giving an account of the limited opportunity framework that are presented to them and the role of territorial-based social organizations in the construction of alternative life projects. Method As this study is part of an action-research project, a peer research methodology was used. It involved the application of surveys by young members of a social organization to young people who attend various community centers in that territory. Likewise, focus groups were held with those who participated as peer researchers. Results The results showed the existence of labor trajectories marked by precariousness, informality and long periods of inactivity, as well as the relevance of the development of the drug market in their neighborhoods and the divergences in these dimensions according to gender. Conclusions Community networks in marginalized neighborhoods have a substantive importance for the creation of new opportunities and put into debate the place of family groups, caregiving and the sexual division of labor among youth.},
  langid = {spanish},
  keywords = {Community organizations,Desigualdades,Exclusión laboral,Inequalities,Investigación entre pares,Jóvenes,Labor exclusion,Organizaciones comunitarias,Peer research methodology,Youth}
}

@article{mirandadiaz2013analisis,
  title = {Análisis sistémico en la generación cultural de una comunidad virtual de aprendizaje},
  author = {Miranda Díaz, Germán Alejandro and Tirado Segura, Felipe},
  date = {2013},
  journaltitle = {Revista electrónica de investigación educativa},
  shortjournal = {Revista electrónica de investigación educativa},
  volume = {15},
  number = {1},
  pages = {01--16},
  issn = {1607-4041},
  url = {http://www.scielo.org.mx/scielo.php?script=sci_arttext&pid=S1607-40412013000100001&lang=pt},
  abstract = {This paper describes a systemic analysis from the standpoint of activity theory of the cultural emergence of a virtual learning community as a complex system. Three levels of analysis were employed: data mining, visualization of complex systems and analysis of discursive interactions, with the aim of understanding the emerging phenomena of online learning and in order to have the necessary elements to assist in planning the formation of virtual communities in formal settings. This was carried out using six years of activity from 3,324 people from different documentary sources: 9,871,531 CMS records; 1,371,907 from LMS; 67,828 IRC statements; and 27,798 online forum comments. In the process, we observed how action aimed at socialization and discussion of its object evolve into historical-cultural milestones such as the culture of merit as opposed to certification, the division of labor and the process of transition from free software to free culture.},
  langid = {spanish},
  keywords = {Activity theory,comunidades virtuales,educación no formal,free software,nonformal education,sistemas culturales,software libre,Teoría de la actividad,virtual education}
}

@incollection{mireyaloza2016camps,
  title = {In {{The Camp}}’s {{Shadows}}},
  booktitle = {University of {{North Carolina Press eBooks}}},
  author = {{Mireya Loza}},
  date = {2016-09-06},
  pages = {63--96},
  doi = {10.5149/northcarolina/9781469629766.003.0005},
  url = {https://openalex.org/W2582031919},
  abstract = {Chapter 2 focuses on bracero gender formations through constructions of masculinity, the maintenance of transnational families, and complex forms of sexual desire. Deriving data from oral histories of indigenous and mestizo braceros located in Mexico and the United States, this chapter examines how transnational experiences expanded gendered social relationships and practices of sexuality that redefined notions of the family and masculinity. As braceros left their families for prolonged periods of time, family units became rearranged and these men built new community networks in predominately homosocial spaces in the United States. Masculinity became contested through notions of sexual desire, physical violence, and bravado. The Bracero Program gave men from small towns and villages the opportunity to engage in non-normative sexual relationships.},
  langid = {english},
  keywords = {inglesa}
}

@article{miriamaliciagleasonrodriguez2021social,
  title = {Social {{Innovation}} from {{University Education}} to {{Reduce}} the {{Digital Gap}} in {{Chiapas}}},
  author = {{Miriam Alicia Gleason Rodríguez} and {Julio E. Rubio} and {Martha Lucía Velázquez Díaz} and {José Manuel Islas Pacheco}},
  date = {2021-10-26},
  journaltitle = {Ninth International Conference on Technological Ecosystems for Enhancing Multiculturality (TEEM'21)},
  shortjournal = {Ninth International Conference on Technological Ecosystems for Enhancing Multiculturality (TEEM'21)},
  pages = {98--102},
  doi = {10.1145/3486011.3486427},
  url = {https://openalex.org/W4200369818},
  abstract = {The digital gap is a social problem that the COVID-19 pandemic has made more visible, primarily affecting the lives of excluded populations. During this time, the universities have been forced to move to virtual models to continue education. This paper presents a case study showing how universities can leverage this situation to reduce the digital gap through social innovation projects. The case study is a university "i-Experience" in summer 2020 with five native social community organizations in Chiapas, Mexico. These organizations mainly engage in the production and commercialization of coffee, honey, woven embroidered clothing, and tourism through cultural routes. Due to the pandemic, their sales were greatly affected, and they sought new digital marketing strategies and the necessary digital skills. The university students developed 18 digital social innovation projects that met this need. The projects were reviewed and their stages validated. Areas of opportunity were identified to scale the projects to positively transform the lives of these communities through technological appropriation.},
  langid = {english},
  keywords = {inglesa}
}

@article{miriamdelcarmenmirandahuiracocha2026inteligencia,
  title = {Inteligencia artificial y transformación educativa percibida por estudiantes de Derecho en dos universidades de Ambato},
  author = {{Miriam del Carmen Miranda Huiracocha} and {Monserrate De Los Ángeles Pazmiño Beltrán} and {Mariana Correa Quimi} and {Mario Edgar Viramontes Robles}},
  date = {2026-10-18},
  journaltitle = {Revista Científica Multidisciplinar G-nerando},
  shortjournal = {Revista Científica Multidisciplinar G-nerando},
  volume = {7},
  number = {2},
  doi = {10.66473/rcmg.v7i2.1569},
  url = {https://openalex.org/W7223367743},
  abstract = {La incorporación de herramientas de inteligencia artificial (IA) en la educación superior modifica la forma en que los estudiantes buscan información, organizan tareas y apoyan su aprendizaje. Sin embargo, su presencia en las prácticas académicas no demuestra por sí sola una mejora objetiva en los resultados de aprendizaje. El objetivo de esta investigación fue comparar el uso de la IA y su influencia en la redefinición del proceso educativo percibido por los estudiantes de derecho de una universidad pública y una privada. Se realizó un estudio cuantitativo, no experimental, transversal y descriptivo-comparativo. La muestra estuvo conformada por 52 estudiantes de octavo ciclo (26 de la universidad pública y 26 de la universidad privada). Se aplicó un cuestionario de 20 ítems en escala tipo Likert validado por juicio de expertos. Los datos se procesaron en IBM SPSS Statistics v.26. Los resultados descriptivos mostraron promedios globales de uso casi idénticos entre instituciones (M = 69,42; DE = 13,48 en la ubiversidad pública vs. M = 70,00; DE = 9,01 en la universidad privada). La prueba t de Student para muestras independientes indicó que no existen diferencias estadísticamente significativas entre ambas universidades (t(50) = 1,32; p = 0,195; IC 95\% [-1,70; 8,17]; d de Cohen = 0,05), con homogeneidad de varianzas confirmada mediante la prueba de Levene (F = 0,076; p = 0,784). No obstante, la universidad pública registró una varianza notablemente mayor (181,77 vs. 81,20), reflejando mayor heterogeneidad intragrupal en el acceso y apropiación tecnológica. Se concluye que la adopción de la IA en la formación jurídica constituye un fenómeno transversal favorecido por la accesibilidad global, requiriendo estrategias institucionales de alfabetización digital y regulación ética para reducir brechas internas.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{miriamraga2026percepciones,
  title = {Percepciones ciudadanas sobre la respuesta institucional y comunitaria tras la DANA de Valencia: Un estudio cualitativo en Parque Alcosa (Alfafar)},
  author = {{Miriam Raga} and {Ángela Carbonell}},
  date = {2026-10-01},
  journaltitle = {DOAJ (DOAJ: Directory of Open Access Journals)},
  shortjournal = {DOAJ (DOAJ: Directory of Open Access Journals)},
  doi = {10.15257/ehquidad.2027.0012},
  url = {https://openalex.org/W7223362319},
  abstract = {La DANA de València de octubre de 2024 afectó gravemente al barrio de Parque Alcosa (Alfafar), revelando tanto las debilidades institucionales como la capacidad organizativa de la comunidad local. El objetivo de este estudio es analizar las percepciones ciudadanas sobre la respuesta institucional y ciudadana frente a la emergencia, así como sus implicaciones para la resiliencia comunitaria. Se empleó una metodología cualitativa basada en entrevistas grupales y análisis documental, centrada en reconstruir experiencias vividas y percepciones compartidas. Los resultados muestran una percepción generalizada de insuficiencia institucional, marcada por la falta de liderazgo visible, descoordinación administrativa y ausencia de protocolos claros. Frente a ello, la autoorganización vecinal, articulada en torno al Kolectivo, permitió responder de forma inmediata a necesidades básicas, actuando como un amortiguador ante la ineficacia institucional. La discusión vincula estos hallazgos con debates sobre desigualdad estructural, capital social y justicia climática, destacando que la resiliencia comunitaria no surge de forma espontánea, sino que se apoya en trayectorias organizativas previas. Se concluye que la gestión del riesgo en contextos vulnerables requiere modelos de gobernanza híbrida que articulen redes comunitarias e instituciones públicas, evitando tanto su instrumentalización como su abandono.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{mirianmarielacorallopez2026gestion,
  title = {Gestión de la innovación para la cultura visual y la ciudadanía mediática},
  author = {{Mirian Mariela Coral López} and {Fidel Ricardo Chiriboga Mendoza}},
  date = {2026-10-01},
  journaltitle = {DOAJ (DOAJ: Directory of Open Access Journals)},
  shortjournal = {DOAJ (DOAJ: Directory of Open Access Journals)},
  url = {https://openalex.org/W7221580588},
  abstract = {El propósito de la investigación consistió en analizar la interrelación existente entre la gestión de la innovación y la cultura visual y ciudadanía mediática en los estudiantes universitarios de la provincia de Manabí del Ecuador. Para ello se utilizó un enfoque cuantitativo, un diseño no experimental, transversal y un tipo de alcance correlacional. La población accesible se definió como un total de 200 estudiantes de pregrado de 18 o más años pertenecientes a diferentes instituciones de educación superior de las ciudades Manta, Portoviejo y Jipijapa; pudiendo determinar una muestra compuesta por 132 sujetos obtenidos a partir de un muestreo no probabilístico de conveniencia. Se aplicó un cuestionario de 32 ítems en base a una escala Likert de cinco puntos, estructurado en ocho dimensiones. La consistencia interna ha sido muy buena para el de la gestión de la innovación (α = 0,902) y para el de la cultura visual y ciudadanía mediática (α = 0,914). Las medias fueron de 3,38 y 3,46, respectivamente. Se constató la existencia de una relación positiva moderada a partir del rho de Spearman (ρ = 0,559; p {$<$} 0,001), confirmada por el tau-b de Kendall (τ-b = 0,396; p {$<$} 0,001). Finalmente, los datos reportados apuntan que los ambientes organizacionales orientados a la innovación, aprendizaje, colaboración y apropiación tecnológica están asociados a niveles más altos en las capacidades de lectura crítica, producción responsable, verificación de los contenidos y participación digital.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{miryanelizabethcabralgonzalez2026gobernanza,
  title = {Gobernanza digital escolar en escuelas rurales del Paraguay: estudio comparativo en dos instituciones de Ñeembucú},
  author = {{Miryan Elizabeth Cabral González}},
  date = {2026-02-25},
  journaltitle = {Arandu-UTIC.},
  shortjournal = {Arandu-UTIC.},
  volume = {13},
  number = {1},
  pages = {1156--1174},
  doi = {10.69639/arandu.v13i1.1969},
  url = {https://openalex.org/W7133359953},
  abstract = {La incorporación de tecnologías digitales en escuelas rurales paraguayas se ha promovido como estrategia para reducir brechas educativas; sin embargo, persisten desigualdades asociadas no solo a la infraestructura, sino también a los procesos organizacionales que median su uso. El presente estudio tuvo como objetivo analizar de qué manera los marcos de gobernanza y acompañamiento institucional configuran los procesos de apropiación tecnológica en dos instituciones educativas rurales del departamento de Ñeembucú que operan bajo condiciones estructurales similares. Se adoptó un enfoque cualitativo con diseño de estudio de casos múltiples de carácter comparativo. Participaron siete actores institucionales —directivos, docentes y una técnica de supervisión— mediante entrevistas semiestructuradas, observación no participante y análisis documental. Los datos fueron analizados mediante codificación temática inductivo-deductiva. Los resultados evidencian trayectorias diferenciadas de gestión digital asociadas a estilos de liderazgo, culturas institucionales y estrategias locales de compensación frente a limitaciones estructurales. En particular, la distribución de responsabilidades digitales se relaciona con una mayor sostenibilidad de las prácticas de gestión, mientras que la centralización incrementa la vulnerabilidad operativa y la sobrecarga funcional. Se concluye que la brecha digital en contextos rurales no es exclusivamente infraestructural, sino que se configura también como una brecha de gobernanza, expresada en la capacidad diferenciada de las instituciones para organizar, sostener y resignificar el uso de tecnologías en su gestión cotidiana.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{moisesramirezhernandez2016tic,
  title = {Las TIC y la interacción social del profesor universitario},
