@article{rangilgallardo2026ia,
  title = {IA lenta y permacomputing: Prácticas artísticas contranarrativas frente a la inteligencia artificial hegemónica},
  shorttitle = {IA lenta y permacomputing},
  author = {Rangil Gallardo, Miguel and Mañas Carbonell, Moisés},
  date = {2026},
  journaltitle = {Arte y políticas de identidad},
  number = {35},
  pages = {9--24},
  publisher = {Servicio de Publicaciones},
  issn = {1889-979X},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10897016},
  urldate = {2026-11-13},
  abstract = {This article examines a set of artistic practices linked to the slow AI movement that operate as counternarratives to extractive, centralized, and corporate artificial intelligence. Drawing on the framework of permacomputing, the text proposes three analytical categories: infrastructure and materiality; design and operability; mediation and pedagogy. Through case studies such as Compost Computer (2025), A definitively unfinished AI (2025), and Project Patching-tik hoeh koe (2024), it examines deliberate constraints of energy, waiting, and intermittency, alongside choices around local execution, documentation, modularity, decentralization, and data curation. It argues that these choices enable systems that can be reactivated, are legible, and can be maintained by communities, shifting the discussion away from performance and toward governance and care. Finally, it highlights potential avenues for strengthening already emerging within slow AI practices: offline-first infrastructures, situated archives, and pedagogical devices for critical literacy. Este artículo examina una serie de prácticas artísticas vinculadas al movimiento slow AI (IA lenta) que operan como contranarrativas frente a la inteligencia artificial extractiva, centralizada y corporativa. Desde el marco del permacomputing, el texto propone tres categorías de análisis: infraestructura y materialidad; diseño y operabilidad; mediación y pedagogía. A través de estudios de caso como Compost Computer (2025), A definitively unfinished AI(2025) o Project Patching-tik hoeh koe (2024) se examinan restricciones deliberadas de energía, espera e intermitencia, junto con decisiones de ejecución local, documentación, modularidad, descentralización y curaduría de datos. Se argumenta que estas decisiones favorecen sistemas reactivables, legibles y mantenibles por comunidades y que desplazan la discusión desde el rendimiento hacia la gobernanza y el cuidado. Por último, se señalan posibles líneas de fortalecimiento iniciadas dentro del propio campo de las prácticas en IA lenta: infraestructuras offline-first, archivos situados y dispositivos pedagógicos de alfabetización crítica.},
  langid = {spanish}
}

