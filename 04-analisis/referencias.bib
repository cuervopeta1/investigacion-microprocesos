@article{hobberjoseberriocaballero2025energia,
  title = {Energía renovable y desarrollo rural: un análisis de la apropiación tecnológica y sus efectos en la productividad y bienestar},
  author = {{Hobber José Berrío Caballero} and {A. Vides-Prado} and {Diego Mauricio Madrid Orrego}},
