@article{alejandroleon2010software,
  title = {Software libre como alternativa para desarrollar sistemas informáticos basados en la lengua indígena de la población. El caso de OpenBiblio distribución náhuatl},
  author = {{Alejandro León} and {María Graciela Gutiérrez Vallejo}},
  date = {2010-01-01},
  journaltitle = {Apertura},
  shortjournal = {Apertura},
  volume = {10},
  number = {1},
  pages = {52--63},
  url = {https://openalex.org/W2159592212},
  abstract = {El desarrollo y uso de las tecnologías de la información y la comunicación (TIC) en el ámbito rural han repercutido poco en el quehacer de estas comunidades, ya que no existen sistemas informáticos en su lengua materna, lo que acrecienta la marginación social y tecnológica; aunada a esta situación, se advierte la falta de recursos financieros. Como alternativa, este ensayo propone centrar los esfuerzos en la implementación del software libre llamado OpenBiblio distribución náhuatl, el cual permitirá automatizar todas las actividades realizadas en una biblioteca comunitaria; con esta acción, se dotan de tecnología y de los manuales para su administración. Estas acciones se verán complementadas con otras herramientas informáticas libres que apoyen la gestión de información, y conviertan la biblioteca en un repositorio de datos y un agente catalizador de las TIC hacia su comunidad. En la primera etapa del proyecto, el sistema estará disponible para ser aplicado en aquellas comunidades donde prevalezca el náhuatl, lengua hablada por 40 por ciento de la población indígena de México. Además, la biblioteca deberá considerar determinados requerimientos técnicos para funcionar. Como el sistema está desarrollado con software libre, puede compartirse libremente y, de ser necesario, el interfaz del programa puede desplegarse en otra lengua. OpenBiblio funciona siguiendo los lineamientos del formato bibliográfico Marc 21 para asegurar la compatibilidad con otros sistemas.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{alejandromarquezbedoya2026inteligencia,
  title = {Inteligencia artificial para la autogestión energética en zonas aisladas: una revisión sistemática de marcos metodológicos, enfoques de modelado y aplicaciones de IA},
  author = {{Alejandro Márquez Bedoya} and {Sandra Ximena Carvajal Quintero} and {Dahiana López García}},
  date = {2026-10-07},
  journaltitle = {Encuentro Internacional de Educación en Ingeniería},
  shortjournal = {Encuentro Internacional de Educación en Ingeniería},
  pages = {1--9},
  doi = {10.26507/paper.5486},
  url = {https://openalex.org/W7225315355},
  abstract = {Los sistemas de energía eléctrica en las Zonas No Interconectadas (ZNI) de Colombia y de diversas regiones en vías de desarrollo enfrentan desafíos de sostenibilidad asociados a su dependencia de combustibles fósiles, caracterizados por altos costos logísticos y limitaciones operativas. En este contexto, la integración de Fuentes No Convencionales de Energía Renovable (FNCER) se ha consolidado como una alternativa para mejorar la cobertura y sostenibilidad del servicio eléctrico; sin embargo, su incorporación en redes aisladas de baja inercia introduce desafíos asociados a la estabilidad y gestión del sistema. Por tanto, ante la baja inercia y la variabilidad de las FNCER, es necesario evolucionar hacia sistemas energéticos autogestionados con toma de decisiones autónoma. En el marco de esta transición desde una operación manual hacia sistemas de energía autogestionados, esta investigación aborda dicha transformación en sistemas eléctricos aislados. En este contexto, el presente artículo busca analizar y sintetizar los marcos metodológicos, enfoques de modelado y aplicaciones de Inteligencia Artificial (IA) reportados en la literatura para la gestión de recursos energéticos aislados. Se busca establecer una línea base que permita determinar qué algoritmos de aprendizaje automático y arquitecturas de control adaptativo son capaces de operar bajo las restricciones técnicas y socioeconómicas propias de las ZNI. La metodología adoptada consiste en una revisión sistemática de literatura que evalúa marcos metodológicos, enfoques de modelado y aplicaciones de IA utilizadas en la operación y gestión de sistemas energéticos en zonas aisladas. La revisión evidencia que la escasez de datos históricos constituye una limitación para la implementación de los modelos de IA actuales, dado que estos requieren grandes volúmenes de información para su entrenamiento. Esta limitación se intensifica en las ZNI colombianas, donde la disponibilidad de datos históricos es estructuralmente limitada. En este sentido, se propone el desarrollo de marcos metodológicos híbridos que utilicen modelos de simulación genéricos para entrenar agentes inteligentes antes de su despliegue, con el fin de reducir el riesgo operativo y los costos de implementación. Asimismo, se resalta que la autogestión inteligente es una necesidad técnica para la estabilidad de redes aisladas; sin embargo, la integración de IA debe realizarse de manera gradual y adaptativa, en coherencia con las condiciones técnicas y contextuales del sistema. Finalmente, se enfatiza la relevancia de marcos regulatorios que reconozcan los servicios complementarios proporcionados por sistemas inteligentes de gestión; asimismo, se recomienda que el desarrollo de futuros modelos de IA para zonas rurales incorpore interfaces de usuario simplificadas que faciliten la supervisión y apropiación tecnológica en entornos rurales, en concordancia con la realidad sociotécnica del territorio.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{alejandronicolaslemacachinell2026diseno,
  title = {Diseño de un programa de concientización y capacitación estratégica para la transformación digital en instituciones de educación superior},
  author = {{Alejandro Nicolás Lema Cachinell} and {Belinda Marta Lema Cachinell} and {Yissel Marely Martin Álvarez}},
  date = {2026-06-30},
  journaltitle = {Revista de Investigación Formativa Innovación y Aplicaciones Técnico - Tecnológicas},
  shortjournal = {Revista de Investigación Formativa Innovación y Aplicaciones Técnico - Tecnológicas},
  volume = {8},
  number = {1},
  pages = {104--115},
  doi = {10.34070/rei/.v8.i1.2026.535},
  url = {https://openalex.org/W7166671811},
  abstract = {El presente artículo tiene como objetivo diseñar un programa de concientización y capacitación estratégica orientado a impulsar la transformación digital en Instituciones de Educación Superior (IES), abordando brechas críticas como la falta de competencias digitales y la resistencia al cambio organizacional. La metodología adoptada corresponde a un enfoque cualitativo de tipo proyectivo, sustentado en revisión bibliográfica y análisis de necesidades previamente identificadas en estudios diagnósticos institucionales. Como resultado, se propone una estructura curricular modular compuesta por cinco ejes formativos: cultura digital, competencias tecnológicas, innovación pedagógica, gestión del cambio y analítica institucional. Asimismo, se detallan recursos didácticos digitalizados, incluyendo plataformas LMS, simuladores, repositorios interactivos y microcontenidos multimedia. La metodología de intervención combina talleres interactivos, webinars de éxito y mentorías personalizadas, diseñadas para fomentar la apropiación tecnológica y reducir la resistencia al cambio mediante estrategias participativas. Se concluye que el programa propuesto constituye una respuesta integral y contextualizada, capaz de fortalecer las capacidades institucionales y promover una transformación digital sostenible en las IES, alineada con las demandas del entorno educativo contemporáneo.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@incollection{alejandroreyes-gonzalez2016extraction,
  title = {From {{Extraction}} to {{Meliponiculture}}: {{A Case Study}} of the {{Management}} of {{Stingless Bees}} in the {{West-Central Region}} of {{Mexico}}},
  booktitle = {{{InTech eBooks}}},
  author = {{Alejandro Reyes-González} and {Andrés Camou-Guerrero} and {Salvador Gómez-Arreola}},
  date = {2016-05-20},
  doi = {10.5772/62654},
  url = {https://openalex.org/W2401460096},
  abstract = {Currently, stingless bees' populations are declining due to environmental degradation. In this context, the authors have developed a research project in the central-western region of Mexico with the goal to generate strategies for conservation and sustainable management of stingless bees. The chapter aims to present the process of this investigation and its main results in terms of a) local knowledge and management strategies of stingless bees, and b) the social process of technological appropriation of meliponiculture by beekeepers. We recognized specific knowledge on the biology and ecology of stingless bees that result in a system for identifying species and management strategies of wild populations of these bees based on the extraction of nests. The implementation of an innovative productive activity based on the principles of meliponiculture and current techniques has been well received by producers, which has led to the formation of the Meliponicultores Michoacanos del Balsas Association, which grows five species of stingless bees. The research suggests that conservation associated with the use of bees (integral meliponiculture) can be enhanced in the region. Faced with the loss of biodiversity and environmental crisis, it is essential to maintain and enhance local knowledge of stingless bees and management practices. This represents an alternative to develop management schemes that allow the raising and breeding of these bees, while its products are obtained.},
  langid = {english},
  keywords = {inglesa}
}

@article{alejandrormendoza2025cybersecurity,
  title = {{{CYBERSECURITY AND STATE-SPONSORED HACKTIVISM IN LATIN AMERICA}}: {{THE CASES OF VENEZUELA AND CUBA}}},
  author = {{Alejandro R MENDOZA}},
  date = {2025-01-21},
  pages = {88--98},
  doi = {10.55843/isl2025symp88m},
  url = {https://openalex.org/W4414206325},
  abstract = {This article examines the rise of state-sponsored hacktivism in Latin America, with a particular focus on Venezuela and Cuba as case studies. The analysis situates these developments within the region’s broader cybersecurity dynamics, marked by low infrastructure investment, increasing geopolitical competition, and the blurred boundaries between cyber activism and cyber warfare. In Venezuela, government-aligned hacker groups such as the so-called Elite Hackers of Venezuela have been implicated in phishing, doxxing, and distributed denial-of-service (DDoS) attacks against political dissidents, as well as counter-cyber operations targeting foreign entities in response to U.S. sanctions on the oil sector. Cuba, operating under a long-standing U.S. embargo, has developed a unique cyber defense doctrine based on offline networks, indigenous software development, and the deployment of state-linked hacker collectives like the Red Hats to conduct propaganda and surveillance. The article further investigates the implications of these activities under international law, highlighting violations of the Budapest Convention on Cybercrime, the inefficacy of NATO’s Cyber Defence Policy in the region, and human rights concerns under Article 8 of the European Convention on Human Rights (ECHR) regarding privacy and freedom of expression. Drawing on comparative cybersecurity governance frameworks, the study proposes a threefold policy approach: establishing a Latin American Cybersecurity Pact for collective defense, implementing transparency and oversight mechanisms to counter state deniability, and strengthening civil society resilience through privacy-enhancing technologies and digital literacy initiatives. The findings suggest that state-sponsored hacktivism in Latin America is evolving into a form of “digital sovereignty,” positioning cyberspace as a strategic arena for both domestic control and international leverage. Without urgent international consensus on cyber norms, such practices risk undermining stability, escalating geopolitical tensions, and eroding fundamental rights across borders.},
  langid = {english},
  keywords = {inglesa}
}

@article{alejandrourieles2022tic,
  title = {Las TIC en la Educación: entre la apropiación tecnológica y la mediación pedagógica},
  author = {{Alejandro Urieles}},
  date = {2022-08-01},
  journaltitle = {Revista de Ciencias de la Educación Docencia Investigación y Tecnologías de la Información CEDOTIC},
  shortjournal = {Revista de Ciencias de la Educación Docencia Investigación y Tecnologías de la Información CEDOTIC},
  volume = {7},
  number = {1},
  pages = {9--13},
  doi = {10.15648/cedotic.1.2022.3361},
  url = {https://openalex.org/W4406607686},
  abstract = {El Covid-19 produjo un profundo impacto en todos los ámbitos de la vida humana. El décimo número de la revista CEDOTIC se publica en este periodo trascendental de cambio hacia las actividades presenciales. En ese sentido el tema de las transformaciones en la esfera de la educación resulta ser un tópico recurrente dado que, por cuenta del aislamiento social, las tecnologías remotas de la información y las comunicaciones cobraron una relevancia crítica al permitir que los procesos educativos siguieran adelante. En consonancia, decidimos dedicar buena parte de este espacio durante el 2022 a la divulgación de experiencias, investigaciones y reflexiones en torno a las innovaciones, didácticas, aplicaciones tecnológicas y pedagogías implementadas para superar este desafío que sin duda aún mantiene a las comunidades e instituciones ocupadas en el ajuste e implementación de sistemas que combinen las jornadas presenciales con las clases remotas.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{alejandrourielesguerrero2022tic,
  title = {TIC na Educação: entre apropriação tecnológica e mediação pedagógica.},
  author = {{Alejandro Urieles Guerrero}},
  date = {2022-08-01},
  journaltitle = {Revista de Ciencias de la Educación Docencia Investigación y Tecnologías de la Información CEDOTIC},
  shortjournal = {Revista de Ciencias de la Educación Docencia Investigación y Tecnologías de la Información CEDOTIC},
  url = {https://openalex.org/W7218223869},
  abstract = {Covid-19 had a profound impact on all areas of human life. The tenth issue of the CEDOTIC magazine is published in this transcendental period of change towards face-to-face activities. In this sense, the issue of transformations in the field of education turns out to be a recurring topic given that, due to social isolation, remote information and communication technologies gained critical relevance by allowing educational processes to continue. Accordingly, we decided to dedicate a large part of this space during 2022 to the dissemination of experiences, research and reflections on innovations, didactics, technological applications and pedagogies implemented to overcome this challenge that undoubtedly still keeps communities and institutions busy. in the adjustment and implementation of systems that combine face-to-face sessions with remote classes.},
