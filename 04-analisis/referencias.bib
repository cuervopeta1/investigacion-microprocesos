@book{esteve2026desafios,
  title = {Desafíos y oportunidades de la gobernanza y la regulación en la era digital: resultados de investigación de la Cátedra Jean Monnet GovReDig},
  shorttitle = {Desafíos y oportunidades de la gobernanza y la regulación en la era digital},
  author = {Esteve, Joaquín Sarrión and Pérez, Amalia Balaguer},
  date = {2026},
  publisher = {Atelier},
  url = {https://dialnet.unirioja.es/servlet/libro?codigo=1035498},
  urldate = {2026-11-13},
  abstract = {La transformación digital plantea nuevos desafíos para la gobernanza, la regulación y la protección de los derechos en una sociedad cada vez más condicionada por el desarrollo tecnológico. Esta obra reúne aportaciones de investigadores y especialistas que examinan las implicaciones jurídicas, éticas y sociales de la digitalización, prestando especial atención a la necesidad de adaptar los marcos normativos e institucionales a las nuevas realidades tecnológicas. El volumen aborda cuestiones como la evolución del tecnoderecho europeo, la investigación científica en la era digital, la dimensión ética de la inteligencia artificial y los retos asociados a la gobernanza de los datos biométricos y de salud.  Asimismo, los distintos estudios profundizan en el derecho a no ser digital, la protección constitucional frente a los riesgos del desarrollo tecnológico, la gobernanza y responsabilidad empresarial y el acceso a la cultura, entre otras materias. Desde una perspectiva multidisciplinar, la publicación ofrece una reflexión sobre el equilibrio entre innovación, derechos fundamentales y responsabilidad institucional. La obra recoge parte de los resultados de las investigaciones desarrolladas en el marco de la Cátedra Jean Monnet «Gobernanza y Regulación en la Era Digital» (Proyecto 101127331-GovReDig), desarrollada durante tres anualidades en la Facultad de Derecho de la UNED, así como de la Cátedra ISAAC «Derechos individuales, investigación científica y cooperación», establecida en la misma Facultad.},
  isbn = {979-13-88510-49-6},
  langid = {spanish}
}

@article{esthercarpio2020apropiacion,
  title = {La apropiación tecnológica en docentes de primaria: diseño de solución para la E.B.N.B. “Eutimio Rivas” Baruta, estado Miranda},
  author = {{Esther Carpio} and {Elisa Gil}},
  date = {2020-08-10},
  journaltitle = {Redalyc (Universidad Autónoma del Estado de México)},
  shortjournal = {Redalyc (Universidad Autónoma del Estado de México)},
  volume = {43},
  number = {98},
  url = {https://openalex.org/W3187153169},
  abstract = {"El trabajo refiere el proceso de apropiación tecnológica de docentes de la EBNB “Eutimio Rivas”; a través de la implantación de un Desarrollo Tecnológico. Se trata de un Proyecto Factible e investigación de campo de tipo descriptiva. La población fue de doce docentes de aula. Se utilizaron dos fases del Modelo General de Desarrollo Tecnológico de Szczurek (1990): Estudio de Necesidades y Diseño de la intervención que consistió en una experiencia de aprendizaje B-Learning, basada Resolución de Problemas en Colaboración de Nelson (2000) y Educación del Carácter de Lickona (1999), a través de una WebQuest. Técnicas: encuesta, observación y entrevistas. En los docentes se evidenciaron actitudes y capacidades para la apropiación tecnológica, pero no el uso de herramientas ni aprovechamiento de recursos disponibles."},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{estherlabradamartinez2011apropiacion,
  title = {Apropiación tecnológica en personas con discapacidad visual},
  author = {{Esther Labrada Martínez}},
  date = {2011-01-01},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  shortjournal = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  number = {62},
  pages = {55--65},
  url = {https://openalex.org/W1946237737},
  abstract = {El fenómeno de la apropiación de la tecnología se identifica como un proceso cultural mediante el cual la persona con discapacidad visual (PcDV) adquiere un conocimiento que favorece su desarrollo educativo y profesional además de originar una transformación a nivel personal denotando una forma distinta para percibir\textbackslash nla discapacidad en la dimensión social. Conceptualmente, el conocer, usar y crear son los criterios a partir de los que se alfabetiza, interactúa y produce los recursos tecnológicos para la generación de competencias en las PcDV, permitiendo trabajar en función de crear espacios sociales para la inserción de las personas con fines productivos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{estherrodriguezsantana2026apropiacion,
  title = {Apropiación de internet en jóvenes habitantes de la zona metropolitana de Guadalajara, México},
  author = {{Esther Rodríguez Santana} and {Janny Amaya Trujillo}},
  date = {2026-10-15},
  journaltitle = {Comunicación},
  shortjournal = {Comunicación},
  number = {54},
  pages = {1--21},
  doi = {10.18566/comunica.n54.a03},
  url = {https://openalex.org/W7222323374},
  abstract = {La extensión de internet ha estado acompañada de discursos o afirmaciones generalizadoras, que han sido objeto de críticas debido a su tendencia a simplificar las complejidades y las particularidades sociohistóricas que han configurado el desarrollo y la apropiación social de esta tecnología en contextos específicos. Entre estas tendencias, destaca la naturalización de la relación que las generaciones más jóvenes establecen con esta tecnología, que ha sido frecuentemente asumida como una condición inherente. En este sentido, el uso extendido y acrítico de categorías generalizadoras como “nativos digitales” ha contribuido a oscurecer la comprensión situada de las maneras en que los jóvenes se relacionan con las tecnologías digitales. En contraposición a esas tendencias, el presente artículo se propone analizar, desde una perspectiva cualitativa, los procesos de apropiación tecnológica entre jóvenes de 18 y 24 años, habitantes de la Zona Metropolitana de Guadalajara, México, con el objetivo de comprender los significados, prácticas y experiencias en torno a internet. Para la obtención de datos se realizaron diez entrevistas semiestructuradas buscando reconstruir, a través de sus memorias, las tecnobiografías de los jóvenes; el análisis de datos consideró los elementos de la teoría fundamentada. Los resultados demuestran que la apropiación de internet se caracteriza por la normalización de esta tecnología en la vida cotidiana; que el principal dispositivo de acceso es el celular; y una tensión entre el discurso de los jóvenes sobre los usos de internet y las prácticas que realmente aplican. En conclusión, el estudio busca aportar una comprensión situada de las trayectorias de incorporación de internet en la vida cotidiana de los jóvenes, evidenciando la diversidad de mediaciones, experiencias y condiciones sociales que intervienen en dichos procesos y contribuyendo así a matizar las interpretaciones generalizadoras que han caracterizado buena parte de los discursos sobre las relaciones entre juventud y tecnologías digitales.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{estradagiron2026inteligencia,
  title = {Inteligencia artificial en educación superior: análisis comparado de marcos regulatorios y políticas educativas en América Latina},
  shorttitle = {Inteligencia artificial en educación superior},
  author = {Estrada Girón, Adriana and Manzano Martínez, Jorge Armando and Servín Gómez, Alejandro},
  date = {2026},
  journaltitle = {Latin American Journal of Humanities and Educational Divergences},
  volume = {5},
  number = {1},
  pages = {100--127},
  publisher = {Grupo J. J. San Marcos},
  issn = {2955-8891},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10884906},
  urldate = {2026-11-13},
  abstract = {The discussion surrounding the use of artificial intelligence in education has intensified in recent years, particularly regarding the need for regulatory frameworks to guide its integration into diverse educational systems. Among the most relevant international initiatives are UNESCO's Recommendation on the Ethics of AI and Regulation (EU) 2024/1689 of the European Parliament, which establish principles related to transparency, human oversight, and the protection of fundamental rights. In Latin America, these guidelines interact with institutional contexts marked by inequalities in digital infrastructure, regulatory frameworks still under development, and teacher training processes in the process of consolidation. From a comparative education perspective, this article examines the relationship between these international regulatory frameworks and emerging policies on smart technologies in Latin American higher education. The analysis is based on a qualitative review of 43 texts published between 2020 and 2025. The comparison revealed differences in the degree of normative institutionalization between global documents and regional experiences. Not all contexts exhibit the same level of formalization. Six analytical categories were defined: ethical governance, teacher training, legal regulation, institutional participation, digital infrastructure, and technological and epistemic sovereignty, the latter developed primarily in Latin American literature. The regulation of these technologies in higher education appears as an ongoing process, characterized by tensions between global orientations and local implementation conditions. La discusión sobre el uso de inteligencia artificial en educación se ha intensificado en los últimos años, especialmente en torno a la necesidad de marcos regulatorios que orienten su incorporación en sistemas educativos diversos. Entre las iniciativas internacionales más relevantes se encuentran la Recomendación sobre la Ética de la IA de la UNESCO y el Reglamento (UE) 2024/1689 del Parlamento Europeo, que establecen principios vinculados con la transparencia, la supervisión humana y la protección de derechos fundamentales. En América Latina, estos lineamientos interactúan con contextos institucionales marcados por desigualdades en infraestructura digital, marcos normativos aún en desarrollo y procesos de formación docente en consolidación. Desde la educación comparada, el artículo examina la relación entre dichos marcos regulatorios internacionales y las políticas emergentes sobre tecnologías inteligentes en la educación superior latinoamericana. El análisis se apoya en una revisión documental cualitativa de 43 textos publicados entre los años 2020 y 2025. La comparación permitió identificar diferencias en el grado de institucionalización normativa entre los documentos globales y las experiencias regionales. No todos los contextos presentan el mismo nivel de formalización. Se delimitaron seis categorías analíticas: gobernanza ética, formación docente, regulación jurídica, participación institucional, infraestructura digital y soberanía tecnológica y epistémica, esta última desarrollada principalmente en la literatura latinoamericana. La regulación de estas tecnologías en educación superior aparece como un proceso en construcción, que presenta por tensiones entre orientaciones globales y condiciones locales de implementación.},
  langid = {spanish}
}

@article{estupinan2017desarrollo,
  title = {Desarrollo de un motor mendocino como herramienta de enseñanza en la aplicación de energías renovables y generación de alternativas energéticas1},
  author = {Estupiñan, Cristian Mauricio and Puerto Reyes, Juan Pablo and Beltrán Morales, Mayra},
  date = {2017},
  journaltitle = {Loginn},
  volume = {1},
  number = {1},
  pages = {7},
  publisher = {Servicio Nacional de Aprendizaje. SENA},
  issn = {2590-7441},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8738546},
  urldate = {2026-11-13},
  abstract = {Thanks to photovoltaic cell development in 1953, it could be demonstrated that the use of light could have practical purposes. Later Calvin Fuller and Daryl Chaplin improved and proposed alternative uses for solar cells. The Mendocino Motor was one of those experimental issues in 1962. However, it was named by Larry Spring, who in 1994 at Mendocino Coast Labs implemented into his prototype a brushless maglev system to reduce friction of the concept. The engine became driven by sunlight and magnetic induction, using neodymium magnets located inside and outside the motor, equidistant locations from each other, in order to achieve magnetic force required to spin the rotor. Although there have been some scholars worldwide progress today, this field requires technological appropriation by students in Bucaramanga and Colombia, so that they get conscious about role that alternative energy for future, and how they can consider different uses for it. The general methodology is proposed projects and training by STEM (Science, Technology, Engineering, and Mathematics). The overall objective of the research is to design, build, simulate and prototype engine one Mendocino study and research, using the virtual modeling software “solidworks” and 3D printing tool Wanhao Duplicator i3. This research is descriptive, seeking to measure variables affecting engine performance through hardware platform Arduino. Due to complexity of this project, the research team is on phase to build and improve the prototype, with some pieces already printed or acquired, achieving levitation and stabilization of the rotor, so this project is under development yet. Gracias al desarrollo de la célula fotovoltaica en 1953 pudo demostrarse que el aprovechamiento de la luz podía tener fines prácticos. Posteriormente Daryl Chaplin y Calvin Fuller, perfeccionan y plantean usos alternativos para las celdas solares. El Motor Mendocino fue uno de esos desarrollos experimentales en 1962; sin embargo su nombre se debe a Larry Spring, quien en 1994 en los Laboratorios de Mendocino Coast implementó un sistema brushless de levitación magnética para reducir la fricción del concepto. A pesar de que en la actualidad ha habido algunos avances académicos a nivel mundial, este campo requiere aun apropiación tecnológica por parte de los estudiantes en Bucaramanga y Colombia, de manera que sean conscientes del papel que tienen las energías alternativas para el futuro y como pueden plantearse diversos usos. La metodología general propuesta es la de formación por proyectos y STEM (Science, Technology, Engineering, Mathematics). El objetivo general de la Investigación es el de diseñar, construir, simular y prototipar un motor mendocino para estudio e investigación, utilizando el software de modelado virtual “solidworks” y la herramienta de impresión 3D Wanhao Duplicator i3. Esta investigación es de tipo descriptivo, buscando medir variables que inciden en el funcionamiento del motor por medio de plataforma hardware Arduino. Debido a la complejidad del proyecto, el equipo de investigadores se encuentra en fase de construcción del prototipo, con algunas de las piezas impresas o adquiridas, logrando la levitación y estabilización del rotor, continuando el proyecto en fase de desarrollo.},
  langid = {spanish}
}

@incollection{eugeniolucas2026entre,
  title = {ENTRE A EXCLUSIVIDADE E O ACESSO LIVRE: A RECONFIGURAÇÃO DO DIREITO DA PATENTE NA ERA DA INOVAÇÃO VERDE},
  author = {{Eugénio Lucas}},
  date = {2026-01-01},
  doi = {10.62140/el549130662},
  url = {https://openalex.org/W7160188521},
  abstract = {Resumo: O presente artigo examina criticamente a reconfiguração do direito da patente face às exigências da inovação verde, num contexto marcado pela emergência climática e pela necessidade de transição para modelos de desenvolvimento sustentável. Partindo de uma análise jurídico-económica e interdisciplinar, demonstra-se que o regime da patente, fortemente assente na lógica de exclusividade e apropriação privada do conhecimento, revela significativas insuficiências quando confrontado com a dinâmica colaborativa, rápida difusão tecnológica e exigências de acesso universal inerentes à inovação ambientalmente orientada. A investigação evidencia que a tensão estrutural entre exclusividade e acesso aberto se intensifica à medida que tecnologias verdes se tornam bens estratégicos de interesse global, expondo limitações do atual quadro normativo, designadamente no âmbito do Acordo TRIPS, cuja aplicação rígida acentua assimetrias entre países desenvolvidos e economias emergentes. O estudo analisa igualmente instrumentos jurídicos alternativos ou complementares às patentes, tais como licenças compulsórias, consórcios de patentes, modelos de código aberto, sistemas de responsabilidade, plataformas multilaterais de cooperação tecnológica e mecanismos de financiamento público da inovação sustentável. Demonstra-se que tais instrumentos não configuram exceções marginais, mas são componentes estruturantes de um novo modelo de propriedade intelectual sustentável, capaz de equilibrar incentivos privados à inovação com a função social e ambiental da tecnologia. Conclui-se que a proteção jurídica da sustentabilidade tecnológica exige uma arquitetura jurídica híbrida, cooperativa e internacionalizada, que incorpore mecanismos de flexibilização, regulação ambiental eficiente e instrumentos de cooperação global. O direito da patente, sem prejuízo da sua exclusividade, deve ser reorientado para um paradigma funcional, centrado na equidade tecnológica, na justiça ambiental e na partilha responsável do conhecimento verde, garantindo que a inovação se converta em benefício efetivo para a humanidade e para a preservação do planeta.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@thesis{eugeniotisselli2016reciprocal,
  title = {Reciprocal {{Technologies}}: {{Enabling}} the {{Reciprocal Exchange}} of {{Voice}} in {{Small-Scale Farming Communities}} through the {{Transformation}} of {{Information}} and {{Communications Technologies}}},
  author = {{Eugenio Tisselli}},
  date = {2016-01-01},
  journaltitle = {PEARL (University of Plymouth)},
  doi = {10.24382/4249},
  url = {https://openalex.org/W2566304758},
  abstract = {This dissertation claims that the reciprocal exchange of voice—an element for constructing community and strengthening political recognition—may be fostered in small-scale farming communities by (1) the appropriation and transformation of information and communications technologies, (2) artistic intervention, and (3) cross-community research. This study contributes to participatory research methodologies, particularly those that seek to tackle the diverse challenges faced by small-scale farmers from a broad, complex perspective. The main issue identified in this dissertation is as follows: The hegemony of economic behaviors, which stands as a cornerstone of neoliberal capitalism, constitutes the latest stage of a historical process in which the voices of small-scale farmers seem to have been progressively and systematically silenced, their traditional practices largely invalidated, and their reciprocal forms of social, political, and economic organization marginalized. The purpose of this study was to explore whether an open-ended, sociotechnical methodology could be designed and applied in small-scale farming communities with the aim of strengthening their reciprocal practices while amplifying the voices of their members. The author's research addressed the question of how the role of information and communications technologies can contribute to the creation of enabling environments in which subsistence farmers may exercise their own values and make their voices heard. Another goal was to study whether the reciprocal exchange of voice could relate to the construction and dissemination of a knowledge commons and improve the resilience of small-scale farmers in the context of complex and pressing challenges such as anthropogenic climate change. Consequently, the ERV (Enabling Reciprocal Voice) Methodology was developed and applied in small-scale farming communities in order to respond to the questions of this study. The ERV Methodology sought to redefine the modes of usage of information and communications technologies in order to help communities establish a shared communicational praxis and strengthen their reciprocal relations. The ERV Methodology stands in contrast with the technological determinism found in the purely solutionist, short-term initiatives that are generally implemented in small-scale farming communities. Instead of offering rapid solutions to isolated problems, the ERV Methodology sought to consolidate the social networks of farmers through online and offline interaction. The case studies examined in this dissertation were carried out in two small-scale farming communities in Tanzania and Mexico. Following the ERV Methodology, mobile phones and the Internet were used by farmers in those communities as tools for the collaborative creation of a knowledge commons focused on local agriculture. It was found that the ERV Methodology, carried out as artistic intervention, may encourage technological appropriation, induce reciprocity, and amplify voice under certain sociotechnical conditions. These findings suggest that such a methodology might benefit farmers by becoming a significant aid to increase their resilience and their capacity to face complex challenges in the longer term. However, another conclusion was that the ERV Methodology should be applied carefully, with a strong awareness of the local context, and that greater efforts must be made in order to integrate other communities, such as local authorities and scientific researchers, into the reciprocal dynamics enabled by the methodology.},
  langid = {english},
  keywords = {inglesa}
}

@thesis{evelizemartinskrugerperes2015apropriacao,
  title = {Apropriação de tecnologias digitais : formação continuada com professores de matemática},
  author = {{Evelize Martins Krüger Peres}},
  date = {2015-01-01},
  journaltitle = {Americanae (AECID Library)},
  url = {https://openalex.org/W1123201088},
  abstract = {Este trabalho traz uma pesquisa sobre o processo de apropriação de tecnologia digital pelos professores de Matemática do município de Guaíba, inscritos no curso de formação continuada proposto para a realização desta pesquisa. Para analisar como ocorreu a apropriação tecnológica, foram propostas atividades relacionadas a conteúdos dos currículos escolares trabalhados pelos professores, utilizando o software GeoGebra e objetos digitais e observadas as atitudes dos professores frente à resolução destas atividades. Ainda, foi proposto que cada professor elaborasse e aplicasse uma sequência de atividades com seus alunos, para analisar como utilizariam os recursos tecnológicos abordados no curso em suas salas de aula. Como fundamentação teórica, buscamos suporte nas teorias de Artigue e Sandohltz, na formação de professores, na informática na educação e o papel da tecnologia na Educação Matemática. A pesquisa buscou responder à questão: Como os professores de matemática inscritos na formação continuada se apropriam de tecnologias digitais para utilizar em sala de aula? A partir dos dados analisados, observamos que houve um crescimento quanto aos níveis de apropriação tecnológica de Sandohltz por parte de alguns professores.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@thesis{evelynalejandrarojastorres2020apropiacion,
  title = {Apropiación de las competencias tecnológicas en docentes del programa de Comunicación Social- Periodismo en la Universidad Autónoma de Occidente},
  author = {{Evelyn Alejandra Rojas Torres}},
  date = {2020-11-19},
  journaltitle = {Repositorio Digital Universidad Autonoma de Occidente},
  url = {https://openalex.org/W7132985115},
  abstract = {Este proyecto pretende caracterizar la implementación de la mediación tecnológica como competencia pedagógica, por parte de tres docentes del programa de Comunicación Social-Periodismo de la Universidad Autónoma de Occidente, desde la indagación del uso de las competencias mediáticas según al enfoque de las asignaturas (práctico, teórico-práctico y teórico) por parte de los docentes, identificación de las herramientas digitales empleadas para la impartición de su clase para propiciar el aprendizaje y la caracterización de las formas en que los educadores han adquirido el conocimiento relacionado con las competencias tecnológicas. Por lo cual se realizó una investigación cualitativa, con enfoque exploratorio-descriptivo, con el fin de desarrollar los objetivos de este proyecto. Los sujetos de estudio son tres docentes del programa de Comunicación Social-Periodismo de la Universidad Autónoma de Occidente, diferenciados por el enfoque de la asignatura que imparten y el nivel de apropiación tecnológica que tienen. Los métodos de investigación fueron la observación participante y el estudio de casos, las técnicas para el desarrollo de la fase metodológica fueron la observación, para la cual se empleó la bitácora como instrumento para la recolección de la información, la entrevista semiestructurada, conformada por un cuestionario de preguntas abiertas dirigidas a los docentes y una encuesta, con un cuestionario estructurado con preguntas cerradas y abiertas dirigido a los estudiantes de estas asignaturas, que permitieron recoger información que entre si se complementó. Para finalizar se presentaron los resultados y su respectivo análisis e interpretación desde los autores examinados en el desarrollo de este proyecto, lo que permitió la presentación de las conclusiones y recomendaciones que le aporten al desarrollo de los docentes y el programa de Comunicación Social-Periodismo de la Universidad Autónoma de Occidente, además de plantear temas que puedan desarrollarse en futuras investigaciones},
  langid = {spanish},
  keywords = {iberoamericana}
}

