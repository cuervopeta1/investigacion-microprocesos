@thesis{corderosanchez2017activismo,
  type = {http://purl.org/dc/dcmitype/Text},
  title = {Activismo mediático, empoderamiento comunicacional y soberanía tecnológica como factores del cambio social y cultural de la sociedad civil (1999-2014)},
  author = {Cordero Sánchez, Ildefonso},
  date = {2017},
  institution = {Universidad de Granada},
  url = {https://dialnet.unirioja.es/servlet/tesis?codigo=125485},
  urldate = {2026-11-13},
  abstract = {En las últimas dos décadas hemos asistido a una revolución tecnológica sin precedentes, que ha provocado un cambio social y cultural en los movimientos sociales, redefiniendo la idea de activismo mediático. Las nuevas tecnologías de la información y la comunicación y la configuración de la sociedad red ha permitido la creación de nuevos modelos de acción comunicativa, facilitados por el uso emancipador, insurgente y contrahegemónico que los movimientos sociales han hecho de las tecnologías de la comunicación. Este uso emancipador, basado en un sistema de valores colectivos desarrollado desde finales del siglo XX, ha permitido la creación de un ecosistema de medios alternativos absolutamente nuevo, a partir de la apropiación de las tecnologías y la experimentación de lenguajes y formatos, por parte de los movimientos sociales, lo que les ha otorgado una gran autonomía a la hora de construir su identidad colectiva, permitiéndoles reducir su dependencia histórica del mainstream. El estudio que se aborda se realiza de la siguiente forma: -En un primer momento se realiza una aproximación terminológica a la teoría general de los movimientos sociales, en tanto que se configuran como sujetos de estudio, atendiendo especialmente a las peculiaridades que presentan en las últimas dos décadas, en la medida que están influenciados directamente por la acción de las nuevas tecnologías de la información y la comunicación, para a continuación desarrollar una aproximación genealógica a los modelos de acción comunicativa de los movimientos de protesta en el periodo de estudio, que se divide en tres fases: la primera, de eclosión del movimiento antiglobalización, que desarrolla un modelo de protesta basado en contracumbres; la segunda, en la que el Foro Social Mundial asume el liderazgo de la lucha por la justicia global; una tercera, en la que aparecerán lo movimientos de indignación y ocupación, dando unas característica propias al movimiento de protesta. Para finalizar la contextualización del fenómeno, se realiza igualmente una aproximación terminológica a determinados conceptos políticos, filosóficos y sociológicos relacionados con el objeto de estudio. -La segunda parte de esta tesis estudia la forma en la que se han producido procesos de apropiación de los lenguajes y las tecnologías por parte de los movimientos sociales, que le han permitido desarrollar un ecosistema de los medios alternativos, capaz de superar los procesos de subinformación, desinformación y manipulación a los que se han visto sometidos históricamente, así como del sistema de valores del que se ha dotado para construir un sistema de información y conocimiento basado en la cultura colaborativa. Este proceso contribuye decisivamente a la democratización de los procesos, a la participación social y a la construcción de un sistema de medios desde la ciudadanía, que permite hablar de un cierto nivel de soberanía informativa y tecnológica de los movimientos sociales. Ello, además, permite la creación de mecanismos autónomos para la construcción de la identidad que les permite hacer visible su protesta y creíble su alternativa. Sin que ello deje de ser una aspiración todavía, los movimientos sociales han iniciado un camino de cambio en su forma de afrontar su relación con los medios y las tecnologías, que los diferencia de etapas anteriores. -En una tercera parte, se analizan una serie de modelos y vectores experimentados en los últimos veinte años en los procesos de acción comunicativa de los movimientos sociales, para terminar con la conclusiones de la investigación.},
  langid = {spanish}
}

