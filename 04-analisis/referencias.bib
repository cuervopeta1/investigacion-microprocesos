@article{2021nube,
  title = {La nube aún está lejos de su madurez en ciberprotección por la falta de especialistas, su rápida evolución y superficie de exposición},
  date = {2021},
  journaltitle = {Revista SIC: ciberseguridad, seguridad de la información y privacidad},
  volume = {30},
  pages = {166},
  publisher = {Ediciones CODA},
  issn = {1136-0623},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8527023},
  urldate = {2026-11-13},
  abstract = {El impulso que ha tenido el uso de la nube por el trabajo en remoto y la necesidad de proteger los datos que hay en ella, subidos desde todo tipo de dispositivos, su seguridad ha experimentado ‘un nuevo amanecer’. A ello se han sumado importantes iniciativas como la acometida por Francia a finales de septiembre, cuando el Director de la Direction Interministérielle du Numérique, su departamento de sistemas de la información, prohibió a sus ministros el empleo de Microsoft 365 para, dice, proteger su soberanía digital. Según una circular interna, “Microsoft 365 no cumple con la doctrina en la nube del centro”, por lo que pide a la Administración pública que deje de usar la nube ofrecida por la multinacional estadounidense para protegerse de la llamada ’Cloud Act’ de EE.UU.},
  issue = {147 (Noviembre 2021)},
  langid = {spanish}
}

@book{2022gestion,
