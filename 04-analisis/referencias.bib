@article{valeriaalonso2025redes,
  title = {Redes comunitarias de cuidado de la salud en Mar Del Plata y Batán desde una perspectiva interseccional},
  author = {{Valeria Alonso}},
  date = {2025-12-04},
  journaltitle = {SALUD publica: revista del Ministerio de Salud de la Provincia de Buenos Aires},
  shortjournal = {SALUD publica: revista del Ministerio de Salud de la Provincia de Buenos Aires},
  url = {https://openalex.org/W7220537562},
  abstract = {Introducción: En Mar del Plata y Batán, las organizaciones sociales articulan redes intersectoriales con áreas del estado, conformadas por asociaciones vecinales, asambleas ambientalistas, movimientos sociales, comunidades indígenas, iglesias, bibliotecas, escuelas, centros de salud. El estudio integra un proyecto sobre estrategias comunitarias y derecho a la salud en Argentina con perspectiva interseccional. Objetivo: Proponemos analizar las estrategias comunitarias en los barrios periurbanos y rurales de Mar del Plata y Batán, según las dimensiones de género, etnicidad y clase social, para comprender cómo recuperar el derecho a la salud en la postpandemia. Metodología: Trabajamos en investigación-acción participativa con un diseño etnográfico colaborativo. Durante 2023 mantuvimos entrevistas en profundidad con 11 mujeres, 5 varones y una mujer transgénero, referentes de organizaciones y movimientos sociales de los barrios periurbanos y rurales de Mar del Plata y Batán para describir la conformación de las redes territoriales. Organizamos 4 talleres de cartografía social y realizamos observación participante con las redes comunitarias de la Zona Oeste Rural, Batán y Playas del Sur, para graficar las problemáticas de salud y las estrategias comunitarias de cuidado. Ensamblamos y editamos los mapeos sociales para su devolución en encuentros ampliados con las redes comunitarias y los efectores de salud, educación, niñez y adolescencia, y políticas de género. Resultados: Las redes comunitarias se organizaron años antes de la pandemia para tratar colectivamente las problemáticas territoriales más urgentes. La mayoría de las actividades son realizadas por mujeres que reconocen una triple carga de trabajo. En los barrios periurbanos, la organización de comedores y abrigo se combina con la prevención de la violencia de género, la lucha por el agua, la salud mental y consumos problemáticos. En las zonas rurales, las acciones por la contaminación del agua y las iniciativas agroecológicas, la visibilización de la violencia de género y la lucha por el transporte se llevan adelante en contextos de segmentación social y discriminación étnica, condiciones precarias de trabajo y vivienda, que vulneran el derecho a la salud de las mujeres, niñxs y adolescentes. Conclusiones: Las estrategias comunitarias de cuidado evidencian la necesidad de ampliar el concepto de salud a las problemáticas ambientales, la violencia de género, la discriminación étnica y las desigualdades de clase. El enfoque interseccional permite revisar el modelo hegemónico en salud pública para integrar las organizaciones y movimientos sociales que sostienen la vida en contextos pauperizados.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{valeriacastroobando2021integralidad,
  title = {La integralidad en el abordaje de la inclusión digital},
  author = {{Valeria Castro Obando}},
  date = {2021-12-13},
  journaltitle = {Dehuidela/Revista latinoamericana de derechos humanos/Revista Latinoamericana de Derechos Humanos (San José)},
  shortjournal = {Dehuidela/Revista latinoamericana de derechos humanos/Revista Latinoamericana de Derechos Humanos (San José)},
  volume = {33},
  number = {1},
  pages = {157--175},
  doi = {10.15359/rldh.33-1.1},
  url = {https://openalex.org/W4212986630},
  abstract = {El siguiente artículo presenta el concepto de la inclusión digital desde una perspectiva crítica en la que se lo plantea como un término complejo y multidimensional, que plasma un proceso que busca potenciar el uso de las tecnologías de la información y la comunicación (TIC) y desarrollar una serie de prácticas, habilidades y destrezas con el fin de que se produzca una apropiación tecnológica que dote de capacidades adecuadas y suficientes para sobrevivir en la sociedad de la información y el conocimiento (SIC). Un enfoque como este comprende tres áreas de acción distintas: el acceso a las TIC (equipamiento y desarrollo de infraestructura de telecomunicaciones), la alfabetización digital y la apropiación digital (uso de TIC y reinvención y adaptación de los usos). Una visión así de la inclusión digital requiere de la puesta en práctica de soluciones integrales que abandonen las visiones reduccionistas y unidimensionales de este problema público; adoptar estrategias que combinen acciones que incluyan la inversión y desarrollo de infraestructura de telecomunicaciones; el equipamiento y asequibilidad de las tecnologías; la calidad en los servicios, y la construcción de capacidades para la apropiación y alfabetización digital, así como considerar las necesidades diferenciadas de aquellos sectores en mayor condición de vulnerabilidad.},
  langid = {spanish},
  keywords = {iberoamericana}
}

