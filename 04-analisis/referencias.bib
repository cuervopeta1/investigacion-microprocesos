@article{ivoniltonsantossantana2026entre,
  title = {ENTRE APROPRIAÇÃO TECNOLÓGICA E PARTICIPAÇÃO CIDADÃ: LETRAMENTO DIGITAL E FORMAÇÃO CRÍTICA NO ESPAÇO ESCOLAR},
  author = {{Ivonilton Santos Santana}},
  date = {2026-01-01},
  journaltitle = {Revista Internacional de Estudos Multidisciplinares Educaler},
  shortjournal = {Revista Internacional de Estudos Multidisciplinares Educaler},
  volume = {2},
  number = {1},
  pages = {179--199},
  doi = {10.29327/2946445.2.1-6},
  url = {https://openalex.org/W7223333093},
  abstract = {O uso crescente das tecnologias digitais nas práticas de comunicação, aprendizagem e participação social amplia as exigências formativas relacionadas à leitura crítica da informação, à responsabilidade nas interações, à segurança e ao exercício da cidadania. Diante desse contexto, o problema que orienta este ensaio consiste em compreender em que bases conceituais o letramento digital pode ser entendido como dimensão da formação cidadã escolar, especialmente na articulação entre criticidade, ética, segurança e participação social. O objetivo é analisar o letramento digital como dimensão da formação cidadã escolar, examinando a articulação entre essas dimensões na cultura digital. Trata-se de um ensaio teórico de natureza bibliográfica, complementado por análise documental, com produção acadêmica brasileira publicada entre 2021 e 2026 e documentos oficiais sobre educação digital e midiática. A análise evidencia que criticidade, responsabilidade ética, segurança, autonomia e participação mantêm relações complementares e recursivas. Conclui-se que a escola exerce função relevante na mediação dessas aprendizagens, favorecendo uma formação digital orientada à compreensão, à responsabilidade, à autonomia e à participação cidadã.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

