@article{llorenslargo2026verdad,
  title = {La verdad y lo veraz: la universidad ante la encrucijada de la IA generativa},
  shorttitle = {La verdad y lo veraz},
  author = {Llorens Largo, Faraón and Molina Carmona, Rafael},
  date = {2026},
  journaltitle = {RIED: revista iberoamericana de educación a distancia},
  volume = {29},
  number = {2},
  pages = {3},
  publisher = {AIESAD (Asociación Iberoamericana de Educación Superior a Distancia)},
  issn = {1138-2783},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10714695},
  urldate = {2026-11-13},
  abstract = {The rapid expansion of generative artificial intelligence is profoundly transforming the knowledge ecosystem and forcing universities to rethink their epistemic, organisational and pedagogical foundations. This article analyses how contemporary indifference towards truth erodes public trust, how generative AI amplifies this erosion by producing plausible but not necessarily truthful content, and how this new scenario strains the role of universities as guarantors of reliable knowledge. Faced with the growing automation of textual production, we argue that truth does not disappear, but it does become more costly to verify, requiring academic institutions to strengthen their mechanisms of validation, traceability, and intellectual responsibility. We also arguethat the university response cannot be limited to incorporating new tools, but requires ethical governance, digital sovereignty that reduces dependencies, and critical competence that enables the entire university community to act judiciously in environments saturated with digitally generated information. To contribute to this debate, we propose an analytical tool, the cube of truth, truthfulness and trust, which allows for the evaluation of the academic use of generative AI in teaching, research and management. Its application to the educational field shows how different types of tasks and levels of knowledge require specific combinations of evidence, verification and authorship. We conclude that the central mission of the university in the age of AI is not to compete in content production, but to preserve the conditions that allow knowledge to be distinguished from other forms of information and to maintain public trust in its work La expansión de la inteligencia artificial generativa está transformando el ecosistema del conocimiento y obligando a las universidades a replantear sus fundamentos epistémicos, organizativos y pedagógicos. Este artículo analiza cómo la indiferencia hacia la verdad erosiona la confianza pública, cómo la IA generativa amplifica esa erosión al producir contenidos plausibles, pero no necesariamente veraces, y cómo este escenario tensiona el papel de las universidades como garantes de conocimiento. Frente a la creciente automatización de la producción textual, sostenemos que la verdad no desaparece, pero sí se vuelve más costosa de verificar, lo que exige a las instituciones académicas reforzar sus mecanismos de validación, trazabilidad y responsabilidad. También argumentamos que la respuesta universitaria no puede limitarse a incorporar nuevas herramientas, sino que requiere una gobernanza ética, una soberanía digital que reduzca dependencias y una competencia crítica que capacite a toda la comunidad universitaria para actuar con criterio en entornos saturados de información generada digitalmente. Para contribuir a este debate, proponemos un instrumento analítico, el cubo de verdad, veracidad y confianza, que permite evaluar el uso de la IA generativa en docencia, investigación y gestión. Su aplicación al ámbito formativo muestra cómo distintos tipos de tareas y niveles de conocimiento exigen combinaciones específicas de evidencia, verificación y autoría. Concluimos que la misión central de la universidad en la era de la IA no es competir en producción de contenidos, sino preservar las condiciones que permiten distinguir el conocimiento del resto de formas de información y mantener la confianza pública en su labor.},
  langid = {spanish}
}

@article{lluisgibertiatienza2011filosofia,
