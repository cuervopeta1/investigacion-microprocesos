@article{lopezdemesa2011evaluacion,
  title = {Evaluación de los impactos de las políticas públicas en la apropiación social de las TIC, caso Medellín - Colombia},
  author = {López de Mesa, Camilo Polanco},
  date = {2011},
  journaltitle = {Revista AHCIET: revista de telecomunicaciones},
  number = {125},
  pages = {46--61},
  publisher = {Asociación Hispanoamericana de Centros de Investigación y Empresas de Telecomunicaciones},
  issn = {0213-1226},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=3634121},
  urldate = {2026-11-13},
  abstract = {The following article details the current state of public policies for the social acceptance of Communication and Information Technologies in educational communities located in Medellín, Colombia, and the impact that these policies have had. The tools used to measure the impact of these policies have been based on how these technologies are applied and used together with how well students and teachers that are a part of state schools with student populations that come from lower socioeconomic backgrounds have accepted these technologies. The implementation of these policies has transformed both teaching and learning processes in educational settings, where CITs have been included into the curriculum. There has also been a significant impact on the societies that surround these schools as they use CITs in extra curricular activities such as �open classroom� days. The roles that teachers and students take in these new learning and teaching environments have also evolved so that there is more access to information and knowledge can be more readily attainable. With CITs, knowledge is no longer exclusive to teachers but it is now made available through different means and spaces which contrast with the typical classroom scenario. El siguiente artículo presenta algunos de los impactos que se han alcanzado con la puesta en marcha de la política pública para la apropiación social de las Tecnologías de la Información y Comunicación (TIC) en comunidades educativas de la ciudad de Medellín � Colombia. Estos impactos se han medido con algunos indicadores tanto en el uso como de la apropiación de estudiantes y docentes pertenecientes a Instituciones Educativas (IE) oficiales que albergan la población estudiantil con más bajo nivel socioeconómico. La implementación de esta política ha transformado tanto los procesos de enseñanza como de aprendizajes de los docentes y estudiantes, en los cuales las TIC se han transversalizado en el currículo, pero también han impactado a la sociedad que vive alrededor de estas Instituciones Educativas, haciendo uso de las TIC en jornadas contrarias a las educativas, bajo el modelo de �aula abierta�. Los roles de docentes y estudiantes en estos nuevos ambientes de enseñanza y aprendizaje, se transforman y evolucionan para posibilitar el acceso a la información y apropiación del conocimiento disponible en los diferentes medios. El conocimiento ya no es una posesión exclusiva del maestro, sino que está disponible en medios y espacios diferentes a los tradicionalmente reconocidos en el aula de clase.},
  langid = {spanish}
}

