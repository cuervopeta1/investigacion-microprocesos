  doi = {10.11144/javeriana.uo37-79.rted},
  url = {https://openalex.org/W2943332784},
  abstract = {Background: Emergence of new technologies and advances in tissue engineering strategies to treat diseases are shifting the conventional conception of medical devices. Tissue engineered products, manufactured as a combination of biomaterials, cells, and/or bioactive factors, are intended to temporarily restore an organ or tissue function, and induce the generation of newly site-appropriate functional tissue. Regulatory pathways for tissue engineered products require grouping policies controlling each of the components: materials, human cells, and active molecules. Purpose: To review current regulatory policies for medical devices (and within this, tissue engineered products), in a subset of Latin American countries, and to analyze the influence of international organizations and technological world power countries on policies of that subset. Methods: Top-down and horizontal diffusion models were employed to identify how regulatory policies have moved to Brazil, Colombia, Ecuador, Mexico, and Peru. Results: There are differences in technological appropriation to comprehensively define and classify medical devices. None of the countries have a definition of tissue engineered products. A top-down diffusion pattern was found to be associated with the current regulations. A horizontal diffusion is being applied as a regional effort to facilitate commercialization of medical products within Latin America. Conclusion: The concept of tissue engineered products is slowly arriving into the evaluated Latin American countries. Each country has the potential to take advantage of local institutions and regional and inter-regional coalitions to improve current guidelines and prepare the health system to the introduction of tissue engineered products.},
  langid = {english},
  keywords = {inglesa}
}

@article{ceciliamercedesquevedo2024fragilidad,
  title = {La fragilidad de lo común a una década de la última transformación urbanística del Barrio Toba (ciudad de Resistencia, Argentina)},
  author = {{Cecilia Mercedes Quevedo}},
  date = {2024-12-23},
  journaltitle = {Revista del Museo de Antropología},
  shortjournal = {Revista del Museo de Antropología},
  volume = {17},
  number = {3},
  pages = {287--300},
  doi = {10.31048/45s97y35},
  url = {https://openalex.org/W4405722235},
  abstract = {This article addresses the socio-environmental impact of urban and housing transformations on the Qom population of the Toba neighborhood in the city of Resistencia, examining state interventions and the political experience of the inhabitants. From a materialist and socioecological perspective, we first analyze the relationships between the cycles of capital accumulation and construction materials, as well as the tensions between the separations that develop within the highly fragmented contemporary city and the production of the common in community networks. Secondly, we characterize the stages that frame the two urban and housing renovations in Barrio Toba. Finally, we explore the politicizations of the neighbors of Barrio Toba from the struggle for housing, noticing in the last decade its fragility as a way of producing the common. This article is based on the consultation of secondary sources, interviews with state and community actors participating in the interventions and ethnographic observations from tours with indigenous referents in the neighborhood. The purpose of the paper considers the historical link between capitalism, indigenous populations and the operation of multiple separations and dispossessions in urban spaces. As a result, the chapter exposes how during the last decade fragile forms of production of the common were expressed, rather than emancipatory responses, coinciding with the socio-sanitary and ecological crisis caused by the Covid-19 pandemic.},
  langid = {spanish},
  keywords = {inglesa}
}

@article{celayaramirez2010apropiacion,
  title = {Apropiación tecnológica en profesores que incorporan recursos educativos abiertos en educación media superior},
  author = {Celaya Ramírez, Rosario and Lozano Martínez, Fernando and Ramírez Montoya, María Soledad},
  date = {2010-06},
  journaltitle = {Revista mexicana de investigación educativa},
  shortjournal = {Revista mexicana de investigación educativa},
  volume = {15},
  number = {45},
  pages = {487--513},
  issn = {1405-6666},
  url = {http://www.scielo.org.mx/scielo.php?script=sci_arttext&pid=S1405-66662010000200007&lang=pt},
  abstract = {The article presents research on the way technological appropriation occurs among high school teachers who incorporate open educational resources from a repository. The methodology used was the case study. Semi-structured interviews, electronic questionnaires to triangulate data, and the analysis of documents were employed. The results indicated that in the cases studied, the subject and the type of open educational resources adopted had an influence on the teacher's perception of resource usefulness. The teachers had a level of knowledge and use of the resource, identified the resources by their characteristics and use, and employed that knowledge to adopt the materials in their courses. However, they did not transfer the resources to different contexts: they did not modify or design resources, but only selected them as a function of the activity.},
  langid = {spanish},
  keywords = {educación media superior,educational innovations,educational resources,high school education,innovaciones educativas,Mexico,México,new technologies,nuevas tecnologías,recursos educacionales}
}

@article{celinagallodiaz2015incidencia,
  title = {Incidencia de la plataforma tecnológica de aprendizaje moodle en las prácticas pedagógicas para la formación de licenciados},
  author = {{Celina Gallo Díaz} and {Jaime Andrés Torres Ortíz}},
  date = {2015-03-26},
  journaltitle = {Repositorio Institucional UPTC},
  shortjournal = {Repositorio Institucional UPTC},
  url = {https://openalex.org/W7133100368},
  abstract = {Spa: La plataforma tecnológica MOODLE en su utilización actual ha servido como mediación tecnológica para el apoyo y transformación de las prácticas pedagógicas en la Modalidad B-learning, incidiendo así en la transformación del discurso pedagógico, la construcción de un nuevo rol del docente tutor y, para la formación de Licenciados en Educación Básica. Con base en esto, la presente investigación se propuso caracterizar cómo se determinan estas prácticas a través del uso de la Pataforma Moodle, tomando en cuenta el sentido de las mismas en la formación de lo humano, a través de las asignaturas en el área de humanidades. A partir de un método cualitativo de investigación-acción se resignificó en primera instancia el sentido formativo en la apropiación tecnológica de las herramientas infocomunicacionales (Plataforma MOODLE), luego se trabajó en la comprensión del fin formativo a través de estas prácticas y las acciones que el docente tutor emprende en la interacción con el estudiante. Entre los resultados obtenidos se encontró la importancia de reconocer la comprensión del fin formativo a través de sus prácticas en el campo de las ciencias humanas y la superación de obstáculos y resistencias culturales centrados en el cumplimiento de normas y reglas disciplinantes, que obstaculizan el desarrollo en el ámbito social e individual en la formación de Licenciados. Palabras clave (5 o 6) Plataforma Tecnológica Moodle, Prácticas Pedagógicas, Formación, Educación a distancia y virtual.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{celsoalexandresouzadealvear2023economia,
  title = {ECONOMIA SOLIDÁRIA 2.0: por um cooperativismo de plataforma solidário},
  author = {{Celso Alexandre Souza de Alvear} and {Ricardo Toledo Neder} and {Daniel Santini}},
  date = {2023-03-28},
  journaltitle = {P2P E INOVAÇÃO},
  shortjournal = {P2P E INOVAÇÃO},
  volume = {9},
  number = {2},
  pages = {42--61},
  doi = {10.21721/p2p.2023v9n2.p42-61},
  url = {https://openalex.org/W4361292023},
  abstract = {Em contraposição ao capitalismo de plataforma, modelo em que empresas gerenciam trabalhadores em condições precárias por meio de algoritmos, o presente artigo pretende aprofundar a ideia de cooperativismo de plataforma, explorando suas possibilidades como instrumento de transformação social e inclusão no Brasil. Parte-se do histórico da economia solidária no país para imaginar soluções estruturadas em solidariedade, participação social e valorização de bens comuns. Tudo a partir de um entendimento de que o desenvolvimento de tecnologia deve ser pensado para além da criação de bens de consumo descartáveis com obsolência programada. Para elaborar e construir soluções são necessários modos de interação e gestão compartilhada entre movimentos sociais com suas demandas populares e desenvolvedores de Tecnologia da Informação e Comunicação (TIC). Articular tais segmentos é o desafio para o desenvolvimento de algoritmos com protagonismo social em projetos capazes de operar em favor do bem público - esse é o melhor caminho para garantir a soberania digital e avançar com empreendimentos econômicos solidários no Brasil.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{cerdadiez2024forced,
  title = {Forced {{Adoption}} of {{Technology}} in {{Older Adults}}: {{A Scoping Review}} of the {{Literature}}},
  shorttitle = {Forced {{Adoption}} of {{Technology}} in {{Older Adults}}},
  author = {Cerda Diez, María Fernanda and Barreto Calle, Cristian and Pavez, Isabel},
  date = {2024},
  journaltitle = {Research on Ageing and Social Policy: (RASP)},
  volume = {12},
  number = {1},
  pages = {1--20},
  publisher = {Hipatia Editorial},
  issn = {2014-671X},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9453077},
  urldate = {2026-11-13},
  abstract = {The concept of forced technology adoption in older people has not been explored in depth, especially in the context of the COVID-19 pandemic, where people were forced to migrate online in order to carry out their daily activities. A systematic scoping review was developed in English and Spanish-speaking indexed journals between 2020 and 2022, to identify the literature addressing this concept in terms of volume, nature and characteristics and to identify possible gaps that may exist. Using the theoretical framework proposed by Arksey and O'Malley (2005), 117 articles were identified in five different databases, of which only seven met the inclusion criteria and were selected for analysis. The results show that the use of the concept applied in older people is still scarce and that there are opportunities to address it from the resistance produced by this type of adoption and the need to develop public policies that naturalize the access and use of ICT in contexts of crises and catastrophes so as not to leave isolated a vulnerable group of the population. En el tan estudiado contexto de la pandemia de COVID-19, las TIC fueron de especial interés respecto de su adopción en poblaciones vulnerables, entre ellas, las personas mayores. Sin embargo, las circunstancias de apropiación tecnológicas fueron complejas con usuarios que sin acceso o habilidades digitales fueron forzados a migrar a lo online para desarrollar sus actividades cotidianas. Es por ello que el presente artículo desarrolla una revisión sistemática de alcance en revistas indexadas de habla inglesa y española entre los años 2020 y 2022, para identificar la literatura que aborda el concepto de adopción forzada en términos de volumen, naturaleza y características e identificar los posibles vacíos teóricos. Utilizando el modelo propuesto por Arksey y O´Malley (2005), se identificaron 117 artículos en cinco bases de datos, de los cuales solo siete cumplieron con los criterios de inclusión y fueron seleccionados para su análisis. Los resultados muestran que la utilización del concepto de adopción forzada de tecnología aplicado en personas mayores sigue siendo escasa y que se presenta la oportunidad de abordarlo desde la resistencia producida por este tipo de adopción y la necesidad de desarrollar políticas públicas que naturalicen el acceso y uso de TIC en contextos de crisis y catástrofes para no dejar aislados a un grupo vulnerable de la población.},
  langid = {english}
}

@article{cerenyavuz2025technonationalism,
  title = {Techno-Nationalism or Technology Sovereignty? {{Comparative}} Evidence from {{MRI}} Technology Development in {{Türkiye}} and {{Brazil}}},
  author = {{Ceren Yavuz} and {İbrahim Semih Akçomak}},
  date = {2025-12-30},
  journaltitle = {ODTÜ gelişme dergisi/ODTÜ gelişme dergisi},
  shortjournal = {ODTÜ gelişme dergisi/ODTÜ gelişme dergisi},
  doi = {10.60165/metusd.v52i2.8},
  url = {https://openalex.org/W7118869177},
  abstract = {This paper compares Türkiye and Brazil within a political-economy framework, analyzing how techno-nationalism and technology sovereignty strategies affect technological learning and indigenous production capabilities, specifically in MRI technology development. Rapid technological advancements and geopolitical shifts have triggered governments to reconsider industrial policies, emphasizing technological autonomy, supply chain resilience, and national security. While Türkiye's “indigenous-national” approach exhibited strong techno-nationalistic tendencies, hindering effective technological learning, Brazil's more open, collaborative strategy significantly facilitated technology transfer and indigenous capabilities. MRI technology provides an ideal context due to its complexity, strategic healthcare importance, and concentrated global market dominated by multinational corporations. The findings reveal that Türkiye’s nationalistic strategy, characterized by limited institutional alignment and global integration, constrained technological capability building. In contrast, Brazil’s strategic localization, supported by structured policy interventions and international collaboration, resulted in effective technological learning and industrial success. This research provides novel insights by examining Türkiye’s hybrid strategy (indigenous-national), an area rarely explored comparatively in existing literature, thus enriching discussions on technology sovereignty and techno-nationalism in emerging economies. Key words: Techno-nationalism, technology sovereignty, Türkiye, Brazil, MRI. JEL codes: O14, O25, 032.},
  langid = {english},
  keywords = {inglesa}
}

@article{cerra2008desenvolvimento,
  title = {Desenvolvimento de produtos no contexto das cadeias de suprimentos do setor automobilístico},
  author = {Cerra, Aline Lamon and Maia, Jonas Lucio},
  date = {2008-03},
  journaltitle = {Revista de Administração Contemporânea},
  shortjournal = {Revista de Administração Contemporânea},
  volume = {12},
  number = {1},
  pages = {155--176},
  issn = {1415-6555},
  url = {http://www.scielo.br/scielo.php?script=sci_arttext&pid=S1415-65552008000100008&lang=pt},
  abstract = {In the Brazilian Automotive Industry, the Product Development activities have been influenced by changes on supply chains resulting from the investments made by new assemblers in order to install new assembly plants in the country, consolidation and denationalization of the auto-part industry, as well as the impacts of phenomena specific to the Brazilian scenario like the 1000cc and bi-fuelled engines. This work aims at comparing the degree of technological autonomy conquered by the engine assemblers installed in Brazil, as well as analysing the Product Development activities that those branches accomplish together with their suppliers. In this sense we try to verify how the relationships between the companies inside these chains are, how the Product Development activities and competencies are distributed along them, and how it is managed by the assemblers. Generally, the Product Development activities of these assemblers are very similar and oriented to local competitiveness. The differences take place as a result of their supply chain structures and of their supplying policies.},
  langid = {portuguese},
  keywords = {automotive industry,desenvolvimento de produtos,gestão da cadeia de suprimentos,indústria automobilística,product development,supply chain management}
}

@article{cerveranavas2022valores,
  title = {Los valores del antiguo continente y el futuro de la protección de datos},
  author = {Cervera Navas, Leonardo and Costa, Graça and Peris Brines, Nerea},
  date = {2022},
  journaltitle = {La Ley privacidad},
  pages = {12},
  publisher = {La Ley},
  issn = {2659-8698},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8488071},
  urldate = {2026-11-13},
  abstract = {Tras un período difícil en el que muchas personas perdieron su vida debido a la pandemia de COVID-19 y no hubo más remedio que restringir algunos derechos, se inició una guerra inesperada en las fronteras de la UE. Desde ese momento, hemos sido testigos de los horrores de la guerra en Ucrania y del aumento de ciberataques en la UE. En este contexto, los principios fundamentales sobre los que se asienta la UE son todavía más necesarios si cabe. Ser europeo significa ser parte de una historia compartida y de unos valores comunes, que están grabados a fuego en nuestras culturas y sociedades. El respeto de los derechos fundamentales, como la protección de datos, es solo un ejemplo importante de estos valores comunes que son la esencia de ser europeos. A pesar de la amenaza a la paz y a la unidad, nuestros valores europeos siguen existiendo e incluso se refuerzan. La sabiduría del llamado «antiguo Continente» nos guiará en el futuro con una certeza: el mundo seguirá cambiando, pero los valores europeos y la Declaración Schuman merecen ser recordados y celebrados cada año. After a difficult period when many people lost their lives due to the COVID-19 pandemic and there was no choice but to restrict some rights, an unexpected war started at the EU's borders. Since then, we have witnessed the horrors of war in Ukraine and the rise of cyber-attacks in the EU. In this context, the fundamental principles on which the EU is founded are even more necessary. Being European means being part of a shared history and common values, which are embedded in our cultures and societies. Respect for fundamental rights, such as data protection, is just one important example of these common values that are the essence of being European. Despite the threat to peace and unity, our European values continue to exist and even strengthen. The wisdom of the so-called «old Continent» will guide us in the future with one certainty: the world will continue to change, but European values and the Schuman Declaration deserve to be remembered and celebrated every year.},
  issue = {12 (abril-junio)},
  langid = {spanish}
}

@article{cerverogarcia.2024riscv,
  title = {RISC-V brinda un futuro tecnológico abierto},
  author = {Cervero García., Teresa},
  date = {2024},
  journaltitle = {Bit},
  number = {234},
  pages = {24--27},
  publisher = {Colegio Oficial de Ingenieros de Telecomunicación},
  issn = {0210-3923},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9892021},
  urldate = {2026-11-13},
  abstract = {La adquisición de Arm por Softbank en 2016 acabó con el  último actor europeo de arquitectura de procesadores. En plena  era digital, y con las altas exigencias de procesamiento que  impone la Inteligencia Artificial (AI), la dependencia de chips  con terceros supone un factor de riesgo. En 2020 se puso de  manifiesto que Europa no disponía de hardware competitivo,  lo que causó la paralización de las cadenas de producción  en toda Europa. Ya por ese entonces, Europa había iniciado  una apuesta estratégica para promover la independencia y  soberanía tecnológica, apoyándose en estándares abiertos a  todos los niveles. Y en lo referente a la arquitectura de  computadores, la opción inevitable es RISC-V.},
  langid = {spanish}
}

@article{cesaraugustoborromeogarcia2016uso,
  title = {Uso de redes sociales en docentes de lengua inglesa y pedagogía: ¿Diferencias por disciplina?},
  author = {{César Augusto Borromeo García} and {Moisés Ramírez Hernández}},
  date = {2016-08-30},
  journaltitle = {Revista Ensayos Pedagógicos},
  shortjournal = {Revista Ensayos Pedagógicos},
  pages = {189--205},
  doi = {10.15359/rep.esp-16.10},
  url = {https://openalex.org/W2624653178},
  abstract = {This paper shows the preliminary results of two graduate research projects whose objectives are to know how Information and Communications Technologies (ICT) are used by teachers in their teaching process in two different disciplines at the Universidad Veracruzana: English Language and Pedagogy. For the collection of data, a questionnaire from ”Brecha digital entre estudiantes y profesores de la Universidad Veracruzana: Capital cultura; trayectorias escolares y desempeño académico; y grado de apropiación tecnológica” was administered to 55\% (35) of English Language teachers and 88\% (44) of Pedagogy; this article shows the results related to the use of social media. The main results highlight that the use of e-mail and social media are the most widely used tools by the teachers in both disciplines with means of socialization, communication and information exchange. The differences are minimal in the use of social media, but it is important to point out that they are used more by Pedagogy than English Language teachers. Finally, the ends by setting ground for future researches focused on specialized social media for each discipline, media that exists, but that are not exploited to its fullest.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@report{cesaraugustohernandezsuarez2024gestion,
  title = {Gestión tecnológica y formación docente en el marco de un ecosistema educativo híbrido},
  author = {{César Augusto Hernández Suárez} and {Juan Diego Hernández Albarracín} and {Jenny Katherine Guevara Jiménez}},
  date = {2024-01-01},
  journaltitle = {Repositorio Universidad Francisco de Paula Santander},
  url = {https://openalex.org/W7201929835},
  abstract = {Este proyecto tiene como objetivo fundamental explorar la Gestión Tecnológica del Conocimiento (GTC) en el contexto educativo de Cúcuta, Norte de Santander, y analizar su influencia en la formación docente y la adopción de modelos educativos híbridos. En el contexto global de la digitalización y la enseñanza híbrida, la GTC ha surgido como un pilar crítico para facilitar la integración de tecnologías en las prácticas educativas, mejorando no solo la transmisión de conocimientos, sino también la calidad general del proceso educativo. La pandemia de COVID-19 reveló las deficiencias estructurales y tecnológicas en el sistema educativo de la región, donde la falta de competencias tecnológicas entre los docentes impidió una transición fluida hacia el uso de tecnologías digitales y modelos híbridos. El problema central de la investigación se enmarca en la necesidad urgente de fortalecer las competencias tecnológicas de los docentes, quienes, a pesar de contar con cierta infraestructura tecnológica, carecen de la capacitación adecuada para gestionar estos recursos eficientemente en el aula. La Gestión Tecnológica del Conocimiento se convierte aquí en una herramienta crucial para superar esta brecha y facilitar una adopción más efectiva de modelos educativos híbridos, que combinen lo presencial con lo virtual. La metodología del proyecto sigue un enfoque mixto, integrando fases cuantitativas y cualitativas para proporcionar una comprensión más profunda del fenómeno investigado. En la fase cuantitativa, se aplicarán cuestionarios con escalas de Likert para medir las percepciones y competencias tecnológicas de los docentes. Este análisis permitirá identificar cómo estas competencias influyen en su capacidad para adoptar y gestionar tecnologías en el contexto de la educación híbrida. Los datos obtenidos serán analizados estadísticamente para obtener una visión clara sobre los niveles actuales de competencias TIC y su correlación con la adopción tecnológica en las aulas. La fase cualitativa, por su parte, utilizará el método fenomenológico hermenéutico para realizar entrevistas en profundidad a docentes y expertos en tecnologías educativas. Este enfoque explorará detalladamente las percepciones y experiencias de los docentes en cuanto a la integración de tecnologías y los desafíos que enfrentan al adoptar modelos híbridos en sus prácticas educativas. Las entrevistas serán transcritas y analizadas para identificar patrones y temas emergentes, lo que permitirá una comprensión más rica y contextualizada de la GTC y su impacto en la educación de la región. El proyecto espera ofrecer estrategias prácticas para mejorar la formación docente en competencias tecnológicas y fomentar una transición más efectiva hacia modelos educativos híbridos. Los resultados se compartirán con la comunidad educativa y otras partes interesadas, con el fin de fomentar la implementación de soluciones tecnológicas que promuevan una mayor apropiación tecnológica por parte de los docentes. Al final, se espera que esta investigación contribuya a una mejora significativa en la calidad educativa en la región, al integrar eficazmente la GTC en la formación docente y en la adopción de modelos híbridos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

