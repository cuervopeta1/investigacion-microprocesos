@article{maelsonjucadequeirozfernandes2026inteligencia,
  title = {Inteligência digital, governança global e os impactos jurídicos da era tecnológica},
  author = {{Maelson Jucá de Queiroz Fernandes}},
  date = {2026-06-10},
  journaltitle = {Revista Projeção e Docência},
  shortjournal = {Revista Projeção e Docência},
  volume = {17},
  number = {2},
  pages = {e2868-e2868},
  doi = {10.54899/rpd.v17n2-2868},
  url = {https://openalex.org/W7164402860},
  abstract = {Esse artigo buscou discutir a relação entre inteligência digital, governança global e os impactos jurídicos da era tecnológica, considerando os desafios produzidos pelo uso de dados, algoritmos, plataformas digitais, inteligência artificial e sistemas automatizados em escala internacional. O estudo foi desenvolvido por meio de pesquisa bibliográfica, de abordagem qualitativa, com análise de livros, legislações, documentos institucionais, relatórios internacionais e produções acadêmicas relacionadas à proteção de dados, segurança cibernética, responsabilidade das plataformas, Direito Internacional e regulação das tecnologias. Os resultados encontrados indicaram que a inteligência digital amplia possibilidades de inovação, eficiência e acesso à informação, mas também intensifica riscos ligados à privacidade, à transparência algorítmica, à soberania digital, à discriminação automatizada e à responsabilização dos agentes tecnológicos. Verificou-se ainda que a governança global se torna necessária diante de fenômenos digitais que ultrapassam fronteiras nacionais e envolvem diferentes jurisdições. Conclui-se que a era tecnológica exige respostas jurídicas mais éticas, cooperativas, transparentes e seguras, capazes de equilibrar inovação, proteção dos direitos fundamentais e responsabilidade institucional.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

