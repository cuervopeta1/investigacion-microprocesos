}

@article{carolineferreirademorais2026analise,
  title = {ANÁLISE DA DISTRIBUIÇÃO DOS LOCAIS COM COLETA SELETIVA NA CIDADE DE UBERLÂNDIA – MG},
  author = {{Caroline Ferreira de Morais} and {Maria Beatriz Junqueira Bernardes}},
  date = {2026-01-16},
  journaltitle = {Espaço em Revista},
  shortjournal = {Espaço em Revista},
  volume = {27},
  number = {2},
  pages = {72--96},
  doi = {10.70261/er.v27i2.74910},
  url = {https://openalex.org/W7124439776},
  abstract = {A viabilidade da análise da distribuição dos pontos e áreas com coleta seletiva na cidade de Uberlândia, foi possível por meio da utilização do software livre QGIS na sua versão 3.28, juntamente a dados gratuitos disponibilizados em plataformas de acesso público. Com isso, este artigo tem como objetivo compreender como estão distribuídos os locais de coleta seletiva na zona urbana de Uberlândia Assim, elaborou-se a carta-imagem do município; o mapa de localização das regiões atendidas pela coleta seletiva, incluindo os ecopontos, as escolas e as associações e cooperativas; e o mapa das escolas com e sem coleta seletiva. Por fim, utilizou-se da estimativa de densidade de kernel para a elaboração de um mapa de concentração de ecopontos e outro de concentração de escolas que aderem à coleta seletiva. As soluções geradas possibilitaram a análise da distribuição dos pontos e áreas com serviço de coleta seletiva. Além da visualização desses locais, ainda foi possível compreender a espacialização dentro do perímetro urbano, dando possibilidades na melhoria das intenções acerca do planejamento urbano e da gestão de resíduos sólidos urbanos.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{carolinemeirelleslinhares2026entre,
  title = {Entre a Inclusão Formal e a Dádiva Da Existência: Uma Crítica Decolonial à Invisibilidade Social Dos Indígenas Com Deficiência Na Ótica de {{Paulo Henrique Martins}}},
  author = {{Caroline Meirelles Linhares} and {Fillipe Angelino Araujo Machado} and {Moisés Bandeira D’Elly}},
  date = {2026-07-20},
  journaltitle = {Revista fisio\&terapia.},
  shortjournal = {Revista fisio\&terapia.},
  volume = {30},
  number = {160},
  pages = {01--39},
  doi = {10.69849/6y2ksg93},
  url = {https://openalex.org/W7169798330},
  abstract = {This article analyzes the intersectionality between the gift of existence and the social invisibility within the reality of Indigenous peoples with disabilities in Brazil, grounded in the decolonial perspective of Paulo Henrique Martins. The study investigates how exclusionary structures remaining from colonization operate in making this population invisible, producing a "double exclusion," particularly within traditional tribes. It questions the role of state assistance which, by ignoring the functional diversities inherent to Indigenous cosmologies, acts as a tool for normalization and control. Through a critical review, this study argues that the enforcement of fundamental rights requires overcoming liberal constitutionalism in favor of the "Buen Vivir" (Good Living) paradigm. Furthermore, community networks of reciprocity and care (by giving, receiving, and reciprocating) function as technologies of resistance, standing counter to "productive bodies" in the capitalist sense. Within this context, the sociology of Paulo Henrique Martins offers the theoretical key to understanding that the oppression experienced by Indigenous individuals with disabilities is not merely an administrative failure, but rather the result of the imposition of Western utilitarian rationality over bodies that do not meet the metrics of economic output. The study concludes that the emancipation of these subjects requires a political reform and the recognition of their own epistemologies.},
  langid = {english},
  keywords = {inglesa}
}

@article{carolinevieiraneves2025literacia,
  title = {Literacia digital dos professores de português do Ensino Médio},
  author = {{Caroline Vieira Neves} and {Dalcimar Casanova} and {Edilson Pontarolo}},
  date = {2025-04-25},
  journaltitle = {Caderno Pedagógico},
  shortjournal = {Caderno Pedagógico},
  volume = {22},
  number = {6},
  pages = {e15771-e15771},
  doi = {10.54033/cadpedv22n6-236},
  url = {https://openalex.org/W4409798581},
  abstract = {Medir a literacia digital dos professores é importante, pois pode indicar necessidades de treinamentos e embasar políticas públicas voltadas à formação docente, essenciais para uma integração mais eficaz das Tecnologias Digitais de Informação e Comunicação (TDIC) no ensino. A escala AliDip é uma ferramenta desenvolvida para avaliar as competências docentes no uso das TDIC, permitindo verificar perfis e níveis de apropriação tecnológica em diferentes contextos educacionais. Este trabalho propõe aplicar a escala AliDip para medir a literacia digital de professores de Língua Portuguesa do Ensino Médio em escolas públicas, buscando preencher uma lacuna de estudos focados nesse nível de ensino e contexto específico, como o município de Pato Branco. Ao compreender as competências e desafios enfrentados por esses docentes, espera-se fornecer um diagnóstico que possa direcionar iniciativas de capacitação e fortalecer o uso pedagógico das TDIC na educação local, promovendo práticas educativas mais conectadas com as demandas do mundo digital.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{carreno-correalina2023aplicacion,
  title = {Aplicación de Tecnología en Comunidades Vulnerables en el Norte de México},
  author = {{Carreño-Correa Lina} and {Giorgi Emanuele} and {XIMENA ARREOLA}},
