  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10919938},
  urldate = {2026-11-13},
  abstract = {La incorporación acelerada de plataformas tecnológicas privadas en la educación superior plantea interrogantes sobre la autonomía institucional, la vigilancia algorítmica y la formación de las futuras generaciones de profesionales en relación con la soberanía digital. Este artículo integra los hallazgos de tres investigaciones desarrolladas entre 2024 y 2026 en la Universidad Nacional de José C. Paz (UNPAZ): (1) un estudio pre-experimental sobre conocimiento y actitudes hacia el software libre y la soberanía digital en estudiantes del Profesorado Universitario en Educación Física (PUEF) (n = 79 en pretest y n = 79 en postest); (2) un estudio cualitativo sobre competencias digitales críticas en estudiantes de primer año de las Licenciaturas en Producción de Bioimágenes e Instrumentación Quirúrgica (n = 24 estudiantes y 6 docentes); y (3) un estudio de caso de enfoque mixto sobre las percepciones estudiantiles acerca de la inteligencia artificial generativa en la modalidad semipresencial del Taller de Informática del PUEF (n = 53 encuestados, con 10 entrevistas a estudiantes y 3 a docentes). Los resultados del caso analizado muestran una paradoja recurrente: el acceso material a dispositivos y redes está ampliamente extendido, pero las competencias críticas, el conocimiento conceptual de la soberanía digital y la confianza en el uso autónomo del software libre y de la inteligencia artificial permanecen limitados. Se observó, además, una apropiación todavía incipiente de alternativas federadas y descentralizadas frente a la vigilancia algorítmica y la desinformación, dimensión que en el corpus analizado cuenta con menor densidad empírica que la referida al software libre y la soberanía digital. Los hallazgos sugieren que la escasa presencia de estos contenidos en la formación de grado no parece explicarse únicamente por un desinterés estudiantil y resulta compatible con la hipótesis de una insuficiente presencia de instancias formativas específicas, hipótesis que se ve reforzada por la demanda curricular explícita observada una vez que los temas son introducidos.},
  langid = {spanish}
}

@article{guillermoalejandrozaragozaalvarado2026transformacion,
  title = {Transformación de las competencias de los docentes universitarios con la integración de la IA},
  author = {{Guillermo Alejandro Zaragoza Alvarado}},
  date = {2026-04-27},
  journaltitle = {Entretextos},
  shortjournal = {Entretextos},
  doi = {10.5281/zenodo.19810380},
  url = {https://openalex.org/W7160756295},
  abstract = {La integración de la inteligencia artificial (IA) en la educación universitaria ha transformado de manera acelerada la práctica pedagógica, evidenciando una brecha entre la disponibilidad de herramientas tecnológicas y la capacidad docente para incorporarlas de forma crítica, ética y pedagógicamente fundamentada. Este estudio tuvo como objetivo analizar las competencias desarrolladas por docentes universitarios ante la integración de la IA. Se adoptó un enfoque cuantitativo de alcance descriptivo, con una muestra intencional de 168 docentes de instituciones públicas y privadas del estado de Aguascalientes, México, en modalidades presencial y virtual. Se aplicó un cuestionario de 16 ítems con escala tipo Likert, validado por juicio de expertos y con un coeficiente de confiabilidad Alfa de Cronbach de .832, estructurado en torno a las variables competencias en IA y rol docente. Los resultados muestran un dominio básico a intermedio en competencias técnicas y éticas, con medias entre 1.52 y 1.88; el pensamiento crítico para determinar el momento y propósito del uso de la IA presentó la media más baja (1.52). En cuanto al rol docente, el uso de analítica de datos para la retroalimentación personalizada alcanzó la media más alta (2.24), aunque el 38.8 \% de los participantes manifestó desconocer su aplicación. Se concluye que la apropiación tecnológica avanza más rápidamente que la reflexión pedagógica, lo que demuestra la necesidad de diseñar programas de formación docente de carácter experiencial y colaborativo que fortalezcan el pensamiento crítico y orienten la integración ética de la IA, así como de desarrollar futuras investigaciones de carácter longitudinal y mixto.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{guillermorodriguez-abitia2005software,
  title = {Software {{Libre}}, {{Piratería}} y {{Cultura}} de {{TI}} En {{México}}},
  author = {{Guillermo Rodríguez-Abitia} and {Susana B. Vidrio-Baron} and {Raul V. Ramirez-Velarde}},
  date = {2005-01-01},
  journaltitle = {Journal of the Association for Information Systems},
  shortjournal = {Journal of the Association for Information Systems},
  pages = {353},
  url = {https://openalex.org/W28169466},
  abstract = {This research in progress analyzes the use of open-source software as a potential alternate path to applications piracy that affects so much the Mexican region, causing economic losses in millions and severe damages to national morality. We propose a determination model where the lack of information technology use culture, along with the high costs associated to commercial applications, fosters the generation of a black market for pirate software. Due to the cognitive dissonance generated, values tend to relax making piracy acceptable or, in the worst cases, an encouragement to act against the great producers of technology in the world. The open-source software alternative provides a possibility for the competitive development of firms, without breaking the law, and promoting a cooperative spirit rarely observed in the business context of Latin American cultures. A perception analysis through a cross-sectional survey study is proposed. We expect to gain valuable insights for the establishment of awareness-building programs in the industry sector regarding the use and benefits of information technologies.},
  langid = {english},
  keywords = {inglesa}
}

@thesis{guillermovictorandrescortestellez2014desarrollo,
  title = {Desarrollo e implementación de un sistema informativo, de ubicación y certificación, con software libre para comunidades indígenas dirigida a la gobernación del Tolima y todas sus entidades asociadas},
  author = {{Guillermo Víctor Andrés Cortes Téllez} and {Abel Olaya Mendoza} and {Cristhian Camilo Diaz}},
  date = {2014-01-01},
  journaltitle = {Repositorio Institucional Universidad Cooperativa de Colombia},
  url = {https://openalex.org/W7214873091},
  abstract = {Este proyecto de investigación es el resultado del análisis, diseño y desarrollo de una herramienta tecnológica, que representa un gran producto en el desarrollo de la organización y divulgación de información dirigida a la red y de fácil acceso a la población interesada. Desarrollo e implementación de un sistema informativo, de ubicación y certificación, con software libre para comunidades indígenas dirigida a la gobernación del Tolima y todas sus entidades asociadas Es imprescindible una aplicación que apoye y fortalezca el proceso comunicativo y divulgativo de temas de interés para comunidades vulnerables y población cercana a estos temas, en las entidades que desarrollan labor social y quieren dar a conocer sus gestiones sin necesidad reunir masas para poner en conocimiento estos temas, pues este sector precisa estrategias innovadoras que estén acorde al proceso de tecnificación y organización, en Colombia y en el mundo. El presente proyecto contiene el análisis contextual del proceso comunicativo y divulgativo de temas de interés para comunidades vulnerables y población cercana desarrollados por la gobernación del Tolima y su dependencia encargada, el diseño y desarrollo del portal informativo que utiliza software Libre, el cual, cumplirá con la labor de informar y mantener actualizados los temas de interés general para este tipo de comunidades. El aplicativo incluye desde el registro de los actores involucrados, Consultas de Comunidades, consultas de puntos estratégicos y de desarrollo de labores con estas comunidades.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{guizzo2026mas,
  title = {Más allá del “hype”: promesas, barreras y estrategias situadas para la adopción de la Inteligencia artificial en PyMES.},
  shorttitle = {Más allá del “hype”},
  author = {Güizzo, Elias Gaston and Di Giovambattista, Mariana and Clausen, Gisela},
  date = {2026},
  journaltitle = {Territorios Productivos},
  pages = {9--20},
  publisher = {Centro de Publicaciones - Instituto Académico Pedagógico de Ciencias Sociales (IAPCS)- UNiversidad Nacional de Villa MaríaUNVM},
  issn = {2953-5123},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10960655},
  urldate = {2026-11-13},
  abstract = {This article analyzes the adoption of Artificial Intelligence (AI) in Small and Medium-Sized Enterprises (SMEs), situating the phenomenon within the context of the “Technocene” and the structural barriers of Latin America. Its objective is to propose a strategic framework that goes beyond “cosmetic” adoption and technological hype, promoting a gradual transition grounded in the resolution of specific productive problems. Based on a review of regional indicators and an analysis of the ecosystem of Córdoba, the study identifies the “data paradox”—the availability of information without governance—as the main obstacle to systemic efficiency. The research outlines an operational roadmap that ranges from “data hygiene” to the creation of autonomous workflows and analytical sovereignty. It highlights the relevance of the Villa María ecosystem, where the articulation between the municipality and universities (UNVM and UTN) acts as a guarantor of a situated transformation. It concludes that the success of AI does not lie in algorithmic complexity, but in the capacity of SMEs to turn this technology into an invisible infrastructure. This strategic integration is essential for strengthening territorial embeddedness, professionalization, and regional competitiveness in a context of accelerated technological change. El presente artículo analiza la adopción de la Inteligencia Artificial (IA) en las PyMEs, situando el fenómeno en el contexto del "Tecnoceno" y las barreras estructurales de América Latina. El objetivo es proponer un marco estratégico que trascienda la adopción "cosmética" y el hype tecnológico, promoviendo una transición gradual basada en la resolución de problemas productivos específicos. A partir de una revisión de indicadores regionales y el análisis del ecosistema de Córdoba, se identifica la "paradoja de los datos" —disponibilidad de información sin gobernanza— como el principal obstáculo para la eficiencia sistémica. La investigación describe una hoja de ruta operativa que va desde la "higiene de datos" hasta la creación de flujos de trabajo autónomos y soberanía analítica. Se destaca la relevancia del ecosistema de Villa María, donde la articulación entre el municipio y las universidades (UNVM y UTN) actúa como garante de una transformación situada. Se concluye que el éxito de la IA no reside en la complejidad algorítmica, sino en la capacidad de las PyMEs para convertir esta tecnología en una infraestructura invisible. Esta integración estratégica resulta vital para fortalecer el arraigo territorial, la profesionalización y la competitividad regional en un escenario de aceleración tecnológica.},
  issue = {4 (El desafío de la Inteligencia Artificial en la Gestión y Producción)},
  langid = {spanish}
}

@article{gustavoadolforubio-rodriguez2021analisis,
  title = {Análisis de las herramientas informáticas utilizadas en una auditoría forense en las cooperativas de ahorro y crédito},
  author = {{Gustavo Adolfo Rubio-Rodríguez} and {Heber Alfredo Guifo Hernández} and {Alexander Blandón Lopez}},
  date = {2021-02-28},
  journaltitle = {Revista Fatec Zona Sul},
  shortjournal = {Revista Fatec Zona Sul},
  volume = {7},
  number = {3},
  doi = {10.26853/refas_issn-2359-182x_v07n03_07},
  url = {https://openalex.org/W3141447674},
  abstract = {El presente trabajo busca analizar las herramientas informáticas usadas en una auditoría forense en las cooperativas de ahorro y crédito del sector financiero de la ciudad de Ibagué, Colombia, partiendo de identificar las herramientas utilizadas en una auditoria forense, y de establecer la percepción de los funcionarios de entidades cooperativas acerca de los fraudes en las cooperativas de ahorro y crédito del sector financiero, y luego proponer a partir del empleo de estas herramientas informáticas, soluciones para la prevención de delitos contra el orden económico social. En el desarrollo del manuscrito se utilizó el método deductivo, puesto que el proyecto parte de situaciones generales que llegan a explicar situaciones particulares contenidas explícitamente en la situación general. Si bien se presume que las herramientas informáticas en la era digital son aliadas fundamentales en el control organizacional, en las entidades consultadas se observan bajos niveles de apropiación tecnológica en el área de control y aseguramiento del riesgo, lo que evidencia fisuras en la actualización tecnológica, la dimensión de desarrollo organizacional de los directivos y en la construcción del ideario regional sobre los peligros a los que se exponen las entidades que tienen carencias tecnológicas.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{gustavojorgegolubenko2020cooperativa,
  title = {Cooperativa 4.0},
  author = {{Gustavo Jorge Golubenko} and {María Soledad Peralta} and {Natalia Anabel Romero}},
  date = {2020-06-25},
  journaltitle = {Sociales Investiga},
  shortjournal = {Sociales Investiga},
  number = {9},
  pages = {98--107},
  url = {https://openalex.org/W3183789201},
  abstract = {Desarrollo de una implementación tecnológica basada en plataformas de Software Libre que se está ejecutando en la Cooperativa de Servicios Públicos y Sociales de Villa del Rosario Limitada. La misma se basa en un Sistema de Información Geográfica (GIS) que se implementó primeramente en la Cooperativa y se abre para el usufructo de las Instituciones del Centro de Operaciones de Emergencia Municipal, permitiendo a cada una de sus Instituciones beneficiarias cargar datos al Sistema para contar con una base de conocimiento actualizaza, soportada en la colaboración mancomunada y que permite dar respuesta inmediata a los objetivos propuestos para cada Institución vinculada. El soporte Tecnológico es fundamental, pero esconde una forma diferente de educar en Valores Cooperativos ya que la eficacia y eficiencia del sistema se basa en la cantidad, calidad y actualización de la información contenida producto del esfuerzo coordinado de todos los actores sociales que conforman las Instituciones del Centro de Operaciones de Emergencia. También es una apuesta a generar indicadores fiables que permitan tomar decisiones de emergencia ante situaciones antrópicas o cualquier alteración del orden que pudiera presentarse, pudiendo evaluar los resultados históricos y apoyándose en los Geoservicios que ya se disponen tanto a nivel provincial como Nacional.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{gustavomoura2017longterm,
  title = {Long-Term Power Systems Integration Using {{OSeMOSYS SAMBA}} - {{South America Model Base}} - and the Bargaining Power of Countries : A Cooperative Games Approach},
  author = {{Gustavo Moura}},
  date = {2017-03-01},
  journaltitle = {Americanae (AECID Library)},
  url = {https://openalex.org/W2949496182},
  abstract = {This study intends to contribute to a better understanding of both advantages and drawbacks of power systems interconnection processes in South America. Based on data available in national and international reports, scenarios for the power supply sector expansion were modelled in the Open Source energy Modelling System – OSeMOSYS – using a new framework named South America Model Base – SAMBA. Features related to costs, carbon emissions, hydro reservoirs, technological performance, electricity demand, population growth, time zones and reserve margin were considered. The Brazilian and Bolivian perspectives of power systems integration were modelled according to data presented by national power plans. The comparison of different scenarios provides insights regarding the contribution of renewable energy generation and sheds light on cross-border trade perspectives in South America. Additionally, using a cooperative games approach, the bargaining power of each country (player) was calculated by applying the Shapley value concept. The proposed methodology may provide important information to support policy makers in international negotiations, thus considerably reducing incentives to non-cooperative actions.},
  langid = {english},
  keywords = {inglesa}
}

@thesis{gustavosigalmacedo2009cooperacao,
  title = {Cooperação qualificante: perspectivas para a autogestão},
  author = {{Gustavo Sigal Macedo}},
  date = {2009-01-01},
  url = {https://openalex.org/W2963825240},
  abstract = {This dissertation presents an interdisciplinary study about the phenomenon of cooperation at work, trying to understand the self-management experiences from a participatory democracy and also personal qualification enhancement point of view within the collectives. It recognizes the cooperativism as a plural and distinct economic sector, showing a brief review about its european tradition of economic mutualism, for one side, and dialoguing with the new possibilities that emerge from some innovative cases, still rare, but that could establish themselves as references on the market position, the internal structure and the modus operandi experimented. As a start point for the study, different concepts related to the social cooperation were prospected, describing the evolutionary, the communicational, the games theory, the systemic and the cultural lenses. Following that section, several conceptions were presented on the organizational studies field, including the sociotechnical approach, the qualifying organization notion, the principal-agent theory, the basic model of a cooperative based on the brazilian legislation, and plus, a possible interface between the self-management, the co-management, the cooperative sector and the so called social-solidarity economy. The study counts with the description of some self-management experiences, like the international cases of Mondragon, La Siembra, Suma and Evergreen, and the brazilian ones, on the textile productive chain, the free software development, the services provision and the cultural production fields. The methodology is constituted of literacy revision and critical analysis of concepts, practices and organizational models. Finally, as a result of this study, it shows a group of theories and recommendations oriented for the promotion of the cooperation and the self-management development.},
  langid = {portuguese},
  keywords = {inglesa}
}

@article{gustavovargasyara2021aporte,
  title = {Aporte del SENA al sistema nacional de ciencia, tecnología e innovación de Colombia},
  author = {{Gustavo Vargas Yara} and {Darwin Rodríguez} and {Aylin Viviana Silva Ortiz}},
  date = {2021-05-21},
  journaltitle = {Revista Mutis},
  shortjournal = {Revista Mutis},
  volume = {11},
  number = {2},
  pages = {109--131},
  doi = {10.21789/22561498.1723},
  url = {https://openalex.org/W3161821673},
  abstract = {Existen diferentes enfoques que dan cuenta de la importancia de la relación entre el crecimiento económico y la implementación de programas de ciencia, tecnología e innovación (CTI) en el marco del diseño, la ejecución y la evaluación de políticas públicas. Por lo anterior, este trabajo aborda dicha relación desde el concepto, la metodología, la normativa y la implementación de la política de CTI de Colombia, resaltando el aporte del Servicio Nacional de Aprendizaje (SENA) a la construcción de programas de CTI en el país. Aquí se muestran las contribuciones de la estrategia SENNOVA, creada por el SENA, como respuesta institucional a la normatividad de ciencia y tecnología nacional y la organización en la inversión de recursos. Finalmente, se concluye que SENNOVA es un agente multiplicador de la apropiación tecnológica, social y colectiva, al transferir el conocimiento generado en los proyectos de diferentes líneas programáticas de CTI a los procesos de formación profesional y al sector productivo, contribuyendo así con la disminución de las brechas tecnológicas existentes en el país.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{gutierrezdiez2020factores,
  title = {Factores motivacionales en los desarrolladores de software libre},
  author = {Gutiérrez Diez, María del Carmen and Bordas Beltrán, José Luis and Piñón Howlet, Laura Cristina},
  date = {2020-12},
  journaltitle = {Investigación administrativa},
  shortjournal = {Investigación administrativa},
  volume = {49},
  number = {126},
  issn = {2448-7678},
  doi = {10.35426/iav49n126.04},
  url = {http://www.scielo.org.mx/scielo.php?script=sci_arttext&pid=S2448-76782020000200004&lang=pt},
  abstract = {Abstract: The objective of this study was establishing the underlying reasons and relationships of programmers who contribute to open software projects, is the cornerstone that allows to increase said contributions. The method used to describe and classify the different kinds of motives, expressed by developers, in relation with the quantity of contributions made to open software projects, through a cluster statistical analysis. The results expressed that software developers show motivations associated with personal satisfactions, acquisition of knowledge, as well as altruistic endeavors to help, without consideration of any monetary or economic retribution to collaborate. Findings showed that the quantity of contributions made is increased based on a personal interest to participate in projects. The originality, as well as the main limitation of this work, is the lack of studies like this among the Mexican software developers, nor is there any related recent literature. The survey was answered by 406 Mexican developers.},
  langid = {spanish},
  keywords = {conocimiento abierto,contribuciones al software libre,desarrolladores software libre,intrinsic and extrinsic motivations,motivaciones intrínsecas y extrínsecas,O40,open knowledge,open source contributions,open source developers,open source software,software libre}
}

@article{gutierrezgalindo2022guia,
  title = {Guía macrofotográfica digital: un camino hacia la enseñanza en ecología y conservación de insectos polinizadores},
  shorttitle = {Guía macrofotográfica digital},
  author = {Gutierrez Galindo, Kevin and Renis Cogollo, Yuliana Julieth},
  date = {2022},
  journaltitle = {Revista de Ciencias de la Educación, Docencia, Investigación y Tecnologías de la Información: CEDOTIC},
  volume = {7},
  number = {2},
  pages = {149--171},
  publisher = {Universidad del Atlántico},
  issn = {2539-1518},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8887973},
  urldate = {2026-11-13},
  abstract = {En esta investigación se diseñó una guía macrofotográfica digital de insectos polinizadores, presentes en jardines ornamentales del Municipio de Puerto Colombia, Atlántico. En la primera etapa se identificaron las zonas urbanas con mayor diversidad de microhábitat, donde se documentaron a través de macrofotografías dos familias del orden Himenóptera: Apidae y Vespidae, que posteriormente en la segunda etapa fueron articuladas a elementos conceptuales de ecología y conservación de insectos polinizadores, dando lugar a una herramienta digital que integró la ciencia, la tecnología y la informática , publicado en Google Sites en el siguiente enlace: https://www.guiadeinsectospolinizadores.tk, disponible para los estudiantes del grado décimo de la Institución Educativa María Mancilla Sánchez, con el objetivo de identificar si la actitud ante el aprendizaje puede ser influenciada por la guía y mejorar el rendimiento académico en la asignatura de biología. Se aplicó un diseño cuasi-experimental, con la participación de 42 estudiantes del grado décimo, 18 pertenecían al grupo A y 24 al B, siendo primero el grupo control y el segundo el experimental. Los resultados de los Postest evidencian una actitud favorable ante el aprendizaje empleando la guía, viéndose reflejado en un rendimiento académico ~excelente en el grupo experimental.},
  langid = {spanish}
}

