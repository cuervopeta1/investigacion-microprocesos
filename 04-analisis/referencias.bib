@article{martatostes2026sociedad,
  title = {Sociedad y ambiente ante los desafíos de la sostenibilidad territorial. Reflexiones introductorias},
  author = {{Marta Tostes} and {Yolanda Rodríguez González}},
  date = {2026-10-23},
  journaltitle = {Revista Kawsaypacha Sociedad y Medio Ambiente},
  shortjournal = {Revista Kawsaypacha Sociedad y Medio Ambiente},
  number = {18},
  doi = {10.18800/kawsaypacha.202602.a000},
  url = {https://openalex.org/W7223451842},
  abstract = {This essay examines society–environment relations through the challenges of territorial sustainability, offering an integrated reading of the twenty-three contributions published in issue 18 of Kawsaypacha. It connects debates on safe and just Earth system boundaries, the plurality of nature’s values, and knowledge co-production with research and situated experiences primarily from Latin America, alongside contributions from Indonesia. The articles are organized into six thematic areas: waste generation and management; knowledge and culture; water availability, access, and conservation; forests and woodlands; rural and urban ways of inhabiting places; and resistance to extractivism. Read together, these contributions reveal connections among socio-environmental inequalities, institutional capacities, local knowledge, technological appropriation, and community participation. The essay argues that responses to territorial transformations must consider ecological conditions alongside resource distribution, recognition of diverse forms of knowledge, and opportunities for communities to influence decision-making. It outlines research directions concerning the continuity of interventions, environmental governance, uncertainty and responsibility, and the relationships among affect, territorial identity, and collective action. In doing so, it reaffirms INTE PUCP’s commitment to interdisciplinary dialogue and the production of knowledge relevant to socio-environmental challenges.},
  langid = {spanish},
  keywords = {inglesa}
}

@book{martens2022activismo,
  title = {Activismo digital, medios comunitarios y comunicación sostenible en América Latina},
  author = {Martens, Cheryl and Franklin Salvio Sharupi Tapuy, Etsa and Venegas, Cristina and Jiménez, Carlos and Pinos, Doris and Rodríguez Ibáñez, Mario and Vila Viñas, David and Crespo, Juan Manuel and Salatino, Maximiliano and García Gago, Santiago and Bravo Muñoz, Loreto and Robayo Valencia, Clara and Medrado, Andrea and Cabral, Taynara and Souza, Renata and Coryat, Diana and Millaleo Hernández, Salvador and Binder, Inés and Acosta, Ana María and Angulo Moncayo, Natalia and Febres Cordero, Belén and Puyosa, Iria and Andrango Bolaños, Juan Diego and Jiménez Becerra, Javier Andrés and Bustamante Salamanca, Mónica and Gutiérrez Pérez, Ángel and Albornoz, María Belén and Tabares Merino, Gema},
  date = {2022},
  publisher = {Universidad San Francisco de Quito USFQ},
  url = {https://dialnet.unirioja.es/servlet/libro?codigo=1010918},
  urldate = {2026-11-13},
  abstract = {En las dos últimas décadas, los medios de comunicación y la tecnología han estado en el centro de conflictos políticos y culturales en América Latina. Importantes batallas sobre el poder mediático entre el gobierno y las corporaciones de medios de comunicación (Artz 2017; Follari 2014) han generado un amplio debate público, así como reformas mediáticas en la región (Martens, Vivares y McChesney 2014; Waisbord 2010). Las organizaciones de medios comunitarios en Latinoamérica y más allá de sus fronteras han estado a la vanguardia, al desafiar configuraciones de poder y legislación relacionadas con los medios de comunicación y la tecnología.  América Latina tiene una larga historia de organización y activismo mediático comunitario; de hecho, los cimientos de la radio comunitaria se remontan a principios del siglo xx en Colombia y Bolivia (Rodríguez 2001; Santiago García Gago, en este volumen). Los medios comunitarios también han desempeñado un papel fundamental como fuentes alternas para la preservación del idioma y las tradiciones (Beltrán 1983). En las décadas de los años setenta y ochenta, académicos y activistas latinoamericanos encauzaron sus estudios al análisis del poder y hegemonía de los medios de comunicación (Beltrán y de Cardona 1980; Dorfman y Mattelart 1972), mientras en otras partes del mundo se enfocaban en el estudio de los efectos de los medios de comunicación.},
  isbn = {978-9978-68-235-7},
  langid = {spanish}
}

