@article{ramirezmera2026preparandose,
  title = {Preparándose para la regulación de la IA: iniciativas de formación institucional en universidades latinoamericanas},
  shorttitle = {Preparándose para la regulación de la IA},
  author = {Ramírez Mera, Urith N. and Angel Rueda, Christian Jonathan},
  date = {2026},
  journaltitle = {Archivos Analíticos de Políticas Educativas=Education Policy Analysis Archives},
  volume = {34},
  number = {1},
  pages = {93},
  publisher = {College of Education University of South Florida},
  issn = {1068-2341},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10956844},
  urldate = {2026-11-13},
  abstract = {This study critically analyzes policies and regulations concerning artificial intelligence (AI) and generative AI in Latin American higher education from a digital education policy perspective. Methodologically, the study employed a critical and comparative document analysis of 52 regulatory, institutional, and academic documents published between 2019 and 2026, using inductive coding supported by Atlas.ti 9. Findings reveal significant regulatory fragmentation and three main tensions: (1) “borrowed ethics,” where universities and institutions adopt international governance frameworks without sufficient implementation capacities; (2) innovation asymmetries between institutions with unequal technological infrastructure; and (3) the limited emergence of debates on neurorights and cognitive sovereignty. The study introduces the concepts of “glocalized stacking” and “compensatory co-governance” to explain how institutions negotiate global regulatory pressures and local realities, contributing to critical discussions on algorithmic governance and technological sovereignty in Latin America. Este estudo analisa criticamente as políticas e regulamentações sobre inteligência artificial (IA) e IA generativa no ensino superior latino-americano a partir de uma perspectiva de política educacional digital. Metodologicamente, foi desenvolvida uma análise documental crítica e comparativa de 52 documentos regulatórios, institucionais e acadêmicos publicados entre 2019 e 2026, utilizando codificação indutiva apoiada pelo Atlas.ti 9. Os resultados evidenciam uma acentuada fragmentação regulatória e três tensões principais: (1) a “ética emprestada”, na qual universidades e instituições adotam marcos internacionais de governança sem capacidades suficientes de implementação; (2) as assimetrias de inovação entre instituições com diferentes infraestruturas tecnológicas; e (3) a emergência limitada de debates sobre neurodireitos e soberania cognitiva. O estudo propõe as categorias de “empilhamento glocalizado” e “governança compensatória” para compreender como as instituições negociam pressões regulatórias globais e contextos locais, contribuindo, assim, para a análise crítica da governança algorítmica e da soberania tecnológica na América Latina. Este estudio analiza críticamente las políticas y regulaciones sobre inteligencia artificial (IA) e IA generativa en la educación superior latinoamericana desde una perspectiva de política educativa digital. Metodológicamente, se desarrolló un análisis documental crítico y comparado de 52 documentos regulatorios, institucionales y académicos publicados entre 2019 y 2026, utilizando codificación inductiva apoyada en Atlas.ti 9. Los hallazgos evidencian una marcada fragmentación regulatoria y tres tensiones principales: (1) la “ética prestada”, donde universidades e instituciones adoptan marcos internacionales de gobernanza sin capacidades suficientes de implementación; (2) las asimetrías de innovación entre instituciones con distinta infraestructura tecnológica; y (3) la emergencia limitada de debates sobre neuroderechos y soberanía cognitiva. El estudio propone las categorías de “apilamiento glocalizado” y “gobernanza compensatoria” para comprender cómo las instituciones negocian presiones regulatorias globales y contextos locales, contribuyendo así al análisis crítico de la gobernanza algorítmica y la soberanía tecnológica en América Latina.},
  langid = {spanish}
}

@article{ramirezramirez2016sistema,
  title = {Sistema para la Informatización del proceso de Auditoría y Control de los Activos Fijos Tangibles en la Facultad de Ciencias y Tecnologías Computacionales},
  author = {Ramirez Ramirez, Tania and Hernández González, Bernardo},
  date = {2016},
  journaltitle = {Serie Científica de la Universidad de las Ciencias Informáticas},
  volume = {9},
  number = {12},
  pages = {36--48},
  publisher = {Ediciones Futuro},
  issn = {2306-2495},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8590560},
  urldate = {2026-11-13},
  abstract = {As part of the rules of the Cuban internal control system, it is established that 10\% of Fixed Tangible Assets (AFT) beaudited monthly, representing a core task within any entity. In the School of Sciences and ComputationalTechnologies of the University of the Computer Science, it is done through the manual testing of the resources with apreviously printed inventory, which generates a cumbersome and inefficient process. The research that follows is theanalysis, design, implementation and evaluation of a computer application aimed at streamlining the process ofAuditing and Control of Fixed Tangible Assets in the Faculty of Sciences and Computational Technologies. Thedevelopment of the system is marked by the use of current technologies and tools attached to the policy oftechnological sovereignty that drives the country. The solution obtained improves the use of human and materialresources, allowing results to be obtained quickly and reliably from the completion of the audit and control process. Como parte de las normas del sistema de control interno cubano, se establece que el 10\% de los Activos FijosTangibles (AFT) sean auditados mensualmente, representando tarea medular dentro de cualquier entidad. En laFacultad de Ciencias y Tecnologías Computacionales de la Universidad de las Ciencias Informáticas, se realiza através del testeo manual de los medios contra un inventario previamente impreso, lo que genera un proceso engorrosoe ineficiente. La investigación que a continuación se presenta consiste en el análisis, diseño, implementación yevaluación de una aplicación informática encaminada a agilizar el proceso de Auditoría y Control de los Activos FijosTangibles en la Facultad de Ciencias y Tecnologías Computacionales. El desarrollo del sistema se encuentra marcadopor el empleo de tecnologías y herramientas de actualidad apegadas a la política de soberanía tecnológica que impulsael país. La solución obtenida mejora el empleo de los recursos humanos y materiales, permitiendo obtener resultadosde manera rápida y fiable a partir de la realización del proceso de auditoría y control.},
  langid = {spanish}
}

