@thesis{gonzalez2026transformacion,
  type = {http://purl.org/dc/dcmitype/Text},
  title = {Transformación socioproductiva y soberanía tecnológica. La función producción en la educación superior universitaria: El caso de la UNLP y la creación de la primera Planta Nacional de Desarrollo Tecnológico de Celdas y Baterías de Litio (UniLiB)},
  shorttitle = {Transformación socioproductiva y soberanía tecnológica. La función producción en la educación superior universitaria},
  author = {González, María Alejandra},
  date = {2026},
  pages = {1},
  institution = {Universidad Nacional de La Plata},
  url = {https://dialnet.unirioja.es/servlet/tesis?codigo=402246},
  urldate = {2026-11-13},
  abstract = {Esta tesis doctoral es el resultado de una investigación sobre la función producción en la educación superior universitaria y los vínculos existentes con las transformaciones socioproductivas y la soberanía tecnológica nacional. Toma como estudio de caso la creación de la primera Planta Nacional de Desarrollo Tecnológico de Celdas y Baterías de Litio (UniLiB) de la Universidad Nacional de La Plata (UNLP). El interés por esta temática radica en el carácter estratégico de esta experiencia, tanto por el impacto institucional hacia el interior de la universidad como por su proyección en el desarrollo nacional y regional. La investigación analiza la jerarquización que desde la gestión universitaria de la UNLP se le dio a la función producción al incluirla en su Plan Estratégico 2022-2026. La Estrategia V del Plan Estratégico 2022-2026 de la UNLP, Producción y Transferencia, tiene por objetivo general “Producir, mediante procesos con los valores agregados por la investigación científica, tecnológica y artística, materiales e insumos para el mejor desarrollo integral de la vida integral en el planeta, transfiriendose con un profundo sentido social solidario, transformador, innovador, emancipador e igualitario”,  caracterizándola como una práctica que integra conocimiento, tecnología y compromiso con la soberanía nacional. Dicha jerarquización se materializa en la creación de una Secretaría de Producción, una decisión política que -según advierten los propios actores de la gestión entrevistados- no registra antecedentes en las estructuras de otras universidades, tanto públicas como privadas, del país o de la región (D. Tovio, comunicación personal, 26 de septiembre de 2024; A. Olivieri, comunicación personal, 12 de julio de 2024; véase Anexo III y V, respectivamente). Este carácter "revolucionario" en la ingeniería institucional responde a la necesidad de dotar a la universidad de un músculo administrativo capaz de operar plantas industriales de escala real, superando la administración inercial de las funciones académicas tradicionales. Asimismo, el trabajo pretende construir un acervo de información pertinente y situada sobre los sentidos en torno a la creación de instalaciones productivas de alta complejidad tecnológica con orientación social desde una universidad pública; así como un análisis de la articulación entre las distintas funciones universitarias (enseñanza, investigación, extensión, transferencia) y la gestión de la educación superior. La Universidad Nacional de La Plata acredita una trayectoria de investigación sistemática sobre el litio de más de cinco décadas, con antecedentes científicos que se remontan a principios de la década de 1970 (Botto, 1973). La Universidad Nacional de La Plata comenzó a investigar sobre el litio a principios de la década de 1970 según consta en la tesis doctoral de Irma Lía Botto, presentada en 1973 en la Facultad de Ciencias Exactas bajo la dirección del Prof. Teodoro G. Krenkel, titulada Aprovechamiento de minerales de litio, en la que se analizan datos de producción y comercio del período 1966–1971 (Botto, 1973). Este antecedente confirma que la UNLP desarrolla investigaciones sistemáticas sobre litio desde hace más de cincuenta años, particularmente en lo relativo a las tecnologías y procesos asociados a este recurso estratégico. Este capital intelectual acumulado se constituye hoy como un activo estratégico para la Argentina, ya que el país alberga una de las mayores reservas mundiales de este mineral (Secretaría de Minería de la Nación, 2021), en un contexto de demanda internacional creciente por la transición hacia modelos energéticos sustentables y la electromovilidad. Es sobre esa base, entonces, que la UNLP impulsa a mediados de 2021 -junto con otros organismos científicos y tecnológicos- la creación de una planta destinada al desarrollo de celdas y baterías de litio. Este trabajo, a su vez, demuestra que el caso de UniLiB no se presenta como un hecho aislado, sino que es una decisión de gestión que se articula con otras experiencias de producción dentro de la universidad, tales como sus otras fábricas, núcleos y unidades productivas.  A través de un enfoque pedagógico y político, esta investigación presenta las etapas que ordenan la experiencia y la integración de procesos industriales en el ámbito académico como una herramienta para generar valor público y responder a las demandas sociales del territorio. “La universidad debe generar un beneficio concreto para la comunidad a la vez que se construye una mejor visión colectiva sobre el sistema universitario en general, la institución universitaria en particular y sobre las propias tareas asociadas como docentes e investigadores” (Tauber, 2022a). En consecuencia, esta investigación analiza la reconfiguración del modelo pedagógico a partir de la integración de la producción; se sostiene que esta convergencia instituye dinámicas de construcción de saber ancladas en las demandas del territorio. En síntesis, esta tesis propone una reflexión situada sobre el rol de la gestión educativa universitaria en la transformación concreta de la sociedad y en la democratización del acceso al conocimiento socialmente relevante, tanto en la comunidad universitaria como en la sociedad en general.},
  langid = {spanish}
}

