@book{mel-rakhawi2026cloud,
  title = {{{BEYOND THE CLOUD Digital Colonialism}} and {{The Fight}} for {{Sovereignty}} in the 21st {{Century}} l},
  author = {{m el-rakhawi}},
  date = {2026-07-13},
  journaltitle = {Zenodo (CERN European Organization for Nuclear Research)},
  doi = {10.5281/zenodo.21329949},
  url = {https://openalex.org/W7168212535},
  abstract = {**Book Summary:** "Beyond The Cloud" examines digital colonialism—the extraction of data from the Global South by tech giants in the US and China. Data has replaced oil as the 21st century's most valuable resource, with three companies controlling 75\% of cloud infrastructure. Data centers consume vast water and electricity while providing minimal local benefits. The book analyzes how algorithms manipulate behavior, AI systems appropriate cultural capital without compensation, and digital payment systems erode financial sovereignty. It presents case studies of resistance: the EU's regulatory framework, China's sovereign ecosystem, India's public digital infrastructure, and Venezuela's indigenous solutions under sanctions. For the Arab world, the book proposes four pillars: regulatory harmonization, indigenous infrastructure investment, human capital development, and regional cooperation. The central argument: digital sovereignty is essential for self-determination. Nations that control their data control their future; those that don't risk permanent digital subordination.},
  langid = {english},
  keywords = {inglesa}
}

@article{melissaaguilarrojas2020museologia,
