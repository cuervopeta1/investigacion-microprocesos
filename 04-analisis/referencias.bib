@thesis{torresvillamil2015lineamientos,
  title = {Lineamientos estratégicos para orientar la construcción de recursos educativos digitales como herramienta de trabajo transversal de las prácticas pedagógicas. Estudio de caso en el programa de formación complementaria de la institución educativa, ENSLAP},
  author = {{Torres Villamil} and {Laura Milena}},
  date = {2015-01-01},
  journaltitle = {Universidad de Chile},
  url = {https://openalex.org/W2221753788},
  abstract = {El objetivo de esta investigación fue proponer lineamientos estratégicos para orientar la construcción de Recursos Educativos Digitales en el Programa de Formación Complementaria de la Institución Educativa ¨Escuela Normal Superior Leonor Álvarez Pinzón¨, como herramienta de trabajo transversal de la práctica pedagógica. La metodología usada fue estudio de casos, bajo el paradigma cualitativo. En la investigación participaron 11 estudiantes de los grados 12 y 13 del Programa de Formación Complementaria de dicha Institución; los instrumentos utilizados fueron Cuestionario – entrevista y observación participante. El análisis de datos se realizó con la interpretación directa de cada caso y la suma categórica de ellos como conjunto, además se hizo un análisis de contenido y un análisis descriptivo con distribución de frecuencias. Los supuestos del estudio indicaron que las estudiantes del Programa de Formación Complementaria integran, utilizan y producen los Recursos Educativos Digitales con base en su experiencia y apropiación tecnológica, así como el grado de conocimiento que tengan de las Tecnologías de la Información y de las Comunicaciones. Los resultados obtenidos indicaron que un aspecto importante de atender para orientar la implementación y construcción de los Recursos Educativos Digitales en las prácticas pedagógicas, consiste en apegarse a la idea del Movimiento Educativo Abierto. Esto significa, establecer un entorno educativo flexible en el que participen todas las iniciativas y propuestas, tanto de las futuras docentes como las de los alumnos (usuarios de los contenidos, con perfiles muy distintos y en situaciones de enseñanza / aprendizaje altamente variadas), quienes «reutilicen o den valor añadido al recurso digital», participando en la construcción del mismo},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{torti2025ii,
  title = {II Jornadas de Educación Digital: debates a 15 años de Conectar Igualdad},
  shorttitle = {II Jornadas de Educación Digital},
  author = {Torti, Bárbara and Bergero Trpin, Tomás and Alonso, Malena and Burgos García, Anaclara},
  date = {2025},
  journaltitle = {Question},
  volume = {3},
  number = {82},
  pages = {23},
  publisher = {Universidad Nacional de La Plata},
  issn = {1669-6581},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10719218},
  urldate = {2026-11-13},
  abstract = {The Second Digital Education Conference: "15 Years of Conectar Igualdad" took place on September 25 and 26, 2025, at the Sergio Karakachoff Building of the National University of La Plata. Organized by the Directorate of Educational Technology of the General Directorate of Culture and Education of the Province of Buenos Aires, the event brought together approximately 600 attendees. It served as a crucial platform for discussing teaching practices mediated by digital technologies in the provincial education system and for fostering dialogues on relevant pedagogical, social, and cultural aspects.    During the conference, 24 roundtable talks were held, featuring over 170 speakers. These talks were organized around four thematic axes: Digital Culture and Education, Integration of Technologies in the Classroom, Accessibility and Inclusive Practices, and Technological Sovereignty and Education. Twelve in-person workshops and three panels were also held, which brought together specialists in digital citizenship, artificial intelligence, and media and information literacy. Additionally, the “Guía Ema”, a resource addressing the non-consensual dissemination of intimate images, was presented. Las II Jornadas de Educación Digital: “15 años de Conectar Igualdad” se llevaron a cabo el 25 y 26 de septiembre de 2025 en el Edificio Sergio Karakachoff de la Universidad Nacional de La Plata. Organizadas por la Dirección de Tecnología Educativa de la Dirección General de Cultura y Educación de la provincia de Buenos Aires, estas jornadas congregaron a aproximadamente 600 participantes. El evento fue un espacio fundamental para discutir prácticas pedagógicas mediadas por tecnologías digitales en el sistema educativo provincial, propiciando diálogos sobre aspectos pedagógicos, sociales y culturales relevantes.    Durante el evento, se realizaron 24 conversatorios de experiencias de educación digital con la participación de más de 170 expositores, organizados en cuatro ejes: Cultura digital y educación; Integración de tecnologías en el aula; Accesibilidad y prácticas inclusivas; y Soberanía tecnológica y educación. También tuvieron lugar 12 talleres presenciales y 3 paneles que reunieron a especialistas en ciudadanía digital, inteligencia artificial y alfabetización mediática e informacional, y se presentó la “Guía Ema”, que aborda la difusión de imágenes íntimas sin consentimiento.},
  langid = {spanish}
}

