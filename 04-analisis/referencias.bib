@article{nohorabeatrizguzmanramirez2017cambios,
  title = {Cambios en la relación entre sociedad y recursos en la horticultura en Morelos},
  author = {{Nohora Beatriz Guzmán Ramírez} and {Elsa Guzmán Gómez}},
  date = {2017-08-23},
  journaltitle = {Inventio, la génesis de la cultura universitaria en Morelos},
  shortjournal = {Inventio, la génesis de la cultura universitaria en Morelos},
  volume = {13},
  number = {30},
  pages = {5--12},
  url = {https://openalex.org/W2803746188},
  abstract = {En Morelos, las transformaciones rurales son y han sido constantes y profundas. Los procesos productivos agrícolas y el uso de los recursos han tomado formas novedosas y cambiantes que llevan a reconfiguraciones del territorio. En el presente artículo se reflexiona sobre las relaciones de reespacialización que surgen en un proceso cultural determinado por lo local. La estructura del texto corresponde a los procesos de cambio generados en la comunidad de Santa Catalina, en Tepoztlán, Morelos, con respecto a la producción jitomatera, en donde se ha vivido un proceso de apropiación de este cultivo en las últimas cinco décadas. Actualmente, los campesinos lo cultivan en tierras ubicadas fuera de su comunidad, para lo cual requieren trasladar trabajadores y agua, pero también conocimientos y experiencias, lo que les ha permitido mantenerse vinculados al mercado regional, a partir de las redes comunitarias.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{norbertoleonardomurolo2014con,
  title = {Con la música a otra parte},
  author = {{Norberto Leonardo Murolo}},
  date = {2014-01-01},
  journaltitle = {Revista Argentina de Estudios de Juventud},
  shortjournal = {Revista Argentina de Estudios de Juventud},
  url = {https://openalex.org/W2141922085},
  abstract = {El objeto de estudio del presente trabajo se focaliza en los usos de la telefonía móvil como reproductor musical en el espacio público. Esta práctica es, comúnmente, utilizada por jóvenes de sectores populares, quienes escuchan cumbia o reggaeton con altavoces y sin auriculares. Esta apropiación tecnológica es, generalmente, combatida por sus pares, la cultura adulta, inclusive por los licenciatarios del transporte público de pasajeros que piden que no se haga. De ello que comience a haber leyes que prohíben usar reproductores musicales sin auriculares en el transporte público. En ese contexto, proponemos analizar el fenómeno desde una perspectiva cualitativa asentada en entrevistas con jóvenes y en observaciones. De ellas se desprende que no se trata, solamente, de la molestia que causa el ruido sino que las críticas se desplazan al género musical que estos jóvenes escuchan y de allí a una fuerte presencia de discriminación de clase.},
  langid = {spanish},
  keywords = {iberoamericana}
}

