@article{georgeduenas2015bilingual,
  title = {A Bilingual Dictionary with {{Semantic Mediawiki}}: {{The}} Language {{Saliba}}'s Case},
  author = {{George Dueñas} and {Diego Gómez-Zará}},
  date = {2015-03-12},
  journaltitle = {Americanae (AECID Library)},
  shortjournal = {Americanae (AECID Library)},
  url = {https://openalex.org/W2298448102},
  abstract = {The language Saliba is spoken approximately by 200 indigenous in the Departments of Casanare, Arauca and Vichada, in Colombia, although the total population of this culture is around 2200 people. The Saliba language is considered a severely endangered language because most of speaker people is over 60 years old. This paper presents the ongoing work of the indigenous languages team at Caro and Cuervo Institute in developing Saliba electronic dictionary in order to revitalize this language. This work consists in creating not only an electronic dictionary, but also a space where linguistic and cultural information is stored about the language; for example, location on a map in the web of the indigenous reserves in Colombia, a grammatical sketch, personal names and toponyms, among others. We have been working with the information collected by Hortensia Estrada during 90s; written texts, recordings, drawings. Our work consists in showing all of this information of a friendly manner in the web. In order to do this, we have had to create templates for placing the information, format the written texts files into the appropriate way, improve the quality of the drawings, and segment the recordings. Furthermore, we have created learning material for Saliba indigenous children. The main software that we have used to create the dictionary is MediaWiki (free software open source) and various kinds of extensions such as: Semantic Mediawiki, Mp3Handler, GoogleMaps, among others. The Mediawiki software, adapted to lexicography needs, has become in an important tool in this project. All of these tools have enabled us to show and recover information from each lexicographic entry. Additionally, we have exported the databases of this dictionary to create smart device applications. This work was socialized and made available for Saliba communities. Indigenous Salibas were taught in the management of these tools in order that this work continues by themselves.},
  langid = {english},
  keywords = {inglesa}
}

@article{georgelipsitz2023way,
  title = {The {{Way We Do}} the {{Things We Do}}: “{{Staying}} in the {{Pocket}}” with {{Guthrie P}}. {{Ramsey}}, {{Jr}}.},
  author = {{George Lipsitz}},
  date = {2023-01-01},
  journaltitle = {American Music},
  shortjournal = {American Music},
  volume = {41},
  number = {2},
  pages = {153--160},
  doi = {10.5406/19452349.41.2.02},
  url = {https://openalex.org/W4399478256},
  abstract = {All of the “what” that Guthrie P. Ramsey, Jr., shows that he knows in Who Hears Here? On Black Music, Pasts \& Present is of enormous value.1 His essays move seamlessly through discussions of a wide range of music and musicians, cultural sites and sensibilities, genres and generations, and authors and art forms. This virtuosity, however, may obscure at first glance what I consider to be the equally important achievement that emanates from the “how” that he knows and the ways he deploys that way of working. The ideas, evidence, and arguments in this book make extraordinary contributions to scholarship and civic life by prodding scholars and cultural critics to conduct our work in a manner that is contributive rather than competitive, that rests on commitments to conversation rather than conversion, that transcends the narrow disciplinary confines and conventions of academic musicology, that encourages us to keep open and to learn from contradictions rather than closing them down, and that embraces a liberating understanding of music as a widely authored social practice enacted in diverse sites that both reflects and shapes historical and social asymmetries of power.Our writing, teaching, talking, mentoring, and musicking help create the world we inhabit. The way Ramsey does the things he does should remind us of the advice of Sun Ra to members of his Arkestra to “be careful what you play . . . every note, every beat, be aware it comes back to you.”2 At its best, playing music can develop and deepen individual and collective capacities for responsibility and accountability. Everyone in an ensemble has a part to play; if one part is not played or is played badly, everyone suffers the consequences. Playing well is not just a matter of individual virtuosity; it requires careful listening, full awareness of the group, and the ability and disposition to accompany others, figuratively and literally. Music scholars are often experienced musicians, but the need for responsibility and accountability that pervades musical performance appears all too rarely in academic training, teaching, writing, reviewing, analyzing, and assessing.Who Hears Here? presents fourteen pieces published by Ramsey between 1996 and 2019, as well as an introduction that situates the book in its 2022 year of publication. It enables readers to see the broad arc of Ramsey's scholarship, to savor both the continuities it recognizes in culture and politics and the generative moments of rupture in each. Some of the pieces make time-specific interventions in music and cultural criticism that may seem out of date, but this occurs in part because the views and dispositions that Ramsey originated in his own work and championed in the scholarship of others at the time of their writing have become widely accepted, while many of the pieces remain as or even more relevant and urgent today as the day they were written.Professional critical analysis from Ramsey's perspective inevitably starts from “a web of personal history, memory, and subjectivity.”3 Music-making and music criticism for him are not practices whose boundaries need to be policed by expert gatekeepers but rather points of entry into the possible creation of a morally just world by people from diverse backgrounds. Ramsey calls for theories of cultural practice that emerge from specific contexts of domination and resistance and that “center the social realities of real historical actors.”4 However, his standpoint, while always situated, is never static. He locates the key organizing theme of his work in “the strength, resilience and dignity of Black people who have fought adversities for centuries,” and relates that his ears were trained to hear music “through the migrant culture” that his family brought from cities in Georgia to their new homes in Chicago. Throughout the book he engages with the wide range of interlocutors from the different demographic groups and disciplines that he has encountered in library books and live performances, at academic conferences and in college classrooms, and in conservatories and concert halls. Personal experiences and abstract intellectual commitments enable Ramsey to identify and discern deftly the importance of the diverse sites where repositories of knowledge about Black music can be found—in house parties, lounges, churches, dance halls, theaters, nightclubs, solitary listening, work songs, and conversations within families and among communities.5 Coming to music through these experiences led Ramsey to develop some foundational aspects of his thinking: e.g. that music is a collaborative endeavor, that as artistic communities develop they model meaningful ways of thinking and social interaction, that genius is never a product of isolated individualism, that communities chronicle and theorize their pasts, and that music cannot be separated from how power and history shape social identities.Both his situated knowledge and abstract theoretical commitments and conclusions lead Ramsey to present music as a network of creative acts rather than merely a canon of created objects. This enables him to connect his advanced understandings of the formal properties of musical composition and performance to their social uses and effects in specific communities at particular historical moments. He eschews the commitment to connoisseurship that often pervades evaluations of works and genres in musicology, and instead engages in cultural critique to connect musical works, gestures, and styles to their signifying effects and social meanings.6 For example, Ramsey argues that artists engaged in jazz, gospel, hip-hop, and other Black-rooted musical forms enact what he calls “social contracts” with audiences that codify expectations about sonic organization, performance styles, audience reaction, and marketing strategies.7 He discusses the repetitive predictability of swing music, not to belittle it as an example of inferior musicianship, but rather to highlight how musical clichés can sometimes function as powerful organizers of new social identities and relations.8 Eschewing criteria grounded solely in matters of formal complexity and mastery, he argues persuasively that the “in the pocket” groove characteristic of the sonic division of labor in funk “rivals for importance the conventions of bebop's complex and more open-ended rhythmic approaches” because both forms fused desires for freedom with invitations to spontaneous creativity.9Ramsey's emphasis on the uses and effects of music enables him to discern other unexpected affinities between very different musical texts and practices. He hears the groove that the band plays on Robert Glasper's “Cherish the Day” as a fusion of gospel songs as played in a hip church with the music made by Chick Corea's Elektric Band. The song's verses and choruses built on identical chord structures strike Ramsey as “an analog interpretation of a digital concept.”10 When judged by their historical and social impacts, James Brown and Miles Davis appear in Ramsey's analysis as equally important figures for cultural theory.11 While recognizing the very different intentions, histories, and understandings of music that distinguish artists from each other, Ramsey finds affinities among diverse artists who transgress imagined barriers of genre, gender, and generation. He finds surprising generative comparisons, contrasts, and affinities by connecting music made by John Coltrane with that by Rosetta Tharpe, and by placing works by Alice Coltrane and Mary Lou Williams in dialogue with those by Ruth Brown and Louis Jordan.12 He describes the 1994 hip-hop album Illmatic by Nas as a hip-hop equivalent to Miles Davis's 1959 classic jazz album Kind of Blue because both sought to make music resonate with the pulse of the people at particular times.13 The kinetic intensifications improvised by dancers and roller skaters at events Ramsey attended as a youth (that entailed collaborations among dancers, skaters, listeners, and recorded music) mirror for him the harmonic moves and narrative respites created by James Brown and his band.14Another singular contribution of Who Hears Here? resides in its insight that in order for Black music to take place it takes places. Ramsey pays particular attention to community spaces that function as alternative academies and autonomous learning circles, as places where people experience, evaluate, learn, and teach music as a complex social practice made up of more than notes, chords, rhythms, and an array of technical devices and figures. Black music from Ramsey's vantage point makes claims on public spaces and imbues them with new meanings as automobiles become mobile sound systems, picnic areas and parks become concert halls, swap meets become music libraries, and concrete sidewalks and asphalt streets become dance floors. Ramsey gives full credit to the musical knowledge he obtained from books and classroom lessons and lectures, but he positions this knowledge in dialogue with—rather than in opposition to—what he learned from community networks of apprenticeship and instruction, and from the sounds made in all the sites where music registers the negative consequences of subjugation and dispossession as well as resistance to them.15While it is productively race based, Ramsey's scholarship is never narrowly race bound. The music he writes about emerges from the collective intelligence honed in struggle that Cedric Robinson identifies as the Black Radical Tradition, an ontology and epistemology rooted in the linked fates of Blackness. Yet Ramsey's work is never only about Blackness, Black people, or Black music. The Black Radical Tradition for him, as for many others, is a way of using the situated experiences of Black people as a point of entry into understanding how the legacies of slavery unwilling to die, Indigenous dispossession in perpetuity, and conquest and coloniality impede the development of any genuine universality. The situated knowledge of Black people offers ways for everyone to escape the intellectual enfeeblements and social injustices encoded within dominant ways of knowing.Ramsey shows that there is no way to understand the uses and effects of Black music without recognizing and reckoning with the ways in which the biological fiction of race functions as a social fact that artificially, arbitrarily, and irrationally uses difference as an excuse for domination and a mechanism for unjustly skewing opportunities and life chances. Music-making and musicology are not innocent victims of this racial order but rather key crucibles where racism is constructed, cultivated, learned, and legitimated. As Loren Kajikawa has argued convincingly, the debilitating legacies of white supremacy continue to produce overrepresentation of Western art music of the eighteenth and nineteenth centuries in the curricula and research conducted in academic music departments and in works performed in concert halls supported by subsidies from universities, philanthropic institutions, and government bodies.16 Much of music education and research remains imprisoned within the preferences, privileges, and presumptions of what Ramsey calls the “white critical eye,” through which analysts from all racial backgrounds are prodded to look.17 This “white critical eye” produces a corresponding “white critical I,” a persona inhabited by scholars and critics that either ignores Black experience entirely or reduces it to metaphorical expressions that depict differences as mechanisms for novelty and product differentiation while occluding the profound aesthetic, political, and moral wisdom developed within aggrieved communities of struggle. The “white critical I” can also lead Black scholars to seek entry into places of power for themselves but then lock the door behind them to keep out others and exclude the concerns of the communities that create, consume, produce, and perform Black music.The problem of the “white critical I,” in Ramsey's view, stems in part from the underrepresentation of Black scholars in musicology. That dimension of the problem requires the recruitment and retention of Black scholars capable of tapping into personal experiences with the Black Radical Tradition—highly trained experts who in Ramsey's words “have been there and know there.”18 The “white critical I” also suffers, however, because of its I-ness as well as its whiteness. Ramsey identifies the “aggressive, individualist attitude that the academy fosters” as an impediment to socially conscious, accountable work.19 He challenges scholars who are white and/or white-minded to “face the music” literally as well as figuratively by welcoming how Black musicologists engage with race as a “social,” “cultural,” and “discursive” concept “with the same enthusiasm they celebrate from the black musicians they study.” He urges musicologists to do the work needed to desegregate the profession thoroughly, not only in its demographics but also by respecting and drawing on the profound wisdom of music as it is practiced in Black communities.20 This entails decentering Western art music and its paradigms, hierarchies, and aesthetic conventions. The reception accorded the work of Philip Ewell (among others) in recent years testifies to both the generative value of antiracist scholarship in musicology and the pernicious and persistent resistance to it.21As Charles Briggs demonstrates in Unlearning, his extraordinary book about the poetics and politics of knowledge, the disciplines deploy debilitating demarcations that insist on separating the scientific from the sacred and the secular; on relegating high, middle, and low culture to incommensurable realms; and on disaggregating historical and social processes into small pieces that occlude broader processes across time and place.22 Practices and processes that take place all at once in the world appear in the university as objects of study in different departments located in different buildings and as parts of books on separate shelves on different floors of libraries. Ramsey's writing offers us an opportunity to use the disciplines without being unduly disciplined by them.Who Hears Here? raises challenges to many of the core categories of disciplinary research on music. Ramsey refuses to erect walls between music and other forms of expressive culture. He acknowledges his appreciation of the arguments by Black feminist literary critics that highlight how differences of caste, color, and gender preclude unitary descriptions and definitions of Black identity.23 The ability of historian Robin D. G. Kelley and literary scholar Farah Jasmine Griffin to locate cultural products in the historical moments in which they emerged provides the methodology that Ramsey deploys in connecting the revolutionary cultural creations of the Black Arts Movement of the 1960s and 1970s to the artists’ commitments to social revolution as well,24 and in analyzing the 1945 recording of “It's Just the Blues” as a musical register of a historical moment when rural migration to urban ghettos produced a blend of gospel, country, and jump blues.25 Similarly, from Ramsey's perspective, part of James Brown's success in the 1960s and 1970s came from his ability to link Southern and Northern musical figures in ways that appealed at one and the same time to both mainstream and avant-garde audience tastes and to both militant revolutionaries and energetic school children.26 Ramsey finds parallels between the configuration and reconfiguration of social worlds evidenced in the broad inventory of samples in contemporary hip-hop and the introduction of Afro-Cuban elements in the jazz music of Dizzy Gillespie in the 1940s.27 This celebration of the dynamism of encounters, fusions, conversations, and collisions in music reflects a core element in Ramsey's way of working: his commitment to keeping open rather than closing down contradictions, to read them as evidence of new questions that need to be asked and answered rather than as embarrassing failures or empty novelties that need to be explained away.Just as a worthy work of art makes us fight against ourselves, good scholarship leaves us with difficult contradictions to negotiate. Ramsey highlights how the experiments that take place in the spaces between convention and innovation inevitably entail complex struggles inflected by asymmetrical power.28 He depicts Pearl Cleage battling with the conflict between her revulsions at the sexism and brutality of Miles Davis and her deep attachment to the things his music helped her to say.29 He notes that spirituals transcribed by abolitionists in an effort to demonstrate the incontrovertible qualities of Black humanity also fueled colonial anthropological ways of knowing that led to the relentless, destructive classification and objectification of racialized peoples and their cultures.30 Even of coloniality can its practice and its Ramsey shows how hip-hop by Black new in in the and by what the to be of Black urban but the and of the culture these to repetitive conventions against which many other Black artists to of the generative of contradictions enables Ramsey to of in work that has been in the As he by James and others, he that he to on what they rather than to them on That appreciation Ramsey's and of what he has learned from He writing about for the way to see and him as a to contemporary Black cultural He feminist and and musicology for how to the of can the disciplines from their and new of analysis of all of the he to other scholars and in all of the claims he makes Ramsey the he in of the music he an to rather than and to value the things that make us different as well as the things that make us the what that he knows in the essays in this Ramsey as a of the first should be for all that the book us about a range of musical forms and musical of us can to or the contributions to scholarship and civic life that Ram