@article{alejandrocanalescruz2014hacia,
  title = {Hacia un nuevo diseño para el aprendizaje: escenarios educativos para la Web 2.0},
  author = {{Alejandro Canales Cruz}},
  date = {2014-01-01},
  journaltitle = {Apertura},
  shortjournal = {Apertura},
  url = {https://openalex.org/W2992222031},
  abstract = {En este artículo se retoma la caracterización de pedagogía en la virtualidad, la cual se fundamenta en la apropiación tecnológica en función de la educación y voluntad de los participantes. Se propone la convergencia del diseño tecnopedagógico, unido a la apropiación creativa y a los usos pedagógicos efectivos para maximizar el proceso educativo. Se plantea el empleo de la especificación IMS Learning Design (LD) para la construcción de escenarios educativos como un proceso sistémico con actividades interrelacionadas que permiten crear ambientes que en verdad faciliten, de forma mediada, el proceso educativo. Finalmente, se presenta una herramienta para la autoría de escenarios educativos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{alejandrogimenez2006propuesta,
  title = {Propuesta de apropiación tecnológica del uso de chamotas de una alfarería artesanal, como sustituto de la arena del concreto para losas de pisos en viviendas populares},
  author = {{Alejandro Giménez} and {Rosa Malavé} and {Glenda Pilar Jacome Lopez}},
  date = {2006-12-01},
  journaltitle = {UCLA Biblioteca de Ingenieria Civil},
  shortjournal = {UCLA Biblioteca de Ingenieria Civil},
  volume = {6},
  number = {1},
  pages = {41--47},
  url = {https://openalex.org/W2893911153},
  abstract = {Este trabajo tiene por objeto optimizar el aprovechamiento de los desechos de una alfarería artesanal ( chamotas) con el fin\textbackslash nes obtener agregado fino como sustituto de la arena del concreto, usado en losas de pisos de viviendas populares y producir\textbackslash nuna apropiación tecnológica del proceso en las comunidades vecinas más desposeídas. Para ello, se adopto como\textbackslash nmetodología un modelo propio resultado de la combinación de los fundamentos empleados por Vanegas J.A. (2003), Pesci,\textbackslash nR. ( 1994) Y López, G. ( 1994) en este tipo de proyectos. Dos comunidades semirurales del Estado Lara - Venezuela (El Coyon\textbackslash ny Los Arangues), fueron escogidas para llevar a cabo la investigación. Se evaluaron dos grandes grupos de aspectos:\textbackslash nsociales- culturales políticos y técnicos- económicos- financieros. El análisis del primer grupo reportó como aspectos más\textbackslash nrelevantes la participación, la organización y los actores involucrados, el segundo grupo arrojó que el agregado reciclado se\textbackslash npuede considerar de buena calidad, produciendo en el peor de los casos una pérdida del 15\% en la resistencia a compresión\textbackslash ndel concreto. Los costos de producción de este tipo de agregado resultaron favorables solo cuando se realizan a nivel\textbackslash ncomunitario, con trituradoras pequeña y orientados a producir una apropiación de la técnica con la conformación de un\textbackslash ncomité de aprovechamiento de desechos (CAD).},
  langid = {spanish},
  keywords = {iberoamericana}
}

