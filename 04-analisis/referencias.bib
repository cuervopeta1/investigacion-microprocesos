@article{juandavidvelasquezgomez2026criterios,
  title = {Criterios preliminares de diseño para experiencias de aprendizaje matemático mediadas por herramientas digitales en contextos de desigualdad digital},
  author = {{JUAN DAVID VELASQUEZ GOMEZ} and {JORGE ALEJANDRO NORIEGA} and {Gustavo Suárez}},
  date = {2026-09-24},
  journaltitle = {Figshare},
  shortjournal = {Figshare},
  doi = {10.6084/m9.figshare.33980089},
  url = {https://openalex.org/W7214211629},
  abstract = {Este working paper propone un marco preliminar para el diseño de experiencias de aprendizaje matemático mediadas por GeoGebra en contextos caracterizados por desigualdades digitales y educativas. El documento analiza la integración de la tecnología desde cuatro dimensiones principales: condiciones materiales e institucionales, mediación docente, diseño de las tareas matemáticas y participación y apropiación tecnológica de los estudiantes.A partir de estas dimensiones se plantean principios de diseño para diagnosticar necesidades, relacionar procedimientos escritos con representaciones digitales, graduar el acompañamiento docente, promover la colaboración y utilizar la revisión de inconsistencias como oportunidad de retroalimentación. Asimismo, se propone una secuencia preliminar de implementación y una agenda de validación para investigaciones posteriores.El documento tiene carácter conceptual y metodológico y no presenta los resultados empíricos completos de la investigación, los cuales se reservan para una futura publicación científica sometida a revisión por pares.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{juandiegorestrepoyepes2026sistemas,
  title = {Sistemas agroalimentarios localizados: seguridad jurídica y derecho a la alimentación en Colombia},
  author = {{Juan Diego Restrepo Yepes} and {Liliana Damaris Pabón Giraldo}},
  date = {2026-08-12},
  journaltitle = {DOAJ (DOAJ: Directory of Open Access Journals)},
  shortjournal = {DOAJ (DOAJ: Directory of Open Access Journals)},
  doi = {10.5281/zenodo.21895687},
  url = {https://openalex.org/W7214701792},
  abstract = {El artículo aborda la creciente preocupación global por la seguridad alimentaria explorando los Sistemas Agroalimentarios Localizados (SIAL) como una solución innovadora que integra la sostenibilidad ambiental, social y económica con la producción de alimentos. Para tal efecto, se empleó una metodología mixta con predominio cualitativo, sustentada en revisión documental y análisis comparado de experiencias latinoamericanas, particularmente en Bolivia, México, Brasil, Argentina, Chile y Colombia. Los resultados evidencian que los SIAL favorecen la valorización de recursos locales, la agricultura familiar, la sostenibilidad territorial y los circuitos cortos de comercialización; asimismo, muestran que en América Latina existen avances normativos e institucionales asociados a estos sistemas, aunque persisten problemas de fragmentación normativa, dependencia institucional y tensiones frente a las dinámicas del mercado global. En el caso colombiano, se identifican instrumentos jurídicos relevantes, pero insuficientes para consolidar una política integral de SIAL. Se concluye que estos sistemas constituyen una herramienta pertinente para la defensa del derecho a la alimentación, siempre que articulen reconocimiento normativo, participación comunitaria, sostenibilidad económica y apropiación tecnológica.},
  langid = {spanish},
  keywords = {iberoamericana}
}

