@article{julianaramirezcandamil2025analisis,
  title = {Análisis sobre las percepciones de docentes en el uso y apropiación de las tecnologías de la información y la comunicación},
  author = {{Juliana Ramírez Candamil} and {Alejandro Peláez Arango} and {Germán Albeiro Castaño Duque}},
  date = {2025-11-24},
  journaltitle = {Educación y Educadores},
  shortjournal = {Educación y Educadores},
  volume = {28},
  number = {1},
  pages = {1--21},
  doi = {10.5294/edu.2025.28.1.6},
  url = {https://openalex.org/W4416593022},
  abstract = {Esta investigación se realizó en cuatro municipios de los departamentos de Caldas y Sucre (Colombia), con el objetivo de conocer las percepciones de docentes de escuelas públicas sobre el uso y apropiación de las tecnologías de la información y la comunicación (TIC) en la enseñanza. A partir de una muestra de 414 docentes, se aplicó un instrumento de 49 preguntas, de las cuales se analizaron 14 relacionadas con competencias TIC, actitudes, apropiación y dotación tecnológica institucional. Los análisis estadísticos revelaron diferencias significativas asociadas al territorio, la edad y el género. Se evidenció que los docentes más jóvenes, especialmente los hombres, manifiestan mayor disposición y competencia en el uso pedagógico de las TIC. Las actitudes positivas con la tecnología se asocian con una mayor probabilidad de uso, aunque persisten barreras vinculadas con creencias y confianza tecnológica. Los resultados muestran que la apropiación tecnológica no depende únicamente de factores técnicos, sino también de condiciones socioculturales e institucionales. Se recomienda diseñar programas de formación continua diferenciados por generación y contexto, promover comunidades de práctica y formular políticas educativas que reconozcan desigualdades regionales y de género. Los hallazgos ofrecen insumos clave para avanzar hacia modelos pedagógicos más inclusivos, sostenibles y contextualizados en América Latina.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{julianatorocamelo2024design,
  title = {Design and planning of a community wireless network for a rural school in Norte de Santander},
  author = {{Juliana Toro Camelo} and {Maria Alejandra Acosta Álvarez}},
  date = {2024-05-28},
  journaltitle = {Repositorio Institucional (Pontificia Universidad Javeriana)},
  url = {https://openalex.org/W7202327938},
  abstract = {La educación rural en Colombia enfrenta una serie de desafíos significativos que afectan su calidad y acceso. La tasa de deserción escolar en áreas rurales supera el 10 \%, en comparación con el 2.5 \% en las ciudades, según datos del Ministerio de Educación Nacional [1]. Entre las limitaciones se incluye el difícil acceso a las instituciones debido a condiciones geográficas y problemas de seguridad. Además, el 40 \% de la población de niñas, niños y adolescentes que no están en el sistema educativo nacional residen en áreas rurales afectadas por el conflicto armado [2]. El problema de deserción se agrava a medida que los estudiantes avanzan a cursos más avanzados, ya que hay menos colegios rurales que ofrecen grados de bachillerato. Otros desafíos incluyen la escasez de docentes debido a bajos salarios y la falta de infraestructura y tecnología adecuada para un aprendizaje de calidad. Todas estas limitaciones se ven agravadas con la falta de acceso a Internet y recursos de Tecnologías de la Información y la Comunicación (TIC). Lo cual no solo coloca a los niños y jóvenes de los centros educativos rurales en desventaja en comparación con otros estudiantes del país y del mundo, sino que también afecta a las personas de las comunidades rurales. La falta de acceso a información actualizada obstaculiza el desarrollo económico y profesional, dificulta el acceso a servicios de salud, impone barreras a la inclusión social y, en general, disminuye la calidad de vida, lo cual es inaceptable para este siglo de la era digital [3]. Las dificultades sociales y geográficas presentes en las áreas rurales de Colombia convierten la solución para la conectividad a Internet en un desafío tecnológico de suma importancia. Durante los últimos años, ha surgido el desarrollo de redes inalámbricas comunitarias como una alternativa en diferentes partes del mundo. Estas redes inalámbricas son redes de telecomunicaciones implementadas y gestionadas de manera colectiva por las comunidades, con el propósito de conectar, comunicar y mejorar su calidad de vida; disminuyendo la brecha digital, fortaleciendo la inclusión social y logrando el acceso a las nuevas tecnologías de la información y la comunicación. Este trabajo de grado presenta el diseño, la planificación y el plan de implementación de una red inalámbrica para el centro educativo Chíchira sede Negavita del municipio de Pamplona en el departamento de Norte de Santander. La solución desarrollada se enmarca dentro de un macroproyecto dividido en tres fases cuyo objetivo principal es establecer una red inalámbrica comunitaria en una escuela asociada a la Fundación de Humanitos; la primera fase se centró en el diseño e implementación de una red comunitaria para un entorno sin conexión a Internet, enfocándose en proporcionar servicio de Internet en la escuela Chíchira. La segunda fase abarcó la implementación de una red comunitaria con conexión a Internet, planificando y diseñando radioenlaces para llevar la conexión desde el casco urbano de Pamplona hasta la escuela. Finalmente, la tercera fase se enfocó en la expansión de la infraestructura de la red, planificando la ubicación de nuevos puntos de acceso para maximizar la cobertura y beneficiar a más personas de la comunidad. Durante la primera fase, se desarrolló un prototipo de servidor que permite acceder a contenidos educativos sin necesidad de una conexión a Internet. También se elaboraron guías de documentación específicas, proporcionando la información necesaria para la implementación, configuración y gestión completa de los componentes de la red implementada. Además, se incluyeron los resultados de las pruebas que evaluaron tanto la cobertura del diseño de la red como la calidad de la red implementada en el laboratorio, mediante simulaciones de tráfico. En las dos últimas fases, se evaluó la viabilidad de los radioenlaces propuestos mediante cálculos y simulaciones, dejando la implementación para proyectos posteriores. Asimismo, se estimó un presupuesto que contempla los costos en cada fase. Este proyecto representa un aporte inicial e importante para el futuro desarrollo e implementación de la red, el cual se llevará a cabo gracias a la participación del semillero ARTICO de la Universidad Javeriana.},
  langid = {spanish},
  keywords = {iberoamericana}
}

