}

@article{barreiro-rozados2026vasallos,
  title = {Vasallos de las plataformas: los medios de servicio público ante las lógicas neoimperialistas del tecnofeudalismo},
  shorttitle = {Vasallos de las plataformas},
  author = {Barreiro-Rozados, Manuel and Calviño Tato, Pablo and López Iglesias, Óscar},
  date = {2026},
  journaltitle = {Dígitos: Revista de Comunicación Digital},
  number = {12},
  pages = {45--64},
  publisher = {Departamento de Teoría de los Lenguajes y Ciencias de la Comunicación},
  issn = {2444-0132},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10876559},
  urldate = {2026-11-13},
  abstract = {The platformisation of the global audiovisual sector has driven a reconfiguration of the public media  sphere through a dynamic of re-feudalisation and cultural neo-imperialism. Streaming platforms, as  central sociotechnical infrastructures of digital capitalism, operate 2 through the extraction, processing  and monetisation of user data, underpinned by a model grounded in network effects, economies of  scale and algorithmic control. This dynamic consolidates a global asymmetry in which a handful of  corporations —predominantly American— function as technological feudal lords governing access,  rules and data, whilst users assume the role of vassals. Furthermore, this techno-feudalism results in a  homogenisation that erodes cultural diversity. Within this context, Public Service Media (PSM),  particularly across the European landscape, have adapted in a mimetic and reactive manner, relegating  their public service remit to a secondary position. In light of this situation, and given the current  inadequacy of the regulatory framework —notably on the part of Community authorities, most  particularly through Directive (EU) 2018/1808, as well as the relevant national legislation— there is an  urgent need for a new binding international regulatory framework, alongside ambitious digital  sovereignty policies, robust privacy protections, and a fundamental reconceptualisation of PSM along  an alternative model centred upon public value, cultural diversity and transparency, with a view to  countering the mercantilist, extractive and centralising logics of platformisation La plataformización del sector audiovisual global ha impulsado una reconfiguración del espacio público  mediático a través de una dinámica de refeudalización y neoimperialismo cultural. Las plataformas de  streaming, como infraestructuras sociotécnicas centrales del capitalismo digital, operan mediante la  extracción, procesamiento y monetización de datos de los usuarios con un modelo basado en los efectos  de red, la economía de escala y el control algorítmico. Esta dinámica consolida una asimetría global en la  que unas pocas corporaciones, principalmente estadounidenses, actúan como señores feudales  tecnológicos que controlan el acceso, las reglas y los datos, mientras los usuarios asumen el papel de  vasallos. Además, este tecnofeudalismo resulta en una homogeneización que erosiona la diversidad  cultural. En este escenario, los Medios de Servicio Público (PSM), particularmente en el contexto europeo, se  han adaptado de forma mimética y reactiva, relegando su misión de servicio público a un plano secundario.  Frente a este panorama, y ante la insuficiencia regulatoria actual, tanto por parte de las autoridades  comunitarias, singularmente mediante la Directiva (UE) 2018/1808, como de las respectivas legislaciones  nacionales, se evidencia la necesidad urgente de un nuevo marco regulatorio internacional vinculante, de  nuevas y ambiciosas políticas de soberanía digital, de protección de la privacidad y de un replanteamiento  de los PSM desde un modelo alternativo centrado en el valor público, la diversidad cultural y la  transparencia, con el objetivo de contrarrestar las lógicas mercantilistas, extractivas y centralizadoras de la  plataformización},
  langid = {spanish}
}

@thesis{barreto2015estudo,
