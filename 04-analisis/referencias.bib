@article{pierrafuentes2022principios,
  title = {Principios para el desarrollo, uso y aplicación de las TIC en el gobierno},
  author = {Pierra Fuentes, Allan and Rodríguez Figueredo, Héctor and Fuentes Rodríguez, Juan Manuel and Montesinos Perurena, Raydel},
  date = {2022-08},
  journaltitle = {Universidad y Sociedad},
  shortjournal = {Universidad y Sociedad},
  volume = {14},
  number = {4},
  pages = {369--378},
  issn = {2218-3620},
  url = {http://scielo.sld.cu/scielo.php?script=sci_arttext&pid=S2218-36202022000400369&lang=pt},
  abstract = {ABSTRACT The objective of this work is to provide an instrument and to carry out a balanced evaluation of the perspectives offered by the use of free and open source software within the public administration, using the socio-technological analysis in the historical-concrete conditions of Cuba. Four principles are proposed that can be summarized in the Four “S” model: Security, Technological Sovereignty, Socio-adaptability and Sustainability. These principles do not contradict the "open source" criteria, nor do they replace the "four freedoms" of the "free software" movement, but rather, added to these, they intend to contribute to the necessary process of Digital Transformation, seen as a continuation of the computerization of society, which seeks to put technology in function of human development and the improvement of the quality of life of the population, giving a qualitative leap. Although not exhaustive, this paper proposes a framework to analyze the conditions for open source adoption in public sector organizations in Cuba.},
  langid = {spanish},
  keywords = {Administración pública,Ciberseguridad,Código abierto,Cybersecurity,Digital transformation,Free software,Open source,Public administration,Soberanía tecnológica,Software libre,Technological sovereignty,Transformación digital}
}

@article{pierre-philippefraiture2023congolese,
  title = {Congolese {{Cultural Production}} in {{Africa}} and the {{World}}},
  author = {{Pierre‐Philippe Fraiture}},
  date = {2023-11-10},
  journaltitle = {French Studies},
  shortjournal = {French Studies},
  volume = {78},
  number = {1},
  pages = {101--127},
  doi = {10.1093/fs/knad236},
  url = {https://openalex.org/W4388964087},
  abstract = {As an object of study, Congolese culture defies ready-made definitions. This inherent complexity has its roots in history. The frontiers of the Democratic Republic of the Congo (DRC) were decided at the Berlin Conference in 1884–85.1 By creating the Congo Free State (CFS), Leopold II, the king of the Belgians, presided over a large ensemble of peoples, such as the Kongo, Lunda, Luba, and Kuba, who had hitherto shared and often competed for land and resources in Central Africa. Before this, the kingdom of Kongo — a huge but scarcely populated political entity encompassing parts of present-day DRC, the Republic of the Congo, and Angola2 — had been gradually Christianized from the late fifteenth century onwards. Even though the cross-cultural traces of this process are extensive, not only in Central Africa but also in Europe and Latin America,3 it was not before the end of the nineteenth century that the DRC — under its previous appellations, CFS (1885–1908) and Belgian Congo (1908–60)4 — experienced a full-scale version of western modernity. The CFS was more than just a Belgian venture. From the very outset, Leopold II was keen to recruit advisers and staff from other western countries and, in the extractive and exploitative logic of this undertaking, he was eager to adopt a multinational strategy.5 When Belgium took over on 15 November 1908, the national basis of the project was reinforced but the colony remained at the mercy of crude capitalist calculations despite the introduction of the ‘Charte coloniale’, a set of laws passed by the Belgian Parliament to put an end to the abuses and crimes committed by the Leopoldian regime.6 It is in this context that a Congolese culture — the main focus of this état présent — emerged. A Congolese culture rather than Congolese culture, for the presence of the colonizers precipitated homogenization and brutally federalized — often by forcefully displacing men and women to satisfy the demands of extracting companies in Katanga and Kasai, in particular — cultural and linguistic practices that had thus far been only loosely connected. This unitarian aspiration underpinned Belgian anthropology from its beginnings to the 1970s, from the launch of the ‘Monographies ethnographiques’ series under Cyrille Van Overbergh’s editorship to the publication of Luc de Heusch’s Le Roi ivre.7 Van Overbergh’s questionnaire-based descriptive ethnography, an intellectual enterprise that, incidentally, secured the primacy of the then Congo Museum (in Tervuren) as the centre for ‘colonial science’,8 could not be more remote from Heusch’s Lévi-Strauss-inspired structuralist musings. However, it is worth noting that despite their methodological and theoretical differences these two figures contributed to the development, and the sedimentation, of a Congolese culture perceived as authentically and genealogically Bantu. Whilst being submitted to the demands of global capitalism and the pressures of a multiplicity of agents from every corner of the western world, the management of the Congo, and the development of a Congolese culture, were also contingent on Belgian linguistic priorities and ethnic contradictions.9 Unlike France, Belgium was never able to develop a strong and coherent national narrative. The French language was from the very outset of the project the lingua franca of the colony. This was due to its international prestige but also to the fact that, since the creation of Belgium in 1830, French had been the de facto language of the Belgian elite, whether from Flanders, Wallonia, or Brussels. Ironically, however, the strong contingent of Catholic missionaries deployed in the Belgian Congo were often Flemings and if their evangelical action was for the most part conducted in French, they also were the active promoters of local languages and even encouraged the development of written literature in Congolese languages such as Kikongo, Lingala, and Ciluba.10 The modern Congolese culture developed in this specific colonial context, then, was unique and certainly very different from what was experienced in the neighbouring French Equatorial Africa where assimilation, through French, remained one of the cornerstones of the system. This linguistic question is of the utmost importance and despite the differences between French and Belgian practices in this area, it must be added here that there were promoters of African languages in the French colonies, too, but that they were often Africans — Cheikh Anta Diop’s work is symptomatic of this trend11 — rather than French.12 Equally, French is the official language of the DRC and, as such, has remained the main tool of social and professional promotion and knowledge dissemination in schools, often at the expense of the widely spoken four main langues véhiculaires (Ciluba, Kikongo, Lingala, and Swahili) and the other 200 or so minority languages invariably repressed and devalorized on the basis of a system reproducing ‘l’idéologie de l’école coloniale’ and ‘une doxa et […] une représentation sociale des langues octroyant au français une fonction privilégiée’.13 As explored by Sinzo Aanza in his acclaimed novel Généalogie d’une banalité, the use of these Congolese languages in educational settings often leads to disciplinary sanctions and corporal punishment against contravening pupils.14 This état présent will not focus on Congolese culture — because it simply does not exist and, if it does, it can only be retrospectively constructed15 — but on this brand of Congolese culture elicited by western (and Belgian) modernity since 1885 and reappropriated — reprised16 — by Congolese intellectuals, artists, and writers. In this reflection, I shall favour the two opposing sides of this rich and multifaceted cultural production. First, this culture’s tendency to visit, and often revisit ad nauseam, the many constraining traces and effects — often brutal, bloody, alienating, and traumatic — of the coercive conditions put in place by seventy-five of and of ethnic and I will that the by this of and also been by Congolese cultural to the of of the In this I will that Congolese and — the since the of this — been able to to and and a of the an a for the Even though the Congo from the of its from to the the the and, not it only just the This of to the of the Congo was as a by the of from the to the from to the of the Congo, was an to the of the but also to the of a As is this — from of to of Congo — part and of modern global of the This its of of and has been and in and to the DRC of and, as will be This has as the and of modern does one from d’une — most colonial and in or the the to this perceived had to be As the for the and its this had to be and its to In his of colonial incidentally, was the of of that the of de had for most such as their to the The to the of the enterprise at its — and — their also to the of the Congolese and often the has remained one of the most in In and the colonizers had put in place the and a system Congolese and were by a in the of and the of to the and even ethnic has been as a of From colonial to the introduction of and since the management of and has the of the the other end of the colonial on the of the DRC, to the colonizers for modern — de and — to In his but a Belgian and Congolese of the by Congolese to the demands of the this […] […] The of these two — the modern but and but also and — the of modern Congo, a that more than contributed to global by one of the most of a that the of the at the end of the nineteenth at the of this the of on Congolese as has been at the expense of the Congolese and if can on and on it is to the this but and has also been in the for a and has been one of the of Congolese cultural production. The of such as and not only in their but also in their the of colonial on Congolese The on the and of African has As most — but also most — on the African and cultural In one of his he the of a and but also at a to the of and experienced b