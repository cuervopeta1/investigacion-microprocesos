  issn = {2007-3607},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9339365},
  urldate = {2026-11-13},
  abstract = {El dinero, como se conoce de manera tradicional, está protagonizando su propia revolución digital. El tiempo manifiestará si estamos frente a un verdadero cambio de paradigma de la esencia del dinero o solo son meras modificaciones en los soportes de representación. Si este último se vincula con la confianza, la esencia del dinero se encuentra relacionada con la confianza en quien lo emite y el consenso social para su uso y extensión. La llegada de los criptoactivos al sistema financiero ha sido un tema recurrente de discusión en los últimos años.},
  langid = {spanish}
}

