@thesis{mauricioestebanreyesguaranda2026uso,
  title = {Uso y apropiación de las Tecnologías de la Información y Comunicación (TIC) en docentes de carreras de ciencias políticas y sociales de la Universidad de Cuenca, Ecuador},
  author = {{Mauricio Esteban Reyes Guaranda}},
  date = {2026-04-01},
  journaltitle = {El Servicio de Difusión de la Creación Intelectual (National University of La Plata)},
  doi = {10.35537/10915/193201},
  url = {https://openalex.org/W7154446186},
  abstract = {La presente tesis analiza el proceso de uso y apropiación de las Tecnologías de la Información y la Comunicación (TIC) por parte de docentes universitarios de las carreras de Género y Desarrollo y de Orientación Familiar de la Facultad de Jurisprudencia y Ciencias Políticas y Sociales de la Universidad de Cuenca, Ecuador. El estudio parte del reconocimiento de que la incorporación significativa de las TIC en la educación superior constituye un requisito indispensable para responder a los desafíos de calidad, equidad e innovación educativa planteados en el marco del Objetivo de Desarrollo Sostenible 4, orientado a garantizar una educación inclusiva y de calidad. Desde un enfoque metodológico mixto, se aplicaron instrumentos cuantitativos para identificar perfiles sociodemográficos, niveles de acceso tecnológico y actitudes docentes hacia las TIC, complementados con grupos focales que permitieron profundizar en las prácticas pedagógicas, así como en las percepciones respecto a los factores institucionales y contextuales que inciden en la apropiación tecnológica. Los resultados evidencian una actitud favorable generalizada hacia el uso de TIC y un acceso básico generalizado a dispositivos digitales, aunque persisten limitaciones significativas en formación institucional, infraestructura tecnológica y políticas de acompañamiento. A nivel cualitativo, se identifican tensiones entre un uso predominantemente instrumental de las TIC y el tránsito hacia formas de apropiación pedagógica más críticas y significativas, donde los factores institucionales y contextuales adquieren un papel determinante. El estudio concluye que la apropiación de las TIC en estas carreras depende tanto de la disposición y trayectoria individual de los docentes como de las condiciones institucionales y socioeconómicas que enmarcan su práctica, ofreciendo una caracterización situada y empíricamente fundamentada de la apropiación tecnológica docente en la educación superior ecuatoriana, un campo poco explorado hasta ahora. Finalmente, se plantea la necesidad de fortalecer estrategias de capacitación continua, apoyo técnico-pedagógico y políticas institucionales claras que fomenten una integración más profunda y equitativa de las TIC en la docencia universitaria.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@incollection{mauricionovaessouza2026agroecologia,
  title = {Agroecologia em expansão: transformações sociais, ambientais e produtivas},
  booktitle = {Mérida Publishers eBooks},
  author = {{Maurício Novaes Souza}},
  date = {2026-01-01},
  doi = {10.69570/mp.978-65-84548-44-2.c5},
  url = {https://openalex.org/W7162399636},
  abstract = {O crescimento da agroecologia reflete uma transformação profunda nas relações entre pessoas, comunidades e o ambiente, ao propor práticas agrícolas que conciliam produção, sustentabilidade e justiça social.Ao integrar saberes tradicionais e científicos, promove sistemas produtivos que fortalecem o solo, conservam a biodiversidade e valorizam as comunidades, contribuindo para a segurança alimentar.Sua expansão ocorre em diferentes contextos: na América Latina, por meio de cooperativas e redes comunitárias; na Europa, impulsionada por políticas públicas e programas de capacitação; e na Ásia, como alternativa à agricultura convencional e instrumento de autonomia local.Esse avanço evidencia a importância do apoio institucional, da educação e de políticas públicas na consolidação da agroecologia.Destacam-se, nesse processo, os incentivos econômicos, a formação técnica e a pesquisa interdisciplinar como elementos fundamentais para ampliar sua adoção.Além disso, o engajamento social e o consumo consciente atuam como forças que impulsionam transformações nos sistemas de produção e distribuição de alimentos.Mais do que um conjunto de técnicas, a agroecologia se afirma como uma filosofia de vida, ao articular sustentabilidade ambiental, equidade social e desenvolvimento humano, consolidando-se como um caminho estratégico para a construção de sociedades mais justas e resilientes.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{mauriciosalazarpaez2026proyecto,
  title = {Proyecto aplicado: análisis de radiofrecuencia de la calidad de experiencia (QOE) con software libre: guía técnica para sustentar vacíos de conectividad ante entes reguladores.},
  author = {{Mauricio Salazar Paez}},
  date = {2026-06-26},
  journaltitle = {Institutional Repository of the National University Open and Distance UNAD (Universidad Nacional Abierta y a Distancia)},
  shortjournal = {Institutional Repository of the National University Open and Distance UNAD (Universidad Nacional Abierta y a Distancia)},
  url = {https://openalex.org/W7170119429},
  abstract = {En la actualidad, los vacíos de cobertura móvil en las comunidades rurales restringen el acceso a servicios como la educación y la salud, lo que profundiza la desigualdad social y técnica. Superar esta barrera es fundamental para garantizar el derecho a la conectividad y fomentar el desarrollo socioeconómico en regiones aisladas, integrándolas al ecosistema digital nacional. Por ello, este proyecto documenta una metodología técnica replicable para el diagnóstico preciso de estas deficiencias, con el fin de proporcionar herramientas técnicas a las poblaciones vulnerables. El enfoque metodológico se basa en mediciones de campo y pruebas de calidad para contrastar la cobertura teórica con la realidad del usuario, empleando herramientas de software libre como QGIS para el análisis geoespacial, Radio Mobile para simulaciones y G-NetTrack para la captura de datos en la red de acceso. A través de este proceso y del análisis de la banda de 700 MHz, se entrega un diagnóstico georreferenciado y una guía metodológica que empodera a los líderes locales en la elaboración de informes técnicos robustos. En conclusión, el proyecto permite sustentar la mejora de la infraestructura ante operadores y entes reguladores como el MinTIC y la CRC, promoviendo así la equidad en el acceso a redes móviles y el desarrollo sostenible del territorio.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{mauriciosantajimenez2015apropiacion,
  title = {Apropiación de la Tecnología Digital en la Práctica Deportiva del Tiro con Arco - Revista de Entrenamiento Deportivo},
  author = {{Mauricio Santa Jiménez} and {Danny Quintero Posso} and {Diego A. Torres}},
  date = {2015-01-01},
  journaltitle = {RED: Revista de entrenamiento deportivo = Journal of Sports Training},
  shortjournal = {RED: Revista de entrenamiento deportivo = Journal of Sports Training},
  volume = {29},
  number = {4},
  pages = {33--40},
  url = {https://openalex.org/W2258207698},
  abstract = {espanolEl siguiente estudio etnográfico se adentra en el análisis de la mediación tecnológica que subyace en las prácticas de los deportistas y entrenadores que convergen en el Campo Suramericano de Tiro con Arco en la ciudad de Medellín. Al estudiar las percepciones de los sujetos, se aprecia en ellos ciertos pensamientos que se refieren a la apropiación de la tecnología frente a los fines del deporte competitivo. Estas expresiones se dejan ver durante los entrenamientos en el campo deportivo y en el diario vivir por fuera de sus muros, en las casas, en las escuelas, en las universidades y en los lugares de trabajo. A través de entrevistas, encuestas y diarios de campo, el estudio se sitúa en las problemáticas que desde la apropiación tecnológica se suceden en la preparación habitual de estos actores. EnglishThe following ethnographic study explores the technological mediation underlying the practices of athletes and coaches who converge on the South American Field Archery in Medellin. By studying the perceptions of the subjects, seen in them certain thoughts relating to the appropriation of technology versus the purposes of competitive sport. These expressions are to be seen during training in the sports field and everyday outside its walls, houses, schools, universities and workplaces. Through interviews, surveys and field diaries, the study lies in the problems that happen technological appropriation from the usual preparation of these actors.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{maxeleliezerorozcomendez2015sistema,
  title = {Sistema de monitoreo de infraestructura de red para el ministerio de economía familiar, comunitario, cooperativa y asociativa (MEFCCA)},
  author = {{Maxel Eliezer Orozco Mendez} and {Alexis Xavier Montoya Gomez}},
  date = {2015-11-01},
  journaltitle = {Repositorio Universidad Nacional Autonoma de Nicaragua-Managua (Universidad Nacional Autonoma de Nicaragua Managua)},
  url = {https://openalex.org/W2612884021},
  abstract = {En el presente trabajo de culminación de estudios, se desarrolla un estudio de software libre Nagios, aplicación que monitorea esencialmente activos y servicios de red. Serán demostradas sus capacidades en una forma práctica, tratando de ayudar al administrador de la red a través del proceso de configuración para el uso de esta herramienta. Algunas de las características de Nagios son: monitoreo de servicios de red SMTP, POP3, HTTP, NNTP, entre otros; monitoreo de los recursos del servidor, tales como CPU, memoria, disco duros y procesos; capacidad para definir la jerarquía de la red; notificaciones inmediatas sobre problemas de red a través de correo electrónico; capacidad de tomar contramedidas de acuerdo con problemas de la red; una interfaz web con el mapa de la red en 2D y 3D, informes, gráficos e históricos. Es versátil, flexible y verifica constantemente la disponibilidad de servicios y hosts. Palabras clave: plugin, software, hosts, monitoreo, fallas de red, Nagios.},
  langid = {spanish},
  keywords = {iberoamericana}
}

