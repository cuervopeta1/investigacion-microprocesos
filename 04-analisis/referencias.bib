  urldate = {2026-11-13},
  abstract = {Este monográfico es parte de un número especial organizado conjuntamente  por la Revista Latinoamericana de Comunicación - Chasqui y el Journal of Latin  American Communication Research, dedicado a la Alfabetización Mediática e  Informacional (AMI) en América Latina y el Caribe, como resultado de la alianza  estratégica entre CIESPAL, ALAIC, la Representación Regional de América  Latina y el Caribe de la Alianza Global para la AMI impulsada por UNESCO, Las  Otras Voces - Comunicación para la democracia y UNIMINUTO cuyo fin común  consiste en identificar, visibilizar y articular iniciativas de nuestra América  en un entorno de aceleradas transformaciones en una región marcada por la  desigualdad.  El número reúne investigaciones desarrolladas en Argentina, Brasil, México,  Paraguay, Cuba y otros países, con el fin de mostrar la diversidad de experiencias  y enfoques sobre el tema. Se aborda la AMI como un campo multidimensional  que combina educación crítica en medios, apropiación tecnológica, prevención  de la desinformación, fortalecimiento de la ciudadanía y desarrollo de políticas  públicas.  El texto ofrece una lectura transversal de los artículos, situándolos en diálogo  con la literatura internacional y destacando sus contribuciones en ámbitos  como la democracia, la salud, la juventud y la innovación pedagógica. A partir  de estas experiencias, se reconocen tanto los avances como los desafíos que  enfrenta la región para consolidar un ecosistema de AMI robusto, articulado  y sostenible. El número especial se propone, así, como un aporte significativo  para la cooperación académica iberoamericana y para el di},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/GJHBUYUD/Bacher et al. - 2025 - Alfabetización Mediática e Informacional en América Latina y el Caribe Introducción y Reflexiones.pdf}
}

@article{badagnani2022primeros,
  title = {Primeros avances hacia la comprensión del rol de la interacción con pares y docentes en la evolución del conocimiento privado de la mecánica},
