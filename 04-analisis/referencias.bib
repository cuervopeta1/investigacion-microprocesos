@article{ivanantoniopintourra2026propuesta,
  title = {Propuesta de Mejora para Sistemas de Identificación Automática de Celo y Cojera Usando Collares IoT en Vacas Lecheras Considerando Experiencias en el Proceso Productivo de la Empresa Lácteos Tronador S.p.A.},
  author = {{Iván Antonio Pinto Urra} and Muñoz, Carlos and {Jaime Bustos} and {Jorge Aravena Lagos}},
  date = {2026-09-01},
  journaltitle = {Zenodo (CERN European Organization for Nuclear Research)},
  shortjournal = {Zenodo (CERN European Organization for Nuclear Research)},
  doi = {10.5281/zenodo.22221442},
  url = {https://openalex.org/W7212165160},
  abstract = {Este trabajo analiza la adopción de collares IoT para la detección temprana de celo y cojera en vacas lecheras, factores críticos para la productividad y el bienestar animal. A partir de un estudio de caso en la empresa Lácteos Tronador S.p.A., se evaluaron, mediante entrevistas, las experiencias del gerente, veterinario, operarios y una representante comercial de la empresa Cooprinsem. Se identificaron fortalezas, como la automatización del monitoreo, y limitaciones, como la escasa capacitación del personal, la falta de integración con sistemas complementarios (puertas automáticas, alertas visuales) y una débil apropiación tecnológica en terreno. El análisis se sistematizó a través de la interpretación de las respuestas y el análisis de sentimientos de los entrevistados. Como resultado, se propone una guía técnica que incorpora mejoras en diseño, soporte postventa e infraestructura, orientada a maximizar el impacto de esta tecnología en contextos reales. El estudio resulta relevante al demostrar cómo una adecuada implementación del IoT puede transformar la gestión sanitaria y reproductiva del ganado, aportando eficiencia, trazabilidad y sostenibilidad al sector lechero nacional.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{ivang.peyretartaruga2015innovaciones,
  title = {Innovaciones sociales e inclusivas: límites y posibilidades para el desarrollo territorial en el contexto de la globalización},
  author = {{Iván G. Peyré Tartaruga}},
  date = {2015-01-01},
  journaltitle = {RePEc: Research Papers in Economics},
  shortjournal = {RePEc: Research Papers in Economics},
  doi = {10.13140/rg.2.1.2579.1760},
  url = {https://openalex.org/W2582354212},
  abstract = {The technological innovation processes play an important role as a constitutive element of territorial development, a concept that intends to bring together the economic dimension (economic development), the social dimension (social development), the environmental dimension (sustainable development) and the territorial imbalances (territorial cohesion). Moreover, these processes are decisive in the context of economic and social changes faced by the world and Latin America, as the capacity of scientific and technological appropriation of regions and countries is crucial. In this context, this article has as its main objective to propose and to evaluate some strategies of territorial development based on the integration between economic and technological development and social inclusion for Latin America, showing the possibilities for their success and their limits and obstacles. The text suggests discussing also the merits and utility of two other concepts: social innovation and inclusive innovation.},
  langid = {spanish},
  keywords = {inglesa}
}

