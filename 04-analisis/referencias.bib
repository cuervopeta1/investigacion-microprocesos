@thesis{mariajessicacalvatorres2025exploracion,
  title = {Exploración de nuevas jergas en comunidades virtuales consumidoras de eSports en Quito: Perspectiva desde la ecología de medios, multimedia e hipermediación},
  author = {{María Jessica Calva Torres} and {Anderson Marcelo Huertas Orozco}},
  date = {2025-01-01},
  journaltitle = {Repositorio Digital de la Universidad Central del Ecuador},
  url = {https://openalex.org/W7225557657},
  abstract = {La presente investigación analiza el papel de la jerga gamer en los procesos de comunicación e identidad dentro de las comunidades virtuales de eSports en la ciudad de Quito, tomando como casos de estudio los videojuegos Dota 2 y Free Fire. A través de un enfoque cualitativo sustentado en la observación participante y en sesiones de discusión grupal, se examina cómo las jergas empleadas por los jugadores constituyen sistemas simbólicos complejos que fortalecen la pertenencia, la cohesión social y la construcción de identidades colectivas en los entornos digitales. La investigación integra perspectivas teóricas de la ecología de medios, la hipermedialidad, la cultura digital y la gamificación, con el propósito de comprender cómo las tecnologías de la información y la comunicación transforman las formas tradicionales de interacción. Se demuestra que el uso del lenguaje en los espacios virtuales no es un recurso accesorio, sino un eje estructurante que define jerarquías, roles, vínculos y dinámicas de poder dentro de las comunidades gamer. El estudio identifica que las expresiones y códigos propios del argot digital funcionan como marcadores de inclusión y legitimidad, reflejando al mismo tiempo procesos de creatividad lingüística, apropiación tecnológica y participación cultural activa. Asimismo, se observa que las jergas trascienden los límites del juego, expandiéndose a redes sociales, transmisiones en vivo y espacios de socialización digital, donde consolidan identidades híbridas y globales. Estas prácticas comunicativas evidencian cómo el lenguaje gamer actúa como un medio de cohesión simbólica, generando sentido de pertenencia y fortaleciendo las interacciones en la era digital. Finalmente, se concluye que las jergas digitales son manifestaciones comunicacionales y socioculturales que configuran los modos de comunicación, la construcción de identidad y las relaciones de poder en el ecosistema digital contemporáneo},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{mariajoseafanadorllach2024data,
  title = {Data {{Curation}} and {{Cartographic Narratives}} on {{Indigenous Circulation Networks}} in the {{Orinoco Region}}: {{Methodological Reflections}} on the {{Project Inventar Colombia}}},
  author = {{María José Afanador Llach}},
  date = {2024-10-01},
  journaltitle = {International Journal of Humanities and Arts Computing},
  shortjournal = {International Journal of Humanities and Arts Computing},
  volume = {18},
  number = {2},
  pages = {184--201},
  doi = {10.3366/ijhac.2024.0332},
  url = {https://openalex.org/W4403394368},
  abstract = {Inventar Colombia: una mirada desde el Orinoco is a digital research project that seeks to reconstruct aspects of the geographic imagination, forms of relationship with nature and its resources, of at least 15 Indigenous groups that inhabited the Orinoco region between the fifteenth and eighteenth centuries. Responding to the limits to what we can know in the archive about the ways in which various Indigenous groups inhabited and conceived the territory, we carried out a process of curation and extraction of geospatial data in historical and archaeological sources. We identified some patterns of territorial occupation and exchange networks of the multiplicity of Indigenous communities that have inhabited the Orinoco region. From iterations for the construction of maps with QGIS and typical GIS conventions, we explored other forms of visualization and narrative construction to deploy the arguments of the research on the web. We proposed a CSM-free web interface developed with JavaScript and open-source libraries and developed a set of cartographic narratives.},
  langid = {english},
  keywords = {inglesa}
}

@book{mariajoseginzovillamayor2024xi,
