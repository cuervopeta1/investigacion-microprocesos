  issn = {1815-5901},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9456617},
  urldate = {2026-11-13},
  abstract = {RESUMEN La implementación de Fuentes Renovables de Energía es cada vez más pertinente en todos los sectores de la sociedad y, fundamentalmente, en comunidades rurales alejadas del sistema eléctrico. Esta realidad precisa de un enfoque social que permita conocer las particularidades de cada asentamiento y sus pobladores. La presente investigación está orientada a estudiar el ámbito social y la aplicación de micro redes para fomentar el desarrollo local y erradicar los problemas socioculturales y políticos que acarrea la falta de acceso a un servicio eléctrico de calidad. Igualmente, se propone una metodología social participativa para el diseño de micro redes eléctricas rurales y la obtención de un resultado integrador y sostenible en el tiempo que satisfaga las expectativas y necesidades de sus beneficiarios. Se aplican, además, otras metodologías cualitativas y cuantitativas para la obtención de datos como son: el análisis documental, la entrevista estructurada y semiestructurada, las encuestas y el árbol de problemas. ABSTRACT The implementation of Renewable Energy Sources is becoming more and more pertinent in all areas and sectors of society but, fundamentally, in rural communities that are far from the national electrical system, due to the complexity of the lives of those people who lack energy electrical. This precise reality, not only from research carried out by technical sciences but also from a social approach that allows knowing the particularities of each of these systems and their inhabitants. This research is aimed at carrying out a study of the social environment that surrounds rural contexts and the application of micro grids in these to promote local development and eradicate sociocultural and political problems caused by the lack of access to a quality electric service and reliability. As well as, proposing a participatory methodology with social considerations for the design of electric micro grids under the realities of rural populations in Cuba and obtaining an integrating result that meets the expectations and needs of its beneficiaries and is sustainable over time. Other methodologies are also applied to obtain data that correspond to qualitative and quantitative methodologies such as: documentary analysis, structured and semi-structured interviews, surveys and the problem tree.},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/EQPJUAR7/Soto Calvo et al. - 2024 - Metodología participativa para el diseño de micro redes eléctricas en Cuba.pdf}
}

@article{sotocobos2026educacion,
  title = {Educación humanista e integración ia Oportunidades, retos, avances en la innovación pedagógica.},
  author = {Soto Cobos, D. A. and Quintero Pinzón, Marilyn},
  date = {2026},
  journaltitle = {Trascendere},
  volume = {3},
  number = {7},
  pages = {1},
  publisher = {Alida de las Mercedes Bazó Pirela},
  issn = {2959-5746},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10838346},
  urldate = {2026-11-13},
  abstract = {This article examines the appropriation of artificial intelligence (AI) in pedagogical practice by teachers at the José Eusebio Caro Educational Institution in NortedeSantander, Colombia. A qualitative approach was used, employing content analysistechniques with Atlas.ti 24 software, based on semi-structured interviews. Theresultsshow an initial phase of exploration and digital readiness, characterizedbytheinstrumental adoption of digital platforms such as Prezi, SchoolAI, TeachAI, ChatGPTPro, Canva, LearnLab, and Curious. Other tools, such as Khanmigo (fromKhanAcademy), Socratic (from Google), Duolingo Max, Quizlet, Q-Chat, and CenturyTech, were also used. Therefore, the teachers recognize the potential of Artificial Intelligenceto strengthen student motivation and personalize pedagogy. However, challengespersist related to connectivity, a lack of ongoing training, and the absence of institutional policies for AI integration. Therefore, it represents a pedagogical opportunityinaneducational society with equity and innovation projected towards a critical, humanizedand ethical vision. El presente artículo que viene a continuación considera la apropiación de la -inteligencia artificial- (IA) práctica pedagógica en los docentes de educación básica del Institución Educativa José Eusebio Caro, Norte de Santander - Colombia. En el cuál, se aplicó un enfoque cualitativo, con técnicas de análisis de contenido mediante el software ATLAS.Ti 24, a partir de entrevista semiestructurada. Los resultados muestran una fase inicial de exploración y aprestamiento digital, caracterizada por la adopción instrumental de plataformas digitales como Prezi, SchoolAI, TeachAI, ChatGPT Pro, Canva, LearnLab y Curious. De esta manera, otras herramientas como Khanmigo (de Khan Academy), Socratic (de Google), Duolingo Max, Quizlet Q-Chat y Century Tech. Por ende, los profesores contemplan el potencial de la Inteligencia Artificial para fortalecer la motivación en el estudiante y asimismo personaliza la pedagogía, conjuntamente, perdura desafíos relacionados con la conectividad, la falta capacitación permanente y la ausencia de políticas institucionales de integración IA. Por ende, representa una oportunidad pedagógica en una sociedad de educación con equidad e innovación proyectada a una visión de crítica, humanizada y ética},
  langid = {spanish}
}

@article{sousa2025modelos,
  title = {Modelos de governação informacional em sistemas de IA generativa: análise crítica comparativa entre ChatGPT e AMÁLIA},
  shorttitle = {Modelos de governação informacional em sistemas de IA generativa},
  author = {Sousa, Nuno Miguel Teixeira},
  date = {2025},
  journaltitle = {Brazilian Journal of Information Science},
  number = {19},
  pages = {22},
  publisher = {Universidade Estadual Paulista},
  issn = {1981-1640},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10361644},
  urldate = {2026-11-13},
  abstract = {Este artigo apresenta uma análise comparativa entre o ChatGPTe o AMÁLIA, destacando como diferentes modelos de IA generativa configuram práticas contrastantes de governação informacional. Através de uma abordagem teórico-empírica, são evidenciadas implicações éticas, jurídicas e sociotécnicas que contribuem para um debate sobre soberania digital e responsabilidade algorítmica em contextos nacionais. Através de uma metodologia qualitativa de base empírica, foram conduzidos testes com ambos os sistemas, permitindo identificar aspetos comparativos: o ChatGPT opera com mecanismos sofisticados de memória, inferência e personalização cumulativa; o AMÁLIA, por sua vez, revela uma estrutura funcional mais restrita, orientada por regras e com menor capacidade de adaptação individualizada. Os resultados mostram que sistemas com maior sofisticação técnica tendem a implicar maiores riscos de opacidade, responsabilidade deslocada e vigilância inferencial, ao passo que soluções mais limitadas garantem maior previsibilidade e contenção no tratamento de dados pessoais. Neste sentido, este estudo contribui de forma para o campo da Ciência da Informação ao propor uma metodologia comparativa entre sistemas de IA generativa com diferentes lógicas de governação informacional, articulando observações empíricas com quadros teóricos robustos. Trata-se de um contributo que oferece uma base crítica e replicável para a análise da personalização algorítmica e das suas implicações ético-jurídicas em contextos nacionais distintos This article presents a comparative analysis between ChatGPT and AMÁLIA, highlighting how different models of generative AI shape contrasting practices of informational governance. Through a theoretical-empirical approach, ethical, legal and socio-technical implications are highlighted that contribute to a debate on digital sovereignty and algorithmic responsibility in national contexts. Using a qualitative, empirically-based methodology, tests were conducted with both systems, allowing comparative aspects to be identified: ChatGPT operates with sophisticated memory, inference and cumulative personalization mechanisms; AMALIA, on the other hand, reveals a more restricted, rule-oriented functional structure with less capacity for individualized adaptation. The results show that systems with greater technical sophistication tend to entail greater risks of opacity, displaced responsibility and inferential surveillance, while more limited solutions guarantee greater predictability and restraint in the processing of personal data. In this sense, this study makes an unprecedented contribution to the field of Information Science by proposing a comparative methodology between generative AI systems with different logics of information governance, articulating empirical observations with robust theoretical frameworks. It is acontribution that offers a critical and replicable basis for the analysis of algorithmic personalization and its ethical and legal implications in different national contexts.},
  langid = {portuguese},
  file = {/home/cuervo/Zotero/storage/6WDZCQ3U/Sousa - 2025 - Modelos de governação informacional em sistemas de IA generativa análise crítica comparativa entre.pdf}
}

