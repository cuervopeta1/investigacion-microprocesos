  shortjournal = {Gaceta UNAM (2000-2009)},
  number = {3929},
  pages = {3},
  url = {https://openalex.org/W2162843959},
  abstract = {ENLAZADA POR VIDEOCONFERENCIA INTERACTIVA, EN LA INAUGURACION DE LA UNIDAD DE DESARROLLO Y USO ESTRATEGICO DE METODOS Y MATERIALES DE ENSENANZA Y APROPIACION TECNOLOGICA (UDEMAT), LUCY MARIA REIDL MARTINEZ, DIRECTORA DE LA FACULTAD DE PSICOLOGIA, AL HABLAR SOBRE EL NUEVO PLAN DE ESTUDIOS DE ESTA FACULTAD, CONSIDERO QUE EL TRABAJO ARDUO QUE REALIZARON POR ANOS LA COMUNIDAD ACADEMICA Y EL CONSEJO TECNICO CULMINO CON LA APROBACION DEL PROGRAMA ANTES DEL PERIODO VACACIONAL. EL PLAN DE ESTUDIOS CONSISTE EN 310 CREDITOS DIVIDIDOS EN ASIGNATURAS TEORICAS Y PR~CTICAS, MISMAS QUE SE SUBDIVIDEN EN CUATRO ~REAS: GENERAL, SUSTANTIVA, TERMINAL Y CONTEXTUAL. TRAS EXPLICAR CADA UNA DE ESTAS ~REAS, INDICO QUE OTRO BENEFICIO ES LA CREACION DE LA UDEMAT, PUES CON ELLA FUE POSIBLE CONECTAR, MEDIANTE C~MARAS DE GESSEL, LOS AUDITORIOS DOCTOR LUIS LARA TAPIA Y DOCTOR SILVIA MACOTELA, LOS LABORATORIOS DE COMPUTO DE POSGRADO Y DE PROCESOS INTERACTIVOS, LA SALA DE JUNTAS DE LA DIRECCION, Y LAS DE USOS MULTIPLES DE LA DIVISION DEL SISTEMA DE UNIVERSIDAD ABIERTA. CON ESTE LOGRO, EXPRESO, LA FACULTAD DE PSICOLOGIA SE COLOCA EN UN LUGAR PRIVILEGIADO, PUES REDUCE LA PRESENCIA FISICA Y TEMPORAL, Y AUMENTA SU CAPACIDAD E INTERCAMBIO ACADEMICO EN LOS ~MBITOS NACIONAL E INTERNACIONAL. LA UDEMAT TENDR~ LAS FUNCIONES DE COORDINAR PROYECTOS Y ACTIVIDADES ORIENTADAS AL DESARROLLO DE METODOS Y MATERIALES DE ENSENANZA POR MEDIO DE LAS TECNOLOGIAS DE INFORMACION Y COMUNICACION, ASI COMO LA PROMOCION DE ESTRATEGIAS DE USO EN ESCENARIOS EDUCATIVOS, DIJO. CONTAR~ CON PLATAFORMAS PARA PUBLICAR ELECTRONICAMENTE CONTENIDOS Y ACTIVIDADES DE ENSENANZA-APRENDIZAJE EN LA WEB, PERMITIR~ LA CONEXION CON SITIOS DONDE SE REALICEN EVENTOS O CLASES, ENLAZADOS DESDE LOS AUDITORIOS O DE LA DIRECCION, Y ASI PODR~N HACERSE PREGUNTAS Y COMENTARIOS. EN UN FUTURO, REVELO, SE PLANEA EXTENDER ESE BENEFICIO A TODAS LAS AULAS, ADEM~S DE INSTALAR UNA PANTALLA DONDE PUEDAN OBSERVARSE EVENTOS REALIZADOS EN UNIVERSIDADES EXTRANJERAS O DEL INTERIOR DEL PAIS.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{contreras2026war,
  title = {War without Accountability. {{AI}} and the Fragmentation of Responsibility in Contemporary Warfare: {{Power}} Infrastructures and Technological Sovereignty},
  shorttitle = {War without Accountability. {{AI}} and the Fragmentation of Responsibility in Contemporary Warfare},
  author = {Contreras, Virginia},
  date = {2026},
  journaltitle = {Cuadernos de RES PUBLICA en derecho y criminología},
  number = {8},
  pages = {10},
  publisher = {Universidad Pablo de Olavide},
  issn = {2990-0697},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10793757},
  urldate = {2026-11-13},
  abstract = {The incorporation of artificial intelligence into security and defense domains has substantially transformed the nature of contemporary warfare, altering not only its operational capabilities but also one of its foundational pillars: the attribution of responsibility. In this new environment, military decisions no longer originate exclusively from clearly identifiable human agents but emerge from complex systems in which algorithms, data, technological infrastructures, state actors, and private companies interact. This article argues that the most profound impact of artificial intelligence in warfare does not lie solely in the automation of processes, but in the progressive fragmentation of responsibility, which complicates the identification of a single accountable subject for decisions and their consequences. In this sense, artificial intelligence does not merely introduce efficiency into military operations but rather produces a structural reconfiguration of responsibility through the fragmentation of the decision-making process, fundamentally altering how decisions and their consequences are attributed in armed conflict. Using an interdisciplinary approach, the article examines transformations in decision-making, the legal and ethical tensions arising from this phenomenon, and the strategic implications of increasing dependence on algorithmic systems. It introduces the notion of the “last human line” as a critical analytical point, representing the increasingly blurred boundary between human decision-making and automation, and highlights the need to rethink normative frameworks for a form of warfare in which responsible actors may be diffuse or virtually absent. ~ La incorporación de la inteligencia artificial en los ámbitos de la seguridad y la defensa ha transformado sustancialmente la naturaleza de la guerra contemporánea, alterando no solo sus capacidades operativas, sino también uno de sus pilares fundamentales: la atribución de responsabilidad. En este nuevo entorno, las decisiones militares ya no se originan exclusivamente en agentes humanos claramente identificables, sino que surgen de sistemas complejos en los que interactúan algoritmos, datos, infraestructuras tecnológicas, actores estatales y empresas privadas. Este artículo sostiene que el impacto más profundo de la inteligencia artificial en la guerra no reside únicamente en la automatización de los procesos, sino en la fragmentación progresiva de la responsabilidad, lo que complica la identificación de un único sujeto responsable de las decisiones y sus consecuencias. En este sentido, la inteligencia artificial no se limita a introducir eficiencia en las operaciones militares, sino que produce una reconfiguración estructural de la responsabilidad a través de la fragmentación del proceso de toma de decisiones, alterando de manera fundamental cómo se atribuyen las decisiones y sus consecuencias en los conflictos armados. Mediante un enfoque interdisciplinario, el artículo examina las transformaciones en la toma de decisiones, las tensiones jurídicas y éticas que surgen de este fenómeno y las implicaciones estratégicas de la creciente dependencia de los sistemas algorítmicos. Introduce la noción de la «última línea humana», como punto analítico fundamental, que representa la frontera cada vez más difusa entre la toma de decisiones humana y la automatización, y destaca la necesidad de replantearse los marcos normativos para una forma de guerra en la que los actores responsables pueden ser difusos o estar prácticamente ausentes. A integração da inteligência artificial nos domínios da segurança e da defesa transformou substancialmente a natureza da guerra contemporânea, alterando não só as suas capacidades operacionais, mas também um dos seus pilares fundamentais: a atribuição de responsabilidade. Neste novo ambiente, as decisões militares já não têm origem exclusivamente em agentes humanos claramente identificáveis, mas emergem de sistemas complexos nos quais interagem algoritmos, dados, infraestruturas tecnológicas, atores estatais e empresas privadas. Este artigo defende que o impacto mais profundo da inteligência artificial na guerra não reside apenas na automatização de processos, mas na fragmentação progressiva da responsabilidade, o que complica a identificação de um único sujeito responsável pelas decisões e pelas suas consequências. Neste sentido, a inteligência artificial não se limita a introduzir eficiência nas operações militares, mas produz antes uma reconfiguração estrutural da responsabilidade através da fragmentação do processo de tomada de decisões, alterando fundamentalmente a forma como as decisões e as suas consequências são atribuídas em conflitos armados. Utilizando uma abordagem interdisciplinar, o artigo examina as transformações na tomada de decisões, as tensões jurídicas e éticas decorrentes deste fenómeno e as implicações estratégicas da crescente dependência de sistemas algorítmicos. Introduz a noção da «última linha humana», como um ponto analítico crucial, representando a fronteira cada vez mais difusa entre a tomada de decisões humana e a automação, e salienta a necessidade de repensar os quadros normativos para uma forma de guerra em que os atores responsáveis podem ser difusos ou praticamente inexistentes. L'integrazione dell'intelligenza artificiale nei settori della sicurezza e della difesa ha trasformato in modo sostanziale la natura della guerra contemporanea, modificando non solo le sue capacità operative, ma anche uno dei suoi pilastri fondamentali: l'attribuzione della responsabilità. In questo nuovo contesto, le decisioni militari non provengono più esclusivamente da agenti umani chiaramente identificabili, ma emergono da sistemi complessi in cui interagiscono algoritmi, dati, infrastrutture tecnologiche, attori statali e aziende private. Questo articolo sostiene che l’impatto più profondo dell’intelligenza artificiale nella guerra non risiede esclusivamente nell’automazione dei processi, ma nella progressiva frammentazione della responsabilità, che complica l’identificazione di un unico soggetto responsabile delle decisioni e delle loro conseguenze. In questo senso, l’intelligenza artificiale non si limita a introdurre efficienza nelle operazioni militari, ma produce piuttosto una riconfigurazione strutturale della responsabilità attraverso la frammentazione del processo decisionale, alterando in modo fondamentale il modo in cui le decisioni e le loro conseguenze vengono attribuite nei conflitti armati. Utilizzando un approccio interdisciplinare, l'articolo esamina le trasformazioni nel processo decisionale, le tensioni giuridiche ed etiche derivanti da questo fenomeno e le implicazioni strategiche della crescente dipendenza dai sistemi algoritmici. Introduce il concetto di “ultima linea umana”, come punto di analisi cruciale, che evidenzia il confine sempre più labile tra il processo decisionale umano e l'automazione, e sottolinea la necessità di ripensare i quadri normativi per una forma di guerra in cui gli attori responsabili possono essere diffusi o praticamente assenti.},
  langid = {english}
}

