  shortjournal = {ScientiaTec},
  volume = {1},
  number = {1},
  doi = {10.35819/scientiatec.v1i1.1420},
  url = {https://openalex.org/W1559627635},
  abstract = {O trabalho é um recorte de uma pesquisa-ação sobre o espaço de aprendizagem digital da matemática aplicado à rede social Facebook, desenvolvido no IFRS – Campus Osório, com os estudantes do segundo ano do Ensino Médio Integrado em Informática. Este tem o objetivo de demonstrar que a rede social Facebook é um espaço de aprendizagem digital, que possibilita por meio das tecnologias digitais online o aprender a aprender matemática por ações cooperativas, segundo os Estudos Sociológicos de Jean Piaget, através de um método colaborativo com a professora de Matemática. Este recorte foi construído pelos estudantes e pela professora de Matemática de forma cooperativa, sempre com a finalidade de demonstrar a importância da apropriação tecnológica digital online na sala de aula como atrativos aos estudantes, e o grande interesse destes em aprenderem Matemática por ações cooperativa.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{alinesimoesaguiar2023inclusao,
  title = {inclusão digital de pessoas com deficiência por intermédio da apropriação tecnológica: um relato de experiência},
  author = {{Aline Simões Aguiar} and {Vanderlei Antônio Stefanuto}},
  date = {2023-04-28},
  journaltitle = {Cadernos do Aplicação},
  shortjournal = {Cadernos do Aplicação},
  volume = {36},
  doi = {10.22456/2595-4377.126076},
  url = {https://openalex.org/W4367307705},
  abstract = {Este artigo versa sobre um relato de experiência docente resultante de um projeto-piloto intitulado “Curso de Informática Básica para Pessoas com Deficiência (PcD)”, com o objetivo de descrever a relevância deste curso para os cursistas, demonstrando os desafios e avanços decorrentes do uso das ferramentas tecnológicas, assim como as conquistas provenientes das relações interpessoais estabelecidas entre alunos aprendizes e alunos monitores. A pesquisa está ancorada na teoria do “computador na educação” de Valente (1991), “educação inclusiva” de Mantoan (2003), “Tecnologias de Informação e Comunicação (TICs)” em Souza, Santos e Schlunzen (2012), entre outros. Adotou-se como metodologia a pesquisa de abordagem qualitativa, descritiva de um relato de experiência. A coleta de dados realizou-se por meio da observação participativa passiva, usando como instrumento para anotações um diário de bordo. Os resultados evidenciaram a necessidade de formação de alunos-monitores, produção e adequação didático-metodológicas e de espaço arquitetônico, bem como o uso de instrumentos específicos, como: apostilas, software e hardware.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{alisonfilgueiras2026memoria,
  title = {Memória, território e inventário colaborativo: Festas populares em Goiás no contexto dos repositórios digitais},
  author = {{Alison Filgueiras} and {Luana Nunes Martins de Lima}},
  date = {2026-07-31},
  journaltitle = {Tendências da Pesquisa Brasileira em Ciência da Informação},
  shortjournal = {Tendências da Pesquisa Brasileira em Ciência da Informação},
  volume = {19},
  number = {1},
  doi = {10.59289/ra2cpj37},
  url = {https://openalex.org/W7204025197},
  abstract = {Este artigo apresenta o aprofundamento da pesquisa sobre a preservação do patrimônio cultural imaterial, articulando os conceitos de memória, território e inventário colaborativo no desenvolvimento de repositórios digitais. O foco reside nas festas populares de Goiás, investigando como o uso de tecnologias da Web Semântica e metodologias participativas pode fortalecer a salvaguarda dessas manifestações. O objetivo é analisar a estruturação do Sistema Guará como um ambiente de curadoria digital que integra informações georreferenciadas e acervos audiovisuais colaborativos. A metodologia, de natureza qualitativa e participante, fundamenta-se na aplicação de micro-ontologias para garantir a interoperabilidade de dados e a representação fidedigna do conhecimento tradicional. Nesta versão ampliada, a análise do corpus documental e a integração com o Google My Maps demonstram que a apropriação tecnológica pelos detentores do saber transforma o repositório em um espaço dinâmico de reafirmação identitária. Os resultados indicam que os repositórios digitais, quando estruturados com participação comunitária e padrões adequados de metadados, constituem instrumentos estratégicos de preservação, difusão e democratização do acesso ao patrimônio cultural. Conclui-se que o modelo colaborativo proposto supera a visão estática dos acervos tradicionais, promovendo uma arquitetura de memória viva e sustentável no ambiente digital.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

