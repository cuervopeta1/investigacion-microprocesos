  doi = {10.54198/ywb0pv18},
  url = {https://openalex.org/W7171142475},
  abstract = {Las tiendas de barrio constituyen una de las principales unidades económicas de abastecimiento local en Colombia. Sin embargo, gran parte de estos establecimientos continúan gestionando sus inventarios mediante procedimientos manuales o registros físicos, lo que dificulta el control de existencias y la toma de decisiones administrativas. El presente artículo describe el proceso de diagnóstico, análisis de requerimientos y diseño de un prototipo web orientado a la gestión de inventarios para tenderos del sector Balmoral del municipio de Fusagasugá. La investigación se desarrolló mediante una metodología participativa basada en el modelo CMA, involucrando a los comerciantes en actividades de socialización, levantamiento de información, interacción tecnológica y validación de necesidades. Los resultados evidenciaron interés por la incorporación de herramientas digitales para el control de inventarios y permitieron identificar requerimientos funcionales y no funcionales para el desarrollo de la solución. Como resultado se diseñó un prototipo funcional adaptado a las condiciones tecnológicas y operativas de los tenderos participantes. Se concluye que la apropiación tecnológica y el desarrollo de herramientas accesibles favorecen el fortalecimiento de los procesos administrativos en pequeños establecimientos comerciales.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{joseagustincastellanosrodriguez2020radio,
  title = {Radio Teocelo como esfera pública alternativa: apropiación tecnológica y movilizaciones sociales},
