@book{martinez2026arquitectura,
  title = {Arquitectura jurídica de los espacios de datos: Análisis normativo, retos y oportunidades en la era digital},
  shorttitle = {Arquitectura jurídica de los espacios de datos},
  author = {Martínez, Belén Andreu and Gutiérrez, Rubén Martínez and Salmerón, Andrés Marín and Gomez, Florencio Navarro},
  date = {2026},
  publisher = {Editorial Comares},
  url = {https://dialnet.unirioja.es/servlet/libro?codigo=1026174},
  urldate = {2026-11-13},
  abstract = {Este libro introduce al lector en una de las transformaciones más decisivas de los próximos años: el desarrollo de los espacios de datos, la gran apuesta europea para una economía digital basada en la confianza, la soberanía tecnológica y el intercambio seguro de información a través de ecosistemas organizativos, jurídicos y tecnológicos. Partiendo de un enfoque institucional y estratégico, la obra explica los marcos normativos que impulsan este nuevo ecosistema -desde la Estrategia Europea de Datos hasta las regulaciones sectoriales más recientes- y muestra cómo los espacios de datos son mucho más que repositorios técnicos: constituyen arquitecturas donde se entrelazan derechos fundamentales, estándares técnicos, incentivos económicos y obligaciones jurídicas. El libro también profundiza en la dimensión tecnológica, desgranando modelos federados, protocolos de intercambio, arquitecturas de referencia e interoperabilidad como condición de posibilidad, siempre conectando la innovación con la necesidad de un marco de confianza, seguridad y control efectivo.   La gobernanza se presenta como elemento central, abordando retos clave como la protección de datos personales, las licencias de uso, los límites del Derecho de la competencia, la distribución de responsabilidades y los riesgos de concentración, exclusión o uso indebido de la información. A modo práctico, se analizan distintos espacios de datos sectoriales -salud, finanzas, sector público, turismo, agricultura, medio ambiente o contratación pública- con especial atención al Espacio Europeo de Datos de Salud, primer ejemplo plenamente regulado a escala europea. El resultado es una obra imprescindible para comprender y participar en la construcción de una economía del dato más eficiente, sostenible y transparente, que no renuncia a la protección de derechos, ni a la innovación responsable. Un libro pensado para profesionales del derecho digital, privacidad, inteligencia artificial y, en general, para cualquiera que quiera anticiparse al futuro del mercado europeo del dato.},
  isbn = {978-84-1369-978-3},
  langid = {spanish}
}

