  url = {https://openalex.org/W7223161146},
  abstract = {La investigación analizó la implementación de un Recurso Educativo Digital, elaborado en Exelearning desde la estrategia de la pedagogía orientada hacia las competencias básicas en Ciencias Naturales con estudiantes de grado noveno de la Institución Educativa San Isidro del municipio de Chochó. La elaboración de esta actividad se desarrolló desde un enfoque mixto sustentado metodológicamente en Investigación Acción Participativa (IAP), permitiendo conocer, intervenir, transformar y comprender prácticas relacionadas con el aprendizaje de las ciencias a partir del uso pedagógico de las TIC. Los resultados evidenciaron una mejora en la motivación académica, la participación, la apropiación tecnológica y la comprensión conceptual.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{josejacintocushicondorpacheco2023entorno,
  title = {Entorno virtual para la enseñanza del pensamiento numérico en la asignatura de la Matemática para los estudiantes del sexto grado de EGB de la Escuela “San Andrés” en el periodo lectivo 2021-2022.},
  author = {{José Jacinto Cushicondor Pacheco}},
  date = {2023-01-01},
  journaltitle = {Repositorio Digital de la Universidad Central del Ecuador},
  url = {https://openalex.org/W7225502044},
  abstract = {En la presente investigación se exponen los significativos beneficios de la inserción técnica- pedagógica de las TIC que en esencia facilita la adquisición de conocimientos y la transferencia de capacidades del pensamiento numérico matemático de manera amigable, empática, cooperativa, colaborativa, interdisciplinaria, dinámica, lúdica y proactiva mediante el Entorno Virtual para el Aprendizaje (EVA) en la plataforma de gestión del aprendizaje Moodle de código abierto, concebida como una herramienta didáctica que facilita el proceso de aprendizaje atrapando la atención de los dicentes. La metodología empleada tuvo un enfoque cuantitativo que ayudo a aumentar la validez y objetividad de la investigación, correlacional de tipo no experimental esto permitiría identificar asociaciones, describir patrones y generar hipótesis que podrían orientar futuras investigaciones en el campo de la enseñanza en entornos virtuales y el pensamiento numérico. La información fue validada mediante la aplicación de un cuestionario de alta confiabilidad. Los resultados obtenidos pusieron de manifiesto que los estudiantes sienten tedio en las clases magistrales de Matemática y que los docentes no utilizan las múltiples info herramientas porque las consideran como poco confiables. Con lo cual, se desperdicia literalmente la posibilidad de desarrollar una adecuada herramienta didáctica que facilite el proceso de enseñanza- aprendizaje. En conclusión, se hace evidente que existe una necesidad de incorporar herramientas tecnológicas en la enseñanza de la matemática y de promover la formación de docentes en el uso de estas herramientas. Los resultados de esta investigación sugieren que la implementación del Entorno Virtual para el Aprendizaje (EVA) en la Aplicación Moodle puede ser una solución efectiva para mejorar la enseñanza y el aprendizaje de la matemática de una manera más atractiva y eficiente para los estudiantes.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{joselinares-morales2021investigacion,
  title = {La investigación y el trabajo editorial en tiempos de pandemia},
  author = {{José Linares-Morales}},
  date = {2021-12-31},
  journaltitle = {IPSA Scientia revista científica multidisciplinaria},
  shortjournal = {IPSA Scientia revista científica multidisciplinaria},
  volume = {6},
  number = {4},
  pages = {8--9},
  doi = {10.25214/27114406.1405},
  url = {https://openalex.org/W4225604038},
  abstract = {Son muchas y muy diversas las enseñanzas que nos ha dejado el convivir con el coronavirus, dados los efectos de la pandemia en nuestro entorno familiar y laboral; los microescenarios en los cuales la adaptación individual se hizo evidentemente necesaria para sortear las circunstancias que determinaron una nueva normalidad, agresivas en principio, y que aparentemente, están cediendo terreno.Desde esta mirada, las personas demostramos nuestra capacidad de resiliencia, nos volcamos a la virtualidad como la alternativa que nos permitió continuar con nuestras vidas como actores sociales, y las herramientas informáticas fueron las mejores aliadas; la transformación digital se convirtió en el camino y la apropiación tecnológica una condición a fortalecer.No es mi propósito en esta editorial, profundizar en el estudio de las implicaciones que conlleva la convergencia de los conceptos antes mencionados; en su lugar, quiero desde la reflexión, destacar el trabajo tanto de los autores como de los revisores, unos trasladando el hacer investigación desde la virtualidad, y otros contribuyendo con una gestión editorial de calidad con vocación por y para la divulgación científica.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{joseluisbuerengomez-acebo2013biblioteca,
  title = {Biblioteca {{Digital}} Del {{Patrimonio Iberoamericano}}: Open Source Technology in the Service of a Major Cooperative Project},
  author = {{José Luis Bueren Gómez-Acebo} and {Elena Sánchez Nogales}},
  date = {2013-01-01},
  url = {https://openalex.org/W1496307687},
  abstract = {The Digital Library of Ibero-American Heritage was presented at the National Library of Spain in September 2012. This new portal provides access to the digital collections of the Ibero-American National Libraries grouped in ABINIA. It currently provides access to the collections of six National Libraries: Brazil, Chile, Colombia, Panama, Portugal and Spain. In the near future new partners are expected to incorporate to the project. The development, after some time of study, has been done under open standards, such as XML, Dublin Core or MARC. The technology of the search engine is the open source Lucene/SOLR and the platform is based on Java and HTML. The portal is already the biggest repository to search Latin-American content and, over time, it could turn into a complementary tool to the most important projects in digital cultural content: Europeana and the Digital Public Library of America. This paper outlines the history of the Project in the context of a growing Ibero-American focus on digital projects and access to cultural heritage, the current situation, the technological architecture and the impact within end users.},
  langid = {english},
  keywords = {inglesa}
}

@article{joseluislopez-gonzalez2013handling,
  title = {Handling of Maize with Formal and Informal Technologies in {{San Nicolas}} de Los {{Ranchos}}, {{Puebla}}, {{Mexico}}},
