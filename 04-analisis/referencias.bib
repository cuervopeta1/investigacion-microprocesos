  doi = {10.56503/cesot/n.17(2025)/3338},
  url = {https://openalex.org/W4412484162},
  abstract = {El artículo analiza el desarrollo de soluciones de gestión empresarial basadas en sistemas de Planificación de Recursos Empresariales (ERP) en dos organizaciones de distinta naturaleza: una cooperativa y una empresa privada convencional. A partir de un enfoque cualitativo, se abordan estudios de caso que combinan entrevistas, observación y análisis documental. El trabajo examina el estado del arte de los ERP, sus desafíos y la influencia del software libre, cuya lógica abierta se vincula con los valores cooperativos, promoviendo prácticas de gestión participativas y transparentes. El marco teórico integra la construcción social de la tecnología y la teoría del actor-red, lo que permite analizar la interacción entre actores humanos y no humanos. Asimismo, se considera la producción de conocimiento y las transformaciones del trabajo en el sector del software desde una perspectiva postindustrial. El estudio compara cómo cada organización configura sus soluciones tecnológicas, articulando principios institucionales, prácticas laborales y modelos de innovación.},
  langid = {spanish},
  keywords = {iberoamericana}
}

