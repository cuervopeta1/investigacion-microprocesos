  pages = {101--112},
  doi = {10.18004/ucsa/2409-8752/2025.012.03.101},
  url = {https://openalex.org/W7132847230},
  abstract = {En el contexto de la transformación digital de la educación superior, este estudio analiza las competencias digitales docentes y las prácticas tutoriales en los Trabajos Finales de Grado (TFG) en carreras de ingeniería de una universidad pública paraguaya. A través de un enfoque cuantitativo, descriptivo y no experimental, se aplicó un cuestionario estructurado a 51 docentes tutores, con el propósito de identificar el nivel de conocimiento sobre plataformas virtuales, la frecuencia de uso de herramientas tecnológicas, la percepción del impacto de las TIC en la calidad tutorial, su influencia en el rezago académico y las principales dificultades en su implementación. Los resultados evidencian que el 82 \% de los tutores posee un conocimiento moderado o alto sobre plataformas digitales, y el 45 \% las utiliza con frecuencia en el acompañamiento académico. Asimismo, el 86 \% considera que las TIC mejoran la calidad de la tutoría, y el 88 \% afirma que contribuyen a reducir el rezago académico. No obstante, se identifican barreras como la falta de capacitación (41 \%), la sobrecarga laboral (25 \%) y la resistencia estudiantil (18 \%), que limitan la apropiación tecnológica plena. El estudio concluye que fortalecer las competencias digitales docentes y mejorar las condiciones institucionales son factores clave para consolidar la transformación digital en la tutoría de TFG. Se recomienda implementar programas de formación continua, políticas de apoyo tecnológico y futuras investigaciones con enfoque cualitativo para profundizar en las experiencias tutoriales. Este trabajo representa un aporte original al abordar empíricamente la dimensión tutorial en carreras técnicas, en un contexto nacional poco explorado.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{lidaximenatabareshiguita2017politicas,
  title = {Políticas públicas en tecnologías de información y comunicación en la alcaldía de Medellín: período 2001-2007},
  author = {{Lida Ximena Tabares Higuita}},
  date = {2017-10-25},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  shortjournal = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  volume = {4},
  number = {7},
  url = {https://openalex.org/W2774525055},
  abstract = {En las últimas décadas el desarrollo tecnológico ha generado constantes e importantes cambios culturales y económicos en el mundo, creando una brecha entre quienes poseen y saben emplear la tecnología y quienes no lo hacen. Esa brecha, conocida como brecha digital, afecta a países, departamentos y ciudades, cuyos gobernantes cada vez son más conscientes de la necesidad de ingresar a la sociedad del conocimiento, y para hacerlo hablan de la urgencia de crear políticas públicas que les ayuden en su propósito. \textbackslash nLos gobernantes de la ciudad de Medellín no han sido ajenos a este llamado, y desde mediados de la década de los 90 comenzaron a realizar esfuerzos para incluir la tecnología en los procesos de ciudad, especialmente desde el área educativa. Este artículo pretende realizar un acercamiento, a través de la sistematización, a las políticas públicas sobre Tecnologías de Información y Comunicación, TIC, desarrolladas por la Alcaldía de Medellín en el periodo 2001-2007, y su influencia en las propuestas de formación en uso y apropiación de TIC para la formación del ciudadano. \textbackslash nLa sistematización sustentada con una amplia indagación documental y entrevistas a los responsables de la creación de los programas sobre TIC en Medellín en el periodo seleccionado, permitió concluir que a pesar de los esfuerzos realizados por las administraciones municipales, Medellín aún no logra tener una política pública sobre TIC. Esto implica que a futuro los ciudadanos no tengan garantizada la continuidad en un proceso de apropiación por parte de las Administraciones Municipales, retrasando así el ingreso de la ciudad a la sociedad del conocimiento. \textbackslash nLo más cercano a un política pública sobre TIC en Medellín es Medellín Digital, una iniciativa interinstitucional liderada por la Administración Municipal que desde 2006 agrupa y coordina todos los procesos de acceso, uso y apropiación tecnológica de la ciudad, pero que no cuenta con una estrategia que le permita permanecer tras un cambio de corriente política en la administración. \textbackslash nDesde el ámbito político pueden hallarse tres explicaciones para que no exista una política pública sobre TIC en Medellín: La falta de interés en las TIC de algunos sectores, los cambios de corriente política en la administración que ha impedido la continuidad de algunas propuestas; y la poca claridad del concepto y la forma de construir políticas públicas que existe en algunos gobernantes.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{lidianepereiradasilva2023olhar,
  title = {O olhar discente sobre as práticas docentes surdas e o uso de ferramentas educacionais digitais},
  author = {{Lidiane Pereira da Silva}},
  date = {2023-10-20},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  url = {https://openalex.org/W7120334891},
  abstract = {The use of digital technologies by individuals promotes sociocultural practices that directly reflect on learning processes. In the academic context, deaf students experience experiences that configure a visual teaching and learning process. Recognizing the need to adopt methodologies that align higher education courses with current technological challenges and that consider the visual aspects of deaf culture, this work aimed to analyze the perception of deaf students in the Licentiate Degree Course in Letters-Libras/Portuguese Language of Federal University of Rio Grande do Norte (UFRN) about the use of digital educational tools in the teaching and learning process. For this, specifically, the objective was: i) to identify the perception of deaf students in training regarding the use of digital educational tools in the teaching and learning process; ii) identify the profile and technological appropriation of deaf students on the Degree Course in Letters-Libras/Portuguese Language at UFRN in training; and iii) diagnose training needs regarding the use of digital educational tools in the teaching practices of deaf academics. This work brings as a theoretical contribution Deaf Studies in education in a critical conception, which highlights the role of sign language in the production of experiences which enable us to (re)think the uses of digital technologies in the training of deaf students. In this way, it is possible to articulate the issues raised by the students themselves, placing them as protagonists of their own training. The research took a qualitative approach with a descriptive-interpretive design and elements of a case study. The participating subjects were five deaf students from the Literature/Libras/Portuguese Language course at UFRN, regularly enrolled in the Supervised Internship in Teacher Training for Elementary Education. Data were collected from a semi-structured interview carried out in Brazilian Sign Language, recorded through video recordings made on the Zoom Meetings digital platform. Data analysis was carried out using the content analysis technique, based on Bardin, organized into three categories of analysis: 1) use of digital educational tools in the classroom; 2): identification of digital educational tools: in the academic lives of deaf students, and 3) types of teaching methodologies applied with digital educational tools by teachers. The results found allow us to highlight important aspects in the pedagogical implications favorable to the use of digital educational tools in the teaching and learning process of deaf students, such as the potential versatility of these resources in pedagogical strategies, especially with written Portuguese. However, it is important to consider that the mere use of these resources, without effective objectivity and criticality, does not imply disruption of methodological practices rooted over time. This requires effort, time and study. And it is in this sense that other research must emerge to encourage new perspectives that contribute to the notability of the subject.},
  langid = {portuguese},
  keywords = {inglesa}
}

@article{lilianadelcarmenvalarezotandazo2026memoria,
  title = {Memoria histórica comunitaria mediante cartografía social digital como estrategia para fortalecer la identidad cultural estudiantil},
  author = {{Liliana Del Carmen Valarezo Tandazo} and {Maria Elizabeth Rodriguez Loor} and {Yuri Mariuxi Cirino Figueroa} and {Mario Jovany Gonzabay Cayetano}},
  date = {2026-08-25},
  journaltitle = {Revista Multidisciplinar de Estudios Generales},
  shortjournal = {Revista Multidisciplinar de Estudios Generales},
  volume = {5},
  number = {3},
  doi = {10.70577/reg.v5i3.864},
  url = {https://openalex.org/W7204712629},
  abstract = {La memoria histórica comunitaria constituye un elemento fundamental para la construcción de la identidad cultural, debido a que permite conservar relatos, tradiciones, experiencias colectivas y conocimientos transmitidos entre generaciones. Sin embargo, los procesos de globalización y transformación social han generado una disminución progresiva del reconocimiento de saberes locales en las nuevas generaciones. En este contexto, la cartografía social digital representa una estrategia pedagógica innovadora que permite recuperar, organizar y representar de manera interactiva la memoria histórica de los territorios, fortaleciendo la participación estudiantil y el vínculo entre escuela y comunidad. El presente artículo analiza la influencia de la cartografía social digital como estrategia educativa para fortalecer la identidad cultural en estudiantes. La investigación se desarrolla bajo un enfoque mixto, considerando dimensiones relacionadas con conocimiento histórico local, sentido de pertenencia, valoración de tradiciones, participación comunitaria y apropiación tecnológica. Los resultados evidencian que la elaboración de mapas digitales comunitarios favorece el reconocimiento del patrimonio cultural, incrementa la participación estudiantil y fortalece la relación entre los aprendizajes escolares y la realidad del territorio. Se concluye que la cartografía social digital constituye una herramienta pedagógica efectiva para recuperar la memoria colectiva, promover la identidad cultural y formar estudiantes conscientes del valor histórico y social de sus comunidades.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{liliansofiaarayaortiz2025estudo,
  title = {Estudo sobre iniciativas locais, narrativas e significados associados à gestão do cuidado comunitário para pessoas idosas dependentes no bairro de Lo Espejo, Santiago do Chile},
  author = {{Lilian Sofia Araya Ortiz}},
  date = {2025-04-24},
  journaltitle = {Digital Library of Theses and Dissertations (Universidade de São Paulo)},
  doi = {10.11606/d.5.2025.tde-06102025-151840},
  url = {https://openalex.org/W4414857488},
  abstract = {O Chile em breve será o país com a maior taxa de pessoas idosas da América Latina. As crescentes necessidades de cuidados recaem, principalmente, sobre as famílias, com precária assistência do Estado e com profunda desigualdade de gênero na distribuição dessa tarefa. Objetivo: caracterizar e analisar as iniciativas locais e ações comunitárias de cuidado às pessoas idosas realizadas por terapeutas ocupacionais e pessoas idosas participantes de organizações sociais do bairro de Lo Espejo em Santiago do Chile. Método: a pesquisa se desenvolve como um estudo de caso exploratório e descritivo com abordagem qualitativa. Resultados: participaram do estudo 6 terapeutas ocupacionais em grupos de discussão e 4 lideranças sociais por meio de entrevistas semiestruturadas. No Capítulo I apresenta-se a análise dos grupos de discussão abrangendo: i) a terapia ocupacional no trabalho interdisciplinar, intersetorial e na construção do vínculo a partir do campo promocional e preventivo, ii) linhas de cuidados da atenção primária e seus desafios na participação significativa em saúde e, iii) os cuidados a partir de uma perspectiva histórica, de gênero e de direitos humanos. No Capítulo II são apresentados achados e discussões a partir dos relatos das lideranças sociais sobre suas histórias pessoais, políticas e comunitárias, com ênfase na participação em espaços de controle social em saúde e na gestão e provisão de cuidados comunitários. Emergirão categorias temáticas como: i) o tecido de bairro e sua comunidade, ii) os cuidados comunitários, suas expressões e o cotidiano do cuidado e, iii) o compromisso com os direitos humanos e a potencialidade da participação. O Capítulo III apresenta a congruência entre ambos os grupos de participantes, considerando a análise de: i) o cuidado, a vulnerabilidade e o exercício de direitos, ii) a organização comunitária, a participação significativa e a promoção de saúde, iii) o cotidiano e o território e, iv) a política pública e a manifestação na vida. Discussão: as participantes coincidem na importância da humanização dos cuidados socioassistenciais e comunitários, entendendo que a construção de vínculos e redes comunitárias a partir da solidariedade é promotora de vida. Evidencia-se que as equipes de saúde mantêm uma aproximação inicial às ações e redes comunitárias de cuidados, e que as organizações sociais são potenciais para fortalecer essas compreensões e alianças para a corresponsabilidade social nos cuidados. Conclusão: o resgate das experiências e perspectivas das participantes fortalece as redes de cuidado e contribui para o desenho de políticas locais baseadas na corresponsabilidade social. É fundamental promover uma participação vinculante e significativa da comunidade, permitindo que suas propostas sejam consideradas na elaboração de políticas públicas pertinentes e situadas. Isso é essencial para avançar rumo a sociedades mais democráticas, nas quais as instituições e as equipes técnicas sejam interpeladas a pensar outras formas de produzir saúde e bem-estar. A defesa da vida digna e dos direitos deve ser o maior compromisso ético, técnico e político na construção de uma sociedade que cuida.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

