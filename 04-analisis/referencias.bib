  date = {2013-12-31},
  journaltitle = {Journal of Agricultural Extension and Rural Development},
  shortjournal = {Journal of Agricultural Extension and Rural Development},
  volume = {5},
  number = {11},
  pages = {285--293},
  doi = {10.5897/jaerd12.138},
  url = {https://openalex.org/W2138842341},
  abstract = {This research evaluated the use of formal and informal technologies used by farmers in the management of maize and the impact it had on yields per hectare. For this purpose, the Formal Technology Appropriation Index (FTAI) and the Degree of Use of Informal Technology (DUIT) were proposed. It was found that, on average, DUIT is greater (61.3) than the FTAI (40.6), indicating that the use of informal technology is more common, but it must be emphasized that it coexists with the formal technology. Informal technology proved to be more efficient to raise the maize yield. Key words: Corn, formal technology, index of modern technology, informal technology, peasant technologies.},
