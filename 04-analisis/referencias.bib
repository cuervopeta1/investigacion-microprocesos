  title = {EL ESPECTRO RADIOELÉCTRICO COMO BIEN COMÚN: UNA REFLEXIÓN EN TORNO A LA COMUNALIDAD Y LAS REDES CELULARES COMUNITARIAS EN OAXACA, MÉXICO},
