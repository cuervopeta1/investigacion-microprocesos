@article{aranda2023barroquizacion,
  title = {La barroquización como táctica de apropiación tecnológica en Latinoamérica},
  author = {Aranda, Leonardo},
  date = {2023},
  journaltitle = {ACTIO Journal of Technology in Design, Film Arts, and Visual Communication},
