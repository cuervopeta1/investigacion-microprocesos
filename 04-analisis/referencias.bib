@article{rosahernandez2016apropiacion,
  title = {Apropiación tecnológica de facilitadores de capacitación a través del empleo de Objetos de Aprendizaje en acceso abierto},
  author = {family=Rosa Hernández, given=Daniela Guadalupe, prefix=de la, useprefix=false and Tamez Herrera, Claudia and Lozano Rodríguez, Armando},
  date = {2016},
  journaltitle = {Revista DIM: Didáctica, Innovación y Multimedia},
  number = {34},
  pages = {13},
  publisher = {Grupo de investigación Didáctica y Multimedia},
  issn = {1699-3748},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=5693471},
  urldate = {2026-11-13},
  abstract = {This paper addresses a research study about the development of technological appropriation by a group of training facilitators after using a Learning Object. Through this study, the developed technological competencies were analyzed by the use of an Open Learning Object to teach Microsoft Excel program and its training in the use of technological tools. The results tell a positive experience with the use of the Learning Object and the development of technological competencies such as to analyze, manage and present the information efficiently. En el presente documento se aborda el estudio sobre la apropiación tecnológica desarrollada por un grupo de facilitadores de capacitación mediante el empleo de un Objeto de Aprendizaje (OA). A través de este estudio se analizaron las competencias tecnológicas desarrolladas a partir del uso del OA abierto para el aprendizaje de operaciones del programa de ofimática de hoja de cálculo, Microsoft Excel, y su empleo en la capacitación del uso de herramientas tecnológicas. Los resultados dan cuenta de una experiencia positiva con el uso del OA así como el desarrollo de competencias tecnológicas como analizar, gestionar y comunicar eficientemente la información.},
  langid = {spanish}
}

@article{rosamargaritamurgascanchano2026apropiacion,
  title = {Apropiación Tecnológica Del Profesorado En Instituciones Educativas Urbanas: Estudio de Caso En El Caribe Colombiano},
  author = {{Rosa Margarita Murgas Canchano} and {Leonar javier Briceño Ariza} and {Carlos Alberto Severiche Sierra} and {Luís Enrique} and {Iris María Cantillo Velásquez} and {Jesus David Iguaran Pinedo}},
  date = {2026-07-15},
  journaltitle = {Sapientiae},
  shortjournal = {Sapientiae},
  volume = {12},
  number = {1},
  pages = {87--98},
  doi = {10.37293/sapientiae121.07},
  url = {https://openalex.org/W7169623642},
  abstract = {This study describes the process of technological appropriation among teachers in educational institutions in the city of Santa Marta, Colombia. Using a predominantly quantitative, descriptive, and cross-sectional approach, a five-point Likert scale questionnaire was administered to a probabilistic sample of 80 teachers, focusing on reliable internet access and the availability of technological infrastructure. The study employed bibliometric methods to identify international trends in technological appropriation. This was done to compare these trends with the urban institutional context of the Colombian Caribbean. The data, processed using frequencies and arithmetic means, reveal a high prevalence of internet access (̄x = 3.83), with half of the teachers reporting being always connected and another third almost never lacking a connection. In contrast, technological infrastructure only reached a moderate prevalence (̄x = 3.08); 38\% of respondents reported almost never having adequate resources. The global average (̄x = 3.46) places technological appropriation in a high range, but the gap between connectivity and material resources reveals heterogeneous adoption. It is concluded that the consolidation of ICT-mediated pedagogical practices will depend on balancing investments in equipment, software, and technical support with ongoing teacher training, so that available access translates into effective digital skills and higher-quality learning.},
  langid = {english},
  keywords = {iberoamericana}
}

@article{rosanamariasantostorresmarcondes2022um,
  title = {Um olhar sobre a apropriação tecnológica dos professores de uma escola da rede particular no contexto do ensino remoto emergencial},
  author = {{Rosana Maria Santos Torres Marcondes} and {Anne Alilma Silva Souza Ferrete} and {Willian Lima Santos} and {Izabel Silva Souza D’Ambrosio} and {Luanne Michella Bispo Nascimento} and {Paula Tauana Santos}},
  date = {2022-05-11},
  journaltitle = {Conjecturas},
  shortjournal = {Conjecturas},
  volume = {22},
  number = {3},
  pages = {865--879},
  doi = {10.53660/conj-935-m07},
  url = {https://openalex.org/W4280544484},
  abstract = {Esta investigação foi desenvolvida segundo os pressupostos da pesquisa qualitativa e do estudo descritivo, mediante o objetivo de perceber a apropriação tecnológica dos professores do 8º ano de uma escola particular de Aracaju-SE, e foi guiada pela pergunta: qual o nível de apropriação tecnológica dos professores ao utilizaram as Tecnologias Digitais de Informação e Comunicação (TDIC) em suas práticas docentes no Ensino Remoto Emergencial? Quanto aos instrumentos para produção dos dados foram adotados a observação da sala de aula no ambiente virtual e a entrevista online. Os resultados desta pesquisa apontam para convergência de atitudes entre os professores participantes, acerca da importância da integração das TDIC no contexto educacional. Por fim, a pesquisa mostrou, segundo as etapas de apropriação tecnológica, que os professores se encontram em diferentes níveis: exposição, adoção, adaptação e apropriação; nas aulas observadas não foram identificadas ações que direcionassem para a etapa de inovação da prática docente.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@incollection{rosanasteinke2026repatriacao,
  title = {A REPATRIAÇÃO DE ARTEFATOS DIGITAIS: O DEBATE ÉTICO SOBRE A POSSE DE GÊMEOS DIGITAIS 3D DE PEÇAS ARQUEOLÓGICAS COLONIAIS POR MUSEUS EUROPEUS},
  booktitle = {Zenodo (CERN European Organization for Nuclear Research)},
  author = {{Rosana Steinke}},
  date = {2026-07-01},
  doi = {10.5281/zenodo.21106267},
  url = {https://openalex.org/W7166832582},
  abstract = {Diante desse quadro, o problema de pesquisa que orienta este capítulo formula-se nos seguintes termos: em que medida a posse e o controle de gêmeos digitais 3D de peças arqueológicas coloniais por museus europeus reproduzem assimetrias coloniais de poder ou podem contribuir para práticas efetivas de repatriação, reparação e justiça patrimonial? O objetivo geral consiste em analisar criticamente o debate ético sobre a posse de gêmeos digitais 3D de peças arqueológicas coloniais mantidas por museus europeus, considerando as tensões entre acesso, propriedade, memória, reparação histórica, soberania digital e direitos culturais das comunidades de origem. Para tanto, os objetivos específicos consistem em discutir a relação entre colonialismo, museus europeus e formação de acervos arqueológicos; examinar o conceito de gêmeo digital 3D aplicado ao patrimônio cultural; problematizar os limites da repatriação digital quando dissociada da restituição material; analisar os dilemas éticos relativos à autoria, propriedade, licenciamento e circulação dos modelos tridimensionais; refletir sobre a participação das comunidades de origem na governança dos acervos digitais; e apontar possibilidades de uma política patrimonial orientada por justiça histórica, consentimento e soberania cultural. Abreu (2023), ao relacionar deslocamento, destruição, transferência de objetos, iconoclastia e repatriação, permite compreender que a circulação forçada dos bens culturais não é episódio encerrado no passado, mas processo que continua produzindo conflitos de memória no presente. Costa et al. (2025), ao analisarem a repatriação do manto Tupinambá, evidenciam que bens culturais indígenas condensam tramas territoriais, cosmológicas e políticas que desafiam a gramática proprietária dos museus, enquanto Garcia et al. (2022), ao discutirem os Mármores do Parthenon, demonstram que conservação e repatriação não são campos opostos, pois a preservação técnica pode compor argumentos em favor da devolução quando articulada à justiça patrimonial. Metodologicamente, o capítulo desenvolve-se como revisão bibliográfica qualitativa, exploratória e crítica, sustentada por estudos de museologia decolonial, patrimônio digital, repatriação cultural, arqueologia pública, ética da informação, propriedade intelectual e direitos culturais, assumindo que a digitalização tridimensional só poderá contribuir para práticas reparadoras quando submetida a consentimento, governança compartilhada, revisão dos metadados coloniais e reconhecimento efetivo da soberania cultural das comunidades de origem.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@thesis{rosariocelayaramirez2009apropiacion,
  title = {La Apropiación Tecnológica en los Profesores que Incorporan Recursos Educativos Abiertos (REA) en Educación Media Superior-Edición Única},
  author = {{Rosario Celaya Ramírez}},
  date = {2009-02-01},
  journaltitle = {Americanae (AECID Library)},
  url = {https://openalex.org/W2268908151},
  abstract = {El objetivo de esta investigación fue analizar los casos de cinco profesores de nivel medio superior que implementaron recursos educativos abiertos (REA), de Knowledge Hub (KHUB), en cursos de diferentes áreas de conocimientos, en una institución educativa del norte de México, con la finalidad de conocer cómo ocurre el proceso de la apropiación tecnológica. Para llegar a la respuesta de la pregunta de investigación se partió de dos constructos: la apropiación tecnológica y los recursos educativos abiertos. La metodología de investigación, que se empleó fue el estudio de caso, bajo el enfoque cualitativo; los instrumentos que se emplearon fueron la entrevista semi estructurada, el cuestionario electrónico y el análisis de documentos. Las entrevistas se aplicaron por vía telefónica, y el cuestionario por mail. Los resultados indican que la asignatura, y el tipo de REA que se adopta influye en la percepción que el docente tiene de la utilidad del recurso educativo abierto. Los profesores, tienen el nivel de conocimiento y aplicación de REA, pues, identifican los recursos por sus características y su empleo: además utilizan esos conocimientos para adoptar esos materiales a sus cursos, sin embargo, no trasladan esos conocimientos a contextos diferentes. Los profesores no modifican o diseñan los recursos, sólo eligen alguno en función de la actividad. Se comprueba, que los profesores emplean los REA del portal, y que, a su vez, estos materiales cumplen con los criterios que se establecen como requisitos para formar parte del reservorio de recursos de KHUB.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{rosariocelayaramirez2010apropiacion,
  title = {Apropiación tecnológica en profesores que incorporan recursos educativos abiertos en educación media superior},
  author = {{Rosario Celaya Ramírez} and {Fernando Lozano Martínez} and {María Soledad}},
  date = {2010-06-01},
  journaltitle = {Revista Mexicana de Investigación Educativa},
  shortjournal = {Revista Mexicana de Investigación Educativa},
  volume = {15},
  number = {45},
  pages = {487--513},
  url = {https://openalex.org/W1899388300},
  abstract = {El artículo presenta una investigación que indagó cómo ocurre la apropiación tecnológica en los profesores que incorporan recursos educativos abiertos (REA) de un repositorio en educación media superior.La metodología fue el estudio de caso; se aplicaron entrevistas semi estructuradas, cuestionarios electrónicos, con el fin de triangular datos, y el análisis de documentos.Los resultados indicaron que en los casos estudiados la asignatura y el tipo de REA que se adoptaron influían en la percepción que el docente tenía de la utilidad del recurso.Los profesores contaban con el nivel de conocimiento y aplicación del recurso, los identificaban por sus características y su empleo y utilizaban esos conocimientos para adoptar los materiales en sus cursos, sin embargo, no los trasladaban a contextos diferentes; los docentes no modificaban o diseñaban los recursos, sólo los elegían en función de la actividad.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{rosariosucapucavisa2022niveles,
  title = {Niveles de apropiación tecnológica y uso de Tablet en la red rural Aricoma de la UGEL Crucero en un escenario sin conectividad, 2022},
  author = {{Rosario Sucapuca Visa}},
  date = {2022-06-30},
  journaltitle = {Horizontes Revista de Investigación en Ciencias de la Educación},
  shortjournal = {Horizontes Revista de Investigación en Ciencias de la Educación},
  volume = {6},
  number = {24},
  pages = {1144--1152},
  doi = {10.33996/revistahorizontes.v6i24.403},
  url = {https://openalex.org/W4289270540},
  abstract = {Es un factor clave el uso de la Tablet en los niveles de apropiación tecnológica. La investigación relacionó las variables de estudio a través de un estudio correlacional. Se usó un cuestionario de 18 preguntas para el uso de la Tablet divido en 6 partes: facilidad de uso percibida, utilidad percibida, presión de la sociedad, conocimiento previo, diseño y usabilidad e intensión de uso. Para el desempeño docente se aplicó un cuestionario de 16 preguntas, dividido en 5 partes: nivel de acceso, nivel de adopción, nivel de adaptación, nivel de apropiación y nivel de invención en una muestra de 139 estudiantes. Se evidenció una asociación significativa entre el uso de la Tablet y la apropiación tecnológica con un valor R de 0.9555. En definitiva, la adopción del uso de la Tablet en los procesos académicos incrementa la apropiación tecnológica y a su vez, la automatización educativa.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{rosasleutenegger2024proceso,
  title = {Proceso de apropiación de tecnologías digitales por comités de agua potable rural en la región de La Araucanía, Chile},
  author = {Rosas Leutenegger, Marco and Vivallo Urra, Óscar Gabriel and Dougnac Quintana, Paulette},
  date = {2024},
  journaltitle = {PAAKAT: rev. tecnol. soc.},
  shortjournal = {PAAKAT: rev. tecnol. soc.},
  volume = {14},
  number = {26},
  issn = {2007-3607},
  doi = {10.32870/pk.a14n26.840},
  url = {http://www.scielo.org.mx/scielo.php?script=sci_arttext&pid=S2007-36072024000100005&lang=pt},
  abstract = {Abstract While the coverage of potable water in rural areas has significantly increased in Chile, challenges persist in ensuring its quality, quantity, and continuity. This has required cooperatives and committees providing this service to engage in projects aimed at improving aspects associated with their management, such as transferring technologies that enable data-driven decision-making. The general objective of this study was to understand the obstacles and facilitators involved in the process of transferring a telemetry system by rural sanitary services, using a conceptual approach composed of three perspectives: sociotechnical systems, technological appropriation, and territorial governance. Information was collected through semi-structured interviews with leaders of rural drinking water committees in the La Araucanía region who have been involved in digital technology projects. The adopted theoretical perspectives, as well as the methodology used in this article, indicate that the appropriation of digital technologies by rural drinking water committees should be understood as a complex, territorial, systemic, multi-agent, and multilevel process.},
  langid = {spanish},
  keywords = {Adoption Model,dispositivos sociotécnicos,gobernanza territorial,Sistema de telemetría,Telemetry System,Territorial Governance}
}

@article{rosasleutenegger2024procesoa,
  title = {Proceso de Apropiación de Tecnologías Digitales por Comités de Agua Potable Rural en la Región de La Araucanía, Chile},
  author = {Rosas Leutenegger, Marco and Vivallo Urra, Oscar Gabriel and Dougnac, Paulette},
  date = {2024},
  journaltitle = {PAAKAT: Revista de Tecnología y Sociedad},
  volume = {14},
  number = {26},
  pages = {1},
  publisher = {Universidad de Guadalajara},
  issn = {2007-3607},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9339359},
  urldate = {2026-11-13},
  abstract = {Si bien Chile ha incrementado considerablemente la cobertura de agua potable en sectores rurales, están pendientes desafíos en materia de garantizar su calidad, cantidad y continuidad. Esto ha exigido a cooperativas y comités que proveen este servicio a involucrarse en proyectos orientados a mejorar aspectos asociados a su gestión como, por ejemplo, transferir tecnologías que permiten contar con datos para la toma de decisiones. El objetivo general es comprender dificultadores y facilitadores involucrados en un proceso de transferencia de un sistema de telemetría por parte de servicios sanitarios rurales o Comités APR. A partir de una aproximación conceptual compuesta por 3 enfoques: sistemas sociotécnicos, apropiación tecnológica y gobernanza territorial. La información se recopiló mediante entrevistas semi-estructuradas a dirigentes de Comités de Agua Potable Rural de la Región de La Araucanía que han trabajado en proyectos de tecnologías digitales.~ Las perspectivas teóricas adoptadas, así como la metodología utilizada en el presente artículo permite indicar que un proceso de apropiación de tecnologías digitales por Comités de Agua Potable Rural, debe ser entendido como un proceso complejo, territorial y sistémico, multi-agente y multi-nivel.},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/XD3EFKVN/Rosas Leutenegger et al. - 2024 - Proceso de Apropiación de Tecnologías Digitales por Comités de Agua Potable Rural en la Región de La.pdf}
}

