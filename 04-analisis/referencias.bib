@thesis{feriabasurto2015proyectos,
  type = {http://purl.org/dc/dcmitype/Text},
  title = {Los proyectos de investigación aplicada sobre tecnologías de información y la gestión de conocimiento en el ámbito de las bibliotecas universitarias: proyección del Modelo Colima},
  shorttitle = {Los proyectos de investigación aplicada sobre tecnologías de información y la gestión de conocimiento en el ámbito de las bibliotecas universitarias},
  author = {Feria Basurto, Lourdes},
  date = {2015},
  institution = {Universidad Complutense de Madrid},
  url = {https://dialnet.unirioja.es/servlet/tesis?codigo=129129},
  urldate = {2026-11-13},
  abstract = {La investigación aporta elementos para el fortalecimiento de la función educadora de la biblioteca universitaria en un mundo interconectado, caracterizado por la abundancia de información y por las facilidades de acceso a la misma, en donde se hacen necesarias las capacidades de innovación y cambio. Se hace una revisión del estado del arte en bibliotecología, tecnología, gestión de conocimiento y educación superior para proceder a abordar un estudio de caso en el que se examina el modelo de buenas prácticas del grupo bibliotecario de una universidad mexicana, la Universidad de Colima, quienes durante 28 años (1983-2011) generaron productos, servicios y metodologías de trascendencia internacional que fueron reconocidos por organismos como la Unesco, OEA y Naciones Unidas. Con base en las estrategias y estructuras de dicho modelo fue posible identificar sus variables de impacto afirmativo y articular una propuesta actualizada, tanto en su marco teórico como en su praxis, con miras a potenciar sus beneficios a otras bibliotecas. Para ello estudian los 25 proyectos de investigación aplicada que más renombre le dieron a Colima en Latinoamérica. La revisión del estado del arte consideró los temas de educación superior y calidad educativa en un entorno de transformación tecnológica permanente, analizando la responsabilidad de la biblioteca universitaria como instancia gestora de conocimiento. Para ello se revisaron estudios recientes que plantean cómo el rol de la universidad ha transitado de ser únicamente transmisora de información, Universidad Modo 1, a ser generadora de saberes y agente activo en el desarrollo de las sociedades como Universidad Modo 2 que requiere bibliotecas Modo 2. Esta es la base en que se sustenta el nuevo modelo que propone esta tesis, estructurado en cuatro dimensiones (tecnología hecha, tecnología hablada, liderazgo/identidad y fortalezas bibliotecológicas) y 64 aptitudes y habilidades, orientado a mejores prácticas para un contexto global caracterizado por lo digital. El aparato crítico que sustenta este trabajo revisa, entre otras fuentes, las conferencias mundiales de la UNESCO para la educación superior y las megatendencias de P. Cazalis; las propuestas de Giddens, Didrikson y Tunnerman y las estadísticas que aportan la Organización de las Naciones Unidas, Banco Mundial y otros centros de investigación. La plataforma ética se sustenta en el pensamiento del Pablo Latapí; en tecnología se examinan estudios de la IFLA, la ACRL y la OCLC, entre otros. Para analizar los conceptos de identidad se revisa a Ortega y Gasset, López Yepes, Bustos, Alfaro y Rendón. En el tema de investigación aplicada se ha bebido de fuentes como Lynn L. Connaway, J.Galindo, J.González, S. Ferreiro y el Manual de Oslo de la OECD. Para los temas de entorno y cultura tecnológica se retoma a Castells, Toffler y las conclusiones de las conferencias mundiales para la sociedad de la información. Las consideraciones con relación a la generación digital son abordadas a partir de los análisis de Turnbull y Prensky. El tema de apropiación tecnológica monitorea a The Economist Intelligence Unit y la Unión Internacional de Telecomunicaciones. La gestión de conocimiento se analizó a partir de P. Drucker, K. Dalkir; J. Baiget, J. Martínez y Á. Quijano. Se realizó revisión archivística, hemerográfica y se estudió a profundidad el trabajo antropológico de T. Márquez, así como a los análisis de L. Feria para el seguimiento a la historia del caso Colima. Como referentes de apoyo para el trazado del nuevo modelo destacan el estudio de J. Amante y otros y los hallazgos de dos consultorías externas, una de ellas contratada por la Fundación Bill \& Mellinda Gates en el tema de liderazgo bibliotecológico.},
  langid = {spanish}
}

