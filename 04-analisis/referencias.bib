@thesis{julianfleischmann2026integrating,
  title = {Integrating Water, Energy, Food, and Ecosystems: Open and Transferable Methods for Planning Sustainable Infrastructure at the Local Scale},
  author = {{Julian Fleischmann}},
  date = {2026-01-01},
  journaltitle = {FreiDok plus (Universitätsbibliothek Freiburg)},
  doi = {10.6094/unifr/288541},
  url = {https://openalex.org/W7222970614},
  abstract = {Preserving the Earth’s vital life-support systems, such as climate, water, soils, and biodiversity, while meeting the basic needs of a growing population, is a key global challenge. In the current era of global instability, this endeavor has become even more difficult, as geopolitical tensions and armed conflicts undermine international collective action to protect ecosystems and the climate. Within this context, local and integrated approaches to water, energy, food, and ecosystems remain vital for delivering sustainable infrastructure solutions, and, when scaled, can address global challenges. Despite its potential, integrated water-energy-food-environment (WEFE) planning for sustainable basic services is rarely implemented due to a lack of accessible and reusable methods and tools to support it. The doctoral project addresses this gap through an integrated approach to water, energy, food, and ecosystems, aiming to advance early-stage planning methods for integrated WEFE systems at the local scale. To achieve this objective, the doctoral project follows a mixed-methods approach that combines quantitative, qualitative, and computational methods and applies them to local real-world case studies in Costa Rica, Colombia, Namibia, South Africa, Uganda, Morocco, Lebanon, and Germany. To ease the early-stage planning of integrated WEFE systems, the following methodological approaches have been developed: • Qualitative analysis of integrated WEFE systems, including their components, energy and material flows, and interactions • Generic framework for modeling diverse integrated WEFE system (OWEFE) • Set of methods for digital data collection and analysis capable of providing site-specific environmental data by entering coordinates and demand data through digital surveys • Survey-based design and multi-objective optimization (MOO) for integrated WEFE systems OWEFE is applied to model an agrivoltaics system in Germany and a wastewater biogas system in Lebanon. Results show that the generic framework enables realistic modeling of two highly distinct integrated WEFE systems and their comparison regarding key performance indicators (KPIs). This facilitates decision-making among many design options. Moreover, the research leverages the potential of open earth data, making site-specific data required for the planning of integrated WEFE systems in the initial planning phase available for any terrestrial location. Additionally, the doctoral project shows that site-tailored configuration using MOO yields plausible results and can be advantageous in comparison to widely used mini-grid design software (HOMER PRO). To enhance accessibility, reusability, and the impact of research, the proposed methodological approaches are made available in accordance with open science principles. In addition to publishing open-access scientific articles, the planning methods are made available as open-source repositories and jointly through the WEFEPlan web app. This will allow potential end-users from research, academia, communities, and grassroots movements to plan and design integrated WEFE systems and support their scale-up to provide sustainable basic services at the local level while contributing to the global challenge of climate and ecosystem protection.},
  langid = {english},
  keywords = {inglesa}
}

@article{julicesalvagni2024contrate,
  title = {Contrate quem luta: movimento dos trabalhadores sem-teto, tecnologias e economia digital solidária},
  author = {{Julice Salvagni} and {Rafael Grohmann} and {Victória Mendonça da Silva}},
  date = {2024-11-04},
  journaltitle = {Sociedade e Estado},
  shortjournal = {Sociedade e Estado},
  volume = {39},
  number = {3},
  doi = {10.1590/s0102-6992-20243903e50567},
  url = {https://openalex.org/W4404044804},
  abstract = {Resumo Este artigo tem o objetivo de analisar elementos de organização da iniciativa Contrate Quem Luta, do Movimento dos Trabalhadores Sem-Teto (MTST), enquanto experiência de tecnologia e trabalho em contexto de economia digital solidária. A partir de entrevistas com trabalhadores do projeto, reflete-se sobre a organização do trabalho e a perspectiva da economia digital solidária; a práxis do movimento social; e a organização da política de base. O MTST se organiza a partir do território, que precede a construção de tecnologias, e da práxis, articulada à construção de conceitos como o de soberania digital popular. Diante disso, pode-se argumentar que o Contrate Quem Luta tem a vantagem do estofo institucional do movimento social para se estabelecer, o que possibilita um fortalecimento da luta e da organização. Os trabalhadores não são apenas prestadores de serviço, eles auxiliam, também, na circulação das palavras e das lutas dos sem-teto.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{julioabelcalderoncockburn2023presentacion,
  title = {Presentación},
  author = {{Julio Abel Calderón Cockburn} and {Manuel Jerjes Loayza Javier}},
  date = {2023-12-21},
  journaltitle = {Revista de Sociología},
  shortjournal = {Revista de Sociología},
  number = {37},
  pages = {5--7},
  doi = {10.15381/rsoc.n37.27156},
  url = {https://openalex.org/W4391113794},
  abstract = {l número 37 de la Revista de Sociología se publica en un periodo de agudización de la crisis económica y política en Perú en el año 2023, la ausencia de gobernabilidad y severos cuestionamientos a la propia vigencia de un régimen democrático representativo, debido a la convivencia de diversos poderes del Estado en función de intereses propios y no de la colectividad.Al incremento de los indicadores de pobreza, efecto de la post pandemia Covid-19, se suma el ingreso del país a un periodo de recesión económica, conflictos entre los poderes del Estado, incluyendo ahora al Poder Judicial, y mayor inseguridad ciudadana, sin que se pueda prever una solución política a la crisis.El ejemplar que presentamos, representa un esfuerzo de sus autores por compartir investigaciones aplicadas a realidades muy diversificadas.Así, el primer artículo de Matías Federico Boglione, perteneciente al Centro de Estudios Avanzados de la Universidad Nacional de Córdoba en Argentina, propone el artículo "Hacia una epistemología exploratoria para el ejercicio de ciudadanía digital: elementos para su construcción" en donde se discute en torno a la tecnología, la cual se ha vuelto transversal a la vida de las personas, configurando verdaderos "ecosistemas comunicativos", nuevos espacios de lucha y resistencia cultural.Boglione se acerca a las problemáticas de la apropiación tecnológica y a las prácticas de activismo mediático como formas de resistencia; a fin de presentar un repertorio de herramientas epistemológicas que contribuyan a describir y comprender acciones y experiencias del ejercicio ciudadano en entornos digitales.Por su parte la socióloga Cristy Ballesteros, académica de la Universidad Nacional Mayor de San Marcos, comparte su investigación "De Madrid a Lima.Narrativas identitarias de mujeres que regresan a sus entornos comunitarios de origen", en donde se analiza la construcción identitaria de las migrantes de nacionalidad peruana que regresan a sus entornos comunitarios de origen.La autora se detiene en narrativas construidas e interpretadas, en el marco de sus experiencias durante el proceso de regreso y de reinserción a sus transformados espacios y contextos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{julioandresherreranunez2026competencias,
  title = {Competencias {{Directivas}} y {{Herramientas Digitales}} En La {{Gestión}} Del {{Cambio}}: {{Estudio Mixto}} En Una {{Empresa Agroindustrial Colombiana}}},
  author = {{Julio Andrés Herrera Nuñez} and {Viviana Martina Alfonso Godoy}},
  date = {2026-10-02},
  journaltitle = {Ibero Ciencias - Revista Científica y Académica},
  shortjournal = {Ibero Ciencias - Revista Científica y Académica},
  volume = {5},
  number = {3},
  pages = {3819--3840},
  doi = {10.63371/ic.v5.n3.a1668},
  url = {https://openalex.org/W7215930352},
  abstract = {This study characterized the managerial competencies and digital tools associated with change management and innovation in an agro-industrial company located in the municipality of Puerto Gaitán (Meta, Colombia), and analyzed their relationship with the perceived organizational impact of change. The research followed a mixed-methods approach with a descriptive-correlational scope, based on 98 self-administered questionnaires answered by employees and contractors and ten semi-structured interviews with staff holding managerial, technical, and administrative roles. Quantitative data were analyzed using descriptive statistics and non-parametric tests (chi-square, Cramér's V, Spearman's rho, Mann-Whitney U, and Kruskal-Wallis), while qualitative information was processed through content analysis with categories derived from the research objectives. Results showed a predominantly intermediate assessment of change processes, with higher favorability in change leadership (48.0 \%) and managerial innovation (47.9 \%) than in change management (44.4 \%). Statistically significant associations were found between the existence of a defined change management pathway and the use of digital tools, between that pathway and frequent impact evaluation, and between digital tool use and the perception of a positive impact on performance, the latter showing the largest magnitude. The qualitative analysis revealed socio-emotional and strategic-technical competencies, a heterogeneous digital ecosystem, and two dominant barriers: resistance to change and training gaps. It was concluded that technological appropriation and process formalization were accompanied by more favorable assessments of organizational change.},
  langid = {english},
  keywords = {inglesa}
}

@article{juliocesarpedroso2013pontos,
  title = {Pontos de Cultura enquanto movimento social: uma pesquisa netnográfica},
  author = {{Julio Cesar Pedroso} and {Carlos José Martins}},
  date = {2013-12-21},
  journaltitle = {E-Compós},
  shortjournal = {E-Compós},
  volume = {16},
  number = {2},
  doi = {10.30962/ec.926},
  url = {https://openalex.org/W2795799733},
  abstract = {Tomando como ponto de partida a formação de uma rede de pontos de cultura enquanto política pública, este artigo visa investigar sua possível configuração como um movimento social. Para tanto, foi realizada uma pesquisa bibliográfica sobre teorias clássicas e contemporâneas dos movimentos sociais, de modo a tratar de forma adequada a inserção dessa problemática na especificidade do campo investigado. Ademais, foi feita uma netnografia através da inserção do pesquisador em uma lista de e-mails representativa da qual participam diversos atores culturais ligados a pontos de cultura do Estado de São Paulo. Além dessa lista foram analisados espaços presenciais de participação, formação de grupos e entrevistas com articuladores da rede. A partir das análises realizadas, pôde-se concluir que a rede dos pontos de cultura comporta um potencial significativo de catalisação de movimentos sociais em fase de expansão. Nesse processo, a cultura digital e o software livre possuem um papel de destaque. Palavras-chave Movimento social. Pontos de Cultura. Netnografia.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{julioernestorubiobarrios2026apropiacion,
  title = {Apropiación tecnológica docente de la inteligencia artificial generativa en la universidad},
  author = {{Julio Ernesto Rubio Barrios} and {Miriam Alicia Gleason Rodríguez}},
  date = {2026-05-14},
  journaltitle = {Educación y Educadores},
  shortjournal = {Educación y Educadores},
  volume = {28},
  number = {3},
  pages = {1--1},
  doi = {10.5294/edu.2025.28.3.3},
  url = {https://openalex.org/W7161174046},
  abstract = {El profesorado desempeña un papel clave en la incorporación de la inteligencia artificial generativa (IAGen) en la educación, proceso que supone, más allá de la adopción instrumental, una apropiación tecnológica situada. Este estudio ofrece un primer acercamiento exploratorio a la apropiación docente de la IAGen mediante un diseño de métodos mixtos con énfasis cualitativo, a partir de un estudio de caso en una universidad privada en México. Para la recolección de datos se integraron una encuesta estructurada, grupos de enfoque intercampus y entrevistas semiestructuradas. El análisis se organizó con base en el Technological Acceptance Model (TAM) y el marco de competencias docentes en IA de la Unesco. Los hallazgos muestran que la utilidad percibida es un motor central para la incorporación de la IAGen y que su uso se concentra en tareas pedagógicas específicas, mientras persisten desafíos relevantes: alucinaciones y sesgos, brechas de capacitación, barreras de acceso, heterogeneidad en la recepción estudiantil e implicaciones para la integridad académica. Particularmente, la evidencia sugiere un nivel inicial de apropiación en la mayoría de los casos y subraya la necesidad de formación docente colaborativa, lineamientos éticos y condiciones institucionales que favorezcan una integración más estratégica y significativa de la IAGen en la educación superior.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{juliopinto2020alison,
  title = {Alison {{J}}. {{Bruey}}. {{Bread}}, {{Justice}}, and {{Liberty}}: {{Grassroots Activism}} and {{Human Rights}} in {{Pinochet}}’s {{Chile}}.},
  author = {{Julio Pinto}},
  date = {2020-02-25},
  journaltitle = {The American Historical Review},
  shortjournal = {The American Historical Review},
  volume = {125},
  number = {2},
  pages = {701--702},
  doi = {10.1093/ahr/rhaa173},
  url = {https://openalex.org/W3016306676},
  abstract = {Is there anything left to say about the Pinochet dictatorship? As a matter of fact, there is, as Bread, Justice, and Liberty: Grassroots Activism and Human Rights in Pinochet’s Chile bears ample proof. Focusing on grassroots activism in two Santiago shantytowns (poblaciones), Alison J. Bruey weaves an empirically rich, analytically nuanced, and deeply sympathetic account of the ways in which some of Chile’s poorest citizens coped with the destruction of their lives and dreams, engineered by the executors of the 1973 coup d’état. As the author vividly shows, this onslaught was simultaneously social and political, a literally deadly combination between repression of dissident views (those of the followers of the Salvador Allende–led experiment on democratic socialism) and withdrawal of long-established social guarantees. Responses were similarly composite, ranging from initial shock and bare struggle for survival to growing defiance, as community networks were rebuilt from the ground and local organizations began to contest the regime’s stranglehold in ever-widening circles, centered on the (for Chile) fairly novel paradigm of human-rights defense. The outcomes of this process were the massive protests that rocked the military government between 1983 and 1986, and that forced transition to democracy in 1988–1990. This, however, was accomplished on terms ultimately favorable to Pinochet’s socioeconomic legacy, to the predictable disappointment of those who bore the brunt of the seventeen-year struggle recounted in the book.},
  langid = {english},
  keywords = {inglesa}
}

