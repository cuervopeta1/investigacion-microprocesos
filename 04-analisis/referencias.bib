ght in defense for a larger technoscientific inclusion, describing its cooperative form of work and the decentralized and non-hierarchical structure of principles as innovative elements and promoters of larger social participation and promotors of the counter-hegemonic fight. Keywords Cyber inclusion. Digital divide. Transnational social movements. Information society. Free software.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{adapeter2026digital,
  title = {Digital Soil Sovereignty: A Comparative Analysis of State Cyber Postures Using the {{CISI}} Framework},
  author = {{Ada Peter} and {Obianuju Udenenwu}},
