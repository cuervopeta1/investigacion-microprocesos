  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10793865},
  urldate = {2026-11-13},
  abstract = {El presente estudio analiza la crisis de seguridad que atraviesa la infraestructura crítica submarina en el actual escenario de zona gris, caracterizado por una creciente obsolescencia de los marcos jurídicos tradicionales frente a las amenazas híbridas. Partiendo de las evaluaciones de riesgo más recientes, se examina la insuficiencia de la Convención de las Naciones Unidas sobre el Derecho del Mar (CNUDM) y el manifiesto vacío de aplicación (enforcement gap) ante el sabotaje intencional, ejemplificado en la operatividad de la denominada flota en la sombra (shadow fleet) y en incidentes como los de los buques Yi Peng 3, Eagle S y Fitburg. En este escenario de inestabilidad en la navegación internacional, con especial incidencia en estrechos internacionales estratégicos, y agravado por las decisiones extraordinarias de la Organización Marítima Internacional (OMI) de marzo de 2026, el núcleo del artículo disecciona la iniciativa legislativa de EE. UU. (el proyecto de ley Strategic Subsea Cables Act de 2026) como una manifestación de jurisdicción prescriptiva extraterritorial (extraterritorial prescriptive jurisdiction) sustentada en el derecho emergente a proteger los usos legítimos del océano. A través de un diálogo doctrinal que integra la teoría de la presencia constructiva y el deber de diligencia debida, se propone una interpretación evolutiva de la jurisdicción de ejecución en la zona económica exclusiva (ZEE) que supere el colapso de la jurisdicción exclusiva del Estado del pabellón y la erosión de la neutralidad marítima. Asimismo, se evalúa si el ejercicio de las medidas coercitivas propuestas en dicho texto desafía el umbral del uso de la fuerza, abogando por una relectura de la soberanía digital apoyada en la protección del medio marino. En conclusión, la seguridad de la red global, por donde transita el 99\% del tráfico digital, exige una custodia colectiva que supere el vacío de aplicación mediante una armonización de los derechos de navegación con las imperativas obligaciones de seguridad nacional y resiliencia estratégica},
  langid = {spanish},
  file = {/home/cuervo/Zotero/storage/D93YWJGM/Arjona Hernández - 2026 - Infraestructura crítica submarina en la zona gris el giro unilateral y la jurisdicción extraterrit.pdf}
}

@article{arnoldolizarragajuarez2020apropiacion,
  title = {Apropiación tecnológica en el manejo de competencias digitales por los profesores de escuelas normales en México},
  author = {{Arnoldo Lizárraga Juárez} and {Evangelina López Ramírez} and {Jorge Eduardo Martínez Íñiguez}},
  date = {2020-06-01},
  journaltitle = {Revista Boletín Redipe},
  shortjournal = {Revista Boletín Redipe},
  volume = {9},
  number = {6},
  pages = {157--167},
  doi = {10.36260/rbr.v9i6.1009},
  url = {https://openalex.org/W3036995028},
  abstract = {El propósito de este documento es referir los resultados del estudio realizado con profesores de Escuelas Normales (formadoras de docentes) de México relativo a los niveles de apropiación que estos manejan sobre las Tecnologías de la información y la comunicación como apoyo a su práctica docente. Las evidencias establecen que este nivel fue bajo, lo que indica una limitada capacidad para diseñar e implementar escenarios educativos apoyados en las tecnologías cuestión que restringe la participación activa del alumno, su comprensión profunda de los contenidos de aprendizaje, ni su actividad constructiva. Esta condición representa un espacio de oportunidad significativo para el futuro próximo ya que estos recursos se vuelven cada vez más indispensables en el quehacer educativo.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{aroljosuerojas2022analisis,
  title = {Análisis Espacial de la Minería y su conflictividad territorial en la Amazonía Suroccidental. Acre, Brasil},
  author = {{Arol Josue Rojas}},
  date = {2022-06-30},
  journaltitle = {SENDAS},
  shortjournal = {SENDAS},
  volume = {3},
  number = {2},
  pages = {28--45},
  doi = {10.47192/rcs.v3i2.84},
  url = {https://openalex.org/W4368283009},
  abstract = {La Amazonía Suroccidental cubre un vasto territorio que en su mayoría se encuentra bajo diferentes marcos legales de protección. Y se erige como una inmensa frontera en cuanto a la presencia de recursos minerales. La presente investigación tiene como objetivo conocer la situación actual de la minería en la Amazonía suroccidental en el estado de Acre, así como de la presencia de conflictos territoriales de dicha actividad en Unidades de Conservación y de territorios indígenas. Para dar cumplimiento a estos objetivos se utilizaron medios de Sistemas de Información Geográfica como el Software Libre Quantum GIS, Versión 3.12.1 (Bucureşti), para generar los diferentes mapas de trabajo. Los resultados demostraron la existencia de conflictos territoriales de la minería en cinco unidades de conservación y en un territorio indígena. Al considerar la importancia del estudio y el reconocimiento de conflictos territoriales, estos pueden devenir en futuros conflictos sociales y ambientales de mayor envergadura en esos territorios, tanto a nivel local como regional.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{arratiamendoza2024influencia,
  title = {La influencia de las recomendaciones en las redes sociales sobre la intención de compra. Un estudio comparativo en la generación millenial y centennial.},
  author = {Arratia Mendoza, Mónica Lizzeth and Sánchez Tovar, Yesenia and Mendoza Flores, José Esteban},
  date = {2024},
  journaltitle = {PAAKAT: Revista de Tecnología y Sociedad},
  volume = {14},
  number = {26},
  pages = {5},
  publisher = {Universidad de Guadalajara},
  issn = {2007-3607},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=9339363},
  urldate = {2026-11-13},
  abstract = {Las redes sociales se han convertido en espacios virtuales que facilitan la interacción entre individuos y permiten compartir información de índole personal y profesional. Las empresas identificaron dicha posición y se apresuraron para captar clientes, por lo que, para posicionar sus productos y/o servicios fueron dejando las acciones de comunicación tradicional y desarrollaron estrategias digitales, de manera que fueron construyendo vínculos más cercanos con los usuarios. El objetivo de la investigación es analizar si las recomendaciones en las redes sociales influyen sobre la intención de compra de las generaciones Y y Z, considerando dos tipos de recomendaciones, las reseñas en línea y las realizadas por los líderes de opinión, además de determinar el efecto del electronic Word of Mouth influye en la intención de compra. La metodología empleada fue con un enfoque cuantitativo y de alcance causal, se analizó una muestra de 388 participantes, los cuales se encuentran entre los 25–39 años (generación Y) y los 15–24 años (generación Z). Los resultados mostraron que la intención de compra de la generación Y o millennials se ve influenciada por el eWOM, las reseñas en línea y por los líderes de opinión; de manera similar los resultados indican que la intención de compra de la generación Z o centennials se ve influenciada por el eWOM y los líderes de opinión, sin embargo, en el caso de este grupo, las reseñas en línea no tienen impacto.},
  langid = {spanish}
}

