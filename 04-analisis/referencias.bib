@article{andresa.galindomontero2021dinamica,
  title = {Dinámica comunitaria en una zona marginal indígena del norte de Colombia frente al cambio climático},
  author = {{Andrés A. Galindo Montero} and {Yolmis Nicolás Rojano Alvarado} and {Luisa Valentina Fuentes-Gómez}},
  date = {2021-07-01},
  journaltitle = {Mundo FESC},
  shortjournal = {Mundo FESC},
  volume = {11},
  number = {S1},
  pages = {38--42},
  doi = {10.61799/2216-0388.883},
  url = {https://openalex.org/W4400236973},
  abstract = {El presente artículo aborda los resultados en las dinámicas comunitarias dadas en el proyecto “Abastecimiento de agua a través del bombeo solar” el cual fue desarrollado por la Universidad de La Guajira y financiado por Colciencias mediante ideas para el cambio-soluciones en agua y pobreza en la convocatoria 574 de 2012, este buscaba mejorar la calidad de vida de las comunidades indígenas de Colombia, desarrollando aspectos socioambientales, comunitarios, agropecuarios e hídricos, en donde fue instalado un sistema fotovoltaico, para el funcionamiento de un modelo hibrido de bombeo solar y molino de viento, construcción de una parcela demostrativa para evaluar distintas técnicas de riego e incentivar subsistencia alimentaria. En el marco del proyecto se reconoció la falta de educación y/o capacitación en el tema y por tanto se dio la necesidad de incentivar trasformaciones en el comportamiento y hábitos para hacer frente al cambio climático, especialmente en una región tan vulnerable por múltiples factores como es la zona norte de Colombia. La metodología que se abordó fue de investigación acción mediante la aplicación de instrumentos y formaciones comunitarias. Los resultados ratifican las bondades que hay en la zona para el aprovechamiento de la energía solar, la siembra en pequeñas parcelas que mejoran la seguridad alimentaria la existencia de voluntad y esfuerzo de los indígenas para lograr la apropiación social de la tecnología para el manejo y uso adecuado del agua en las actividades cotidianas, con visión de sustentabilidad.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@thesis{andreseduardoquinterobuitrago2012implementacion,
  title = {implementación de Nagios como modelo de prueba para el monitoreo de la infraestructura de la Red activa en la Universidad Cooperativa de Colombia Sede Bogotá},
  author = {{Andrés Eduardo Quintero Buitrago}},
  date = {2012-09-28},
  journaltitle = {Repositorio Institucional Universidad Cooperativa de Colombia},
  url = {https://openalex.org/W7215001215},
  abstract = {El monitorear las plataformas Tecnológicas donde se soporta el funcionamiento de las TIC a tomado gran importancia para verificar en tiempo real y de forma constante el estado de la infraestructura administrada. Con el auge del Software Libre existen herramientas que pueden desarrollar esta labor como lo es Nagios, sin incurrir en costos de licenciamiento que en definitiva influye en las decisiones tomadas por los administradores de TIC para su uso. Es por esto que se planteó realizar pruebas de monitoreo de la Infraestructura de la Red Activa de la UCC sede Bogotá, ya que no cuentan con una herramienta para este fin. El área de Sistemas de la UCC sede Bogotá proporcionó los recursos necesarios para desarrollar este proyecto, se llevó una bitácora de las actividades desarrolladas a diario, además de acordar entre el proponente y el área de sistemas la confidencialidad de la información proporcionada. Inicialmente se planteó monitorear máquinas Windows, Linux, Routers y Switches, pero la plataforma casi en un 100\% esta soportada en Windows así que se incluyo el monitoreo de Impresoras que también es posible con Nagios. Se deseaba monitorear máquinas que fueran de pruebas, pero toda la plataforma era de producción, se autorizó por parte de la Directora de TI Ing. Ivonne Duran, realizar pruebas sobre algunas de estas máquinas. Se presentaron dificultades en la puesta en marcha de las notificaciones vía email y Sms debido a que los puertos son restringidos, se solicitó a la Directora de TI habilitar el puerto 587 para este fin, también se presentaron dificultades en el monitoreo de Routers y Switches capa 3 ya que requieren de que tengan activado el agente Snmp para que puedan ser monitoreados de forma optima. Después de tener en funcionamiento la Aplicación Nagios3 basados en Linux Ubuntu 11.04 de forma virtual usando Vmvare7, se evaluó el funcionamiento por parte de TI de Bogotá, dando sus apreciaciones sobre el funcionamiento y dando visto bueno para su uso en TI de la UCC sede Bogotá, destacando sus ventajas y beneficios que trae esta herramienta para el desarrollo de sus actividades diarias.},
  langid = {spanish},
  keywords = {iberoamericana}
}

