  keywords = {brecha digital,digital divide,digital literacy,educación superior,ensino superior,exclusão digital,higher education,ICT,indigenous people,iniciação à computação,iniciación a la informática,población indígena,população indígena,tecnologia da informação,tecnologías de la información}
