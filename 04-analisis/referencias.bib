@thesis{carlosdhayangarciazambrano2026proposed,
  title = {Proposed governance methodology for sustainable energy communities in the context of a just energy transition in Colombia},
  author = {{Carlos Dhayan Garcia Zambrano} and {Luisa Natalia Daza Vargas}},
  date = {2026-10-01},
  journaltitle = {Repositorio Universidad Distrital},
  url = {https://openalex.org/W7223420885},
  abstract = {El presente trabajo de grado propone una metodología de gobernanza para el desarrollo de comunidades energéticas sostenibles en el marco de la Transición Energética Justa en Colombia. La investigación parte de la identificación de brechas organizativas, técnicas, económicas e institucionales que limitan la participación comunitaria y la permanencia de estas iniciativas. Mediante una revisión documental de literatura científica, experiencias nacionales e internacionales y del marco normativo colombiano, se definieron cinco factores determinantes: organización comunitaria y autogobierno (30 \%), gestión y transferencia técnica para la administración, operación y mantenimiento (25 \%), sostenibilidad económica y asignación de valor (20 \%), articulación multiescalar e institucional (15 \%) y capacitación, aprendizaje y educación eco-social (10 \%). Con base en estos factores se estructuró una metodología participativa y adaptable compuesta por cinco etapas: diagnóstico comunitario y territorial; organización y gobernanza; planeación técnica, económica y ambiental; implementación, operación y apropiación tecnológica; y monitoreo, evaluación y mejora continua. La propuesta incluye instrumentos para caracterizar las condiciones iniciales, definir roles y responsabilidades, evaluar la viabilidad técnica y financiera, orientar la capacitación y realizar seguimiento multidimensional. Su aplicación teórico-conceptual en la iniciativa “Una Luz por El Mirador”, ubicada en el barrio El Mirador de Ciudad Bolívar, Bogotá D.C., permitió reconocer fortalezas asociadas con la organización comunitaria, la articulación académico-comunitaria y la estructuración de alternativas energéticas para el Salón Comunal y la Carrera 27A. Asimismo, evidenció necesidades de fortalecimiento en la formalización de responsabilidades, la transferencia de capacidades técnicas, la financiación de la administración, operación y mantenimiento, y la evaluación continua. Se concluye que la sostenibilidad de las comunidades energéticas depende de articular la infraestructura con la participación, el autogobierno, la apropiación tecnológica, la gestión económica y el acompañamiento institucional, atendiendo las particularidades de cada territorio.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{carloseduardomagrin2024projeto,
  title = {Projeto {{ROME}}: {{Aprendizagem Cooperativa}} Entre {{Alunos}} Da {{Graduação}} e {{Ensino Médio}}},
  author = {{Carlos Eduardo Magrin} and {Felipe Bachtchen} and {Maicon Parizotto} and {Pedro Kutski} and {Eduardo Todt}},
  date = {2024-11-13},
  pages = {61--66},
  doi = {10.5753/sbrlars_estendido.2024.244685},
  url = {https://openalex.org/W4408696065},
  abstract = {This paper presents the ROME project as a cooperative and collaborative learning tool for high school and university students. The authors validate the platform by implementing STEM education, incorporating concepts of PBL and maker culture, and conducting mini-courses at UniCuritiba. The ROME project aims to develop a solid and documented foundation for implementing mobile robotics squads in schools, highlighting the academic, social, and economic benefits. As industries adopt new technologies, there is an increase in the demand for skilled personnel in multidisciplinary areas such as robotics and programming. However, as the reality of Brazilian public schools differs significantly from the conditions found in private schools, low-income students face restricted access to robotics courses and materials. The ROME project addresses this issue by broadening access to robotics education by providing a low-cost robotics kit. ROME is a non-profit, open-source, and scalable project. The project allows university students to apply their knowledge in a real-world context, enhancing their technical and interpersonal skills. Additionally, ROME promotes inclusion, empowering students who would otherwise not have access to this knowledge. As an open-source project, the files for developing ROME and support materials are accessible at https://github.com/rosie-projects/rome.},
  langid = {english},
  keywords = {inglesa}
}

@incollection{carloseduardoribeiro2025capitulo,
  title = {Capítulo 3: o curso de governança territorial saudável e sustentável e as ações de inteligência cooperativa: análise do projeto “a construção de capacidades sociais para o enfrentamento da COVID-19 e suas consequências nos territórios”},
  booktitle = {Arca - Repositório Institucional da Fiocruz},
  author = {{Carlos Eduardo Ribeiro} and {Flora Carvalho de Oliveira e Freitas Fonseca} and {Joelma Fernandes da Silva} and {Lara Cristina Borges} and {Luzia Soares de Jesus Farias} and {Maria Beatriz Siqueira Campos de Oliveira} and {Wagner de Jesus Martins}},
  date = {2025-01-01},
  url = {https://openalex.org/W7133444908},
  abstract = {Este trabalho relata a experiência do projeto “A Construção de Capacidades Sociais para o Enfrentamento da COVID-19 e suas Consequências nos Territórios”, desenvolvido no curso de pós-graduação em Governança Territorial para o Desenvolvimento Saudável e Sustentável. O projeto foi implementado na Cidade Estrutural, no Distrito Federal, em parceria com a Fundação Oswaldo Cruz, o Instituto Federal de Brasília e a Universidade de Brasília. O projeto tem como objetivo formar pesquisadores sociais, chamados de Agentes de Governança Territorial, por meio da ativação de redes sociotécnicas e da integração entre conhecimentos científicos e saberes territoriais. Os discentes desempenham um papel ativo na execução desse projeto e este estudo constitui-se, portanto, de uma pesquisa social qualitativa, com metodologia de pesquisa participante. Dentre os objetivos específicos deste estudo, inclui-se a análise da influência do curso na execução do projeto. Ademais, foi realizado um exame do perfil sociodemográfico da região estudada, abordando-se temáticas como a territorialização dos Objetivos de Desenvolvimento Sustentável da Organização das Nações Unidas (ONU) em comunidades vulneráveis por meio da implementação de ações de economia solidária e da aplicação de tecnologias sociais. A análise dos aspectos revelou a importância crucial da criação e do fortalecimento das redes comunitárias existentes para promover o desenvolvimento saudável e sustentável da Cidade Estrutural. Essa relevância foi evidenciada pela contribuição do curso de pós-graduação, do edital que viabilizou o projeto e das ações voltadas à formação e valorização dos agentes territoriais de vigilância popular em saúde, que desempenharam um papel ativo e participativo no projeto, contribuindo e fortalecendo as redes existentes.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@thesis{carlosernestocarrilloarellano2011analisis,
  title = {Análisis de protocolos de encaminamiento para redes inalámbricas tipo malla en modo infraestructura},
  author = {{Carlos Ernesto Carrillo Arellano}},
  date = {2011-09-12},
  doi = {10.24275/uami.1544bp36k},
  url = {https://openalex.org/W4212839110},
  abstract = {Las redes inalámbricas en malla (Wireless Mesh Networks -WMN) son un nuevo paradigma de las redes de datos.Esta novedosa propuesta tecnológica puede ser adaptada a diversos escenarios de aplicación, tales como: redes comunitarias, extensión inalámbrica de redes cableadas, sistemas de automatización, sistemas de transporte inteligente, etc. Las redes inalámbricas en malla en modo infraestructura (Infrastructure WMN -iWMN) son actualmente, la variante más prometedora para extender la cobertura de las redes cableadas, y particularmente la de Internet.Éstas, ofrecen conectividad inalámbrica a usuarios móviles a través de una arquitectura de red con características muy atractivas, entre las que destacan su bajo costo, eficiencia, escalabilidad, confiabilidad y sobre todo, su facilidad para ser desplegadas.Las iWMN estan conformadas por dos elementos fundamentales: la troncal de la red y el conjunto de usuarios móviles.La troncal de la red ó backbone, está integrado por nodos inalámbricos estáticos capaces de encaminar datos de manera cooperativa (multihop network ), permitiendo así el establecimiento de rutas de comunicación entre usuarios móviles o bien entre estos usuarios y otras arquitecturas de red.Es debido a esta característica que cada uno de los nodos que conforman el backbone hereda las funciones y responsabilidades propias de un dispositivo de encaminamiento.Por esta razón, es necesario utilizar protocolos de encaminamiento que, además de lograr el establecimiento de rutas de comunicación, sean capaces de maximizar el desempeño de la red, minimizar los problemas inherentes a la misma, así como atender los requerimientos de las aplicaciones que residirán en ella.A pesar de las notorias diferencias entre redes ad hoc e iWMN, los protocolos de encaminamiento diseñados específicamente para las primeras han sido considerados como una plataforma viable para atender el problema de encaminamiento en estas últimas.Sin embargo, existen dudas justificadas sobre la eficiencia inducida por estos esquemas de encaminamiento en esta novedosa arquitectura de red, llegándose a afirmar que el desempeño inducido podría no ser óptimo.Este trabajo de investigación busca contribuir a los esfuerzos de evaluación de desempeño de los protocolos de encaminamiento diseñados para redes ad hoc en iWMN.A través de la evaluación de desempeño de los esquemas de encaminamiento Ad hoc On Demand Distance Vector (AODV) y Destination Sequenced Distance Vector (DSDV) en iWMN, buscamos evidencia que permita identificar los pros y contras de esta adopción.Las propiedades principales para la elección de estos esquemas de encaminamiento son: su funcionalidad distribuida, su i Contenido Lista de Figuras V 8.1.Señalización del protocolo DSDV. . . . . . . . . . . . . . . . . . . . . . . . .8.2.Envío de un paquete de señalización DSDV del nodo Y al nodo X. . . . . . .8.3.Estado de las tablas de encaminamiento durante el proceso de actualización.8.4.Estado de las tablas de encaminamiento durante la integración de un nuevo nodo. . . . . . . . . . . . . . . . . . . . . . . . . . .},
  langid = {spanish},
  keywords = {iberoamericana}
}

