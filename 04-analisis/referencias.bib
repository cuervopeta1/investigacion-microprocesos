  doi = {10.5897/jabsd2013.0201},
  url = {https://openalex.org/W2313939109},
  abstract = {This work presents a methodology for executing a technological intervention model that improves the management of maize and its yield per hectare. In order to meet the aforesaid goals, 60 maize growers were surveyed; the use of exotechnologies and endotechnologies was assessed through the calculation of the modern technology appropriation index (IATM, by its acronym in Spanish) and the rural technologies use degree (GETC, by its acronym in Spanish); and the growers were classified into low, medium and high efficiency categories in accordance with their IATM and GETC. The results showed that, the IATM was low and the GETC high; that growers used both types of technologies; and that there is not a direct relation between the IATM and the maize yield, although the yield and the GETC are in fact related. Finally, the maize growers were classified in accordance with their unitary yield and the most efficient maize management technological package used by the producers was identified. Such package is considered as the technological model, through which the low-efficiency and mediumâ€‘efficiency growers can increase their yields to 91 and 24\%, respectively. Key words: Exotechnologies and endotechnologies, maize management, modern technology appropriation index (IATM) and rural technologies use degree (GETC).},
  langid = {english},
  keywords = {inglesa}
}

@article{aarontrehub2013safety,
  title = {Safety in {{Numbers}}: {{Distributed Digital Preservation Networks}}},
  author = {{Aaron Trehub} and {Martin Halbert}},
  date = {2013-01-11},
  url = {https://openalex.org/W2256717704},
  abstract = {It has long been recognized that there is safety in numbers and that redundancy enhances survivability. This principle has been applied in many spheres of human activity, from engineering to military science. It is now being applied in librarianship and digital preservation, through the creation of distributed digital preservation (DDP) networks using the open-source LOCKSS (“Lots of Copies Keep Stuff Safe”) software. This paper describes two Private LOCKSS Networks (PLNs) based in North America: the MetaArchive Cooperative, an international preservation network serving more than 50 member institutions in the U.S., Brazil, Spain, and the U.K.; and the Alabama Digital Preservation Network (ADPNet), a state-based preservation network serving academic libraries, public libraries, and the state archives in Alabama. The paper argues that PLNs offer a technologically robust, administratively manageable, and economically sustainable way to protect digital assets and ensure the continuity of digital libraries in the face of natural and man-made disasters.},
  langid = {english},
  keywords = {inglesa}
}

@incollection{aartismithmadan2019womens,
  title = {Women’s Street Artivism in {{India}} and {{Brazil}}},
  booktitle = {Routledge {{eBooks}}},
  author = {{Aarti Smith Madan}},
  date = {2019-02-01},
  pages = {314--325},
  doi = {10.4324/9781315167343-27},
  url = {https://openalex.org/W2921444673},
  abstract = {This chapter examines the ways in which India and Brazil have become the locus of enunciation for a pan-indigenous feminist environmental movement that connects colonial legacies of violence against women as violence against mother earth; reclaiming public space thus brings to bear on two spatial projects of liberation. It centers on the art, writing, and activism of Shilo Shiv Suleman, a contemporary artist based in Bangalore who has quickly gained international acclaim for her work, which ranges from giant installations at Burning Man to TED talks to founding the Fearless Collective. With their community-based art, this group of visual artists denounces rape culture and gender violence and has created safe spaces across the Global South, including a collaborative project with the indigenous women’s group Pelas Mulheres on the coast of Bahia, Brazil. The binational collaboration sought to use art to reclaim a Tupinamba indigenous ancestral graveyard. By analyzing the Fearless Collective’s aesthetic reclamation of Tupinamba territory as well as Fearless Futures: A Feminist Cartographer’s Toolkit , a 56-page open-source manual that emerged from their work in Brazil, this chapter sheds light on the power of street art and participative ritual to undo centuries of injustice against both women and environment.},
  langid = {english},
  keywords = {inglesa}
}

@incollection{aayushmangaikwad2026harnessing,
  title = {Harnessing {{AI}} for {{Climate Resilience}} in the {{Global South}}: {{Ethical Governance}} and {{Digital Sovereignty}} in {{BRICS}}+},
  booktitle = {Advances in Computational Intelligence and Robotics Book Series},
  author = {{Aayushman Gaikwad} and {khusboo Malik (c1c3f107-7330-4bdf-a9bd-af37820cb070} and {Smruti Mishra}},
  date = {2026-05-13},
  pages = {247--282},
  doi = {10.4018/979-8-3373-7205-1.ch009},
  url = {https://openalex.org/W7160983151},
  abstract = {The Global South is disproportionately affected by climate change, but digital societies are structured so that the global governance of artificial intelligence (AI) spawn's new climate adaptation infrastructures, which place two major threats to digital sovereignty and epistemic justice in marginalised territories. The chapter examines the ways in which BRICS+ countries (comprising 45 -percent of the worldwide population) are using AI to become more climate-resistant and challenging Western technology governance paradigms by invoking data sovereignty and implementing Indigenous Knowledge Systems (IKS).We apply the doctrinal policy analysis in the outreach of the decolonial theory and the digital sovereignty perspective through a comparative case-study analysis of the four main BRICS + initiatives that relate to India, Brazil, South Africa, and China along with the additional boundary cases based on Ethiopia and Iran.},
  langid = {english},
  keywords = {inglesa}
}

@article{abbondanzieri2026infraestructura,
  title = {¿La infraestructura de datos es el nuevo horizonte del desarrollo?: implicancias geopolíticas y financieras de la transformación digital para América Latina},
  shorttitle = {¿La infraestructura de datos es el nuevo horizonte del desarrollo?},
  author = {Abbondanzieri, Camila},
  date = {2026},
  journaltitle = {Tramas y redes: Revista del Consejo Latinoamericano},
  number = {10},
  pages = {77--93},
  publisher = {Consejo Latinoamericano de Ciencias Sociales (CLACSO)},
  issn = {2796-9096},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10798255},
  urldate = {2026-11-13},
  abstract = {This article analyzes the reconfiguration of development in the current phase of digital capitalism, driven by the growing centrality of data infrastructure. It argues that development is increasingly organized around the construction, financing, and control of digital infrastructures. The study examines the nature of data infrastructure as an entity that is simultaneously public, private, and geopolitical. It also identifies three key implications for Latin America: the redefinition of what constitutes a financeable asset, growing dependence on global technology players, and the expansion of market-mediated provision models. The article argues that this dynamic impacts regional autonomy. Este artículo analiza la reconfiguración del desarrollo en la actual fase del capitalismo digital a partir de la centralidad creciente de la infraestructura de datos. Sostiene que el desarrollo se organiza cada vez más en torno a la construcción, financiamiento y control de infraestructuras digitales. El trabajo examina la naturaleza de la infraestructura de datos como objeto simultáneamente público, privado y geopolítico. Asimismo, identifica tres implicancias clave para América Latina: la redefinición del objeto financiable, la creciente dependencia de actores tecnológicos globales y la expansión de esquemas de provisión mediados por el mercado. Se argumenta que esta dinámica incide sobre la autonomía regional.},
  langid = {spanish}
}

@article{abdulazizi.almulhim2026rethinking,
  title = {Rethinking Sustainable Urban Planning in the {{Global South}}: Six Paradigm Shifts for the next Decade},
  author = {{Abdulaziz I. Almulhim}},
  date = {2026-10-30},
  journaltitle = {Frontiers in Sustainable Cities},
  shortjournal = {Frontiers in Sustainable Cities},
  volume = {8},
  doi = {10.3389/frsc.2026.2014131},
  url = {https://openalex.org/W7224961610},
  abstract = {Cities across the Global South are entering a decisive decade for sustainable development.Rapid urbanization and intensifying climate change are placing growing pressure on urban sustainability, increasing environmental risks while challenging cities' social, economic, and infrastructural systems (Almulhim \& Cobbinah, 2026;UN-Habitat, 2024). These pressures are unfolding alongside widening socio-spatial inequalities, infrastructure and resource constraints, and profound technological and economic change, with climate impacts often falling disproportionately on vulnerable and marginalized urban populations (UN-Habitat, 2024).Climate-induced migration adds another layer of complexity, as environmental stress can accelerate rural-to-urban mobility, placing additional pressure on infrastructure, services, and informal and peri-urban development in receiving cities (Almulhim et al., 2024). These pressures do not occur independently. They interact within increasingly complex urban systems, where decisions about land use, housing, mobility, infrastructure, ecosystems, and public services can generate consequences far beyond the sectors in which they originate. The significance of these interactions also extends beyond city boundaries, as urban growth increasingly shapes land cover, hydrological systems, climate, biogeochemical processes, and habitats at broader scales (Espey et al., 2024).Although the term Global South encompasses highly diverse urban contexts and should not imply a single development trajectory, the nature and intensity of urban challenges vary considerably across regions, from rapid urban expansion and informality to housing pressures, climate vulnerability, displacement, and resource scarcity (United Nations, 2026). Nevertheless, many cities across Africa, Asia, Latin America, and the Middle East face a common challenge: the pace and complexity of urban change increasingly exceed the capacity of conventional planning institutions and instruments to respond effectively. This mismatch between inherited planning approaches and contemporary urban realities has long been recognized, particularly in relation to informality, inequality, rapid urbanization, and the assumptions underpinning planning theory and practice (Watson, 2009). A decade of expanded urban policy commitments has not resolved this challenge. The United Nations (2026), in its assessment of progress in implementing the New Urban Agenda, reports that implementation continues to lag behind the growing scale and complexity of urban challenges. A recent study further shows that sustainable development outcomes remain highly uneven across space and that socioeconomic progress can coexist with environmental deterioration, reinforcing the need for planning approaches that address trade-offs across multiple dimensions of urban sustainability (Guo et al., 2026).The challenge, however, is not a lack of ideas. Sustainable urban planning now draws on a rapidly expanding repertoire of approaches, including resilience planning, nature-based solutions, participatory governance, smart-city technologies, integrated infrastructure, and data-driven decision-making. Yet the translation of these approaches into sustained urban transformation remains uneven. Climate adaptation, for example, depends on institutional capacity, meaningful participation, and the ability to address the needs of poor and vulnerable communities (Chu et al., 2016). Similarly, recent research on nature-based solutions highlights governance, financial feasibility, social acceptance, and context-specific approaches as critical conditions for effective urban planning and implementation (Mirsafa et al., 2025). Informality further complicates this transition because formal and informal institutions, economic activities, and socio-ecological processes are deeply interdependent rather than functioning as separate urban systems (Eakin et al., 2025).The central question for the coming decade is therefore no longer simply what cities should do to become more sustainable, but how planning itself must change to enable sustainable urban transitions under conditions of complexity, uncertainty, informality, and inequality. This Grand Challenge argues that incremental improvements to conventional planning will not be sufficient.It identifies six interrelated paradigm shifts: from sectoral planning to systems thinking; from static plans to adaptive and resilient planning; from formal planning to inclusive urbanism; from growthcentered planning to well-being and equity; from engineering-dominated solutions to ecological urbanism; and, ultimately, from planning as control to planning as continuous learning.Conventional urban planning has played an essential role in organizing land use, guiding infrastructure investment, regulating development, and articulating long-term visions for cities.The challenge is therefore not that conventional planning has become irrelevant, but that many of its underlying assumptions are increasingly insufficient for the conditions under which cities in the Global South are evolving. Planning instruments have often been built around expectations of relatively predictable urban growth, effective formal institutions, clearly defined administrative responsibilities, reliable data, and development that can be managed through formal regulatory systems. In many rapidly urbanizing contexts, however, urban change unfolds through a more complex combination of formal and informal processes, uneven institutional capacity, infrastructure deficits, resource constraints, and increasingly uncertain climatic and socioeconomic conditions. This mismatch is increasingly visible at the implementation level. The United Nations (2026), in its assessment of progress in implementing the New Urban Agenda, reports that despite the wider adoption of national urban and housing policies, implementation has not kept pace with the growing scale and complexity of urban challenges. Persistent gaps between national policy frameworks and municipal planning instruments, limited local capacity, fragmented institutional mandates, weak monitoring systems, and inadequate financing continue to constrain implementation. These broader constraints are also evident in rapidly urbanizing Saudi cities, where population growth, environmental pressures, implementation limitations, and mismatches between national priorities and local urban conditions have challenged planning practice (Almulhim \& Cobbinah, 2024). These conditions reinforce the need for context-sensitive planning approaches in the Global South, particularly given the limitations of uncritically transferring planning knowledge and models developed in substantially different socioeconomic and institutional contexts (Verdini et al., 2025).A second limitation lies in the fragmented treatment of problems that are systemically interconnected. Land-use decisions influence mobility and infrastructure demand; housing conditions shape exposure to climate hazards; water, energy, ecosystems, and public health interact across administrative and sectoral boundaries. Yet institutions responsible for these systems often operate through separate mandates, budgets, datasets, and planning cycles. The United Nations (2026) similarly identifies fragmented institutional mandates and weak coordination across levels of government as persistent barriers to translating urban policy into spatially coordinated investment and implementation. Evidence from urban climate governance illustrates how fragmented institutional arrangements can constrain integrated responses even where climate risks are recognized (Pazhuhan, 2023). Similar problems appear in adaptation finance: analysis of projects in the Global South found limited attention to uncertainty and relatively weak mechanisms for generating transformative effects across sectors (Forino et al., 2022).Climate change further exposes the limits of planning based predominantly on stable baselines and anticipated trajectories. Increasing climatic variability, compound risks, migration, economic disruption, and rapid technological change make urban futures progressively harder to predict. This does not eliminate the need for long-term plans; rather, it changes what long-term planning must be capable of doing. Earlier work on cities in the Global South already argued that climate adaptation requires governance approaches able to connect different spatial and temporal scales, accommodate multiple forms of knowledge, and integrate formal and informal responses (Birkmann et al., 2010). More recent research similarly emphasizes that adaptive governance must be interpreted through the particular institutional and social conditions of the Global South rather than transferred uncritically from elsewhere (Yasmin et al., 2019). These limitations should therefore not be understood as isolated failures of individual plans or institutions. Collectively, they point to a deeper mismatch between a planning paradigm designed largely around sectoral organization, predictability, formality, and control, and urban realities increasingly characterized by interdependence, uncertainty, informality, and rapid change.The task ahead is not to abandon established planning instruments, but to reposition them within a broader paradigm capable of integrating systems, adapting to uncertainty, recognizing diverse forms of urbanism and knowledge, prioritizing equity and ecological processes, and learning continuously from implementation. Figure 1 conceptualizes this transition through six interrelated paradigm shifts that, taken together, provide a framework for rethinking sustainable urban planning in the Global South. Six paradigm shifts for rethinking sustainable urban planning in the Global South. The framework does not imply the wholesale replacement of conventional planning approaches. Rather, it represents a reorientation of planning toward more systemic, adaptive, inclusive, equitable, ecological, and learning-based approaches capable of responding to increasingly complex and uncertain urban conditions.The limitations outlined above suggest that the challenge is not simply to improve individual planning instruments, but to reconsider some of the principles through which urban planning understands and responds to change. The six shifts presented below are neither mutually exclusive nor intended as universal prescriptions for the highly diverse cities of the Global South. Rather, they identify complementary directions through which planning can become more capable of engaging with interdependence, uncertainty, informality, inequality, ecological limits, and institutional change. Their value lies not in replacing established planning practices wholesale, but in expanding the ways in which urban problems are framed, decisions are made, and implementation is evaluated. Overall, the six shifts provide an integrated, Global South-focused perspective for framing the interconnected challenges that sustainable urban planning must address over the next decade and for linking these challenges to the research priorities outlined in Section 4.Urban sustainability is inherently multidimensional and multiscalar, meaning that interventions that generate benefits in one dimension or at one spatial scale may produce different outcomes or trade-offs in others (Seto et al., 2017). Urban sustainability challenges rarely conform to the administrative and sectoral boundaries through which cities are planned. about land influence mobility, infrastructure housing, ecological and exposure to environmental risks, while water, energy, and infrastructure systems on one Sustainable urban systems are therefore increasingly understood through the interactions social institutions, ecological processes, and interconnected rather than through individual sectors et al., A housing for example, may environmental and of inequality. This need for is a