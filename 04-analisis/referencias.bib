  title = {Technology adoption among older adults: Bridging the digital divide},
  author = {{Mariana Álvarez Huertas} and {Nicole Daiana Buitrago Moreno} and {Natalia Varón Munevar}},
  date = {2025-06-20},
  journaltitle = {Repositorio Institucional (Pontificia Universidad Javeriana)},
  url = {https://openalex.org/W7128748857},
  abstract = {En un contexto en el que la transformación digital está redefiniendo las dinámicas sociales, económicas y culturales, las personas mayores siguen enfrentándose a importantes brechas en el acceso, el uso y la apropiación de las tecnologías. Estas brechas no solo se deben a factores generacionales o educativos, sino también a la limitada alfabetización tecnológica de esta población y a la percepción de que estas aplicaciones no están diseñadas para ellos. Esto se explica principalmente por el hecho de que no crecieron inmersos en entornos digitales, lo que limita su familiaridad y confianza para adoptar nuevas tecnologías. Ante este problema, Camino D: Ser Digital es una propuesta metodológica destinada a facilitar la apropiación tecnológica en las personas mayores. Su diseño es versátil y replicable, y aunque puede adaptarse a diferentes contextos, en este caso se centra en el uso de la plataforma digital Uber para reforzar su autonomía en materia de movilidad y transporte. La metodología se organiza en cinco fases integradas, que van desde el reconocimiento del dispositivo móvil y el entorno digital hasta la interacción segura y autónoma con la aplicación, incluyendo la resolución de errores y la evaluación del proceso. Inicialmente, se llevó a cabo una caracterización cualitativa y cuantitativa de la población de adultos mayores mayores de 60 años que residen en las localidades de Suba, Fontibón y Usaquén en Bogotá, con el objetivo de identificar los factores clave que definen su contexto y sus necesidades en relación con la tecnología. Posteriormente, se desarrolló un diseño preliminar basado en modelos pedagógicos que añaden valor al proceso de adopción digital, como el aprendizaje colaborativo, el aprendizaje experiencial y el enfoque de diseño centrado en el usuario. También contempla diversas estrategias para reforzar la motivación y la confianza de los usuarios. El desarrollo del método se llevó a cabo a través de dos sesiones presenciales en Calucé Senior Living, un hogar para personas mayores ubicado en Usaquén. Participaron ocho personas con una edad promedio de 76,9 años que cumplían con los criterios y delimitaciones establecidos para el trabajo: habilidades básicas de lectura y escritura, capacidades cognitivas y físicas funcionales, y acceso a su propio teléfono inteligente. Para validar la eficacia del diseño, se llevó a cabo un experimento factorial 2², que incluía dos factores: tipo de apoyo complementario A (manual o instructor) e interacción social B (individual o en parejas), teniendo como variable de respuesta el tiempo que tardaban en solicitar un vehículo en Uber. Mediante un análisis estadístico con ANOVA, se formuló como hipótesis nula (H0) que los factores evaluados (A, B o AB) no tienen efecto sobre la variable de respuesta. Cuando se evaluaron los supuestos y se comprobó que no se cumplía el supuesto de homogeneidad, se utilizó una prueba no paramétrica como alternativa para corroborar los resultados obtenidos en el ANOVA inicial. Los resultados mostraron que el apoyo complementario guiado por un instructor redujo significativamente el tiempo de aprendizaje en comparación con el uso exclusivo del manual; y el tratamiento que minimizó la variable de respuesta fue el apoyo del instructor con la modalidad de aprendizaje en parejas. Por último, para evaluar el aprendizaje alcanzado, se aplicó una encuesta basada en los modelos UTAUT2 y STAM, incorporando variables como la intención de uso, la utilidad percibida, la confianza y la expectativa de esfuerzo. Los usuarios mostraron un aumento en su motivación, confianza e interés en explorar otras herramientas digitales, lo que refleja un cambio positivo en su actitud y comportamiento hacia la tecnología.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{marianabarrios2026diversas,
  title = {Diversas pero no dispersas. Experiencia de investigación-acción feminista en las comunidades de Cinturão Verde y Facão (Cáceres, Mato Grosso, Brasil)},
  author = {{Mariana Barrios} and {Liliane Cristine Schlemer Alcântara}},
  date = {2026-10-23},
  journaltitle = {Zenodo (CERN European Organization for Nuclear Research)},
  shortjournal = {Zenodo (CERN European Organization for Nuclear Research)},
  doi = {10.5281/zenodo.23598120},
  url = {https://openalex.org/W7223273663},
  abstract = {RESUMEN Objetivo Este artículo presenta y analiza una experiencia de investigación-acción participativa feminista desarrollada en el municipio de Cáceres, Estado de Mato Grosso, Brasil, junto a mujeres de las comunidades rurales Cinturão Verde y Facão, integrantes de una asociación de agricultura familiar. Metodología El análisis adoptó un enfoque cualitativo, y la experiencia se basó en los postulados de la investigación-acción participativa feminista y en la educación popular. El proceso se organizó en dos etapas: una exploratoria, orientada a identificar problemáticas vinculadas a las relaciones de género y al trabajo de cuidados; y una etapa de acción, materializada en la realización de talleres participativos, uno mixto y otro exclusivamente entre mujeres. En estos talleres fueron empleadas técnicas de la educación popular feminista. Resultados Los resultados evidencian la persistencia de la división sexual del trabajo, la sobrecarga de cuidados sobre las mujeres y la naturalización de las violencias de género, así como el potencial del “entre mujeres” y de las redes comunitarias como estrategias de empoderamiento colectivo. Conclusiones principales Las conclusiones se focalizan en las dificultades atravesadas -por ejemplo, la escasa participación en el taller mixto y algunas limitaciones temporales-, así como los aprendizajes obtenidos para futuras experiencias de investigación-acción feminista.},
  langid = {spanish},
  keywords = {iberoamericana}
}

