@article{nietovera2021modelo,
  title = {Modelo de apropiación de tecnologías de la información geográfica como apoyo a la consolidación de ciudades inteligentes, caso de estudio Bogotá (Colombia)},
  author = {Nieto Vera, Yeni Andrea and Rocha Salamanca, Luz Angela},
  date = {2021},
