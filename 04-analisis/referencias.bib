@article{silvag.2016stuxnet,
  title = {StuxNet – El software como herramienta de control geopolítico},
  author = {Silva G., Francisco},
  date = {2016},
  journaltitle = {Revista PUCE},
  number = {2},
  pages = {117},
  publisher = {Pontificia Universidad Católica de Ecuador},
  issn = {1390-7719},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=8472808},
  urldate = {2026-11-13},
  abstract = {Las tecnologías evolucionan rápidamente, y esta carrera no deja atrás al malware. En el 2010 se dio a conocer un virus informático que marcó un hito por sus efectos que cruzan la línea entre lo virtual y el mundo real, y por conjugar además elementos tecnológicos y geopolíticos, dando luz de lo que podrían ser las próximas guerras. El virus StuxNet atacó con éxito infraestructura crítica de un país de Medio Oriente dejando rastros que describen un contexto geopolítico del que formó parte, y que ha dado origen a múltiples investigaciones las cuales han servido para la elaboración de este artículo. El caso StuxNet, plantea a la soberanía tecnológica de importancia estratégica para un país, es decir, el tener control sobre las tecnologías, y generar capacidad técnica local para lograrlo.},
  langid = {spanish}
}

@article{silvanadonadiovilelalemos2016profissionalizacao,
  title = {PROFISSIONALIZAÇÃO DOCENTE NAS ESCOLAS PÚBLICAS DO ESTADO DE TOCANTINS: novo contexto de ensino e aprendizagem pelas tecnologias digitais},
  author = {{Silvana Donadio Vilela Lemos}},
  date = {2016-10-30},
  journaltitle = {Revista Observatório},
  shortjournal = {Revista Observatório},
  volume = {2},
  number = {4},
  pages = {394--394},
  doi = {10.20873/uft.2447-4266.2016v2especial2p394},
  url = {https://openalex.org/W2541513148},
  abstract = {O presente artigo é o recorte do Relatório Técnico das Oficinas Teórico-Práticas do Curso de Formação Prouca-Tocantins, desenvolvidas com profissionais das escolas municipais, no período de agosto de 2013 a dezembro de 2014. Pretende-se relatar a proposta pedagógica de formação de professores e gestores das escolas municipais, para o uso pedagógico das Tecnologias Digitais de Informação e Comunicação (TDIC), a partir da utilização do laptop. Na sequência, apresentar a concepção de três oficinas e a sua recriação em três escolas municipais, dentre as 15 oficinas ofertadas no curso de formação. A metodologia baseou-se na análise do Relatório Técnico Teórico-Práticas do Curso de Formação do Prouca-Tocantins. Há evidências de que a inserção das TDIC e do laptop a partir de Projetos Temáticos impulsionou uma nova relação entre professores e estudantes, protagonistas e parceiros em equipes de trabalho. Há indícios de que a inserção das TDIC e do laptop nas práticas pedagógicas motivou os estudantes a pesquisar, ler, selecionar, organizar e compartilhar informações; dialogar; escrever em coautoria; e expressar os novos saberes em diferentes linguagens midiáticas, para sua publicação. Há evidências de que a formação contribuiu para minimizar a insegurança dos professores em integrar as TDIC e o laptop às práticas pedagógicas. Dentre os desafios, destacam-se os diferentes níveis de apropriação tecnológica e pedagógica dos profissionais das escolas. Apresenta-se, como indicador emergente, a continuidade dos estudos de formação dentro do contexto escolar, com um conjunto diferenciado de oficinas. PALAVRAS-CHAVE: Profissionalização docente. Tecnologias digitais. Inovação educativa. ABSTRACT This article is the cut of the Technical Report of the Workshop Theoretical and Practices Training Course of PROUCA-Tocantins , developed with professionals in the municipal schools from August 2013 to December 2014. The aim is to relate the pedagogical proposal of training teachers and managers of municipal schools for the pedagogical use of Information and Communication Digital Technologies (TDIC), from the use of the laptop. Further, the present design of two workshops and their recreation in three municipal schools, among the fifteen workshops offered in the training course. The methodology was based on the analysis of the Technical Report Theoretical-Practical Training Course of PROUCA-Tocantins. There is evidence that the inclusion of TDIC and laptop from Thematic Projects boosted a new relationship between teachers and students, actors and partners in work teams. There are indications that the inclusion of TDIC and laptop to pedagogical practices, motivated students to search, read, select, organize and share information, dialogue, co-authored write and express new knowledge in different media languages for publication. There is evidence that the training helped minimize the insecurity of teachers to integrate TDIC and the laptop to pedagogical practices. Among the challenges present, there are different levels of technological and pedagogical appropriation of school workers. It presents, as emerging indicator, the continuity of the studies of training within the school context, with a differentiated set of workshops. KEYWORDS: Teacher professionalization. Digital technologies. Educational innovation. RESUMENEste artículo es el corte del Informe Técnico del Taller de prácticas teóricas Prouca-Tocantins curso de formación, desarrollado con profesionales en las escuelas municipales a partir de agosto de 2013 hasta diciembre de 2014. El objetivo es relacionar la propuesta pedagógica de la formación maestros y directores de escuelas municipales para el uso educativo de las Tecnologías de la Información y Comunicación Digital (TDIC), a partir de la utilización de la computadora portátil. Además, el presente diseño de tres talleres y su reconstrucción en tres escuelas municipales, entre los 15 talleres que se ofrecen en el curso de formación. La metodología se basa en el análisis del informe técnico de repaso de Prouca-Tocantins curso de formación. Hay evidencia de que la inclusión de TDIC y un ordenador portátil de proyectos temáticos impulsó una nueva relación entre profesores y estudiantes, actores y socios en equipos de trabajo. Hay indicios de que la inclusión de TDIC y un ordenador portátil en las prácticas pedagógicas motivados a los estudiantes a buscar, leer, seleccionar, organizar y compartir información; el diálogo; escribir en coautoría; y expresar nuevos conocimientos en diferentes lenguajes de la comunicación para su publicación. Hay evidencia de que la formación ayudó a minimizar la inseguridad de los maestros para integrar TDIC y el ordenador portátil para prácticas pedagógicas. Entre los desafíos, se destacan los diferentes niveles de apropiación tecnológica y pedagógica de los trabajadores de la escuela. , Se presenta como ventana emergente, la continuidad de los estudios de formación dentro del contexto escolar, con un conjunto diferente de los talleres PALABRAS-CLAVE: La profesionalización docente; tecnologías digitales; innovación educativa.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@thesis{silvanasofiagianninicarrera2026estudio,
  title = {estudio de caso en una escuela pública primaria del interior del Uruguay},
  author = {{Silvana Sofía Giannini Carrera}},
  date = {2026-01-01},
  journaltitle = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  url = {https://openalex.org/W7215134882},
  abstract = {La presente investigación educativa, de carácter aplicado, analiza el proceso de integración de las tecnologías digitales en una escuela pública de educación primaria del interior del país, con especial énfasis en los desafíos asociados a la gestión y al liderazgo institucional. Desde un enfoque cualitativo y mediante un estudio de caso, se buscó comprender de qué manera determinadas condiciones organizacionales incidían en el uso pedagógico de las tecnologías y en las dinámicas institucionales cotidianas. El abordaje metodológico comprendió entrevistas exploratorias al equipo directivo, entrevistas semiestructuradas al colectivo docente y análisis de documentos institucionales. El diagnóstico permitió identificar niveles heterogéneos de apropiación tecnológica entre los docentes, así como una débil articulación entre las prácticas pedagógicas desarrolladas en el centro. Si bien se reconocieron experiencias significativas de incorporación de tecnologías digitales, estas se presentaban de forma fragmentada y con dificultades para sostenerse y proyectarse institucionalmente. Esta situación se vinculó con debilidades en los procesos de planificación, coordinación pedagógica, trabajo colaborativo y conducción institucional. En respuesta a los hallazgos, y en consonancia con el carácter aplicado del estudio, se diseñó un plan de mejora institucional orientado a fortalecer la gestión del centro y promover una integración pedagógica progresiva, equitativa y sostenible de las tecnologías digitales. La propuesta contempla la construcción de criterios comunes, instancias de formación y acompañamiento docente, y el fortalecimiento de los procesos de planificación y evaluación. Los resultados destacan el liderazgo educativo como una condición relevante para promover la mejora organizacional y favorecer una cultura institucional basada en la innovación pedagógica, la colaboración profesional y la mejora continua.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{silveriochisaguanomaliquinga2026hacia,
  title = {Hacia una Soberanía Tecnológica de los pueblos Indígenas: Un marco estratégico de gobernanza de datos frente al extractivismo algorítmico},
  author = {{Silverio Chisaguano Maliquinga}},
  date = {2026-09-01},
  journaltitle = {Polo del Conocimiento},
  shortjournal = {Polo del Conocimiento},
  volume = {11},
  number = {9},
  pages = {201--218},
  doi = {10.23857/pc.v11i8.12385},
  url = {https://openalex.org/W7204935253},
  abstract = {La presente investigación analizó la transformación digital, la expansión de la inteligencia artificial ha generado nuevas oportunidades para el desarrollo social y económico, dando lugar a un incremento de desigualdades en el acceso, control y uso de datos. En este marco, los pueblos indígenas también sufren el extractivismo algorítmico y el colonialismo de datos por la misma apropiación de la información que puede contener saberes ancestrales, lenguas, costumbres, múltiples territorios y alternativas organizativas de carácter comunitario. El propósito de este trabajo ha sido el de proponer un marco estratégico de gobernanza de datos para facilitar el fortalecimiento de la soberanía tecnológica de los pueblos indígenas y contrarrestar los procesos de extracción algorítmica en el contexto latinoamericano. El trabajo ha sido desarrollado bajo un enfoque cualitativo, documental, analítico e interpretativo, mediante una revisión documental sistematizada por la que se identificaron y relacionaron aportaciones sobre soberanía tecnológica, soberanía de datos, IA ética y decolonial, gobernanza comunitaria y autodeterminación digital. Los resultados obtenidos permitieron construir un marco específico de una estrategia fundamentada en cuatro dimensiones: tecnológica, organizacional-cultural, formativa y ética-sostenibilidad, relacionadas por los principios de autonomía, reciprocidad, responsabilidad y beneficio común. De la misma forma se trazó una ruta de cinco fases: diagnóstico comunitario, establecimiento de reglas de gobernanza, desarrollo de capacidades, puesta en práctica la infraestructura propia y cooperativa, así como la auditoría y la evaluación. Se concluye que al abordar la soberanía tecnológica indígena no basta con facilitar el acceso a herramientas digitales, sino que conviene considerar la capacidad de las comunidades para decidir colectivamente sobre los datos, las tecnologías y los conocimientos; que ello debe propiciar una transformación digital intercultural, participativa y orientada a la protección de los derechos colectivos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{silviabacher2025alfabetizacion,
  title = {Alfabetización Mediática e Informacional en América Latina y el Caribe: Introducción y Reflexiones},
  author = {{Silvia BACHER} and {Tomás Durán Becerra} and {Fernando OLIVEIRA PAULINO} and {Elíseo R. Colón} and {Gissela Dávila Cobo}},
  date = {2025-08-29},
  journaltitle = {Chasqui Revista Latinoamericana de Comunicación},
  shortjournal = {Chasqui Revista Latinoamericana de Comunicación},
  number = {159},
  doi = {10.16921/chasqui.v1i159.5220},
  url = {https://openalex.org/W4414342814},
  abstract = {Este monográfico es parte de un número especial organizado conjuntamente por la Revista Latinoamericana de Comunicación - Chasqui y el Journal of Latin American Communication Research, dedicado a la Alfabetización Mediática e Informacional (AMI) en América Latina y el Caribe, como resultado de la alianza estratégica entre CIESPAL, ALAIC, la Representación Regional de América Latina y el Caribe de la Alianza Global para la AMI impulsada por UNESCO, Las Otras Voces - Comunicación para la democracia y UNIMINUTO cuyo fin común consiste en identificar, visibilizar y articular iniciativas de nuestra América en un entorno de aceleradas transformaciones en una región marcada por la desigualdad. El número reúne investigaciones desarrolladas en Argentina, Brasil, México, Paraguay, Cuba y otros países, con el fin de mostrar la diversidad de experiencias y enfoques sobre el tema. Se aborda la AMI como un campo multidimensional que combina educación crítica en medios, apropiación tecnológica, prevención de la desinformación, fortalecimiento de la ciudadanía y desarrollo de políticas públicas. El texto ofrece una lectura transversal de los artículos, situándolos en diálogo con la literatura internacional y destacando sus contribuciones en ámbitos como la democracia, la salud, la juventud y la innovación pedagógica. A partir de estas experiencias, se reconocen tanto los avances como los desafíos que enfrenta la región para consolidar un ecosistema de AMI robusto, articulado y sostenible. El número especial se propone, así, como un aporte significativo para la cooperación académica iberoamericana y para el diseño de estrategias educativas y sociales que respondan a los retos del siglo XXI.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{silviabacher2025media,
  title = {Media and {{Information Literacy}} in {{Latin America}} and the {{Caribbean}}: {{Introduction}} and {{Reflections}}},
  author = {{Silvia Bacher} and {Tomás Durán Becerra} and {F Paulino} and {Elíseo R. Colón} and {Gissela Dávila Cobo}},
  date = {2025-12-23},
  journaltitle = {Journal of Latin American Communication Research},
  shortjournal = {Journal of Latin American Communication Research},
  volume = {13},
  number = {2},
  pages = {1--8},
  doi = {10.55738/journal.v13i2p.1-8},
  url = {https://openalex.org/W7122935599},
  abstract = {This monograph is part of a special issue co-organized by the Latin American Journal of Communication - Chasqui and the Journal of Latin American Communication Research, dedicated to Media and Information Literacy (MIL) in Latin America and the Caribbean. This is the result of a strategic alliance between CIESPAL, ALAIC, the Latin American and Caribbean Regional Representation of the Global Alliance for MIL promoted by UNESCO, Las Otras Voces - Communication for Democracy, and UNIMINUTO. Their common goal is to identify, highlight, and articulate initiatives from Latin America in a context of accelerated transformations in a region marked by inequality. The issue brings together research conducted in Argentina, Brazil, Mexico, Paraguay, Cuba, and other countries to showcase the diversity of experiences and approaches on the topic. MIL is addressed as a multidimensional field that combines critical media education, technological appropriation, disinformation prevention, citizenship empowerment, and public policy development. The text offers a cross-sectional reading of the articles, placing them in dialogue with international literature and highlighting their contributions in areas such as democracy, health, youth, and pedagogical innovation. Based on these experiences, it recognizes both the progress and the challenges the region faces in consolidating a robust, articulated, and sustainable MIL ecosystem. The special issue thus aims to make a significant contribution to Ibero-American academic cooperation and to the design of educational and social strategies that respond to the challenges of the 21st century.},
  langid = {english},
  keywords = {inglesa}
}

@thesis{silviacarinacardosocassandra2025implementacao,
  title = {A implementação do IVA em São Tomé e Príncipe},
  author = {{Sílvia Carina Cardoso Cassandra}},
  date = {2025-10-22},
  journaltitle = {Portuguese National Funding Agency for Science, Research and Technology (RCAAP Project by FCT)},
  url = {https://openalex.org/W7221735201},
  abstract = {A presente dissertação analisa a implementação do Imposto sobre o Valor Acrescentado (IVA) em São Tomé e Príncipe, introduzido a 1 de junho de 2023, procurando avaliar em que medida o modelo adotado segue as boas práticas internacionais recomendadas por organismos como a OCDE, o FMI e a União Europeia. A investigação articula três eixos: (i) enquadramento conceptual e evolução global do IVA; (ii) descrição do processo legislativo e do desenho jurídico do imposto em São Tomé e Príncipe; e (iii) análise crítica das convergências, divergências e fragilidades do modelo nacional face às orientações internacionais. A metodologia combinou análise normativa (CIVA e diplomas complementares), exame documental (relatórios e recomendações de parceiros internacionais) e análise empírica dos resultados orçamentais entre 2019 e 2025, complementada com entrevistas a atores institucionais e económicos. Conclui-se que, apesar de o modelo são-tomense revelar uma notável convergência formal com as boas práticas, subsistem importantes fragilidades na capacidade administrativa, na apropriação tecnológica e na execução prática, que condicionam a eficácia arrecadatória e a legitimidade social do imposto. A dissertação identifica, por fim, recomendações para o futuro, centradas no reforço da administração tributária, na simplificação do regime e no combate à informalidade.},
  langid = {portuguese},
  keywords = {iberoamericana}
}

@article{silviafernandez-sabido2026soberania,
  title = {Soberanía tecnológica y lenguas indígenas: de la dominación histórica a la era de la inteligencia artificial},
  author = {{Silvia Fernández-Sabido} and {LAURA PENICHE SABIDO}},
  date = {2026-01-01},
  journaltitle = {Texto Livre Linguagem e Tecnologia},
  shortjournal = {Texto Livre Linguagem e Tecnologia},
  volume = {19},
  doi = {10.1590/1983-3652.2026.64143},
  url = {https://openalex.org/W7224826582},
  abstract = {Resumen La relación entre las lenguas originarias y el desarrollo tecnológico ha estado históricamente marcada por tensiones de poder y exclusión sistémica. Este artículo analiza cómo la evolución de las tecnologías de la comunicación y la información reconfigura las relaciones de poder en las comunidades indígenas y condiciona su soberanía frente a la inteligencia artificial (IA). Mediante una revisión crítico-documental de 62 fuentes clave (67.7 \% de actualidad), apoyada en herramientas de IA para el soporte en la redacción, se sistematiza una genealogía que transita desde el saber ancestral hasta el activismo digital contemporáneo. Los resultados, sustentados en taxonomías de viabilidad técnica y evolución histórica que integran los impactos reportados en la literatura, revelan un movimiento pendular en la agencia tecnológica: desde la autonomía prehispánica hasta la desposesión simbólica mediante la alfabetización latina, culminando en la actual reapropiación de herramientas digitales y en el posicionamiento frente a los desafíos del Procesamiento de Lenguaje Natural (PLN). Se concluye que la integración soberana en los Grandes Modelos de Lenguaje (LLM) requiere trascender el extractivismo de datos para establecer protocolos de colaboración horizontal y diseño participativo. La soberanía de la palabra en la era de la IA es una condición necesaria para la alineación de la tecnología con los mejores valores humanos.},
  langid = {spanish},
  keywords = {iberoamericana}
}

@article{simoncrisostomoloncopan2026simon,
  title = {Simón {{Crisóstomo Loncopán}}: {{Mapuche Territorial Governance}} and {{Forest Restoration}}},
  author = {{Simón Crisóstomo Loncopán} and {Pablo González Rivas} and {Paula Tiara Torres}},
  date = {2026-04-29},
  journaltitle = {Apollo (University of Cambridge)},
  shortjournal = {Apollo (University of Cambridge)},
  doi = {10.17863/cam.129786},
  url = {https://openalex.org/W7157602399},
  abstract = {In this episode of Smart Forests Radio, we speak with Simón Crisóstomo Loncopán, lonko (“chief” in Mapudungun) and president of the Mapuche Community for Territorial Governance in Curarrehue, Araucanía region, Wallmapu, Chile. Simón reflects on how leadership and governance processes have grown from within the territory, shaped by Mapuche political education, social movements and community networks spanning Latin America. Simón outlines the methodologies and technologies supporting territorial defence and forest stewardship, including Indigenous management plans for fire prevention and ecosystem restoration. The conversation spotlights mapping as a tool for protection and land claims, which becomes powerful when diverse perspectives work together, enabling dialogue with Mapuche communities and the state. He also explores how drones and three-dimensional imagery help move beyond an imposed view, offering new ways to see and connect with the territory.},
  langid = {english},
  keywords = {inglesa}
}

@article{simonegabrielydasilvalima2021cibercultura,
  title = {Cibercultura e internet das coisas: os desdobramentos da educação na era digital/ Cyberculture and the internet of things: the unfolding of education in the digital age},
