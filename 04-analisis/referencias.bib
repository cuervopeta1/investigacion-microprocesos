  issn = {1851-0027},
  doi = {10.37603/2250.7728.v30.n1.48383},
  url = {http://www.scielo.org.ar/scielo.php?script=sci_arttext&pid=S1851-00272026000100053&lang=pt},
  abstract = {Abstract This paper analyses the Mirapedia project, a wiki repository on the heritage of Miramar de Ansenuza (Córdoba, Argentina). For the implementation of the proposal, a cycle of Collaborative Content Creation Workshops was developed, which included training workshops, Editatones and a Feedback Session with the first advances of the wiki. This paper approaches the experience of the cycle of workshops from a reflective perspective, addressing the potential of the wiki as a tool for participatory heritage management that allows us to generate a corpus of community and open information on local heritage, as well as the challenges and limitations posed using this type of platform.},
